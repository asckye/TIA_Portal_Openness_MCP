<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="TIA Portal · MCP Bridge" Width="1200" Height="780" MinWidth="1200" MinHeight="780" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource Ui.WindowBackground}" Foreground="{DynamicResource Ui.Label}" FontFamily="{DynamicResource Ui.Font}" FontSize="12" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" xmlns:glass="clr-namespace:TiaDesktop.Glass;assembly=__VIEW_ASSEMBLY__">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- GLASS RESOURCES -->
    <Style TargetType="Button" BasedOn="{StaticResource Glass.Button}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Glass.Field}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Glass.Combo}"/>
    <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}"/>
    <Style x:Key="ModeCard" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Panel" Background="{DynamicResource Ui.CardBackground}" BorderBrush="{DynamicResource Ui.HairLine}" BorderThickness="1" CornerRadius="16" Padding="20,17">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Panel" Property="BorderBrush" Value="{DynamicResource Ui.AccentSoftBorder}"/>
                <Setter TargetName="Panel" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Panel" Property="Padding" Value="19,16"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ClientChoice" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Tile" CornerRadius="12" Background="{DynamicResource Ui.FieldBackground}" BorderBrush="{DynamicResource Ui.FieldBorder}" BorderThickness="1" Padding="13,11" Height="80">
              <Grid>
                <ContentPresenter/>
                <Border x:Name="Check" Width="15" Height="15" CornerRadius="8" BorderBrush="{DynamicResource Ui.DashedBorder}" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <TextBlock x:Name="Tick" Text="" FontFamily="Segoe Fluent Icons" FontSize="9" Visibility="Collapsed" Foreground="{DynamicResource Ui.OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Ui.AccentSoftBorder}"/>
                <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
                <Setter TargetName="Tile" Property="Padding" Value="12,10"/>
                <Setter TargetName="Check" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ClientTile">
      <StackPanel ToolTip="{Binding Tooltip}">
        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Margin="0,0,18,3"/>
        <TextBlock FontSize="11">
          <TextBlock.Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}">
              <Setter Property="Text" Value="{DynamicResource Text.NotDetected}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ui.TertiaryLabel}"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding Detected}" Value="True">
                  <Setter Property="Text" Value="{DynamicResource Text.Detected}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding Path}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10" Foreground="{DynamicResource Ui.TertiaryLabel}" Margin="0,3,0,0"/>
      </StackPanel>
    </DataTemplate>
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
      <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border CornerRadius="10" Background="{DynamicResource Ui.FieldBackground}" BorderBrush="{DynamicResource Ui.FieldBorder}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="{DynamicResource Ui.WindowBackground}" ClipToBounds="True">
    <Ellipse Fill="{DynamicResource Glass.GlowOne}" Width="1200" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-420,-322,0,0" IsHitTestVisible="False"/>
    <Ellipse Fill="{DynamicResource Glass.GlowTwo}" Width="1000" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-380,-302" IsHitTestVisible="False"/>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="18,0,8,0">
        <StackPanel x:Name="CaptionTitle" Orientation="Horizontal">
          <Border Width="16" Height="16" Background="{DynamicResource Ui.Accent}" CornerRadius="5" VerticalAlignment="Center"/>
          <TextBlock Text="TIA Portal · MCP Bridge" FontWeight="SemiBold" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Menu x:Name="MenuBar" Background="Transparent" Foreground="{DynamicResource Ui.SecondaryLabel}" FontSize="11" VerticalAlignment="Center">
            <MenuItem Header="•••" Padding="10,4">
              <MenuItem x:Name="UpdateMenu" Header="{DynamicResource Text.Update}">
                <MenuItem x:Name="UpdateInstalledItem" Header="{DynamicResource Text.UnknownEngine}" IsEnabled="False"/>
                <MenuItem x:Name="UpdateStateItem" Header="{DynamicResource Text.NotChecked}" IsEnabled="False"/>
                <Separator/>
                <MenuItem x:Name="CheckUpdate" Header="{DynamicResource Text.CheckUpdate}"/>
                <MenuItem x:Name="RunUpdate" Header="{DynamicResource Text.RunUpdate}" IsEnabled="False"/>
                <MenuItem x:Name="OpenReleases" Header="{DynamicResource Text.Releases}"/>
              </MenuItem>
              <MenuItem x:Name="ShowClientHelp" Header="{DynamicResource Text.ClientHelp}"/>
              <MenuItem x:Name="OpenProjectPage" Header="{DynamicResource Text.ProjectPage}"/>
              <MenuItem x:Name="AboutItem" Header="{DynamicResource Text.About}"/>
              <Separator/>
              <MenuItem x:Name="LanguageEnglish" Header="English" IsCheckable="True"/>
              <MenuItem x:Name="LanguageChinese" Header="中文" IsCheckable="True"/>
              <Separator/>
              <MenuItem x:Name="ThemeLight" Header="{DynamicResource Text.Light}" IsCheckable="True"/>
              <MenuItem x:Name="ThemeDark" Header="{DynamicResource Text.Dark}" IsCheckable="True"/>
              <MenuItem x:Name="ThemeAuto" Header="{DynamicResource Text.Auto}" IsCheckable="True"/>
              <Separator/>
              <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                  <Button x:Name="SaveBoth" Content="{DynamicResource Text.SaveBoth}"/>
                </MenuItem.Header>
              </MenuItem>
            </MenuItem>
          </Menu>
          <Button x:Name="Minimize" Content="" Style="{StaticResource Glass.CaptionButton}" ToolTip="{DynamicResource Text.Minimize}"/>
          <Button x:Name="Maximize" Content="" Style="{StaticResource Glass.CaptionButton}" ToolTip="{DynamicResource Text.Maximize}"/>
          <Button x:Name="Close" Content="" Style="{StaticResource Glass.CaptionButton}" ToolTip="{DynamicResource Text.Close}"/>
        </StackPanel>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="24,12,24,24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="340"/>
          </Grid.ColumnDefinitions>
          <Grid x:Name="Panes">
            <Grid.RowDefinitions>
              <RowDefinition Height="126"/>
              <RowDefinition Height="102"/>
              <RowDefinition Height="18"/>
              <RowDefinition Height="176"/>
              <RowDefinition Height="18"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="6,7,0,0">
              <TextBlock x:Name="PageStep" Text="{DynamicResource Text.Eyebrow}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" Foreground="{DynamicResource Ui.Accent}"/>
              <TextBlock x:Name="PageTitle" FontSize="30" FontWeight="Bold" Margin="0,4,0,4"/>
              <TextBlock x:Name="PageSubtitle" FontSize="14" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" LineHeight="19" MaxWidth="630" HorizontalAlignment="Left"/>
            </StackPanel>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <RadioButton x:Name="RemoteNav" GroupName="Modes" IsChecked="True" Style="{StaticResource ModeCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Text.RemoteMode}" FontSize="15" FontWeight="Bold"/>
                  <Border HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Glass.Chip}">
                        <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Ui.Accent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="HTTP" FontSize="10" FontWeight="Bold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{DynamicResource Text.RemoteNote}" FontSize="12" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                </Grid>
              </RadioButton>
              <RadioButton x:Name="LocalNav" Grid.Column="2" GroupName="Modes" Style="{StaticResource ModeCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Text.LocalMode}" FontSize="15" FontWeight="Bold"/>
                  <Border HorizontalAlignment="Right">
                    <Border.Style>
                      <Style TargetType="Border" BasedOn="{StaticResource Glass.Chip}">
                        <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Ui.Accent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <TextBlock Text="STDIO" FontSize="10">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked,RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Border>
                  <TextBlock Grid.Row="1" Text="{DynamicResource Text.LocalNote}" FontSize="12" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                </Grid>
              </RadioButton>
            </Grid>
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <Border CornerRadius="16" Background="{DynamicResource Ui.CardShadowFill}" Effect="{DynamicResource Glass.CardShadow}" IsHitTestVisible="False" Margin="0,8,0,-8"/>
                <Border Style="{StaticResource Glass.Card}" Padding="20,18">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="26"/>
                      <RowDefinition Height="62"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource Text.Installation}" Style="{StaticResource Glass.Heading}"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource Text.Version}" Style="{StaticResource Glass.Muted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="Version" DisplayMemberPath="DisplayName" SelectedValuePath="Key" Height="36"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Text.InstallPath}" Style="{StaticResource Glass.Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="TiaPath" Height="36" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="BrowseTia" Content="{DynamicResource Text.Browse}" Height="32"/>
                        <Button x:Name="DetectTia" Content="{DynamicResource Text.Detect}" Height="32" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock x:Name="DetectionSource" Text="{DynamicResource Text.NotDetected}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
              <Grid Grid.Column="2">
                <Border CornerRadius="16" Background="{DynamicResource Ui.CardShadowFill}" Effect="{DynamicResource Glass.CardShadow}" IsHitTestVisible="False" Margin="0,8,0,-8"/>
                <Border x:Name="ServerPane" Style="{StaticResource Glass.Card}" Padding="20,18">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="26"/>
                      <RowDefinition Height="62"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ServerCardTitle" Style="{StaticResource Glass.Heading}"/>
                    <TextBlock x:Name="ServerCardNote" Style="{StaticResource Glass.Mono}" HorizontalAlignment="Right" FontSize="10"/>
                    <Grid x:Name="AddressRow" Grid.Row="1" Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{DynamicResource Text.Ip}" Style="{StaticResource Glass.Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ServerAddress" Tag="192.0.2.10" Height="36" FontFamily="{DynamicResource Ui.FontMono}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="{DynamicResource Text.Port}" Style="{StaticResource Glass.Muted}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ServerPort" Text="8765" Height="36" FontFamily="{DynamicResource Ui.FontMono}"/>
                      </StackPanel>
                    </Grid>
                    <Grid x:Name="ServerActions" Grid.Row="2" Margin="0,12,0,0">
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="Network" Content="{DynamicResource Text.Network}" Height="32"/>
                        <Button x:Name="StartServer" Content="{DynamicResource Text.Start}" Height="32" Margin="8,0,0,0">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Glass.Primary}">
                              <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                        <Button x:Name="StopServer" Content="{DynamicResource Text.Stop}" Height="32" IsEnabled="False" Margin="8,0,0,0">
                          <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Glass.Button}">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </Trigger>
                              </Style.Triggers>
                            </Style>
                          </Button.Style>
                        </Button>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Ui.StatusIdle}" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding Text,ElementName=LinkState}" Style="{StaticResource Glass.Muted}"/>
                        <TextBlock x:Name="Status" Text="{DynamicResource Text.Idle}" Visibility="Collapsed"/>
                      </StackPanel>
                    </Grid>
                    <Border x:Name="LocalNote" Grid.Row="1" Visibility="Collapsed">
                      <TextBlock Text="{DynamicResource Text.LocalEngineNote}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock x:Name="LocalActionsNote" Grid.Row="2" Visibility="Collapsed" Text="{DynamicResource Text.LocalActionsNote}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
            <Grid Grid.Row="5">
              <Border CornerRadius="16" Background="{DynamicResource Ui.CardShadowFill}" Effect="{DynamicResource Glass.CardShadow}" IsHitTestVisible="False" Margin="0,8,0,-8"/>
              <Border x:Name="ClientPane" Style="{StaticResource Glass.Card}" Padding="20,18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="38"/>
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource Text.AiClients}" FontWeight="Bold"/>
                    <TextBlock x:Name="ClientSelection" Style="{StaticResource Glass.Muted}" FontSize="12" Cursor="Hand"/>
                  </StackPanel>
                  <TextBlock Text="{DynamicResource Text.ClientNote}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right"/>
                  <ListBox x:Name="ClientChoices" Grid.Row="1" Style="{StaticResource Glass.List}" ItemContainerStyle="{StaticResource ClientChoice}" ItemTemplate="{StaticResource ClientTile}" SelectionMode="Multiple" MaxHeight="250" VerticalAlignment="Top" Margin="-2,0,-8,8">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{DynamicResource ClientColumns}"/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                  </ListBox>
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SecretBand" Margin="0,0,10,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="Key" PasswordChar="·" FontSize="16"/>
                        <TextBox x:Name="KeyVisible" Visibility="Collapsed" Height="38" FontFamily="{DynamicResource Ui.FontMono}"/>
                        <TextBlock x:Name="KeyPlaceholder" Text="{DynamicResource Text.Secret}" Foreground="{DynamicResource Ui.PlaceholderLabel}" Margin="12,0" IsHitTestVisible="False"/>
                        <Button x:Name="GenerateKey" Grid.Column="1" Content="{DynamicResource Text.Generate}" Width="81" Height="38" Margin="10,0,0,0"/>
                        <CheckBox x:Name="ShowKey" Grid.Column="2" Content="{DynamicResource Text.Show}" Style="{StaticResource Glass.Button}" Width="60" Height="38" Margin="10,0,0,0"/>
                      </Grid>
                    </Border>
                    <Button x:Name="TestClient" Grid.Column="1" Content="{DynamicResource Text.Test}" Style="{StaticResource Glass.Outline}" Width="140" Height="38" Margin="0,0,10,0"/>
                    <Button x:Name="SaveClient" Grid.Column="2" Content="{DynamicResource Text.Write}" Width="152" FontSize="13" Height="38" Background="{DynamicResource Ui.StrongFill}" Foreground="{DynamicResource Ui.StrongText}"/>
                  </Grid>
                  <TextBlock x:Name="ClientInstructions" Visibility="Collapsed"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="253"/>
              <RowDefinition Height="14"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Ui.SummaryBackground}" CornerRadius="16" Padding="22" TextElement.Foreground="{DynamicResource Ui.SummaryText}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="30"/>
                  <RowDefinition Height="28"/>
                  <RowDefinition Height="28"/>
                  <RowDefinition Height="28"/>
                  <RowDefinition Height="28"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource Text.Summary}" FontWeight="Bold" FontSize="13"/>
                <Border Background="#268A98A6" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="9,4">
                  <TextBlock x:Name="LinkState" Text="{DynamicResource Text.Idle}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10"/>
                </Border>
                <TextBlock x:Name="LinkLeftLabel" Grid.Row="1" Text="{DynamicResource Text.Clients}" Foreground="{DynamicResource Ui.SummaryMuted}"/>
                <TextBlock x:Name="LinkClient" Grid.Row="1" HorizontalAlignment="Right" FontWeight="Bold"/>
                <TextBlock x:Name="LinkRightLabel" Grid.Row="2" Text="{DynamicResource Text.Service}" Foreground="{DynamicResource Ui.SummaryMuted}"/>
                <TextBlock x:Name="LinkServer" Grid.Row="2" HorizontalAlignment="Right" FontWeight="Bold"/>
                <TextBlock Grid.Row="3" Text="{DynamicResource Text.Address}" Foreground="{DynamicResource Ui.SummaryMuted}"/>
                <TextBlock x:Name="LinkEndpoint" Grid.Row="3" HorizontalAlignment="Right" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11"/>
                <TextBlock Grid.Row="4" Text="{DynamicResource Text.Transport}" Foreground="{DynamicResource Ui.SummaryMuted}"/>
                <TextBlock x:Name="Transport" Grid.Row="4" HorizontalAlignment="Right" FontWeight="Bold"/>
                <Border Grid.Row="5" Background="#263DBBDC" BorderBrush="#553DBBDC" BorderThickness="1" CornerRadius="10" Padding="13,9" Margin="0,10,0,0">
                  <TextBlock x:Name="LastTest" Text="{DynamicResource Text.InitialTest}" FontSize="11" TextWrapping="Wrap" LineHeight="17"/>
                </Border>
              </Grid>
            </Border>
            <Grid Grid.Row="2">
              <Border CornerRadius="16" Background="{DynamicResource Ui.CardShadowFill}" Effect="{DynamicResource Glass.CardShadow}" IsHitTestVisible="False" Margin="0,8,0,-8"/>
              <Border Style="{StaticResource Glass.Card}" Padding="22,18">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="{DynamicResource Text.Log}" Style="{StaticResource Glass.Heading}"/>
                  <TextBlock x:Name="LogCount" Text="{DynamicResource Text.EmptyLog}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right"/>
                  <TextBox x:Name="Log" Grid.Row="1" Height="Auto" MinHeight="0" Background="Transparent" BorderThickness="0" Padding="0,3" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" TextBlock.LineHeight="24" TextBlock.LineStackingStrategy="BlockLineHeight" IsReadOnly="True" VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
                  <glass:GlassLogView Grid.Row="1" LogText="{Binding Text,ElementName=Log}" Foreground="{DynamicResource Ui.Label}"/>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
