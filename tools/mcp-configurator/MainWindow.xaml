<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TIA · MCP — Connect"
 Width="1236" Height="1101" MinWidth="1000" MinHeight="720" WindowStartupLocation="CenterScreen"
 Background="#FAFAFC" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#111820"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#7C8997"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="23"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#344C68"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#DFE5EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
    <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#A0ABB8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#287BCD"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,10"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Field" CornerRadius="10" Background="White" BorderBrush="#D7DFE9" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#287BCD"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#D7DFE9" BorderThickness="1" CornerRadius="10"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#344C68"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="16,0,32,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#D7DFE9" BorderThickness="1" CornerRadius="10" MinWidth="180" Padding="6"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="17,10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D7DFE9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#14263D"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#A4B2C2"/><Setter Property="Effect" Value="{x:Null}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#287BCD"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2678CA"/><Setter Property="BorderBrush" Value="#2678CA"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#236DCD" BlurRadius="12" ShadowDepth="4" Opacity="0.22"/></Setter.Value></Setter></Style>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#DDE6EF"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" CornerRadius="12" Padding="13,15" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#1C2730"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#2678CA"/><Setter Property="Foreground" Value="White"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClientChoice" TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,10,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Choice" Background="White" CornerRadius="12" Padding="13,11" MinHeight="61" BorderThickness="1" BorderBrush="#D7DFE9"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#F5F8FC"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#EAF3FF"/><Setter TargetName="Choice" Property="BorderBrush" Value="#2479E7"/><Setter Property="Foreground" Value="#005BAF"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ClientTile"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}"/><TextBlock Text="{Binding Category}" FontFamily="Consolas" FontSize="10" Foreground="#8696A9" Margin="0,5,0,0"/></StackPanel></DataTemplate>
 </Window.Resources>
 <Grid Background="#FAFAFC">
  <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101518"><Grid Margin="20,27,20,24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="26" Height="26" CornerRadius="8" Background="#2678CA" VerticalAlignment="Top" HorizontalAlignment="Left"><TextBlock Text="T" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1"><TextBlock Text="TIA · MCP" Foreground="#F3F7FA" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,0"/><TextBlock Text="CONNECT" Foreground="#879BAB" FontSize="11" FontFamily="Consolas" Margin="0,9,0,0"/></StackPanel>
   </Grid>
   <StackPanel Grid.Row="1"><TextBlock Text="连接方式" Foreground="#748794" FontSize="11" Margin="5,0,0,14"/>
    <RadioButton x:Name="ServerNav" GroupName="Pages" Style="{StaticResource Nav}" IsChecked="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="01" FontFamily="Consolas" FontSize="11" Opacity="0.65" Margin="0,1,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="虚拟机服务端" FontWeight="SemiBold"/><TextBlock Text="在安装 TIA 的电脑上" FontSize="11" Margin="0,5,0,0" Opacity="0.65"/></StackPanel></Grid></RadioButton>
    <RadioButton x:Name="ClientNav" GroupName="Pages" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="02" FontFamily="Consolas" FontSize="11" Opacity="0.65" Margin="0,1,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="AI 客户端" FontWeight="SemiBold"/><TextBlock Text="在当前宿主机上" FontSize="11" Margin="0,5,0,0" Opacity="0.65"/></StackPanel></Grid></RadioButton>
    <RadioButton x:Name="LocalNav" GroupName="Pages" Style="{StaticResource Nav}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="03" FontFamily="Consolas" FontSize="11" Opacity="0.65" Margin="0,1,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="本机连接" FontWeight="SemiBold"/><TextBlock Text="TIA 与 AI 客户端同机" FontSize="11" Margin="0,5,0,0" Opacity="0.65"/></StackPanel></Grid></RadioButton>
   </StackPanel>
   <Border Grid.Row="3" BorderBrush="#273037" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel>
    <StackPanel Orientation="Horizontal"><Ellipse x:Name="ServiceDot" Width="7" Height="7" Fill="#A7B4BD" Margin="0,0,7,0"/><TextBlock x:Name="ServiceState" Text="服务未启动" Foreground="#DDE6EF" FontSize="12" FontWeight="SemiBold"/></StackPanel>
    <TextBlock Text="两端各配置一次，之后直接启动服务。" Foreground="#718896" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/><TextBlock Text="V20 / V21" Foreground="#607583" FontFamily="Consolas" FontSize="11" Margin="0,9,0,0"/>
   </StackPanel></Border>
  </Grid></Border>
  <ScrollViewer x:Name="ContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="36,32,36,30">
   <StackPanel>
    <StackPanel Margin="0,0,0,23"><TextBlock x:Name="PageStep" Text="STEP 01 · VIRTUAL MACHINE" FontFamily="Consolas" FontSize="11" Foreground="#2678CA"/><TextBlock x:Name="PageTitle" Text="让虚拟机中的 TIA 就绪" FontSize="26" FontWeight="Bold" Margin="0,9,0,0"/><TextBlock x:Name="PageSubtitle" Text="配置 HTTP 服务，供宿主机上的 AI 客户端连接。" Style="{StaticResource Muted}" Foreground="#62768C" Margin="0,6,0,0"/></StackPanel>
    <Border Background="#F0F2F4" CornerRadius="15" BorderBrush="#E0E6EC" BorderThickness="1" Padding="20,15" Margin="0,0,0,22">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="ConnectionLeftLabel" Text="宿主机" Foreground="#8B98A5" FontSize="11"/><TextBlock Text="Claude / Codex / IDE" FontWeight="Medium" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="92"><TextBlock x:Name="ConnectionProtocol" Text="HTTP" Foreground="#7C8B9E" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/><Border Height="1" Background="#AFC6DE" Margin="0,4,0,0"><Border Width="30" Height="1" Background="#2678CA" HorizontalAlignment="Right"/></Border></StackPanel>
      <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock x:Name="ConnectionRightLabel" Text="虚拟机" Foreground="#8B98A5" FontSize="11" HorizontalAlignment="Right"/><TextBlock Text="MCP 服务 + TIA Portal" FontWeight="Medium" Margin="0,4,0,0"/></StackPanel>
     </Grid>
    </Border>
    <Grid x:Name="Pages">
     <StackPanel x:Name="ServerPage"><Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="0,0,0,22"><TextBlock Text="在安装 TIA 的电脑上完成" DockPanel.Dock="Right" Foreground="#8795A6" FontSize="11" VerticalAlignment="Center"/><TextBlock Text="服务设置" FontSize="17" FontWeight="SemiBold"/></DockPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="TIA 版本" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="Version" SelectedIndex="0"><ComboBoxItem Content="V21"/><ComboBoxItem Content="V20"/></ComboBox></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="安装目录（不带 Bin）" Style="{StaticResource FieldLabel}"/><DockPanel><Button x:Name="BrowseTia" Content="浏览" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="DetectTia" Content="自动检测" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="按环境变量 TiaPortalLocation、注册表和默认安装目录探测"/><TextBox x:Name="TiaPath" FontFamily="Consolas"/></DockPanel></StackPanel>
      </Grid>
      <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="虚拟机 IPv4 地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerAddress" Tag="例如 192.0.2.10" FontFamily="Consolas"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ServerPort" Text="8765" FontFamily="Consolas"/></StackPanel>
      </Grid>
      <TextBlock Text="连接密钥" Style="{StaticResource FieldLabel}" Margin="0,22,0,8"/>
      <DockPanel><Button x:Name="GenerateKey" Content="生成密钥" DockPanel.Dock="Right" Margin="8,0,0,0"/><Grid><PasswordBox x:Name="ServerKey"/><TextBox x:Name="ServerKeyVisible" Visibility="Collapsed" FontFamily="Consolas"/><TextBlock x:Name="ServerKeyPlaceholder" Text="点击右侧生成，或输入已有密钥" Foreground="#A0ABB8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></DockPanel>
      <CheckBox x:Name="ShowServerKey" Content="显示密钥 · 宿主机需填写同一个值" Foreground="#73859B" FontSize="12" Margin="4,19,0,23"/>
      <Border Height="1" Background="#EAEFF4" Margin="0,0,0,18"/>
      <Grid><StackPanel Orientation="Horizontal"><Button x:Name="SaveServer" Content="保存配置" Margin="0,0,10,0"/><Button x:Name="Network" Content="配置网络权限"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StartServer" Content="启动服务" MinWidth="98" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="StopServer" Content="停止" IsEnabled="False"/></StackPanel></Grid>
     </StackPanel></Border></StackPanel>
     <StackPanel x:Name="ClientPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel>
      <DockPanel Margin="0,0,0,20"><TextBlock x:Name="ClientSelection" Text="已选 Claude Code" DockPanel.Dock="Right" Foreground="#8795A6" FontSize="11" VerticalAlignment="Center" Cursor="Hand"/><TextBlock Text="选择 AI 客户端" FontSize="17" FontWeight="SemiBold"/></DockPanel>
      <ListBox x:Name="ClientChoices" SelectionMode="Multiple" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ClientChoice}" ItemTemplate="{StaticResource ClientTile}" Margin="0,0,-10,10" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource ClientColumns}"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="虚拟机 IPv4 地址" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClientAddress" Tag="例如 192.0.2.10" FontFamily="Consolas"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="服务端端口" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClientPort" Text="8765" FontFamily="Consolas"/></StackPanel>
      </Grid>
      <TextBlock Text="与服务端相同的密钥" Style="{StaticResource FieldLabel}" Margin="0,22,0,8"/>
      <Grid><PasswordBox x:Name="ClientKey"/><TextBox x:Name="ClientKeyVisible" Visibility="Collapsed" FontFamily="Consolas"/><TextBlock x:Name="ClientKeyPlaceholder" Text="粘贴服务端生成的密钥" Foreground="#A0ABB8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
      <CheckBox x:Name="ShowClientKey" Content="显示密钥" Foreground="#73859B" FontSize="12" Margin="4,19,0,23"/>
      <Border Height="1" Background="#EAEFF4" Margin="0,0,0,18"/>
      <Grid><Button x:Name="TestClient" Content="测试连接" HorizontalAlignment="Left"/><Button x:Name="SaveClient" Content="配置所选客户端" MinWidth="138" Style="{StaticResource Primary}" HorizontalAlignment="Right"/></Grid>
     </StackPanel></Border>
      <TextBlock x:Name="ClientInstructions" Visibility="Collapsed"/>
     </StackPanel>
     <StackPanel x:Name="LocalPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel>
      <TextBlock Text="本机连接" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,17"/>
      <TextBlock Text="TIA Portal 与 AI 客户端在同一台电脑时，无需填写 IP：客户端通过 stdio 自动启动 MCP，配置一次即可使用。" Style="{StaticResource Muted}" Foreground="#657C94" Margin="0,0,0,18"/>
      <UniformGrid Columns="3" Margin="0,0,-12,16">
       <Border Background="#F5F7F9" CornerRadius="12" BorderBrush="#E5EBF1" BorderThickness="1" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="连接方式" Foreground="#8997A7" FontSize="11"/><TextBlock Text="stdio · 自动启动" FontFamily="Consolas" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Background="#F5F7F9" CornerRadius="12" BorderBrush="#E5EBF1" BorderThickness="1" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="TIA 版本" Foreground="#8997A7" FontSize="11"/><TextBlock x:Name="LocalVersion" Text="V21" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border>
       <Border Background="#F5F7F9" CornerRadius="12" BorderBrush="#E5EBF1" BorderThickness="1" Padding="16" Margin="0,0,12,0"><StackPanel><TextBlock Text="客户端" Foreground="#8997A7" FontSize="11"/><TextBlock x:Name="LocalSelection" Text="Claude Code" TextTrimming="CharacterEllipsis" FontSize="14" Margin="0,7,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Expander Header="选择客户端（可多选）" Foreground="#73859B" FontSize="12" Margin="0,0,0,16"><ListBox x:Name="LocalChoices" SelectionMode="Multiple" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ClientChoice}" ItemTemplate="{StaticResource ClientTile}" Margin="0,12,-10,0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource ClientColumns}"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></Expander>
      <Border Height="1" Background="#EAEFF4" Margin="0,0,0,18"/>
      <StackPanel Orientation="Horizontal"><Button x:Name="SaveLocal" Content="一键配置本机" MinWidth="125" Style="{StaticResource Primary}" Margin="0,0,10,0"/><Button x:Name="GoServer" Content="选择 TIA 路径"/></StackPanel>
     </StackPanel></Border></StackPanel>
    </Grid>
    <Border Style="{StaticResource Card}" Padding="0" Margin="0,22,0,0"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border BorderBrush="#EAEFF4" BorderThickness="0,0,0,1" Padding="20,15"><DockPanel>
      <Border DockPanel.Dock="Right" Background="#F0F3F5" CornerRadius="15" Padding="11,5"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#AFBAC4" Margin="0,0,6,0"/><TextBlock x:Name="Status" Text="等待配置" Foreground="#748599" FontSize="11"/></StackPanel></Border>
      <TextBlock Text="运行状态" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
     </DockPanel></Border>
     <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="11" MinHeight="52" MaxHeight="200" Padding="20,16" Background="Transparent" BorderThickness="0" Foreground="#526D8A"/>
    </Grid></Border>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
