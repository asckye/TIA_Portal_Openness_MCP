<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TIA Portal · MCP Bridge"
 Width="1320" Height="1120" MinWidth="1080" MinHeight="740" WindowStartupLocation="CenterScreen"
 Background="#E9E7E1" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#171A18"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#9A9C93"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#7D8279"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="24"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="#E4E2DA"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="13,10"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFDDD4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="SelectionBrush" Value="#2F5B4C"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid>
    <Border x:Name="Field" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="#A9ABA1" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
   </Grid><ControlTemplate.Triggers>
    <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#2F5B4C"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Field" Property="Background" Value="#F4F2EC"/><Setter Property="Foreground" Value="#8E9189"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="13,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Field" CornerRadius="11" Background="White" BorderBrush="#DFDDD4" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#2F5B4C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="White" BorderBrush="#DFDDD4" BorderThickness="1" CornerRadius="11"><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#5D6259"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="16,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="White" BorderBrush="#DFDDD4" BorderThickness="1" CornerRadius="11" MinWidth="150" Padding="6"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="15,10"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDDBD2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#1F2320"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#AFB2A9"/><Setter TargetName="Surface" Property="Background" Value="#F5F3ED"/><Setter TargetName="Surface" Property="BorderBrush" Value="#E7E5DD"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#2F5B4C"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#2F5B4C"/><Setter Property="BorderBrush" Value="#2F5B4C"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#2F5B4C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="26"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Segment" TargetType="RadioButton"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#7D8279"/><Setter Property="FontSize" Value="12.5"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Pill" CornerRadius="9" Padding="15,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="White"/><Setter TargetName="Pill" Property="BorderBrush" Value="#DEDCD4"/><Setter Property="Foreground" Value="#171A18"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Toggle" TargetType="CheckBox"><Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#6E7369"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
    <Border x:Name="Track" Width="36" Height="20" CornerRadius="10" Background="#DBD9D1" VerticalAlignment="Center"><Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/></Border>
    <ContentPresenter Margin="11,0,0,0" VerticalAlignment="Center"/>
   </StackPanel><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#2F5B4C"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ClientChoice" TargetType="ListBoxItem"><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Choice" Background="White" CornerRadius="12" Padding="13,10" MinHeight="56" BorderThickness="1" BorderBrush="#E2E0D8"><ContentPresenter/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#F6F4EF"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#E9F1EC"/><Setter TargetName="Choice" Property="BorderBrush" Value="#2F5B4C"/><Setter Property="Foreground" Value="#255043"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ClientTile"><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Hint}"/><TextBlock Text="{Binding Category}" FontFamily="Consolas" FontSize="10" Foreground="#9A9C93" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate>
 </Window.Resources>

 <Border Background="White" CornerRadius="20" BorderBrush="#DFDDD5" BorderThickness="1" Margin="18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

   <Border BorderBrush="#EDEBE4" BorderThickness="0,0,0,1" Padding="30,20"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="34" Height="34" CornerRadius="11" Background="#2F5B4C" VerticalAlignment="Center"><TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
     <TextBlock Text="TIA Portal · MCP Bridge" FontSize="15" FontWeight="SemiBold"/>
     <TextBlock Text="ENGINEERING LINK CONSOLE" Style="{StaticResource Mono}" FontSize="10" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Background="#F2F0EA" CornerRadius="12" BorderBrush="#E3E1D9" BorderThickness="1" Padding="4"><StackPanel Orientation="Horizontal">
      <RadioButton x:Name="RemoteNav" GroupName="Modes" Style="{StaticResource Segment}" Content="虚拟机 ↔ 宿主机" IsChecked="True"/>
      <RadioButton x:Name="LocalNav" GroupName="Modes" Style="{StaticResource Segment}" Content="同一台电脑"/>
     </StackPanel></Border>
     <Border Background="#F2F0EA" CornerRadius="14" BorderBrush="#E3E1D9" BorderThickness="1" Padding="12,6" Margin="12,0,0,0"><StackPanel Orientation="Horizontal">
      <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#B4B7AE" Margin="0,0,7,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Status" Text="等待配置" Foreground="#6E7369" FontSize="11.5"/>
     </StackPanel></Border>
    </StackPanel>
   </Grid></Border>

   <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="30,26,30,26">
    <StackPanel>
     <StackPanel Margin="0,0,0,18" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock x:Name="PageStep" Text="TWO SIDES · ONE PASS" Style="{StaticResource Mono}"/>
      <TextBlock x:Name="PageTitle" Text="在一页里连接 TIA 与 AI" FontSize="30" FontWeight="Bold" Margin="0,10,0,0"/>
      <TextBlock x:Name="PageSubtitle" Text="A 侧在装有 TIA 的虚拟机上启动服务，B 侧在宿主机上选择客户端，两侧共用同一把密钥。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
     </StackPanel>

     <Border Background="#F6F4EF" CornerRadius="16" BorderBrush="#E7E5DD" BorderThickness="1" Padding="24,15" Margin="0,0,0,18"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock x:Name="LinkLeftLabel" Text="HOST · 客户端侧" Style="{StaticResource Mono}"/>
       <TextBlock x:Name="LinkClient" Text="Claude Code" FontWeight="SemiBold" FontSize="14" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock x:Name="LinkEndpoint" Text="等待填写地址" Style="{StaticResource Mono}" HorizontalAlignment="Center" Foreground="#8A8D84"/>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Line X2="1" Stretch="Fill" Height="1" Stroke="#CBC8C0" StrokeThickness="1" StrokeDashArray="1 3" VerticalAlignment="Center"/>
        <Ellipse Grid.Column="1" Width="6" Height="6" Fill="#B4B7AE" VerticalAlignment="Center"/>
       </Grid>
       <TextBlock x:Name="LinkState" Text="idle" Style="{StaticResource Mono}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
       <TextBlock x:Name="LinkRightLabel" Text="VIRTUAL MACHINE · 服务侧" Style="{StaticResource Mono}" HorizontalAlignment="Right"/>
       <TextBlock x:Name="LinkServer" Text="MCP 服务 · TIA Portal V21" FontWeight="SemiBold" FontSize="14" Margin="0,7,0,0" HorizontalAlignment="Right"/>
      </StackPanel>
     </Grid></Border>

     <Grid x:Name="Panes">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel>
       <Grid Margin="0,0,0,22">
        <StackPanel Orientation="Horizontal">
         <Border Width="24" Height="24" CornerRadius="8" Background="#E7F0EB" BorderBrush="#D3E1D9" BorderThickness="1"><TextBlock Text="A" Foreground="#2F5B4C" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock x:Name="ServerCardTitle" Text="虚拟机服务端" FontSize="16" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="ServerCardNote" Text="装有 TIA 的机器" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
       </Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="VERSION" Style="{StaticResource Mono}" Margin="0,0,0,9"/><ComboBox x:Name="Version" SelectedIndex="0"><ComboBoxItem Content="V21"/><ComboBoxItem Content="V20"/></ComboBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="INSTALL PATH · 不带 BIN" Style="{StaticResource Mono}" Margin="0,0,0,9"/><DockPanel><Button x:Name="BrowseTia" Content="浏览" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="DetectTia" Content="自动检测" DockPanel.Dock="Right" Margin="8,0,0,0" ToolTip="按环境变量 TiaPortalLocation、注册表和默认安装目录探测"/><TextBox x:Name="TiaPath" FontFamily="Consolas" FontSize="12"/></DockPanel></StackPanel>
       </Grid>
       <Grid x:Name="AddressRow" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="AddressLabel" Text="VM IPV4" Style="{StaticResource Mono}" Margin="0,0,0,9"/><TextBox x:Name="ServerAddress" Tag="例如 192.0.2.10" FontFamily="Consolas" FontSize="12"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="PORT" Style="{StaticResource Mono}" Margin="0,0,0,9"/><TextBox x:Name="ServerPort" Text="8765" FontFamily="Consolas" FontSize="12"/></StackPanel>
       </Grid>
       <Border x:Name="LocalNote" Visibility="Collapsed" Background="#F6F4EF" CornerRadius="12" BorderBrush="#E7E5DD" BorderThickness="1" Padding="16,14" Margin="0,20,0,0"><StackPanel>
        <TextBlock Text="TRANSPORT · 固定" Style="{StaticResource Mono}"/>
        <TextBlock Text="stdio · 客户端按需自动启动引擎" FontSize="13.5" Margin="0,8,0,0"/>
        <TextBlock Text="同机连接不经 HTTP，无需 IP、端口、密钥和防火墙规则。" Style="{StaticResource Muted}" FontSize="12" LineHeight="21" Margin="0,7,0,0"/>
       </StackPanel></Border>
       <Border Height="1" Background="#EEECE5" Margin="0,18,0,16"/>
       <Grid x:Name="ServerActions">
        <Button x:Name="Network" Content="网络权限" HorizontalAlignment="Left"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="StopServer" Content="停止" IsEnabled="False" Margin="0,0,10,0"/><Button x:Name="StartServer" Content="启动服务" MinWidth="104" Style="{StaticResource Primary}"/></StackPanel>
       </Grid>
       <TextBlock x:Name="LocalActionsNote" Visibility="Collapsed" Style="{StaticResource Muted}" FontSize="12" LineHeight="21" Text="选好版本与安装目录后，在右侧写入客户端配置即可；本机模式不需要启动服务。"/>
      </StackPanel></Border>

      <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel>
       <Grid Margin="0,0,0,20">
        <StackPanel Orientation="Horizontal">
         <Border Width="24" Height="24" CornerRadius="8" Background="#E7F0EB" BorderBrush="#D3E1D9" BorderThickness="1"><TextBlock Text="B" Foreground="#2F5B4C" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <TextBlock Text="AI 客户端" FontSize="16" FontWeight="SemiBold" Margin="11,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="ClientSelection" Text="已选 Claude Code" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
       </Grid>
       <ListBox x:Name="ClientChoices" SelectionMode="Multiple" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ClientChoice}" ItemTemplate="{StaticResource ClientTile}" Margin="0,0,-10,0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource ClientColumns}"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
       <Border Height="1" Background="#EEECE5" Margin="0,10,0,16"/>
       <Grid>
        <Button x:Name="TestClient" Content="测试连接" HorizontalAlignment="Left"/>
        <Button x:Name="SaveClient" Content="写入客户端配置" MinWidth="148" Style="{StaticResource Primary}" HorizontalAlignment="Right"/>
       </Grid>
      </StackPanel></Border>
     </Grid>
     <TextBlock x:Name="ClientInstructions" Visibility="Collapsed"/>

     <Border x:Name="SecretBand" Background="#EFF4F1" CornerRadius="16" BorderBrush="#DCE6E0" BorderThickness="1" Padding="22,16" Margin="0,16,0,0"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="318"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="SHARED SECRET" Style="{StaticResource Mono}" Foreground="#7E9189"/>
       <TextBlock Text="A / B 共用一把密钥" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"/>
       <TextBlock Text="在服务端生成后自动填入客户端配置，两侧数值必须一致。" Style="{StaticResource Muted}" FontSize="12" LineHeight="21" Margin="0,7,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center">
       <DockPanel>
        <Button x:Name="GenerateKey" Content="生成密钥" DockPanel.Dock="Right" Margin="10,0,0,0" MinWidth="104"/>
        <Grid><PasswordBox x:Name="Key"/><TextBox x:Name="KeyVisible" Visibility="Collapsed" FontFamily="Consolas" FontSize="12"/><TextBlock x:Name="KeyPlaceholder" Text="点击右侧生成，或粘贴已有密钥" Foreground="#A9ABA1" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
       </DockPanel>
       <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
        <CheckBox x:Name="ShowKey" Style="{StaticResource Toggle}" Content="显示密钥"/>
        <Button x:Name="SaveBoth" Content="保存两端配置" Style="{StaticResource Quiet}" Margin="22,0,0,0" VerticalAlignment="Center"/>
       </StackPanel>
      </StackPanel>
     </Grid></Border>

     <Border Style="{StaticResource Card}" Padding="0" Margin="0,16,0,0"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border BorderBrush="#EEECE5" BorderThickness="0,0,0,1" Padding="24,13"><Grid>
       <TextBlock Text="ACTIVITY LOG" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
       <TextBlock x:Name="LogCount" Text="0 entries" Style="{StaticResource Mono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid></Border>
      <TextBox x:Name="Log" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontSize="11.5" MinHeight="52" MaxHeight="210" Padding="24,13" Background="Transparent" BorderThickness="0" Foreground="#5A6058"/>
     </Grid></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Border>
</Window>
