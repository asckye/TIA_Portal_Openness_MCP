<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><Nullable>annotations</Nullable></PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/TiaOpenness.Client/TiaOpenness.Client.csproj" /></ItemGroup>
  <ItemGroup><PackageReference Include="Newtonsoft.Json" Version="13.0.3" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="BridgeJsonGolden.json" /></ItemGroup>
  <ItemGroup><Compile Include="../../../tiaportal-mcp/tests/TiaMcpServer.Tests/BundleLayoutTests.cs" Link="BundleLayoutTests.cs" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../src/TiaOpenness.Bridge/TiaOpenness.Bridge.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" /></ItemGroup>
  <Target Name="CopyBridgeForFunctionalTests" AfterTargets="Build">
    <ItemGroup><BridgePayload Include="../../src/TiaOpenness.Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.exe;../../src/TiaOpenness.Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.dll;../../src/TiaOpenness.Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.config" /></ItemGroup>
    <Copy SourceFiles="@(BridgePayload)" DestinationFolder="$(TargetDir)bridge" SkipUnchangedFiles="true" />
    <Delete Files="$(TargetDir)bridge/Newtonsoft.Json.dll" Condition="!Exists('../../src/TiaOpenness.Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/Newtonsoft.Json.dll')" />
  </Target>
</Project>
