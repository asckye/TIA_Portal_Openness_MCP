<!--
  The only two glyphs the theme draws.

  Buttons in this design are text, not icon-plus-text: with a dozen short Chinese labels an icon
  beside each one adds noise without adding meaning, and a mixed set of hand-drawn glyphs is worse
  than none. What is left is the two marks that are not labels at all - the tick inside a checkbox
  and the chevron on a pop-up button.

  Both are stroked on a 16x16 grid; keep any addition on the same grid and the same construction.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <PathGeometry x:Key="Icon.Check" Figures="M3,8.4 L6.4,11.8 L13,4.6" />

  <PathGeometry x:Key="Icon.ChevronDown" Figures="M3.4,6.2 L8,10.4 L12.6,6.2" />

</ResourceDictionary>
