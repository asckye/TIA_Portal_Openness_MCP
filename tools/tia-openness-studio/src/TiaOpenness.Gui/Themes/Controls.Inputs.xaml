<!--
  Text fields, checkboxes, switches and the pop-up button.

  Fields come in three finishes and the view uses each for one thing: outlined for a field the
  user is expected to type into, filled grey for a filter that narrows what is already there, and
  mono for anything that is a path. The focus ring is drawn outside the border so a focused field
  does not shift its neighbours.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">

  <!-- ===================== text field ===================== -->
  <Style x:Key="Ui.TextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="Background" Value="{DynamicResource Ui.FieldBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ui.FieldBorder}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Ui.Label}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Accent}" />
    <Setter Property="SelectionOpacity" Value="0.30" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Ring" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent"
                  Margin="-2" Padding="2">
            <Border x:Name="Field"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    SnapsToDevicePixels="True">
              <Grid>
                <TextBlock x:Name="Placeholder"
                           Text="{Binding Path=(ux:Ux.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{DynamicResource Ui.PlaceholderLabel}"
                           FontFamily="{TemplateBinding FontFamily}"
                           FontSize="{TemplateBinding FontSize}"
                           Margin="{TemplateBinding Padding}"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed" />
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="{TemplateBinding Padding}"
                              VerticalAlignment="Center"
                              Focusable="False"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden" />
              </Grid>
            </Border>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
              <Setter TargetName="Ring" Property="Opacity" Value="0.40" />
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Ui.ControlDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Ui.TertiaryLabel}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBox" BasedOn="{StaticResource Ui.TextBox}" />

  <!-- A path or other value: monospace. -->
  <Style x:Key="Ui.TextBox.Mono" TargetType="TextBox" BasedOn="{StaticResource Ui.TextBox}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Small}" />
  </Style>

  <!-- A filter: filled, borderless, visibly lighter than a field that expects input. -->
  <Style x:Key="Ui.TextBox.Filled" TargetType="TextBox" BasedOn="{StaticResource Ui.TextBox}">
    <Setter Property="Background" Value="{DynamicResource Ui.FieldFillBackground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <!-- The log pane: read-only mono text with no chrome of its own; the card supplies the frame. -->
  <Style x:Key="Ui.TextBox.Console" TargetType="TextBox" BasedOn="{StaticResource Ui.TextBox}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Small}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== checkbox ===================== -->
  <Style x:Key="Ui.CheckBox" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5"
                    Background="{DynamicResource Ui.FieldBackground}"
                    BorderBrush="{DynamicResource Ui.FieldBorder}"
                    BorderThickness="1.5"
                    VerticalAlignment="Center"
                    SnapsToDevicePixels="True">
              <Path x:Name="Tick"
                    Data="{DynamicResource Icon.Check}"
                    Stroke="{DynamicResource Ui.OnAccent}"
                    StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Stretch="Uniform" Margin="3" Opacity="0" />
            </Border>
            <ContentPresenter x:Name="Label" Margin="8,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ui.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox" BasedOn="{StaticResource Ui.CheckBox}" />

  <!-- ===================== switch ===================== -->
  <!-- A CheckBox drawn as a toggle. Used for the two session options in the header: they are
       modes that stay set, not items in a list, and a switch reads as "on/off" where a box
       reads as "included". -->
  <Style x:Key="Ui.Switch" TargetType="CheckBox" BasedOn="{StaticResource Ui.CheckBox}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11"
                    Background="{DynamicResource Ui.SwitchTrackOff}"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Ellipse x:Name="Knob" Width="18" Height="18"
                       Fill="{DynamicResource Ui.SwitchKnob}"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="2,0,0,0" />
            </Border>
            <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </StackPanel>

          <ControlTemplate.Triggers>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ui.Accent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== pop-up button (ComboBox) ===================== -->
  <Style x:Key="Ui.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"
                  Margin="4,1" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource Ui.ComboBoxItem}" />

  <Style x:Key="Ui.ComboBox" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Ui.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Chrome"
                          Background="{DynamicResource Ui.ControlBackground}"
                          BorderBrush="{DynamicResource Ui.ControlBorder}"
                          BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                    <Path Data="{DynamicResource Icon.ChevronDown}"
                          Stroke="{DynamicResource Ui.SecondaryLabel}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="None"
                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.ControlHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="Selection"
                              Margin="12,0,32,0"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

            <TextBlock x:Name="Empty"
                       Text="{Binding Path=(ux:Ux.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                       Foreground="{DynamicResource Ui.PlaceholderLabel}"
                       Margin="12,0,32,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Visibility="Collapsed" />

            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{DynamicResource Ui.CardBackground}"
                      BorderBrush="{DynamicResource Ui.Separator}"
                      BorderThickness="1" CornerRadius="10" Padding="0,4"
                      MinWidth="{Binding ActualWidth, ElementName=Toggle}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Direction="270" />
                </Border.Effect>
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="SelectionBoxItem" Value="{x:Null}">
              <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox" BasedOn="{StaticResource Ui.ComboBox}" />

</ResourceDictionary>
