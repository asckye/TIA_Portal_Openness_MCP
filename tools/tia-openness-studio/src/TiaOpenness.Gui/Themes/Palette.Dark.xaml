<!--
  Dark appearance. Same keys as Palette.Light.xaml, in the same order, so the pair can be read
  side by side; ThemeTests asserts neither file has grown a token the other lacks.

  The accent is lifted a step so it keeps contrast on the dark surfaces, and the text on it flips
  to dark - a white label on this amber would fail contrast.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- accent -->
  <SolidColorBrush x:Key="Ui.Accent" Color="#C9954A" />
  <SolidColorBrush x:Key="Ui.AccentHover" Color="#D6A45D" />
  <SolidColorBrush x:Key="Ui.AccentPressed" Color="#B07F2C" />
  <SolidColorBrush x:Key="Ui.OnAccent" Color="#1C1710" />
  <SolidColorBrush x:Key="Ui.AccentSoft" Color="#3A2F1C" />
  <SolidColorBrush x:Key="Ui.AccentSoftBorder" Color="#5C4829" />
  <SolidColorBrush x:Key="Ui.AccentText" Color="#E6BC74" />

  <!-- surfaces -->
  <SolidColorBrush x:Key="Ui.WindowBackground" Color="#1C1B19" />
  <SolidColorBrush x:Key="Ui.HeaderBackground" Color="#232220" />
  <SolidColorBrush x:Key="Ui.SidebarBackground" Color="#1F1E1C" />
  <SolidColorBrush x:Key="Ui.CardBackground" Color="#262523" />
  <SolidColorBrush x:Key="Ui.PanelBackground" Color="#2C2B28" />
  <SolidColorBrush x:Key="Ui.CodeBackground" Color="#262523" />
  <SolidColorBrush x:Key="Ui.RowAlternate" Color="#2B2A27" />

  <!-- text -->
  <SolidColorBrush x:Key="Ui.Label" Color="#F0EEE9" />
  <SolidColorBrush x:Key="Ui.SecondaryLabel" Color="#B5B2AA" />
  <SolidColorBrush x:Key="Ui.TertiaryLabel" Color="#85827A" />
  <SolidColorBrush x:Key="Ui.PlaceholderLabel" Color="#75726B" />

  <!-- lines -->
  <SolidColorBrush x:Key="Ui.Separator" Color="#393733" />
  <SolidColorBrush x:Key="Ui.HairLine" Color="#302E2A" />
  <SolidColorBrush x:Key="Ui.DashedBorder" Color="#4C4A44" />

  <!-- controls -->
  <SolidColorBrush x:Key="Ui.ControlBackground" Color="#2E2D2A" />
  <SolidColorBrush x:Key="Ui.ControlHover" Color="#37352F" />
  <SolidColorBrush x:Key="Ui.ControlPressed" Color="#403E38" />
  <SolidColorBrush x:Key="Ui.ControlBorder" Color="#46443E" />
  <SolidColorBrush x:Key="Ui.ControlDisabled" Color="#262523" />
  <SolidColorBrush x:Key="Ui.FieldBackground" Color="#201F1D" />
  <SolidColorBrush x:Key="Ui.FieldBorder" Color="#46443E" />
  <SolidColorBrush x:Key="Ui.FieldFillBackground" Color="#2C2B28" />

  <!-- segmented control / tabs / progress track -->
  <SolidColorBrush x:Key="Ui.SegmentTrack" Color="#33312D" />
  <SolidColorBrush x:Key="Ui.SegmentThumb" Color="#3B3934" />

  <!-- switches -->
  <SolidColorBrush x:Key="Ui.SwitchTrackOff" Color="#4A4842" />
  <SolidColorBrush x:Key="Ui.SwitchKnob" Color="#F0EEE9" />

  <!-- selection -->
  <SolidColorBrush x:Key="Ui.SelectionFill" Color="#C9954A" />
  <SolidColorBrush x:Key="Ui.SelectionText" Color="#1C1710" />
  <SolidColorBrush x:Key="Ui.SelectionInactive" Color="#3B3934" />

  <!-- semantic -->
  <SolidColorBrush x:Key="Ui.Red" Color="#E5624F" />
  <SolidColorBrush x:Key="Ui.Orange" Color="#E0A040" />
  <SolidColorBrush x:Key="Ui.Green" Color="#5BBF7A" />
  <SolidColorBrush x:Key="Ui.StatusIdle" Color="#6B6963" />

  <!-- scrollers -->
  <SolidColorBrush x:Key="Ui.ScrollThumb" Color="#FFFFFF" Opacity="0.24" />
  <SolidColorBrush x:Key="Ui.ScrollThumbHover" Color="#FFFFFF" Opacity="0.40" />

</ResourceDictionary>
