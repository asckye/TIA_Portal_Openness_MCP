<!--
  Lists, tables and scrollers.

  The table is the centre of this app, so it is set quietly: no vertical rules, no heavy header,
  a hairline under the header row and alternating row tints doing the work instead. Selection is
  a full-width amber row and goes grey when the grid loses focus, so the window never shows two
  things that look active at once.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== scroller ===================== -->
  <Style x:Key="Ui.Scroller.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="{DynamicResource Ui.ScrollThumb}" CornerRadius="4" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Ui.ScrollThumbHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An arrowless track. The RepeatButtons are kept but given no size, because ScrollBar's own
       logic still expects PART_Track to have them as siblings. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="MinWidth" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" Width="0" Height="0" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource Ui.Scroller.Thumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" Width="0" Height="0" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>

          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <!-- The size swap lives on the style, not in the template: a style trigger outranks a style
         setter, whereas a template trigger against the Width setter above is the kind of
         precedence puzzle that only shows up as a mysteriously fat scrollbar. -->
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="11" />
        <Setter Property="MinHeight" Value="11" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ScrollViewer keeps its stock template. Retemplating it would also retemplate the one
       inside every TextBox (PART_ContentHost) and inside the DataGrid, for no gain: the look
       here comes from the scroller above, not from the viewer around it. -->

  <!-- ===================== sidebar list ===================== -->
  <Style x:Key="Ui.ListBoxItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="8"
                  BorderBrush="Transparent" BorderThickness="1"
                  Padding="{TemplateBinding Padding}" Margin="0,0,0,4">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.ControlHover}" />
            </MultiTrigger>
            <!-- A selected device is a soft amber card rather than a filled bar: the sidebar is a
                 place you return to, and a saturated row there would outshout the table. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.AccentSoft}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Ui.AccentSoftBorder}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.SelectionInactive}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBoxItem" BasedOn="{StaticResource Ui.ListBoxItem}" />

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- ===================== table ===================== -->
  <Style x:Key="Ui.DataGridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SeparatorBrush" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="Chrome" Background="Transparent"
                    BorderBrush="{DynamicResource Ui.Separator}" BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                   Cursor="SizeWE" Opacity="0">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent" />
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.ControlHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Ui.DataGridColumnHeader}" />

  <Style x:Key="Ui.DataGridCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Selection is painted by the row, so the cell must not paint it a second time. -->
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ui.SelectionText}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="DataGridCell" BasedOn="{StaticResource Ui.DataGridCell}" />

  <Style x:Key="Ui.DataGridRow" TargetType="DataGridRow">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <!-- No Background setter: the DataGrid assigns RowBackground / AlternatingRowBackground to
         each row, and a style setter here would silently win over it. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <DataGridCellsPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True" />
                <Condition Property="IsSelected" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.ControlHover}" />
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.SelectionFill}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.SelectionText}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Ui.SelectionInactive}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Label}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="DataGridRow" BasedOn="{StaticResource Ui.DataGridRow}" />

  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Ui.RowAlternate}" />
    <Setter Property="GridLinesVisibility" Value="None" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowHeight" Value="38" />
    <Setter Property="ColumnHeaderHeight" Value="34" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="CanUserDeleteRows" Value="False" />
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="SelectionUnit" Value="FullRow" />
    <Setter Property="EnableRowVirtualization" Value="True" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
  </Style>

</ResourceDictionary>
