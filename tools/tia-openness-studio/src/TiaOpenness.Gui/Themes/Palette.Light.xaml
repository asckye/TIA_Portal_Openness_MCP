<!--
  Light appearance.

  A warm, paper-like scheme: off-white surfaces, near-black text, and one amber accent that is
  used sparingly - filled primary buttons, the selected segment, section marks, links, the
  checked state of switches. Everything else is neutral so the accent keeps its meaning.

  Only this file and Palette.Dark.xaml know any hex. Everything downstream refers to these tokens
  by DynamicResource, which is what lets the appearance switch without rebuilding the window.
  ThemeTests asserts the two palettes define exactly the same keys.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- accent -->
  <SolidColorBrush x:Key="Ui.Accent" Color="#B07F2C" />
  <SolidColorBrush x:Key="Ui.AccentHover" Color="#BE8B33" />
  <SolidColorBrush x:Key="Ui.AccentPressed" Color="#946A20" />
  <SolidColorBrush x:Key="Ui.OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.AccentSoft" Color="#F6ECD7" />
  <SolidColorBrush x:Key="Ui.AccentSoftBorder" Color="#E8D6B0" />
  <SolidColorBrush x:Key="Ui.AccentText" Color="#8A5F1A" />

  <!-- surfaces -->
  <SolidColorBrush x:Key="Ui.WindowBackground" Color="#F4F3EF" />
  <SolidColorBrush x:Key="Ui.HeaderBackground" Color="#FAF9F6" />
  <SolidColorBrush x:Key="Ui.SidebarBackground" Color="#F4F3EF" />
  <SolidColorBrush x:Key="Ui.CardBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.PanelBackground" Color="#F3F2EE" />
  <SolidColorBrush x:Key="Ui.CodeBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.RowAlternate" Color="#F8F7F4" />

  <!-- text -->
  <SolidColorBrush x:Key="Ui.Label" Color="#1F1F1F" />
  <SolidColorBrush x:Key="Ui.SecondaryLabel" Color="#5F5E5A" />
  <SolidColorBrush x:Key="Ui.TertiaryLabel" Color="#8D8B85" />
  <SolidColorBrush x:Key="Ui.PlaceholderLabel" Color="#9C9A93" />

  <!-- lines -->
  <SolidColorBrush x:Key="Ui.Separator" Color="#E3E0D8" />
  <SolidColorBrush x:Key="Ui.HairLine" Color="#ECEAE4" />
  <SolidColorBrush x:Key="Ui.DashedBorder" Color="#CFCBC1" />

  <!-- controls -->
  <SolidColorBrush x:Key="Ui.ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.ControlHover" Color="#F6F5F1" />
  <SolidColorBrush x:Key="Ui.ControlPressed" Color="#ECEAE4" />
  <SolidColorBrush x:Key="Ui.ControlBorder" Color="#D9D6CE" />
  <SolidColorBrush x:Key="Ui.ControlDisabled" Color="#F3F2EE" />
  <SolidColorBrush x:Key="Ui.FieldBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.FieldBorder" Color="#D9D6CE" />
  <SolidColorBrush x:Key="Ui.FieldFillBackground" Color="#F1F0EC" />

  <!-- segmented control / tabs / progress track -->
  <SolidColorBrush x:Key="Ui.SegmentTrack" Color="#E9E7E1" />
  <SolidColorBrush x:Key="Ui.SegmentThumb" Color="#ECEAE4" />

  <!-- switches -->
  <SolidColorBrush x:Key="Ui.SwitchTrackOff" Color="#D3D0C8" />
  <SolidColorBrush x:Key="Ui.SwitchKnob" Color="#FFFFFF" />

  <!-- selection -->
  <SolidColorBrush x:Key="Ui.SelectionFill" Color="#B07F2C" />
  <SolidColorBrush x:Key="Ui.SelectionText" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Ui.SelectionInactive" Color="#E6E3DB" />

  <!-- semantic -->
  <SolidColorBrush x:Key="Ui.Red" Color="#C0392B" />
  <SolidColorBrush x:Key="Ui.Orange" Color="#B9770E" />
  <SolidColorBrush x:Key="Ui.Green" Color="#2E7D4F" />
  <SolidColorBrush x:Key="Ui.StatusIdle" Color="#B8B5AD" />

  <!-- scrollers -->
  <SolidColorBrush x:Key="Ui.ScrollThumb" Color="#000000" Opacity="0.22" />
  <SolidColorBrush x:Key="Ui.ScrollThumbHover" Color="#000000" Opacity="0.40" />

</ResourceDictionary>
