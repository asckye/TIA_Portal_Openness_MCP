<Project>
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TiaOpenness.Openness</AssemblyName><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StudioApiAssembly Condition="'$(StudioReleaseKey)' != '21'">Siemens.Engineering.dll</StudioApiAssembly>
    <StudioApiAssembly Condition="'$(StudioReleaseKey)' == '21'">Siemens.Engineering.Base.dll</StudioApiAssembly>
    <DefineConstants Condition="'$(StudioReleaseKey)' != '14sp1' and '$(StudioReleaseKey)' != '15.1'">$(DefineConstants);STUDIO_VCI</DefineConstants>
    <DefineConstants Condition="'$(StudioReleaseKey)' == '20' or '$(StudioReleaseKey)' == '21'">$(DefineConstants);STUDIO_VCI_MODERN</DefineConstants>
    <DefineConstants Condition="'$(StudioReleaseKey)' == '16' or '$(StudioReleaseKey)' == '17'">$(DefineConstants);STUDIO_VCI_INITIAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../TiaOpenness.Core/TiaOpenness.Core.csproj" />
    <Compile Include="../*.cs" /><Compile Include="StudioRelease.cs" />
    <NativeApi Include="$(SiemensEngineeringDirectory)/Siemens.Engineering*.dll" />
    <Reference Include="@(NativeApi)"><Private>false</Private><SpecificVersion>true</SpecificVersion></Reference>
  </ItemGroup>
  <Target Name="RequireMatchingPublicApi" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SiemensEngineeringDirectory)' == ''" Text="Supply the official matching PublicAPI directory with SiemensEngineeringDirectory." />
    <GetAssemblyIdentity AssemblyFiles="$(SiemensEngineeringDirectory)/$(StudioApiAssembly)"><Output TaskParameter="Assemblies" ItemName="ApiIdentity" /></GetAssemblyIdentity>
    <Error Condition="'%(ApiIdentity.Version)' != '$(StudioApiVersion)'" Text="This adapter requires exact $(StudioReleaseKey) PublicAPI assemblies." />
  </Target>
</Project>
