<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFrameworks>net48;net10.0-windows</TargetFrameworks></PropertyGroup>
  <ItemGroup Condition="'$(TiaSharedAdapterPaths)' == 'true'">
    <ProjectReference Include="../../../tiaportal-mcp/src/TiaMcp.Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" />
    <!-- Keep the original compilation units byte-identical in the default build.
         The switched loader/channel copies are checked against those originals. -->
    <Compile Remove="Abstractions/SessionFactoryLoader.cs;Rpc/BridgeChannel.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TiaSharedAdapterPaths)' != 'true'">
    <Compile Remove="Adapters/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TiaOpenness.Contracts/TiaOpenness.Contracts.csproj" />
    <ProjectReference Include="../../../tiaportal-mcp/src/TiaMcp.WorkerChannel/TiaMcp.WorkerChannel.csproj" />
    <Compile Include="../../../tiaportal-mcp/src/TiaMcp.Logic/Siemens/TiaVersionCatalog.cs" Link="Versioning/TiaVersionCatalog.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../../openness-shared/LocalProcess.cs" Link="Shared/LocalProcess.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../../openness-shared/ProcessArguments.cs" Link="Shared/ProcessArguments.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../../../openness-shared/OpennessEnvironment.cs" Link="Shared/OpennessEnvironment.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../../openness-shared/BundleLayout.cs" Link="Shared/BundleLayout.cs" />
    <Compile Include="../../../openness-shared/DataLocations.cs" Link="Shared/DataLocations.cs" />
    <InternalsVisibleTo Include="TiaOpenness.Core.Tests" />
  </ItemGroup>
</Project>
