<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>HttpTests</AssemblyName>
    <RootNamespace>HttpTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup><Reference Include="System.Web.Extensions" /></ItemGroup>
  <!-- Only SDK attributes are compiled in; engine and runtime dependencies resolve beside the loaded EXE. -->
  <ItemGroup><PackageReference Include="ModelContextProtocol.Core" Version="0.3.0-preview.4" IncludeAssets="compile" /></ItemGroup>
  <ItemGroup><Compile Include="../TiaMcpServer.Tests/HmiScreenTraversalTests.cs" Link="HmiScreenTraversalTests.cs" /></ItemGroup>
</Project>
