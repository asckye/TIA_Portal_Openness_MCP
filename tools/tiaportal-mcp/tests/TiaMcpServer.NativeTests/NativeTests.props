<Project>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SiemensToken Condition="'$(TiaMajor)' == '20'">d29ec89bac048f84</SiemensToken>
    <SiemensToken Condition="'$(TiaMajor)' == '21'">29bfe5fdf4ba5d3b</SiemensToken>
    <TiaPortalLocation Condition="'$(SiemensEngineeringDirectory)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Siemens\Automation\_InstalledSW\TIAP$(TiaMajor)\Global', 'Path', '', RegistryView.Registry64, RegistryView.Registry32))</TiaPortalLocation>
    <SiemensEngineeringDirectory Condition="'$(SiemensEngineeringDirectory)' == '' and '$(TiaMajor)' == '20'">$(TiaPortalLocation)\PublicAPI\V20</SiemensEngineeringDirectory>
    <SiemensEngineeringDirectory Condition="'$(SiemensEngineeringDirectory)' == ''">$(TiaPortalLocation)\PublicAPI\V21\net48</SiemensEngineeringDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\*.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="$(SiemensBaseAssembly), Version=$(TiaMajor).0.0.0, Culture=neutral, PublicKeyToken=$(SiemensToken)">
      <HintPath>$(SiemensEngineeringDirectory)\$(SiemensBaseAssembly).dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>True</SpecificVersion>
    </Reference>
  </ItemGroup>
  <Target Name="RequireNativeSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(SiemensEngineeringDirectory)\$(SiemensBaseAssembly).dll')" Text="Supply the matching V$(TiaMajor) PublicAPI with -p:SiemensEngineeringDirectory=... (compile only). Live execution resolves the installed API from the registry." />
  </Target>
</Project>
