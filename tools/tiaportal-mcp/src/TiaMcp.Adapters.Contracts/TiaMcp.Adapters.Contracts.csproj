<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../../../Version.props" />
  <PropertyGroup>
    <TargetFrameworks>net461;net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <UseReferenceAssemblyPackage Condition="'$(UseReferenceAssemblyPackage)' == ''">true</UseReferenceAssemblyPackage>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net461' and '$(UseReferenceAssemblyPackage)' == 'true'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48' and '$(UseReferenceAssemblyPackage)' == 'true'" />
  </ItemGroup>
  <!-- Include resolved references so transitive JSON/native dependencies also fail the build. -->
  <Target Name="RejectNativeAndJsonDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <!-- net8 supplies STJ implicitly. Remove that compiler input as well, so even
           an accidental source-level dependency cannot compile in this assembly. -->
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'System.Text.Json' and '%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'System.Text.Json' and '%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
      <ForbiddenContractReference Include="@(Reference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(?i:Siemens|Newtonsoft|System\.Text\.Json|System\.Json|System\.Web\.Extensions|Json|Jil|Utf8Json)'))" />
      <ForbiddenContractReference Include="@(ReferencePath)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(?i:Siemens|Newtonsoft|System\.Text\.Json|System\.Json|System\.Web\.Extensions|Json|Jil|Utf8Json)'))" />
      <ForbiddenContractPackage Include="@(PackageReference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(?i:Siemens|Newtonsoft|System\.Text\.Json|System\.Json|System\.Web\.Extensions|Json|Jil|Utf8Json)'))" />
    </ItemGroup>
    <Error Condition="'@(ForbiddenContractReference)' != '' Or '@(ForbiddenContractPackage)' != ''" Text="TiaMcp.Adapters.Contracts must not reference Siemens or JSON libraries: @(ForbiddenContractReference); @(ForbiddenContractPackage)" />
  </Target>
</Project>
