<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../TiaMcp.WorkerProtocol/TiaMcp.WorkerProtocol.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(UseReferenceAssemblyPackage)' == 'true'" />
  </ItemGroup>
  <Target Name="RejectUnsupportedCodecFramework" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net48' and '$(TargetFramework)' != 'net8.0'">
    <Error Text="Strict JSON v2 supports net48 and net8.0 only. net461 workers require an explicit reviewed runtime/dependency decision; computed netstandard compatibility is not accepted." />
  </Target>
  <ItemGroup><Compile Include="../TiaMcp.WorkerProtocol.JsonShared/JsonSession.cs" Link="Shared/JsonSession.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../TiaMcp.WorkerProtocol.JsonShared/StrictCodec.cs" Link="Shared/StrictCodec.cs" /></ItemGroup>
</Project>
