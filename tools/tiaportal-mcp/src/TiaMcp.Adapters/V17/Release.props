<Project>
  <PropertyGroup>
    <AdapterReleaseKey>17</AdapterReleaseKey>
    <TiaReleaseKey Condition="'$(TiaReleaseKey)' == ''">17</TiaReleaseKey>
    <AdapterExpectedFramework>net48</AdapterExpectedFramework>
    <TargetFramework>net48</TargetFramework>
    <AdapterFeatureConstants>PLC_RH;PLC_SAFETY;PLC_WATCH_READ;PLC_SPECIAL_EXPORT</AdapterFeatureConstants>
  </PropertyGroup>
  <ItemGroup>
    <AdapterApi Include="$(SiemensEngineeringDirectory)/Siemens.Engineering.dll"><ApiName>Siemens.Engineering</ApiName><ExpectedIdentity>Siemens.Engineering, Version=17.0.0.0, Culture=neutral, PublicKeyToken=d29ec89bac048f84</ExpectedIdentity></AdapterApi>
  </ItemGroup>
</Project>
