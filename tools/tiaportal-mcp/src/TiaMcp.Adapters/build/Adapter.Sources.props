<Project>
  <!-- Transitional shared native source, compiled separately against each exact API.
       Deliberately no glob, generated placeholder, or Siemens copy. DTOs come from Contracts. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../TiaMcp.Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;BaseOutputPath;OutputPath;IntermediateOutputPath;AssemblyName;RuntimeIdentifier" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceDelete.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceDeletePolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcHardwareCatalog.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcHardwareCatalogPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/BindingSnapshotContract.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/BindingSnapshotProcessSource.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/BindingSnapshotAdapter.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcRuntimeQueries.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcRuntimeQueryPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/MutationIdentityPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcCompilePolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExchangePolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExportPublication.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchExport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchImport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchImportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchExportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBlockXmlPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcFoundationEngine.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcFoundationPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDisconnectPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcLifecyclePolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcOfflineChecks.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcOfflinePolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcReadContracts.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcReadPathPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcp.Logic/Siemens/TiaVersionCatalog.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcp.Logic/Siemens/EngineeringAssemblyIdentity.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer/Siemens/OpennessReleaseContract.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSupplementaryRead.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSupplementaryReadPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSoftwareRead.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSoftwareReadPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSpecialExport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcSpecialExportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDocumentExport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchDocumentExport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchDocumentExportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDocumentExportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceImport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceWorkflow.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceWorkflowPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcExternalSourceImportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDocumentImport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDocumentImportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchDocumentImport.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcBatchDocumentImportPolicy.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDeviceAdd.cs" />
    <AdapterSource Include="$(AdapterSourceRoot)/TiaMcpServer.PlcFoundation/PlcDeviceAddPolicy.cs" />
    <Compile Include="@(AdapterSource)" Link="NativeShared/%(Filename)%(Extension)" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../../openness-shared/NativeCallDiagnostics.cs" Link="Diagnostics/NativeCallDiagnostics.Shared.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Diagnostics/NativeCallDiagnostics.cs" Link="Diagnostics/NativeCallDiagnostics.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../Diagnostics/InvocationJournal.cs" Link="Diagnostics/InvocationJournal.cs" />
    <Compile Include="$(AdapterSourceRoot)/TiaMcp.Logic/ModelContextProtocol/PortalFailureClassifier.cs" Link="Diagnostics/PortalFailureClassifier.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <Reference Include="@(AdapterApi)">
      <HintPath>%(Reference.Identity)</HintPath><Private>false</Private><SpecificVersion>true</SpecificVersion>
    </Reference>
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net461' and '$(UseReferenceAssemblyPackage)' == 'true'" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>TiaReleaseKey</_Parameter1><_Parameter2>$(AdapterReleaseKey)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>AdapterIntegration</_Parameter1><_Parameter2>standalone-worker-preview</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>NativeCallInstrumentation</_Parameter1><_Parameter2>weave-and-verify-required</_Parameter2></AssemblyAttribute>
    <Compile Include="$(MSBuildThisFileDirectory)../../../../openness-shared/OpennessEnvironment.cs" Link="Shared/OpennessEnvironment.cs" />
  </ItemGroup>
</Project>
