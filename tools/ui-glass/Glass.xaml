<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Glass.Text" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Glass.Muted" TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}">
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>
  <Style x:Key="Glass.Mono" TargetType="TextBlock" BasedOn="{StaticResource Glass.Muted}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
  </Style>
  <Style x:Key="Glass.Heading" TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="Glass.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Ui.CardBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ui.HairLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="22,18"/>
  </Style>
  <Style x:Key="Glass.Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Accent}"/>
    <Setter Property="TextElement.FontSize" Value="10"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
  </Style>
  <ControlTemplate x:Key="Glass.ButtonTemplate" TargetType="ButtonBase">
    <Grid>
      <Border x:Name="Shadow" Visibility="Collapsed" CornerRadius="17" Background="{TemplateBinding Background}" Effect="{DynamicResource Glass.AccentShadow}"/>
      <Border x:Name="Surface" CornerRadius="17" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="Tag" Value="AccentPill">
        <Setter TargetName="Shadow" Property="Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Surface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.75"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.45"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Glass.Button" TargetType="ButtonBase">
    <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="13,6"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template" Value="{StaticResource Glass.ButtonTemplate}"/>
  </Style>
  <Style x:Key="Glass.Primary" TargetType="ButtonBase" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="Tag" Value="AccentPill"/>
    <Setter Property="Background" Value="{DynamicResource Ui.Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
  </Style>
  <Style x:Key="Glass.Outline" TargetType="ButtonBase" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
  </Style>
  <Style x:Key="Glass.Quiet" TargetType="ButtonBase" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Glass.CaptionButton" TargetType="ButtonBase" BasedOn="{StaticResource Glass.Quiet}">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
  </Style>
  <Style x:Key="Glass.Nav" TargetType="RadioButton" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Margin" Value="0,0,0,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" Padding="12,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ui.SegmentThumb}"/>
              <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glass.NavAction" TargetType="Button" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Glass.Field" TargetType="TextBox">
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="Background" Value="{DynamicResource Ui.FieldBackground}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ui.FieldBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Ui.Accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Field" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Ui.PlaceholderLabel}" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glass.Combo" TargetType="ComboBox">
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border CornerRadius="10" Background="{DynamicResource Ui.FieldBackground}" BorderBrush="{DynamicResource Ui.FieldBorder}" BorderThickness="1">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons" FontSize="8" Foreground="{DynamicResource Ui.SecondaryLabel}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Ui.WindowBackground}" BorderBrush="{DynamicResource Ui.FieldBorder}" BorderThickness="1" CornerRadius="10" Padding="6">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glass.Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Mark" Width="14" Height="14" BorderThickness="1" BorderBrush="{DynamicResource Ui.DashedBorder}" CornerRadius="7"/>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Ui.Accent}"/>
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Mark" Property="BorderThickness" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Glass.List" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Glass.Row" TargetType="ListBoxItem">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0" MinHeight="40" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
