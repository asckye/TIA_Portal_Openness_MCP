  {
    "id": "sequence/plc-scl-block",
    "topic": "plc-scl-block",
    "purpose": "Create a block from SCL text: source file -> external source -> generated block -> compile -> save.",
    "preconditions": "connect-project done; the PLC software path is known.",
    "notes": "Use the complete SCL files in GetToolUsage(language=\"scl\"). External source and SIMATIC SD envelopes differ. Generation may overwrite an existing block.",
    "releaseKeys": [
      "20",
      "21"
    ],
    "profile": "full-engine",
    "kind": "call-sequence",
    "validation": "Contract checked; native acceptance of this revision NOT RUN.",
    "steps": [
      {
        "tool": "WritePlcSclSourceFile",
        "arguments": {
          "sclContent": "<complete FUNCTION / FUNCTION_BLOCK / DATA_BLOCK text>",
          "outputPath": "C:\\Temp\\<Block>.scl"
        },
        "expect": "Meta reports the file written"
      },
      {
        "tool": "ManagePlcExternalSources",
        "arguments": {
          "softwarePath": "PLC_1",
          "action": "createFromFile",
          "name": "<Block>",
          "filePath": "C:\\Temp\\<Block>.scl",
          "dryRun": true
        },
        "expect": "preview clean"
      },
      {
        "tool": "ManagePlcExternalSources",
        "arguments": {
          "softwarePath": "PLC_1",
          "action": "createFromFile",
          "name": "<Block>",
          "filePath": "C:\\Temp\\<Block>.scl",
          "dryRun": false
        },
        "expect": "external source created"
      },
      {
        "tool": "GenerateBlocksFromExternalSource",
        "arguments": {
          "softwarePath": "PLC_1",
          "externalSourceName": "<Block>"
        },
        "expect": "generated blocks listed"
      },
      {
        "tool": "CompileAndDiagnosePlc",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "ErrorCount 0"
      },
      {
        "tool": "SaveProject",
        "arguments": {},
        "expect": "IsModified false"
      }
    ]
  },
