    "notes": "Use GetToolUsage(exampleId=\"scl-add\") for the complete source. V14 SP1 returns no generated object list; the later overload reports native objects. No automatic save or download. Normal native generation rejection is Status=failed and keeps the session usable; correct the source and preview again. Status=outcome-unknown requires project inspection.",
    "releaseKeys": [
      "14sp1",
      "15.1",
      "16",
      "17",
      "18",
      "19"
    ],
    "profile": "plc-foundation",
    "kind": "call-sequence",
    "validation": "Contract checked; native acceptance NOT RUN.",
    "steps": [
      {
        "tool": "GetState",
        "arguments": {},
        "expect": "Intended exact project already attached; copy ProjectFile."
      },
      {
        "tool": "GetProjectTree",
        "arguments": {},
        "expect": "Copy the exact PLC software path; use the complete ASCII FC_Add.scl example on the TIA host."
      },
      {
        "tool": "ImportPlcExternalSource",
        "arguments": {
          "softwarePath": "PLC_1",
          "groupPath": "",
          "filePath": "C:\\Examples\\FC_Add.scl",
          "dryRun": true
        },
        "expect": "Status=planned; review source/target and copy this operation's PlanHash."
      },
      {
        "tool": "ImportPlcExternalSource",
        "arguments": {
          "softwarePath": "PLC_1",
          "groupPath": "",
          "filePath": "C:\\Examples\\FC_Add.scl",
          "dryRun": false,
          "confirm": true,
          "expectedProjectFile": "<ProjectFile from GetState>",
          "expectedPlanHash": "<PlanHash from the immediately preceding preview>"
        },
        "expect": "Status=completed, Executed=true; retain returned SourceName. No generation/compile yet."
      },
