        "expect": "masterSecret WithPassword"
      },
      {
        "tool": "CompileDevice",
        "arguments": {
          "devicePathJson": "[\"<Station>\"]"
        },
        "expect": "0 errors (warnings allowed)"
      }
    ]
  },
  {
    "id": "sequence/download-plcsim",
    "topic": "download-plcsim",
    "purpose": "Download a standard CPU to a PLCSIM Advanced instance and go online (the maintainer's only permitted online target).",
    "preconditions": "cpu-protection done for that CPU; PLCSIM Advanced 8.0 installed on the TIA machine; the CPU is a standard one (F-CPUs are refused by Openness).",
    "notes": "Softbus makes TIA show a single 'PLCSIM' PG/PC interface; register with that when the instance is new. Downloads to FW >= 2.9 CPUs need trustDeviceCertificate (default true).",
    "releaseKeys": [
      "20",
      "21"
    ],
    "profile": "full-engine",
    "kind": "call-sequence",
    "validation": "Contract checked; native acceptance of this revision NOT RUN.",
    "steps": [
      {
        "tool": "ReadPlcSimAdvancedInstances",
        "arguments": {
          "includeState": true
        },
        "expect": "instances and api.networkMode"
      },
      {
        "tool": "ManagePlcSimAdvancedInstance",
        "arguments": {
          "instanceName": "<Instance>",
          "action": "register",
          "cpuType": "CPU1500_Unspecified",
          "communicationInterface": "Softbus",
          "dryRun": false,
          "confirmInstanceChange": true
        },
        "expect": "registered (skip when it exists)"
      },
      {
        "tool": "ManagePlcSimAdvancedInstance",
        "arguments": {
          "instanceName": "<Instance>",
          "action": "powerOn",
          "dryRun": false,
          "confirmInstanceChange": true
        },
        "expect": "stateAfter Run/Stop"
      },
      {
        "tool": "ReadTransferRoutes",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "a 'PLCSIM' PC interface with the CPU's IP"
      },
      {
        "tool": "CompileSoftware",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "0 errors"
      },
      {
        "tool": "CheckDownloadReadiness",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "ready"
      },
      {
        "tool": "DownloadToPlc",
        "arguments": {
          "softwarePath": "PLC_1",
          "pgPcInterface": "PLCSIM",
          "targetIpAddress": "<CPU IP>"
        },
        "expect": "State Success / Warning"
      },
      {
        "tool": "GoOnline",
        "arguments": {
          "softwarePath": "PLC_1",
          "ipAddress": "<CPU IP>",
          "pgPcInterface": "PLCSIM"
        },
        "expect": "Online"
      },
      {
        "tool": "GetOnlineState",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "Online"
      },
      {
        "tool": "CompareSoftwareToOnline",
        "arguments": {
          "softwarePath": "PLC_1",
          "maxDepth": 4
        },
        "expect": "0 differences after a download"
      },
      {
        "tool": "GoOffline",
        "arguments": {
          "softwarePath": "PLC_1"
        },
        "expect": "Offline"
      }
    ]
  },
