  {
    "id": "sequence/startdrive-bico-read",
    "topic": "startdrive-bico-read",
    "purpose": "Read one intended offline BICO connection using the official V20/V21 parameter path.",
    "preconditions": "Intended project and exact drive/control-unit paths are known; substitute placeholders and parameter. Do not automatically execute a known failing target such as p2051[0].",
    "notes": "Offline values describe engineering configuration. Interpret the returned value shape using GetToolUsage(toolName=\"ManageStartdriveParameter\", operation=\"read\"). Native regression acceptance NOT RUN.",
    "releaseKeys": [
      "20",
      "21"
    ],
    "profile": "full-engine",
    "kind": "call-sequence",
    "validation": "Contract checked; native acceptance of this revision NOT RUN.",
    "steps": [
      {
        "tool": "GetState",
        "arguments": {},
        "expect": "The operator-intended project is already bound; no automatic reconnect."
      },
      {
        "tool": "FindTools",
        "arguments": {
          "query": "ManageStartdriveParameter",
          "limit": 1
        },
        "expect": "Tool is available on this selected full engine; inspect its schema and example."
      },
      {
        "tool": "ManageStartdriveParameter",
        "arguments": {
          "devicePathJson": "[\"<exact drive device>\"]",
          "itemPathJson": "[\"<exact drive/control unit item>\"]",
          "driveObjectNumber": 0,
          "driveObjectIndex": 0,
          "parameter": "p1070[0]",
          "action": "read",
          "dryRun": true
        },
        "expect": "For the requested target only, meta.before.value has a BICO source or scalar/null; stop on failure."
      }
    ]
  },
