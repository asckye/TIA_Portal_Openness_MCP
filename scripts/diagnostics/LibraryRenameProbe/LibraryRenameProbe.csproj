<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <SiemensEngineeringDirectory Condition="'$(SiemensEngineeringDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\..\sdk\TIA_V21_PublicAPI\V21\net48</SiemensEngineeringDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="BuildPackage.cs" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Siemens.Engineering.Base, Version=21.0.0.0, Culture=neutral, PublicKeyToken=29bfe5fdf4ba5d3b">
      <HintPath>$(SiemensEngineeringDirectory)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
      <SpecificVersion>True</SpecificVersion>
    </Reference>
  </ItemGroup>
</Project>
