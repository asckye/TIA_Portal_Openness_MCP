<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="SelectedAdapterProject;SelectedAdapterDirectory;WorkerExpectedFramework">
  <!-- One PLC foundation worker per release. Full V20/V21 MCP engines remain separate. -->
  <PropertyGroup>
    <RootNamespace>TiaMcp.PlcWorker</RootNamespace>
    <WorkerExpectedFramework>net48</WorkerExpectedFramework>
    <TargetFramework>$(WorkerExpectedFramework)</TargetFramework>
    <OutputType>Exe</OutputType><AssemblyName>TiaMcp.PlcWorker.$(TiaReleaseKey)</AssemblyName>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><Nullable>enable</Nullable>
    <SelectedAdapterDirectory Condition="'$(TiaReleaseKey)' == '14sp1'">V14Sp1</SelectedAdapterDirectory>
    <SelectedAdapterDirectory Condition="'$(TiaReleaseKey)' == '15.1'">V15_1</SelectedAdapterDirectory>
    <SelectedAdapterDirectory Condition="'$(TiaReleaseKey)' == '16' or '$(TiaReleaseKey)' == '17' or '$(TiaReleaseKey)' == '18' or '$(TiaReleaseKey)' == '19' or '$(TiaReleaseKey)' == '20' or '$(TiaReleaseKey)' == '21'">V$(TiaReleaseKey)</SelectedAdapterDirectory>
    <SelectedAdapterProject Condition="'$(SelectedAdapterDirectory)' != ''">../Adapters/$(SelectedAdapterDirectory)/Adapter.$(TiaReleaseKey).csproj</SelectedAdapterProject>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <UseReferenceAssemblyPackage Condition="'$(UseReferenceAssemblyPackage)' == ''">true</UseReferenceAssemblyPackage>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <WorkerSourceRoot Condition="'$(WorkerSourceRoot)' == ''">$(MSBuildProjectDirectory)</WorkerSourceRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../WorkerChannel/TiaMcp.WorkerChannel.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;BaseOutputPath;OutputPath;IntermediateOutputPath;AssemblyName;RuntimeIdentifier" />
    <ProjectReference Include="../Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;BaseOutputPath;OutputPath;IntermediateOutputPath;AssemblyName;RuntimeIdentifier" />
    <Compile Include="$(WorkerSourceRoot)/Program.cs" Link="Program.cs" />
    <Compile Include="../Shared/SwallowedExceptions.cs" Link="Shared/SwallowedExceptions.cs" />
    <Compile Include="$(WorkerSourceRoot)/FoundationWorkerDispatcher.cs" Link="FoundationWorkerDispatcher.cs" />
    <Compile Include="$(WorkerSourceRoot)/WorkerJson.cs" Link="WorkerJson.cs" />
    <Compile Include="$(WorkerSourceRoot)/WorkerOperations.cs" Link="WorkerOperations.cs" />
    <Compile Include="$(WorkerSourceRoot)/WorkerSessionOutcomeState.cs" Link="WorkerSessionOutcomeState.cs" />
    <Compile Include="$(WorkerSourceRoot)/WorkerFailurePolicy.cs" Link="WorkerFailurePolicy.cs" />
    <Compile Include="../Shared/HostFailurePolicy.cs" Link="Shared/HostFailurePolicy.cs" />
    <Compile Include="../Shared/ProcessLossPolicy.cs" Link="Shared/ProcessLossPolicy.cs" />
    <Compile Include="../Shared/SessionBehavior.cs" Link="Shared/SessionBehavior.cs" />
    <ProjectReference Include="$(SelectedAdapterProject)" Condition="'$(SelectedAdapterProject)' != ''"
                      GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;BaseOutputPath;OutputPath;IntermediateOutputPath;AssemblyName;TargetFramework;RuntimeIdentifier" />
    <PackageReference Include="System.Text.Json" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48' and '$(UseReferenceAssemblyPackage)' == 'true'" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TiaMcpTestPolicy)' != ''"><_Parameter1>TiaMcpTestPolicy</_Parameter1><_Parameter2>$(TiaMcpTestPolicy)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>TiaReleaseKey</_Parameter1><_Parameter2>$(TiaReleaseKey)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>NativeCallInstrumentation</_Parameter1><_Parameter2>adapter-weave-verify-required-production-blocked</_Parameter2></AssemblyAttribute>
  </ItemGroup>
  <Target Name="ValidateWorkerAdapter" BeforeTargets="PrepareForBuild;CollectPackageReferences;ResolveProjectReferences;_GenerateRestoreGraphProjectEntry">
    <Error Condition="'$(SelectedAdapterDirectory)' == '' or !Exists('$(SelectedAdapterProject)')" Text="Worker requires one of eight exact release adapters; original V14/V15 excluded. No default version is selected." />
    <Error Condition="'$(TargetFramework)' != '$(WorkerExpectedFramework)'" Text="Worker framework mismatch for $(TiaReleaseKey)." />
    <Error Condition="'$(PlatformTarget)' != 'x64' or '$(OutputType)' != 'Exe'" Text="The source-preview worker requires an x64 executable." />
    <ItemGroup><WorkerAdapterReference Include="@(ProjectReference)" Condition="'%(ProjectReference.Identity)' != '../Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj' and '%(ProjectReference.Identity)' != '../WorkerChannel/TiaMcp.WorkerChannel.csproj'" /></ItemGroup>
    <Error Condition="'@(ProjectReference->Count())' != '3' or '@(WorkerAdapterReference->Count())' != '1' or '@(WorkerAdapterReference)' != '$(SelectedAdapterProject)'" Text="Worker must reference exactly one selected adapter, never the former Foundation or multiple adapters." />
    <Error Condition="'$(EnableDefaultCompileItems)' != 'false'" Text="Worker sources must use the explicit allowlist." />
  </Target>
</Project>
