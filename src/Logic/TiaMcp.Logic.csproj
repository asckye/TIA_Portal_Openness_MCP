<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Shared/AuditSources.props" />
  <Import Project="../Shared/ApprovalSources.props" />
  <Import Project="../Shared/WorkbenchControlSources.props" />
  <Import Project="$(MSBuildThisFileDirectory)../../Version.props" />
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);TIA_APPROVAL_PRIVATE_JOURNAL</DefineConstants>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);TIA_BUNDLE_LAYOUT_PUBLIC</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TiaMcp.WorkbenchControl.Tests</_Parameter1>
    </AssemblyAttribute>
    <ProjectReference Include="../Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <PackageReference Include="Esprima" Version="3.0.5" />
    <PackageReference Include="System.Text.Json" Version="10.0.0-preview.4.25258.110" />
    <ProjectReference Include="../../third_party/TiaGitAddIn.Core/TiaGitAddIn.Core.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <Compile Include="../Shared/OpennessEnvironment.cs" Link="Shared/OpennessEnvironment.cs" />
    <Compile Include="../Shared/NativeInputPolicy.cs" Link="Shared/NativeInputPolicy.cs" />
    <Compile Include="../Shared/HostFailurePolicy.cs" Link="Shared/HostFailurePolicy.cs" />
    <Compile Include="../Shared/ProcessLossPolicy.cs" Link="Shared/ProcessLossPolicy.cs" />
    <Compile Include="../Shared/NativePathSelection.cs" Link="Shared/NativePathSelection.cs" />
    <Compile Include="../Shared/NativeExportPolicy.cs" Link="Shared/NativeExportPolicy.cs" />
    <Compile Include="../Shared/BundleLayout.cs" Link="Shared/BundleLayout.cs" />
    <Compile Include="../Shared/DataLocations.cs" Link="Shared/DataLocations.cs" />
    <Compile Include="../Shared/LocalProcess.cs" Link="Shared/LocalProcess.cs" />
    <Compile Include="../Shared/ProcessArguments.cs" Link="Shared/ProcessArguments.cs" />
    <Compile Include="../Shared/CallJournalPayload.cs" Link="Shared/CallJournalPayload.cs" />
    <Compile Include="../Shared/ToolUsageCatalog.cs" Link="Shared/ToolUsageCatalog.cs" />
    <EmbeddedResource Include="../Shared/ToolUsageData.json" LogicalName="TiaMcp.ToolUsage.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../schemas/standards/v1/*.schema.json" LogicalName="TiaMcp.Generation.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Check resolved references as well as declarations, including transitive dependencies. -->
  <Target Name="RejectEngineDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <ForbiddenLogicReference Include="@(Reference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(?i:Siemens|ModelContextProtocol)'))" />
      <ForbiddenLogicReference Include="@(ReferencePath)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(?i:Siemens|ModelContextProtocol)'))" />
      <ForbiddenLogicPackage Include="@(PackageReference)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Identity)', '^(?i:Siemens|ModelContextProtocol)'))" />
    </ItemGroup>
    <Error Condition="'@(ForbiddenLogicReference)' != '' Or '@(ForbiddenLogicPackage)' != ''" Text="TiaMcp.Logic must not reference Siemens or ModelContextProtocol: @(ForbiddenLogicReference); @(ForbiddenLogicPackage)" />
  </Target>
</Project>
