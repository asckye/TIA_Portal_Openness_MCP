<Project>
  <!-- Native path migrations remain opt-in until the real-machine ledger is accepted. -->
  <PropertyGroup>
    <TiaSharedAdapterPaths Condition="'$(TiaSharedAdapterPaths)' == ''">false</TiaSharedAdapterPaths>
    <DefineConstants Condition="'$(TiaSharedAdapterPaths)' == 'true'">$(DefineConstants);TIA_SHARED_ADAPTER_PATHS</DefineConstants>
  </PropertyGroup>
  <Target Name="ReportSharedAdapterPaths" BeforeTargets="CoreCompile">
    <Message Importance="high" Text="$(MSBuildProjectName): TiaSharedAdapterPaths=$(TiaSharedAdapterPaths)" />
  </Target>
</Project>
