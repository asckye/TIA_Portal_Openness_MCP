<Project>
  <!-- Exact release keys: 14sp1, 15.1, 16, 17, 18, 19, 20, 21.
       Each row owns one feature's release range. Profiles select each consumer's
       compiler symbols; Adapter also compiles the Studio native sources.
       Pipe delimiters keep service/minor releases distinct from major-version aliases. -->
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter' Or '$(TiaFeatureProfile)' == 'HardwareAddressing'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_ADDRESS_PROCESS_IMAGE_SERVICE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ATTRIBUTE_DELEGATE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_TEXTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_CLASSES;PLC_SUPERVISION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_LISTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_OPC_UA</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_B5_V21;PLC_B5_V20_PLUS</DefineConstants>

    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_INTEGRITY_PROVIDERS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_UNITS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_MOTION_MODERN</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SAFETY_UNITS</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_MOTION_V21</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_UNIT_GROUP_NAME</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_BLOCK_WRITE_PROTECTION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V151</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V17</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V20</DefineConstants>

    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_TRANSFER_MULTICAST</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_CATALOG_ENTRIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_CAX_TRANSFER_RESULT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_TRANSFER_AREAS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_DOMAINS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_MRP_INSTANCES</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '17' Or '$(TiaReleaseKey)' == '18' Or '$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_DIAGNOSTICS</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '18' Or '$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_CERTIFICATES</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_TELECONTROL</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_HARDWARE_LINKED_TAGS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_CUSTOM_IDENTITY</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_COMPILATION_PROPERTIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_VIRTUAL_COMPILATION_PROPERTIES</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);ENGINEERING_COMPILATION_SERVICES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_OBJECT_IDENTIFIER;LIBRARY_DOCUMENT_IMPORT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_COMPARE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SOURCE_RESULTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_RH</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_READ</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_ENTRIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SPECIAL_EXPORT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_EXPORT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SAFETY</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_TECH_GROUP_READ</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_CATALOG</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_DOCUMENT_EXPORT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Studio' Or '$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI_INITIAL</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI_MODERN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Engine'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '20'">$(DefineConstants);TIA_V20</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter' and '$(TiaReleaseKey)' == '20'"><DefineConstants>$(DefineConstants);PLC_B5_V20_PLUS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21'">$(DefineConstants);HMI_UNIFIED</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);HMI_GRAPHICS_PROVIDER</DefineConstants>
  </PropertyGroup>
</Project>
