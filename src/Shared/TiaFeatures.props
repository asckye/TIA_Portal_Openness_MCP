    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_TECH_GROUP_READ</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_CATALOG</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_DOCUMENT_EXPORT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Studio' Or '$(TiaFeatureProfile)' == 'Adapter'">
    <!-- Project.IsPrimary exists from V15.1 (ProjectBase.IsPrimary from V17). -->
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_IS_PRIMARY</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI_INITIAL</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);STUDIO_VCI_MODERN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Engine'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '20'">$(DefineConstants);TIA_V20</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter' and '$(TiaReleaseKey)' == '20'"><DefineConstants>$(DefineConstants);PLC_B5_V20_PLUS</DefineConstants></PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">

    <DefineConstants Condition="'$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21'">$(DefineConstants);HMI_UNIFIED</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);HMI_GRAPHICS_PROVIDER</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);HMI_CPM_PROVIDER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SAFETY_GLOBAL</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SAFETY_PROGRAM;SAFETY_GLOBAL_READ</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SAFETY_GLOBAL_FULL</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);SAFETY_V21</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);OPTIONAL_V20_PLUS</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);OPTIONAL_V21</DefineConstants>
  </PropertyGroup>
