<Project>
  <!-- Exact release keys: 14sp1, 15.1, 16, 17, 18, 19, 20, 21.
       Each row owns one feature's release range. Profiles select each consumer's
       compiler symbols; Adapter also compiles the Studio native sources.
       Pipe delimiters keep service/minor releases distinct from major-version aliases. -->
  <!-- Every PlcWorker uses the same session flow; Adapter compiles its implementation. -->
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Worker' Or '$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants Condition="$([System.String]::Copy('|14sp1|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);WORKER_SESSION_LIFECYCLE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|14sp1|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_SCAFFOLD</DefineConstants>
  </PropertyGroup>
  <!-- Seed registration stays on the evidenced engine-port formats; older releases still refuse it. -->
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Worker'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21'">$(DefineConstants);WORKER_SEED_HMI_IMPORT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Worker'">
    <DefineConstants>$(DefineConstants);WORKER_PROPERTY_ADMISSION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter' Or '$(TiaFeatureProfile)' == 'HardwareAddressing'">
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_ADDRESS_PROCESS_IMAGE_SERVICE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ATTRIBUTE_DELEGATE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TiaFeatureProfile)' == 'Adapter'">
    <DefineConstants>$(DefineConstants);TIA_NATIVE_ONLINE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_FOLDER</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_BLOCK_INTERFACE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_ADDRESSES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_TARGET_ADDRESSES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_LEGITIMATION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_SELECTIVE_DELETE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_DOWNLOAD_SENSITIVE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_AUTHENTICATION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_DOWNLOAD</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_FINGERPRINTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_TLS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_LOADABLE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_SCAN</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ONLINE_RH</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);ONLINE_ADDRESS_OVERLOAD;ONLINE_PASSWORD_SECURITY;ONLINE_PARAMETERS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_EXCHANGE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_MULTIUSER</DefineConstants>
    <!-- MarkingService/Markings/Marking exist from V17; ProjectServer.GetProjectServerGroups and ProjectServerGroup from V20. -->
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_MULTIUSER_MARKINGS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_MULTIUSER_SERVER_GROUPS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_TEXT_CATEGORIES</DefineConstants>
    <!-- ProjectBase (and TiaPortal.LocalSessions) exist from V17; V14 SP1-V16 bind Siemens.Engineering.Project. -->
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_BASE</DefineConstants>
    <!-- ProjectComposition.Open/OpenWithUpgrade/Retrieve*(..., UmacDelegate) and UmacCredentials exist from V15.1. -->
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_UMAC</DefineConstants>
    <!-- TiaPortal.Authentication / AuthenticationEventArgs exist from V17. -->
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PROJECT_AUTHENTICATION_EVENT</DefineConstants>
    <!-- LicenseNotFoundException exists from V17, MissingProductsException from V18. -->
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);OPENNESS_LICENSE_EXCEPTION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);OPENNESS_MISSING_PRODUCTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_DEVICE_USERS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_WATCH_WEB</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_SIMPLE_WEB</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_MASTER_SECRET</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_ACCESS_CONTROL</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_ALL_CONFIGURATION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_UMC_EXTENDED</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_UMC_SERVER_SYNC</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_CERT_EXPORT_IMPLICIT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_DEVICE_SYSLOG</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_PROJECT_SYSLOG</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_CERTIFICATE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_DEVICE_RIGHT_DELETE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_PROJECT_PROTECTION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_UMAC</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);SECURITY_POLICY</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);COLLABORATION_TEAMCENTER</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_TEXTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_CLASSES;PLC_SUPERVISION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ALARM_LISTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_OPC_UA</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_B5_V21;PLC_B5_V20_PLUS</DefineConstants>

    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_INTEGRITY_PROVIDERS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_UNITS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_MOTION_MODERN</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SAFETY_UNITS</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_MOTION_V21</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_UNIT_GROUP_NAME</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_BLOCK_WRITE_PROTECTION</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V151</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V17</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_V20</DefineConstants>

    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_TRANSFER_MULTICAST</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_TRANSFER_MULTICAST_V19</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_ATTRIBUTE_SUPPORTED_TYPES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_CATALOG_ENTRIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_CAX_TRANSFER_RESULT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_TRANSFER_AREAS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_DOMAINS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_HARDWARE_MRP_INSTANCES</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '17' Or '$(TiaReleaseKey)' == '18' Or '$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_DIAGNOSTICS</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '18' Or '$(TiaReleaseKey)' == '19' Or '$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_CERTIFICATES</DefineConstants>
    <DefineConstants Condition="('$(TiaReleaseKey)' == '20' Or '$(TiaReleaseKey)' == '21')">$(DefineConstants);PLC_HARDWARE_TELECONTROL</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);PLC_HARDWARE_LINKED_TAGS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_CUSTOM_IDENTITY</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_COMPILATION_PROPERTIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_VIRTUAL_COMPILATION_PROPERTIES</DefineConstants>
    <DefineConstants Condition="'$(TiaReleaseKey)' == '21'">$(DefineConstants);ENGINEERING_COMPILATION_SERVICES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);ENGINEERING_OBJECT_IDENTIFIER;LIBRARY_DOCUMENT_IMPORT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);LIBRARY_COMPARE</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SOURCE_RESULTS</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_RH</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|16|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_READ</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|17|18|19|20|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_ENTRIES</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|16|17|18|19|20|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_SPECIAL_EXPORT</DefineConstants>
    <DefineConstants Condition="$([System.String]::Copy('|15.1|21|').Contains('|$(TiaReleaseKey)|'))">$(DefineConstants);PLC_WATCH_EXPORT</DefineConstants>
