<Project Sdk="Microsoft.NET.Sdk">
  <!-- Product FileVersion/InformationalVersion from the release property the hosts use (Version.props), so the shipped
       updater carries the release label (for example 4.0.0-beta.1); the binding identity stays AssemblyVersion 1.0.0.0. -->
  <Import Project="$(MSBuildThisFileDirectory)../../Version.props" />
  <PropertyGroup><AssemblyVersion>1.0.0.0</AssemblyVersion></PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TiaMcp.Updater</AssemblyName>
    <RootNamespace>TiaMcp.Updater</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <OutputPath Condition="'$(UpdaterTestSource)' != 'true'">$(MSBuildThisFileDirectory)..\..\bin-build\updater\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UpdaterTestSource)' == 'true'">
    <DefineConstants>$(DefineConstants);UPDATER_TEST_SOURCE</DefineConstants>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\bin-build\updater-test\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ProductReleaseVersion.cs" Link="Shared\ProductReleaseVersion.cs" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
