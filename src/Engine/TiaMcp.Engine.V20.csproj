<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup Condition="'$(TiaSharedAdapterPaths)' != 'true'"><Compile Include="../Adapters/Native/Vci/VciFallbackAdapter.cs" Link="Native/Vci/VciFallbackAdapter.cs" /></ItemGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../Version.props" />
  <PropertyGroup>
    <RootNamespace>TiaMcp.Engine.V20</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>Latest</LangVersion>
    <OutputType>Exe</OutputType>
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
    <AssemblyName>TiaMcp.Engine.V20</AssemblyName>
    <BaseOutputPath>.\bin-v20</BaseOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-v20\**;bin\**;bin-v20\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>TiaMcpWorkerIsolationDefault</_Parameter1>
      <_Parameter2>$(TiaMcpWorkerIsolationDefault)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(TiaMcpEngineWorkerSdkFixture)' == 'true'">
      <_Parameter1>TiaMcpEngineWorkerSdkFixture</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Esprima" Version="3.0.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.4.25258.110" />
    <PackageReference Include="ModelContextProtocol" Version="0.3.0-preview.4" />
    <PackageReference Include="YamlDotNet" Version="13.7.1" />
    <PackageReference Include="Siemens.Collaboration.Net.OperatingSystem.Windows" Version="3.0.1725521661" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Resolver" Version="1.1.1725480302" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Packages.Openness" Version="20.0.1744190253" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management">
      <HintPath>C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8\System.Management.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Include="tests\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../third_party/TiaGitAddIn.Core/TiaGitAddIn.Core.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <Compile Include="../../third_party/SiemensOpcUaModelled/**/*.cs" LinkBase="SiemensOpcUaModelled" />
    <EmbeddedResource Include="../../third_party/SiemensOpcUaModelled/Phases/Phase1/InterfaceTemplate.xml" LogicalName="TiaMcp.OpcUa.InterfaceTemplate.xml" />
    <EmbeddedResource Include="../../reference/v21-ecosystem.json" LogicalName="TiaMcp.V21Ecosystem.json" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/InvocationJournal.cs" Link="Shared/InvocationJournal.cs" /><Compile Include="../Shared/NativeCallDiagnostics.Journal.cs" Link="Shared/NativeCallDiagnostics.Journal.cs" /><Compile Include="../Shared/NativeCallDiagnostics.cs" Link="Shared/NativeCallDiagnostics.Shared.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/ImportDependencyPlanner.cs" Link="Shared/ImportDependencyPlanner.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/SwallowedExceptions.cs" Link="Shared/SwallowedExceptions.cs" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Adapters/V20/Adapter.20.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" AdditionalProperties="SiemensEngineeringDirectory=$(SiemensEngineeringDirectory)" />
    <ProjectReference Include="../OnlineChannels/TiaMcp.OnlineChannels.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../WorkerChannel/TiaMcp.WorkerChannel.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
    <ProjectReference Include="../Logic/TiaMcp.Logic.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/CallJournalPayload.cs" Link="Journal/CallJournalPayload.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../PlcWorker/FoundationWorkerDispatcher.cs" Link="Worker/FoundationWorkerDispatcher.cs" />
    <Compile Include="../PlcWorker/WorkerJson.cs" Link="Worker/WorkerJson.cs" />
    <Compile Include="../PlcWorker/WorkerOperations.cs" Link="Worker/WorkerOperations.cs" />
    <Compile Include="../PlcWorker/WorkerFailurePolicy.cs" Link="Worker/WorkerFailurePolicy.cs" />
    <Compile Include="../PlcWorker/WorkerSessionOutcomeState.cs" Link="Worker/WorkerSessionOutcomeState.cs" />
  </ItemGroup>
  <Import Project="../EngineHost/EngineHostSources.props" />
</Project>
