    <LangVersion>Latest</LangVersion>
    <OutputType>Exe</OutputType>
    <AssemblyName>TiaMcp.Engine.V21</AssemblyName>
    <RootNamespace>TiaMcp.Engine.V21</RootNamespace>
    <BaseOutputPath>.\bin</BaseOutputPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;obj-v20\**;bin\**;bin-v20\**</DefaultItemExcludes>
    <!-- Release builds ship no .pdb, so the debug directory only served to embed the
         builder's absolute source path (an RSDS entry naming the private repo tree)
         into every published exe. Nothing reads it once the .pdb is gone. -->
    <DebugType Condition="'$(Configuration)'=='Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)'=='Release'">false</DebugSymbols>
  </PropertyGroup>
