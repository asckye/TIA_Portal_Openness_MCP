<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- 2.7.41: keep the MCP server process alive when an Openness background thread throws after TIA Portal itself has died
         (2.7.40 real project, G120C: TIA Portal V21 exits on several Startdrive calls, and the engine then followed it with
         exit code 0xE0434352 / "Exception.ToString() failed"). With the legacy policy a non-main-thread exception is logged by
         Program.cs (AppDomain.UnhandledException) instead of terminating the process; every tool then reports the dead TIA
         process through GetState / the connection-failure record until AttachToOpenProject rebinds. The SDK still merges the
         generated assembly binding redirects into this <runtime> element. -->
    <legacyUnhandledExceptionPolicy enabled="1" />
  </runtime>
</configuration>
