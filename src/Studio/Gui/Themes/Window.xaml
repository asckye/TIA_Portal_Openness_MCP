<!--
  The window itself.

  The window keeps its native Windows frame: title bar, caption buttons, snapping, and the
  rounded corners Windows 11 applies. What the style sets is the ground everything else sits on -
  background, text colour and the two typographic defaults - so that TextBlocks placed anywhere in
  the tree inherit them without needing a style of their own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style x:Key="Ui.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Ui.WindowBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

</ResourceDictionary>
