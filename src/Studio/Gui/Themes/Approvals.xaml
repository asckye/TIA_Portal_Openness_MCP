<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Primer.ApprovalItem" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.TableItem}">
    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}"/>
  </Style>
  <Style x:Key="Primer.ApprovalRing" TargetType="Path">
    <Setter Property="Stroke" Value="{DynamicResource Primer.accent}"/>
    <Style.Triggers><DataTrigger Binding="{Binding CountdownTone}" Value="Warning"><Setter Property="Stroke" Value="{DynamicResource Primer.warn}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.ApprovalConfirm" TargetType="Button" BasedOn="{StaticResource Primer.Answer}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.destructiveText}"/>
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><AccessText Text="{Binding}" Foreground="{DynamicResource Primer.destructiveText}" TextWrapping="Wrap" TextAlignment="Center"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.ApprovalListPane" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style x:Key="Primer.ApprovalDecisionPane" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.bg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
  </Style>
</ResourceDictionary>
