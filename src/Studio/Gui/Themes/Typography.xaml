<!-- Embedded Manrope UI faces and JetBrains Mono values; Windows fonts supply CJK fallback. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <FontFamily x:Key="Ui.Font">/TiaOpenness;component/Fonts/#Manrope, Segoe UI Variable, Microsoft YaHei UI</FontFamily>
  <FontFamily x:Key="Ui.FontMono">/TiaOpenness;component/Fonts/#JetBrains Mono, Consolas</FontFamily>

  <sys:Double x:Key="Ui.FontSize.Caption">11</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Small">11</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Body">12</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Title">17</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading">22</sys:Double>

  <Style x:Key="Ui.Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Ui.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}" />
  </Style>

  <Style x:Key="Ui.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}" />
  </Style>

  <!-- A value rather than prose: paths, versions, counts. -->
  <Style x:Key="Ui.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}" />
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Small}" />
  </Style>

  <!-- The app name in the header. -->
  <Style x:Key="Ui.Text.AppTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Title}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- A pane or row label: bold body text, normally preceded by a Ui.SectionMark. -->
  <Style x:Key="Ui.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- The title of an empty state. -->
  <Style x:Key="Ui.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,10" />
  </Style>

</ResourceDictionary>
