<!--
  The glyphs the theme draws.

  Buttons in this design are text, not icon-plus-text: with a dozen short Chinese labels an icon
  beside each one adds noise without adding meaning, and a mixed set of hand-drawn glyphs is worse
  than none. What is left is the marks that are not labels at all: the tick inside a checkbox, the
  chevrons on pop-up buttons, expanders and scroll bars, the overflow ellipsis, the four Ant Alert
  status marks and the Ant Empty tray.

  All are stroked on a 16x16 grid; keep any addition on the same grid and the same construction.
  Status marks differ in shape (i, !, tick, cross), not only in colour, so they survive high contrast.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <PathGeometry x:Key="Icon.Check" Figures="M3,8.4 L6.4,11.8 L13,4.6" />

  <PathGeometry x:Key="Icon.ChevronDown" Figures="M3.4,6.2 L8,10.4 L12.6,6.2" />
  <PathGeometry x:Key="Icon.ChevronUp" Figures="M3.4,9.8 L8,5.6 L12.6,9.8" />
  <PathGeometry x:Key="Icon.ChevronLeft" Figures="M9.8,3.4 L5.6,8 L9.8,12.6" />
  <PathGeometry x:Key="Icon.ChevronRight" Figures="M6.2,3.4 L10.4,8 L6.2,12.6" />

  <!-- Three short round-capped strokes read as dots at any size. -->
  <PathGeometry x:Key="Icon.Ellipsis" Figures="M3.2,8 L3.8,8 M7.7,8 L8.3,8 M12.2,8 L12.8,8" />

  <!-- Ant Alert marks: info-circle, exclamation-circle, check-circle, close-circle. -->
