<ResourceDictionary xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Primer.DoctorIconTile" TargetType="Border" BasedOn="{StaticResource Primer.ToneChip}">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="Primer.DoctorStatusChip" TargetType="Border" BasedOn="{StaticResource Primer.ToneChip}">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>
  <Style x:Key="Primer.AuditInspector" TargetType="Border" BasedOn="{StaticResource Primer.Inset}">
    <Setter Property="Padding" Value="16,12"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedAudit}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding IsChecked, ElementName=DetailsToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="Pages.AgentTabs">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <views:AgentPagePill Content="{Binding ApprovalsTabLabel}" AutomationProperties.Name="{Binding ApprovalsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnApprovalsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Approvals">
        <views:AgentPagePill.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="M6,1 L11,3 11,7 Q11,10 6,13 Q1,10 1,7 L1,3 Z M3.5,6.5 L5.5,8.5 8.5,5"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.3" Margin="0,0,5,0"/>
              <TextBlock Text="{l:Tr Shell.ApprovalsPill}" VerticalAlignment="Center"/>
              <Border x:Name="ApprovalsCountBadge" Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"
                Tag="{Binding DataContext.Approvals.PendingCount,RelativeSource={RelativeSource AncestorType=RadioButton}}">
                <TextBlock Text="{Binding Tag,RelativeSource={RelativeSource AncestorType=Border}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </DataTemplate>
        </views:AgentPagePill.ContentTemplate>
      </views:AgentPagePill>
      <views:AgentPagePill Content="{Binding CallsTabLabel}" AutomationProperties.Name="{Binding CallsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnCallsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls">
        <views:AgentPagePill.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path Data="M0,7 L3,7 5,2 8,12 10,7 13,7" StrokeThickness="1.3" Margin="0,0,5,0"
                Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
              <TextBlock Text="{l:Tr Shell.CallsPill}" VerticalAlignment="Center"/>
              <Border x:Name="CallsCountBadge" Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"
                Tag="{Binding DataContext.CallStatTotal,RelativeSource={RelativeSource AncestorType=RadioButton}}">
                <TextBlock Text="{Binding Tag,RelativeSource={RelativeSource AncestorType=Border}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </DataTemplate>
        </views:AgentPagePill.ContentTemplate>
      </views:AgentPagePill>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="Primer.PageClientRow" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.ClientRow}">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tile" Style="{StaticResource Primer.ListRow}" Padding="12,2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding DisplayName}" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Style="{StaticResource Primer.Switch}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.cardSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="Primer.PageClientContent">
    <Grid ToolTip="{Binding Tooltip}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ClientName" Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="{DynamicResource Ui.FontSize.Control}"/>
      <TextBlock Grid.Row="1" Style="{StaticResource Primer.DetectionText}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
    </Grid>
  </DataTemplate>
  <Style x:Key="Primer.FeatureCell" TargetType="Border" BasedOn="{StaticResource Primer.Plain}">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style x:Key="Primer.CallButton" TargetType="Button" BasedOn="{StaticResource Primer.TableButton}">
    <Setter Property="Padding" Value="14,10"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.accentSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter Property="BorderThickness" Value="2,0,0,1"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.LogEntryRow" TargetType="Border">
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="MinHeight" Value="{DynamicResource Ui.RowHeight}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Background" Value="{DynamicResource Primer.warnBg}"/></DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Background" Value="{DynamicResource Ant.colorErrorBg}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.PolicySwitchTrack" TargetType="Border">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked,ElementName=ApprovalOn}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.PolicySwitchPosition" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Background="Transparent">
        <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="5,0" HorizontalAlignment="Left" Fill="{DynamicResource Primer.textFaint}" Visibility="Hidden"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Thumb" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="Tag" Value="On">
          <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Primer.onPrimary}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.SettingsNavigation" TargetType="ListBox" BasedOn="{StaticResource Primer.List}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr Settings.Sections}" Style="{StaticResource Primer.Muted}"
          FontWeight="SemiBold" Margin="10,8,0,10"/>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
      </DockPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="Pages.SettingsSectionLabel">
    <DockPanel>
      <Path x:Name="Icon" DockPanel.Dock="Left" Data="{StaticResource Icon.WorkbenchAgent}"
        Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.4" Margin="0,0,8,0" VerticalAlignment="Center"
        Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
      <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
    </DockPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="Appearance">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.WorkbenchSun}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="Service">
        <Setter TargetName="Icon" Property="Data" Value="{StaticResource Icon.WorkbenchProject}"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate x:Key="Pages.ThemePreview">
    <Border Height="76" BorderThickness="1" BorderBrush="{DynamicResource Primer.inputBorder}"
      Background="{DynamicResource Primer.bg}" CornerRadius="5" Padding="3">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Primer.rail}" Padding="3,8">
          <StackPanel>
            <Rectangle Height="6" Fill="{Binding Tag,RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Rectangle Height="5" Fill="{DynamicResource Primer.textMuted}" Margin="0,5"/>
            <Rectangle Height="5" Fill="{DynamicResource Primer.textFaint}"/>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Background="{DynamicResource Primer.sidebar}" Padding="6,10">
          <StackPanel><Rectangle Height="3" Fill="{DynamicResource Primer.textMuted}"/>
            <Rectangle Height="3" Fill="{DynamicResource Primer.inputBorder}" Margin="0,5,6,0"/></StackPanel>
        </Border>
        <Border Grid.Column="2" CornerRadius="3" Margin="5" Background="{DynamicResource Primer.card}" Padding="7">
          <StackPanel>
            <Rectangle Height="4" Width="30" HorizontalAlignment="Left" Fill="{Binding Tag,RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            <Rectangle Height="3" Margin="0,6,12,0" Fill="{DynamicResource Primer.inputBorder}"/>
            <Rectangle Height="3" Margin="0,4,32,0" Fill="{DynamicResource Primer.divider}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </DataTemplate>
</ResourceDictionary>
