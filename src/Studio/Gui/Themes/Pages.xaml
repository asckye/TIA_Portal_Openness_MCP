<ResourceDictionary xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Primer.AuditInspector" TargetType="Border" BasedOn="{StaticResource Primer.Inset}">
    <Setter Property="Padding" Value="16,12"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedAudit}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding IsChecked, ElementName=DetailsToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="Pages.AgentTabs">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <views:AgentPagePill Content="{Binding ApprovalsTabLabel}" AutomationProperties.Name="{Binding ApprovalsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnApprovalsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Approvals"/>
      <views:AgentPagePill Content="{Binding CallsTabLabel}" AutomationProperties.Name="{Binding CallsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnCallsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls"/>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="Primer.PageClientRow" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.ClientRow}">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tile" Style="{StaticResource Primer.ListRow}" Padding="12,2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding DisplayName}" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Style="{StaticResource Primer.Switch}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.cardSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="Primer.PageClientContent">
    <Grid ToolTip="{Binding Tooltip}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ClientName" Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="{DynamicResource Ui.FontSize.Control}"/>
      <TextBlock Grid.Row="1" Style="{StaticResource Primer.DetectionText}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Pages.EnvironmentCheck">
    <DockPanel MinHeight="{DynamicResource Ui.RowHeight}" Margin="8,0">
      <Path DockPanel.Dock="Left" Style="{StaticResource Primer.ToneIcon}" Tag="{Binding Tone}" Margin="0,0,12,0"/>
      <StackPanel>
        <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None"/>
        <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
      </StackPanel>
    </DockPanel>
  </DataTemplate>
  <Style x:Key="Primer.BlkBadge" TargetType="Border" BasedOn="{StaticResource Primer.Tag}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Ui.Radius.XS}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.text}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Kind}" Value="OB">
        <Setter Property="Background" Value="{DynamicResource Primer.blkObBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.blkObFg}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="FB">
        <Setter Property="Background" Value="{DynamicResource Primer.blkFbBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.blkFbFg}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="FC">
        <Setter Property="Background" Value="{DynamicResource Primer.blkFcBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.blkFcFg}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="DB">
        <Setter Property="Background" Value="{DynamicResource Primer.blkDbBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.blkDbFg}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Kind}" Value="F">
        <Setter Property="Background" Value="{DynamicResource Primer.blkFsBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.blkFsFg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.BlkBadgeText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Mono}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}"/>
  </Style>
</ResourceDictionary>
