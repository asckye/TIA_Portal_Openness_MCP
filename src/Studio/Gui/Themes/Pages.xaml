<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Pages.SyncPreview" TargetType="Button" BasedOn="{StaticResource Primer.Run}">
    <Setter Property="Command" Value="{Binding VersionControl.VcPush}"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ToWorkspace}" Value="False"><Setter Property="Command" Value="{Binding VersionControl.VcPull}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Pages.SyncRun" TargetType="Button" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="Command" Value="{Binding VersionControl.VcPush}"/>
    <Style.Triggers><DataTrigger Binding="{Binding IsChecked,ElementName=ToWorkspace}" Value="False"><Setter Property="Command" Value="{Binding VersionControl.VcPull}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Pages.ClientRow" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.ClientRow}">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tile" Style="{StaticResource Primer.ListRow}" Padding="12,2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding DisplayName}" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Style="{StaticResource Primer.Switch}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.cardSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="Pages.ClientContent">
    <Grid ToolTip="{Binding Tooltip}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ClientName" Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="{DynamicResource Ui.FontSize.Control}"/>
      <TextBlock Grid.Row="1" Style="{StaticResource Primer.DetectionText}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="Pages.EnvironmentCheck">
    <DockPanel MinHeight="{DynamicResource Ui.RowHeight}" Margin="8,0">
      <Path DockPanel.Dock="Left" Style="{StaticResource Primer.ToneIcon}" Tag="{Binding Tone}" Margin="0,0,12,0"/>
      <StackPanel>
        <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" TextTrimming="None"/>
        <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
      </StackPanel>
    </DockPanel>
  </DataTemplate>
</ResourceDictionary>
