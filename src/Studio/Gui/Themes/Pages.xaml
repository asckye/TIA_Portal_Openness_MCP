<ResourceDictionary xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Primer.DoctorIconTile" TargetType="Border" BasedOn="{StaticResource Primer.ToneChip}">
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="Primer.DoctorStatusChip" TargetType="Border" BasedOn="{StaticResource Primer.ToneChip}">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Padding" Value="8,0"/>
  </Style>
  <Style x:Key="Primer.AuditInspector" TargetType="Border" BasedOn="{StaticResource Primer.Inset}">
    <Setter Property="Padding" Value="16,12"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding SelectedAudit}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding IsChecked, ElementName=DetailsToggle}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="Pages.AgentTabs">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <views:AgentPagePill Content="{Binding ApprovalsTabLabel}" AutomationProperties.Name="{Binding ApprovalsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnApprovalsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Approvals">
        <views:AgentPagePill.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Shell.ApprovalsPill}" VerticalAlignment="Center"/>
              <Border x:Name="ApprovalsCountBadge" Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"
                Tag="{Binding DataContext.Approvals.PendingCount,RelativeSource={RelativeSource AncestorType=RadioButton}}">
                <TextBlock Text="{Binding Tag,RelativeSource={RelativeSource AncestorType=Border}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </DataTemplate>
        </views:AgentPagePill.ContentTemplate>
      </views:AgentPagePill>
      <views:AgentPagePill Content="{Binding CallsTabLabel}" AutomationProperties.Name="{Binding CallsTabLabel}"
        Style="{StaticResource Primer.IdePill}" IsChecked="{Binding OnCallsPage, Mode=OneWay}"
        Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls">
        <views:AgentPagePill.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{l:Tr Shell.CallsPill}" VerticalAlignment="Center"/>
              <Border x:Name="CallsCountBadge" Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"
                Tag="{Binding DataContext.CallStatTotal,RelativeSource={RelativeSource AncestorType=RadioButton}}">
                <TextBlock Text="{Binding Tag,RelativeSource={RelativeSource AncestorType=Border}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </StackPanel>
          </DataTemplate>
        </views:AgentPagePill.ContentTemplate>
      </views:AgentPagePill>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="Primer.PageClientRow" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.ClientRow}">
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tile" Style="{StaticResource Primer.ListRow}" Padding="12,2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center"/>
              <ToggleButton Grid.Column="1" AutomationProperties.Name="{Binding DisplayName}" IsChecked="{Binding IsSelected,RelativeSource={RelativeSource TemplatedParent},Mode=OneWay}" Style="{StaticResource Primer.Switch}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.cardSel}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <DataTemplate x:Key="Primer.PageClientContent">
    <Grid ToolTip="{Binding Tooltip}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock x:Name="ClientName" Text="{Binding DisplayName}" TextWrapping="Wrap" TextTrimming="None" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="{DynamicResource Ui.FontSize.Control}"/>
      <TextBlock Grid.Row="1" Style="{StaticResource Primer.DetectionText}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
    </Grid>
  </DataTemplate>
  <Style x:Key="Primer.FeatureCell" TargetType="Border" BasedOn="{StaticResource Primer.Plain}">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Padding" Value="16,10"/>
  </Style>
  <Style x:Key="Primer.JournalTableItem" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.TableItem}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="ux:ContrastSelection.Active" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Primer.accentSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.AuditTableItem" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.JournalTableItem}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding Selected}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Ant.colorErrorBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolid}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.CallButton" TargetType="Button" BasedOn="{StaticResource Primer.TableButton}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="14,10"/>
  </Style>
  <Style x:Key="Primer.LogEntryRow" TargetType="Border">
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="MinHeight" Value="{DynamicResource Ui.RowHeight}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="Primer.PolicySwitchTrack" TargetType="Border">
    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked,ElementName=ApprovalOn}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.PolicySwitchPosition" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Background="Transparent">
        <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="5,0" HorizontalAlignment="Left" Fill="{DynamicResource Primer.textFaint}" Visibility="Hidden"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Thumb" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="Tag" Value="On">
          <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Primer.onPrimary}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter Property="IsHitTestVisible" Value="False"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.SettingsNavigation" TargetType="ListBox" BasedOn="{StaticResource Primer.List}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{l:Tr Settings.Sections}" Style="{StaticResource Primer.Muted}"
          FontWeight="SemiBold" Margin="10,8,0,10"/>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
      </DockPanel>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="Pages.SettingsSectionLabel">
    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
  </DataTemplate>
  <Style x:Key="Primer.AuditVerificationResult" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.okBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Style.Triggers><DataTrigger Binding="{Binding VerificationBroken}" Value="True">
      <Setter Property="Background" Value="{DynamicResource Ant.colorErrorBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorErrorBorder}"/>
    </DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.AuditProgressBand" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.sidebar}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="Primer.DoctorRow" TargetType="ListBoxItem" BasedOn="{StaticResource Primer.TableItem}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <ContentPresenter HorizontalAlignment="Stretch"/>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
    <Setter Property="ToolTip" Value="{Binding Detail}"/>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="ux:ContrastSelection.Active" Value="False"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.DoctorRowSurface" TargetType="Border">
    <Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True">
      <Setter Property="Background" Value="{DynamicResource Ant.colorErrorBg}"/>
    </DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="Pages.DisclosureHeading">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Margin="0,0,5,0" VerticalAlignment="Center">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
            <Setter Property="Text" Value="▸"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True">
                <Setter Property="Text" Value="▾"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Text="{Binding}" Style="{StaticResource Primer.Muted}" FontWeight="Medium" VerticalAlignment="Center"/>
    </StackPanel>
  </DataTemplate>
  <Style x:Key="Primer.DoctorEvidence" TargetType="Expander" BasedOn="{StaticResource Primer.Expander}">
    <Setter Property="HeaderTemplate" Value="{StaticResource Pages.DisclosureHeading}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
              AutomationProperties.Name="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
              FocusVisualStyle="{StaticResource Primer.Focus}" HorizontalAlignment="Left" Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="LinkSurface" Background="Transparent" Padding="0,2">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="LinkSurface" Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Manual" Visibility="Collapsed" Margin="0,4,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Manual" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Warning}" Value="True"/>
        <Condition Binding="{Binding ShowManual}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
      <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
        <Condition Binding="{Binding ShowManual}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.DoctorFailedGroup" TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentAttentionCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style>
  <Style x:Key="Primer.DoctorPendingGroup" TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentPendingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style>
  <Style x:Key="Primer.DoctorPassedGroup" TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding EnvironmentPassedCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
              </Style.Triggers></Style>
  <Style x:Key="Primer.DoctorFailureIcon" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Ant.colorErrorSolid}"/>
    <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="Primer.DoctorIssueGroup" TargetType="Border" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorErrorBorder}"/>
  </Style>
  <Style x:Key="Primer.SettingsSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}"><Style.Triggers>
              <Trigger Property="ux:Ux.Narrow" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
            </Style.Triggers></Style>
  <Style x:Key="Primer.SafetyReview" TargetType="Button" BasedOn="{StaticResource Primer.Button.Primary.Small}"><Style.Triggers>
                    <DataTrigger Binding="{Binding Visibility, ElementName=SaveTargetChanges}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers></Style>
  <Style x:Key="Primer.StorageRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="20,12"/>
  </Style>
  <Style x:Key="Primer.SettingsDivider" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.divider}"/>
  </Style>
  <Style x:Key="Primer.ProductIcon" TargetType="Border">
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
  </Style>
  <Style x:Key="Primer.ActionDialog" TargetType="Border" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="CornerRadius" Value="14"/>
  </Style>
  <Style x:Key="Primer.ActionDialogIcon" TargetType="Border" BasedOn="{StaticResource Primer.Tag.Accent}">
    <Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="Primer.LogLevelToken" TargetType="TextBlock" BasedOn="{StaticResource Primer.LogLevelText}">
    <Setter Property="Text" Value="—"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static ux:LogLevel.Info}">
        <Setter Property="Text" Value="INFO"/><Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static ux:LogLevel.Warning}"><Setter Property="Text" Value="WARN"/></DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static ux:LogLevel.Error}"><Setter Property="Text" Value="ERROR"/></DataTrigger>
      <DataTrigger Binding="{Binding Level}" Value="{x:Static ux:LogLevel.Debug}"><Setter Property="Text" Value="DEBUG"/></DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
