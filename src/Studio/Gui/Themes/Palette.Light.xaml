<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Ant Design v5 default algorithm, mapped onto the workbench vocabulary.

    The Primer.* names are kept so pages, code and tests keep resolving; each one now carries the
    Ant map/alias token named beside it. WCAG 2.2 AA overrides Ant where they disagree: text that
    must reach 4.5:1 uses the next darker palette step (blue-7 for primary text and the primary
    button, gold-9 for warning text, green-8 for success text), and component boundaries that must
    reach 3:1 use gray-7 instead of colorBorder.
  -->
  <!-- colorBgLayout -->
  <SolidColorBrush x:Key="Primer.bg" Color="#F5F5F5"/>
  <!-- colorBgContainer -->
  <SolidColorBrush x:Key="Primer.card" Color="#FFFFFF"/>
  <!-- colorFillAlter over colorBgContainer (table header, card footer) -->
  <SolidColorBrush x:Key="Primer.cardSoft" Color="#FAFAFA"/>
  <!-- controlItemBgActive -->
  <SolidColorBrush x:Key="Primer.cardSel" Color="#E6F4FF"/>
  <!-- colorBorderSecondary -->
  <SolidColorBrush x:Key="Primer.cardBorder" Color="#F0F0F0"/>
  <!-- colorSplit -->
  <SolidColorBrush x:Key="Primer.divider" Color="#0F050505"/>
  <!-- colorBgContainer -->
  <SolidColorBrush x:Key="Primer.input" Color="#FFFFFF"/>
  <!-- gray-7: colorBorder #D9D9D9 is 1.4:1, a field boundary needs 3:1 -->
  <SolidColorBrush x:Key="Primer.inputBorder" Color="#8C8C8C"/>
  <!-- Button defaultBg = colorBgContainer -->
  <SolidColorBrush x:Key="Primer.pill" Color="#FFFFFF"/>
  <!-- controlItemBgHover (rgba(0,0,0,0.04)) flattened onto colorBgContainer -->
  <SolidColorBrush x:Key="Primer.pillHover" Color="#F5F5F5"/>
  <!-- colorBgElevated -->
  <SolidColorBrush x:Key="Primer.menuBg" Color="#FFFFFF"/>
  <!-- colorText -->
  <SolidColorBrush x:Key="Primer.text" Color="#E0000000"/>
  <!-- colorTextSecondary -->
  <SolidColorBrush x:Key="Primer.textMuted" Color="#A6000000"/>
  <!-- colorTextSecondary: colorTextTertiary (0.45) is 3.4:1 -->
  <SolidColorBrush x:Key="Primer.textFaint" Color="#A6000000"/>
  <!-- gray-7, as inputBorder -->
  <SolidColorBrush x:Key="Primer.checkBorder" Color="#8C8C8C"/>
  <!-- blue-7 (colorPrimaryActive): colorPrimary #1677FF is 4.1:1 as text -->
  <SolidColorBrush x:Key="Primer.accent" Color="#0958D9"/>
  <!-- colorTextLightSolid -->
  <SolidColorBrush x:Key="Primer.onAccent" Color="#FFFFFF"/>
  <!-- primary button background: blue-7, white text 6.2:1 -->
  <SolidColorBrush x:Key="Primer.primaryBg" Color="#0958D9"/>
  <!-- gold-9: colorWarningText #FAAD14 is 1.9:1 -->
  <SolidColorBrush x:Key="Primer.warn" Color="#874D00"/>
  <!-- colorWarningBg -->
  <SolidColorBrush x:Key="Primer.warnBg" Color="#FFFBE6"/>
  <!-- green-8: colorSuccessText #52C41A is 2.3:1 -->
  <SolidColorBrush x:Key="Primer.ok" Color="#237804"/>
  <!-- colorSuccessBg -->
  <SolidColorBrush x:Key="Primer.okBg" Color="#F6FFED"/>
  <!-- colorInfoBg -->
  <SolidColorBrush x:Key="Primer.noteBg" Color="#E6F4FF"/>
  <!-- colorInfoBorder -->
  <SolidColorBrush x:Key="Primer.noteBorder" Color="#91CAFF"/>
  <!-- blue-7, as accent -->
  <SolidColorBrush x:Key="Primer.noteAccent" Color="#0958D9"/>
  <!-- Typography code background rgba(150,150,150,0.1) flattened onto colorBgContainer -->
  <SolidColorBrush x:Key="Primer.codeBg" Color="#F5F5F5"/>
  <!-- colorText -->
  <SolidColorBrush x:Key="Primer.codeText" Color="#E0000000"/>
  <!-- green-8, as ok -->
  <SolidColorBrush x:Key="Primer.diffGreen" Color="#237804"/>
  <!-- red-7: colorErrorText #FF4D4F is 3.3:1 -->
  <SolidColorBrush x:Key="Primer.diffRed" Color="#CF1322"/>
  <!-- colorTextLightSolid on the primary and danger buttons -->
  <SolidColorBrush x:Key="Primer.primaryText" Color="#FFFFFF"/>
  <!-- text on a solid warn surface -->
  <SolidColorBrush x:Key="Primer.warningText" Color="#FFFFFF"/>
  <!-- colorWarningBg: the pending-approval badge shares the warning surface -->
  <SolidColorBrush x:Key="Primer.countWarningBg" Color="#FFFBE6"/>
  <!-- keyboard focus ring: colorPrimary (4.1:1 on colorBgContainer, 3.8:1 on colorBgLayout) -->
  <SolidColorBrush x:Key="Primer.focusOuter" Color="#1677FF"/>
  <SolidColorBrush x:Key="Primer.focusInner" Color="#FFFFFF"/>
  <!-- colorText -->
  <SolidColorBrush x:Key="Primer.selectedText" Color="#E0000000"/>
  <SolidColorBrush x:Key="Primer.hoverText" Color="#E0000000"/>

  <!-- Ant tokens without a Primer counterpart. -->
  <!-- colorPrimary: graphics only (borders, ink bar, check fill, progress); 3:1 is enough there -->
  <SolidColorBrush x:Key="Ant.colorPrimary" Color="#1677FF"/>
  <!-- solid primary hover/active: blue-8/blue-9, because colorPrimaryHover #4096FF fails white text -->
  <SolidColorBrush x:Key="Ant.colorPrimaryHover" Color="#003EB3"/>
  <SolidColorBrush x:Key="Ant.colorPrimaryActive" Color="#002C8C"/>
  <!-- colorLinkHover, darkened to blue-8 so hovered link and button text keep 4.5:1 -->
  <SolidColorBrush x:Key="Ant.colorLinkHover" Color="#003EB3"/>
  <!-- controlItemBgActiveHover -->
  <SolidColorBrush x:Key="Ant.controlItemBgActiveHover" Color="#BAE0FF"/>
  <!-- colorWhite: glyphs drawn on colorPrimary (check mark, switch handle) -->
  <SolidColorBrush x:Key="Ant.colorWhite" Color="#FFFFFF"/>
  <!-- colorBorder: default button, dashed button and tag outline -->
  <SolidColorBrush x:Key="Ant.colorBorder" Color="#D9D9D9"/>
  <!-- colorErrorActive: error outline and danger text (4.6:1) -->
  <SolidColorBrush x:Key="Ant.colorError" Color="#D9363E"/>
  <SolidColorBrush x:Key="Ant.colorErrorBg" Color="#FFF2F0"/>
  <SolidColorBrush x:Key="Ant.colorErrorBorder" Color="#FFCCC7"/>
  <!-- solid danger button: colorErrorActive, red-7 and red-8 keep white text above 4.5:1 -->
  <SolidColorBrush x:Key="Ant.colorErrorSolid" Color="#D9363E"/>
  <SolidColorBrush x:Key="Ant.colorErrorSolidHover" Color="#CF1322"/>
  <SolidColorBrush x:Key="Ant.colorErrorSolidActive" Color="#A8071A"/>
  <SolidColorBrush x:Key="Ant.colorWarningBorder" Color="#FFE58F"/>
  <SolidColorBrush x:Key="Ant.colorSuccessBorder" Color="#B7EB8F"/>
  <!-- colorFillSecondary: progress rail, segmented hover, count badge -->
  <SolidColorBrush x:Key="Ant.colorFillSecondary" Color="#0F000000"/>
  <SolidColorBrush x:Key="Ant.colorBgContainerDisabled" Color="#0A000000"/>
  <SolidColorBrush x:Key="Ant.colorTextDisabled" Color="#40000000"/>
  <SolidColorBrush x:Key="Ant.colorBgMask" Color="#73000000"/>
  <!-- colorBgSpotlight / colorTextLightSolid: tooltip -->
  <SolidColorBrush x:Key="Ant.colorBgSpotlight" Color="#D9000000"/>
  <SolidColorBrush x:Key="Ant.colorTextLightSolid" Color="#FFFFFF"/>
  <!-- boxShadowSecondary layers: 0 3px 6px -4px 0.12, 0 6px 16px 0 0.08, 0 9px 28px 8px 0.05 -->
  <SolidColorBrush x:Key="Ant.boxShadowKey" Color="#1F000000"/>
  <SolidColorBrush x:Key="Ant.boxShadowUmbra" Color="#14000000"/>
  <SolidColorBrush x:Key="Ant.boxShadowAmbient" Color="#0D000000"/>
</ResourceDictionary>
