      <DataTrigger Binding="{Binding Visible}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding IsActive}" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsVersionControl}" Value="True">
        <Setter Property="AutomationProperties.Name" Value="{l:Tr Shell.VersionControl}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
