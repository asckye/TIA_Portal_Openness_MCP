  <Style x:Key="Project.TreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="AlternationCount" Value="2147483647"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="TreeViewItem">
        <StackPanel>
          <Grid>
            <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" MinHeight="28"
              Padding="{TemplateBinding Padding}">
              <DockPanel>
                <ToggleButton x:Name="Switcher" Width="10" Height="16" Margin="0,0,6,0" Focusable="False" ClickMode="Press"
                  IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
                  AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                      <Path x:Name="Arrow" Data="{StaticResource Icon.ChevronRight}" Stroke="{DynamicResource Primer.textFaint}"
                        Stretch="Uniform" Width="{TemplateBinding Width}" Height="{TemplateBinding Width}"/>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="Data" Value="{StaticResource Icon.ChevronDown}"/>
                    </Trigger></ControlTemplate.Triggers>
                  </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Border x:Name="Outline" CornerRadius="7" IsHitTestVisible="False"
              BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          </Grid>
          <Border x:Name="Branch" Margin="11,2,0,0" Padding="9,0,0,0" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Primer.cardBorder}"
            Visibility="Collapsed"><ItemsPresenter/></Border>
        </StackPanel>
        <ControlTemplate.Triggers>
          <Trigger Property="Tag" Value="Device">
            <Setter TargetName="Branch" Property="Margin" Value="11,4,0,0"/>
            <Setter TargetName="Switcher" Property="Width" Value="11"/>
          </Trigger>
          <Trigger Property="ux:Ux.Narrow" Value="True">
            <Setter TargetName="Branch" Property="Margin" Value="4,2,0,0"/>
            <Setter TargetName="Branch" Property="Padding" Value="2,0,0,0"/>
          </Trigger>
          <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Branch" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="HasItems" Value="False">
            <Setter TargetName="Switcher" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="Branch" Property="Visibility" Value="Collapsed"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
            <Setter TargetName="Outline" Property="BorderThickness" Value="1"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="ItemsControl.AlternationIndex" Value="0"><Setter Property="Margin" Value="0"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.ProjectNode" TargetType="TreeViewItem" BasedOn="{StaticResource Project.TreeItem}">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded,Mode=TwoWay}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Padding" Value="6,0"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Project.DeviceItem" TargetType="TreeViewItem" BasedOn="{StaticResource Primer.ProjectNode}">
    <Setter Property="Tag" Value="Device"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Margin" Value="0,6,0,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Caption}" Value=""><Setter Property="Padding" Value="8,0"/></DataTrigger>
      <DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource Primer.accentSoft}"/></DataTrigger>
      <DataTrigger Binding="{Binding MatchesFilter}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.ProjectLinkNode" TargetType="TreeViewItem" BasedOn="{StaticResource Project.TreeItem}">
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="AutomationProperties.Name" Value="{l:Tr Project.Tags}"/>
