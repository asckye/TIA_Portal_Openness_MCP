  <Style x:Key="Primer.ProjectBlockChoice" TargetType="CheckBox">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid x:Name="Choice" Background="Transparent">
        <Border x:Name="Row" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent"/>
        <ContentPresenter Margin="{TemplateBinding Padding}"/>
        <Border x:Name="ActiveBar" Width="3" Height="16" Margin="3,0,0,0" HorizontalAlignment="Left"
          Style="{StaticResource Primer.ProjectActiveBar}" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource Primer.card}"/>
          <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
        </DataTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Choice" Property="Opacity" Value="0.55"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="Padding" Value="12,6,8,6"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsFolder}" Value="True"><Setter Property="Padding" Value="0"/></DataTrigger>
    </Style.Triggers>
