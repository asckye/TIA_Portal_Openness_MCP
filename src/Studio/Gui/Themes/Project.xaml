  <Style x:Key="Project.LadderContact" TargetType="Path">
    <Setter Property="Width" Value="50"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="StrokeThickness" Value="2.2"/>
    <Setter Property="Data" Value="M0,15 H15 M15,1 V29 M35,1 V29 M35,15 H50"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Symbol}" Value="┤/├">
        <Setter Property="Data" Value="M0,15 H15 M15,1 V29 M35,1 V29 M35,15 H50 M18,27 L32,3"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsCoil}" Value="True">
        <Setter Property="Data" Value="M0,15 H5 M13,1 C3,9 3,21 13,29 M37,1 C47,9 47,21 37,29 M45,15 H50"/>
