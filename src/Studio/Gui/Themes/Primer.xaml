    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
  </Style>
  <!-- type="text", size="small". -->
  <Style x:Key="Primer.Quiet" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="ux:Ux.Variant" Value="Text"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight.Small}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <!-- Icon-only text button: colorIcon glyph (secondary text strength for 3:1). -->
  <Style x:Key="Primer.CaptionButton" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style x:Key="Primer.IconButton" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
  </Style>
  <Style x:Key="Primer.Dashed" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="ux:Ux.Variant" Value="Dashed"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="Primer.Link" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="ux:Ux.Variant" Value="Link"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
  </Style>
  <!-- danger (outlined): colorErrorActive text and outline. -->
  <Style x:Key="Primer.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="ux:Ux.Variant" Value="Danger"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorError}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ant.colorError}"/>
  </Style>
  <Style x:Key="Primer.Small" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight.Small}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
  </Style>
  <Style x:Key="Primer.Large" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight.Large}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Large}"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Large}"/>
  </Style>
  <Style x:Key="Primer.Run.Small" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Run}">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight.Small}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
  </Style>
  <Style x:Key="Primer.Run.Large" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Run}">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight.Large}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Large}"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Large}"/>
  </Style>

  <!--
    Ant Input: controlHeight, colorBgContainer, a 3:1 outline (gray-7) and the colorPrimary focus
    border. The 2px "FocusRing" stands in for Ant's 2px controlOutline halo, which at 10% alpha
    would not be a visible focus indicator.
  -->
  <ControlTemplate x:Key="Primer.ValidationNone">
    <AdornedElementPlaceholder/>
  </ControlTemplate>
  <Style x:Key="Primer.Input" TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primer.text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="SelectionTextBrush" Value="{DynamicResource Primer.onAccent}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Primer.ValidationNone}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Field" CornerRadius="{StaticResource Ui.Radius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Primer.textFaint}" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Border x:Name="FocusRing" CornerRadius="{StaticResource Ui.Radius}" BorderThickness="2" BorderBrush="{DynamicResource Ant.colorPrimary}" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorError}"/>
              <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Ant.colorError}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The shared chevron of a pop-up button: Icons.xaml's 16px grid, drawn at 12px. -->
  <Style x:Key="Primer.Chevron" TargetType="Path">
    <Setter Property="Data" Value="{DynamicResource Icon.ChevronDown}"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- A glyph from Icons.xaml drawn at 14px in the secondary text colour. -->
  <Style x:Key="Primer.Icon" TargetType="Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- A glyph inside a button: it takes the button's text colour, so hover and disabled follow. -->
  <Style x:Key="Primer.ButtonIcon" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Stroke" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ButtonBase}}"/>
  </Style>
  <Style x:Key="Primer.ButtonIcon.Ellipsis" TargetType="Path" BasedOn="{StaticResource Primer.ButtonIcon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Ellipsis}"/>
    <Setter Property="StrokeThickness" Value="2.2"/>
  </Style>
  <!-- Ant Alert icons: the status colour that already meets 4.5:1, and a distinct shape per status. -->
  <Style x:Key="Primer.AlertIcon.Info" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Info}"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.noteAccent}"/>
  </Style>
  <Style x:Key="Primer.AlertIcon.Success" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Success}"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.ok}"/>
  </Style>
  <Style x:Key="Primer.AlertIcon.Warning" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Warning}"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.warn}"/>
  </Style>
  <Style x:Key="Primer.AlertIcon.Error" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Error}"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.diffRed}"/>
  </Style>
  <!-- List status icon: the Alert mark for a FeatureTone in Tag; a minus circle for checks that did not run. -->
  <Style x:Key="Primer.ToneIcon" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Data" Value="{DynamicResource Icon.Minus}"/>
    <Setter Property="Stroke" Value="{DynamicResource Primer.textMuted}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Success}">
        <Setter Property="Data" Value="{DynamicResource Icon.Success}"/>
        <Setter Property="Stroke" Value="{DynamicResource Primer.ok}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}">
        <Setter Property="Data" Value="{DynamicResource Icon.Warning}"/>
        <Setter Property="Stroke" Value="{DynamicResource Primer.warn}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Accent}">
        <Setter Property="Data" Value="{DynamicResource Icon.Info}"/>
        <Setter Property="Stroke" Value="{DynamicResource Primer.noteAccent}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!--
    Ant Empty (simple image): a decorative colorBorder tray above a description in secondary text
    (Ant's colorTextDescription is 45% black, 3.4:1, so the description uses the 65% token).
    Use as <ContentControl Style="{StaticResource Primer.Empty}" Content="..."/>.
  -->
  <Style x:Key="Primer.EmptyImage" TargetType="Path" BasedOn="{StaticResource Primer.Icon}">
    <Setter Property="Data" Value="{DynamicResource Icon.Empty}"/>
    <Setter Property="Width" Value="64"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="StrokeThickness" Value="1"/>
    <Setter Property="Stroke" Value="{DynamicResource Ant.colorBorder}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Primer.EmptyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}"/>
    <Setter Property="LineHeight" Value="{StaticResource Ui.LineHeight}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="TextTrimming" Value="None"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <DataTemplate x:Key="Primer.EmptyContent">
    <TextBlock Text="{Binding}" Style="{StaticResource Primer.EmptyText}"/>
  </DataTemplate>
  <Style x:Key="Primer.Empty" TargetType="ContentControl">
    <Setter Property="ContentTemplate" Value="{StaticResource Primer.EmptyContent}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <StackPanel>
            <Path Style="{StaticResource Primer.EmptyImage}" Margin="0,0,0,8"/>
            <ContentPresenter HorizontalAlignment="Center"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Ant Select: the Input field, a chevron, and an elevated option list 4px below. -->
  <Style x:Key="Primer.Select" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Field" CornerRadius="{StaticResource Ui.Radius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
            <ToggleButton AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent},TargetNullValue=''}" FocusVisualStyle="{StaticResource Primer.Focus}" Focusable="False" Tag="{TemplateBinding Tag}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Path x:Name="Chevron" Style="{StaticResource Primer.Chevron}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Border x:Name="FocusRing" CornerRadius="{StaticResource Ui.Radius}" BorderThickness="2" BorderBrush="{DynamicResource Ant.colorPrimary}" Visibility="Collapsed" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="4" HorizontalOffset="-8" AllowsTransparency="True" Focusable="False" PopupAnimation="{StaticResource Primer.PopupAnimation}">
              <ContentControl Style="{StaticResource Primer.Elevated}" Margin="8,0,8,14" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="256">
                  <ItemsPresenter/>
                </ScrollViewer>
              </ContentControl>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
              <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Ant Checkbox: 16px, borderRadiusSM, colorPrimary fill with a colorWhite tick. -->
  <Style x:Key="Primer.Checkbox" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Border x:Name="Mark" BorderThickness="1" BorderBrush="{DynamicResource Primer.checkBorder}" Background="{DynamicResource Primer.input}" CornerRadius="{StaticResource Ui.Radius.Small}"/>
              <Path x:Name="CheckMark" Data="{DynamicResource Icon.Check}" Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource Ant.colorWhite}" StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed"/>
              <Border x:Name="Partial" Width="8" Height="8" Background="{DynamicResource Ant.colorPrimary}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Ant.colorPrimary}"/>
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="Partial" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
              <Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Partial" Property="Background" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Ant Radio: 16px circle, colorPrimary fill with an 8px colorWhite dot when checked. -->
  <Style x:Key="Primer.Radio" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="16" Height="16" VerticalAlignment="Center">
              <Ellipse x:Name="Ring" StrokeThickness="1" Stroke="{DynamicResource Primer.checkBorder}" Fill="{DynamicResource Primer.input}"/>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Ant.colorWhite}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Ant.colorPrimary}"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ant.colorBorder}"/>
              <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Ant List: the stock template paints a fixed white ground when disabled, which shows through behind a modal in dark. -->
  <Style x:Key="Primer.List" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!--
    Ant Table row: colorSplit rule, rowHoverBg (colorFillAlter) and rowSelectedBg
    (controlItemBgActive). The 3px colorPrimary bar keeps the selected row identifiable
    without relying on the 1.1:1 tint alone.
  -->
  <Style x:Key="Primer.TableItem" TargetType="ListBoxItem">
    <Setter Property="AutomationProperties.Name"><Setter.Value>
      <MultiBinding Converter="{StaticResource Primer.AccessibleName}">
        <Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
      </MultiBinding>
    </Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="12,0" MinHeight="36" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter/>
            </Border>
            <Border x:Name="SelectionBar" Width="3" HorizontalAlignment="Left" Background="{DynamicResource Ant.colorPrimary}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Primer.cardSel}"/>
      </Trigger>

      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
          <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="ux:ContrastSelection.Active" Value="True"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <!-- A borderless Select used as an inline preference picker. -->
