  <!--
    Ant Switch: 44x22 track, 18px colorWhite handle. Off uses the 3:1 boundary grey (Ant's
    colorTextQuaternary track is 1.8:1); on uses colorPrimary.
  -->
  <Style x:Key="Primer.Switch" TargetType="ToggleButton" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Background" Value="{DynamicResource Primer.checkBorder}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <StackPanel Orientation="Horizontal" Background="Transparent">
        <Border x:Name="Track" Width="44" Height="22" CornerRadius="11" Background="{TemplateBinding Background}" VerticalAlignment="Center">
          <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource Ant.colorWhite}" HorizontalAlignment="Left" Margin="2,0"/>
        </Border>
        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
          <Setter TargetName="Track" Property="Background" Value="{DynamicResource Ant.colorPrimary}"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
          <Setter TargetName="Track" Property="Opacity" Value="0.65"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <!--
    Scroll bars keep 24px hit targets and line buttons; the thumb is the thin rounded Ant handle
    in the 3:1 boundary grey, on a transparent track.
  -->
  <Style TargetType="RepeatButton">
    <Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource Primer.ScrollCommandName}">
      <Binding Path="Command" RelativeSource="{RelativeSource Self}"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
    </MultiBinding></Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>

  <Style x:Key="Primer.ScrollButton" TargetType="RepeatButton" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource Primer.ScrollCommandName}"><Binding Path="Command" RelativeSource="{RelativeSource Self}"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/></MultiBinding></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.ScrollArrow" TargetType="Path" BasedOn="{StaticResource Primer.ButtonIcon}">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Height" Value="10"/>
  </Style>
  <Style x:Key="Primer.ScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24"/><Setter Property="MinWidth" Value="24"/>
    <Setter Property="AutomationProperties.Name" Value="{l:Tr Access.ScrollPosition}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border x:Name="Handle" Margin="7" CornerRadius="5" Background="{DynamicResource Primer.inputBorder}"/>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Primer.textMuted}"/>
        </Trigger>
        <Trigger Property="IsDragging" Value="True">
          <Setter TargetName="Handle" Property="Background" Value="{DynamicResource Primer.textMuted}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="Primer.VerticalScroll" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Style="{StaticResource Primer.ScrollButton}"><Path Style="{StaticResource Primer.ScrollArrow}" Data="{DynamicResource Icon.ChevronUp}"/></RepeatButton>
      <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource Primer.ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Style="{StaticResource Primer.ScrollButton}"><Path Style="{StaticResource Primer.ScrollArrow}" Data="{DynamicResource Icon.ChevronDown}"/></RepeatButton>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="Primer.HorizontalScroll" TargetType="ScrollBar">
    <Grid Background="Transparent">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Style="{StaticResource Primer.ScrollButton}"><Path Style="{StaticResource Primer.ScrollArrow}" Data="{DynamicResource Icon.ChevronLeft}"/></RepeatButton>
      <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource Primer.ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}" Style="{StaticResource Primer.ScrollButton}"><Path Style="{StaticResource Primer.ScrollArrow}" Data="{DynamicResource Icon.ChevronRight}"/></RepeatButton>
    </Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template" Value="{StaticResource Primer.VerticalScroll}"/>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="24"/>
      <Setter Property="Template" Value="{StaticResource Primer.HorizontalScroll}"/>
    </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.ContextToggle" TargetType="ToggleButton" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>

  <!--
    Ant layout: a collapsible Sider with a grouped inline Menu, a Header with breadcrumb, status and
    icon actions, and a PageHead at the top of every page.
  -->
  <Style x:Key="Primer.Sider" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <!-- Menu item group title: colorTextDescription, shown only when the Sider is expanded. -->
  <Style x:Key="Primer.MenuGroup" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="Margin" Value="20,16,12,6"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Compact" Value="True">
        <Setter Property="Visibility" Value="Collapsed"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!--
    Inline Menu item: 40px, borderRadiusLG, controlItemBgHover on hover, controlItemBgActive with the
    primary text colour when selected. A 3px colorPrimary bar marks the selected item without colour
    alone. In the collapsed Sider only the icon remains.
  -->
  <Style x:Key="Primer.NavItem" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="Padding" Value="16,0,12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Ui.Radius.Large}"/>
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="{StaticResource Ui.Radius.XS}" Background="{DynamicResource Ant.colorPrimary}" Visibility="Hidden"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Path x:Name="Glyph" Style="{StaticResource Primer.Icon}" Data="{TemplateBinding ux:Ux.Icon}" Stroke="{TemplateBinding Foreground}" Margin="0,0,10,0"/>
              <ContentPresenter x:Name="Label" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.cardSel}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
            <Trigger Property="ux:Ux.Compact" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Glyph" Property="Margin" Value="0"/>
              <Setter TargetName="Glyph" Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="Padding" Value="0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- An inline Menu entry that opens a drawer instead of a page (the shared button template, text type). -->
  <DataTemplate x:Key="Primer.MenuButtonContent">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Path x:Name="Glyph" Style="{StaticResource Primer.ButtonIcon}" Width="14" Height="14" Margin="0,0,10,0" Data="{Binding Path=(ux:Ux.Icon),RelativeSource={RelativeSource AncestorType=Button}}"/>
      <AccessText x:Name="Label" Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Path=(ux:Ux.Compact),RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
        <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="Glyph" Property="Margin" Value="0"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
  <Style x:Key="Primer.MenuButton" TargetType="Button" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Large}"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Margin" Value="4,2"/>
    <Setter Property="Padding" Value="16,0,12,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="ContentTemplate" Value="{StaticResource Primer.MenuButtonContent}"/>
    <Setter Property="ToolTip" Value="{Binding Content,RelativeSource={RelativeSource Self}}"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Compact" Value="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- The same entry while its drawer is open: the selected menu item. -->
  <Style x:Key="Primer.MenuButton.Selected" TargetType="Button" BasedOn="{StaticResource Primer.MenuButton}">
    <Setter Property="Background" Value="{DynamicResource Primer.cardSel}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
  </Style>
  <!-- Header icon action: the text stays the content (and tooltip and name); the template draws ux:Ux.Icon. -->
  <DataTemplate x:Key="Primer.HeaderIconContent">
    <Path Style="{StaticResource Primer.ButtonIcon}" Width="16" Height="16" Data="{Binding Path=(ux:Ux.Icon),RelativeSource={RelativeSource AncestorType=Button}}"/>
  </DataTemplate>
  <Style x:Key="Primer.HeaderIconButton" TargetType="Button" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ContentTemplate" Value="{StaticResource Primer.HeaderIconContent}"/>
    <Setter Property="ToolTip" Value="{Binding Content,RelativeSource={RelativeSource Self}}"/>
  </Style>
  <!-- Breadcrumb: parent items in secondary text, the current page in colorText. -->
  <Style x:Key="Primer.Breadcrumb" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
  </Style>
  <!-- PageHeader: a level-4 title with tags, a secondary subtitle, actions on the right, 16px below. -->
  <!-- Ant Card head (small size): 38px, divider below; the card keeps its own outline. -->
  <Style x:Key="Primer.CardHead" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
  <Style x:Key="Primer.PageHead" TargetType="Border">
    <Setter Property="Margin" Value="0,0,0,16"/>
  </Style>
  <Style x:Key="Primer.PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
  </Style>
  <Style x:Key="Primer.PageSubtitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <!-- Statistic: secondary title above a 24px value. -->
  <Style x:Key="Primer.StatisticTitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
  </Style>
  <Style x:Key="Primer.StatisticValue" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Heading}"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
  </Style>
  <Style x:Key="Primer.StatisticValue.warn" TargetType="TextBlock" BasedOn="{StaticResource Primer.StatisticValue}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.warn}"/>
  </Style>
  <Style x:Key="Primer.StatisticValue.danger" TargetType="TextBlock" BasedOn="{StaticResource Primer.StatisticValue}">
    <Setter Property="Foreground" Value="{DynamicResource Primer.diffRed}"/>
  </Style>
  <!-- Steps: a 24px numbered circle, primary when reached. -->
  <Style x:Key="Primer.StepIcon" TargetType="Border">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="Done">
        <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.accent}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Current">
        <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.primaryBg}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.primaryText}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.StepTail" TargetType="Border">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="12,0"/>
    <Setter Property="Background" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- Table consistency badge dot. -->
  <Style x:Key="Primer.ConsistencyDot" TargetType="Ellipse">
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Fill" Value="{DynamicResource Primer.ok}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Info.IsConsistent}" Value="False">
        <Setter Property="Fill" Value="{DynamicResource Primer.warn}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!--
    boxShadowSecondary behind an in-window drawer, dialog or notification: a sibling placed with the
    same size and alignment as the panel it shades. High contrast drops it.
  -->
  <Style x:Key="Primer.Shadow" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid x:Name="Shadows">
            <Border Margin="-8,-2,-8,-14" CornerRadius="16" Background="{DynamicResource Ant.boxShadowAmbient}"/>
            <Border Margin="-4,0,-4,-8" CornerRadius="12" Background="{DynamicResource Ant.boxShadowUmbra}"/>
            <Border Margin="-1,1,-1,-3" CornerRadius="9" Background="{DynamicResource Ant.boxShadowKey}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
              <Setter TargetName="Shadows" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Components the pages do not use yet, so later pages start from the same specification:
    Tabs, Menu and Dropdown, Slider, Card (GroupBox) and Table (ListView).
  -->
  <!-- Ant Tabs (line). -->
  <Style x:Key="Primer.TabItem" TargetType="TabItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Margin" Value="0,0,32,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid Background="Transparent">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            <Border x:Name="Ink" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Ant.colorPrimary}" Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
              <Setter TargetName="Ink" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Tabs" TargetType="TabControl">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource Primer.cardBorder}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,16,0,0" KeyboardNavigation.TabNavigation="Local"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem" BasedOn="{StaticResource Primer.TabItem}"/>
  <Style TargetType="TabControl" BasedOn="{StaticResource Primer.Tabs}"/>

  <!-- Ant Menu / Dropdown: colorBgElevated list, 32px items, controlItemBgHover, colorSplit dividers. -->
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Margin" Value="0,4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Height="1" Background="{DynamicResource Primer.divider}"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Separator">
    <Setter Property="Margin" Value="0,8"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Height="1" Background="{DynamicResource Primer.divider}"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.MenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Grid>
            <Border x:Name="Surface" Background="Transparent" CornerRadius="{StaticResource Ui.Radius.Small}" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconHost" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed">
                  <ContentPresenter x:Name="Icon" ContentSource="Icon"/>
                  <Path x:Name="CheckMark" Data="{DynamicResource Icon.Check}" Stretch="Uniform" Width="12" Height="12" Stroke="{DynamicResource Primer.accent}" StrokeThickness="2" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" Foreground="{DynamicResource Primer.textMuted}" VerticalAlignment="Center"/>
                <Path x:Name="Arrow" Grid.Column="3" Style="{StaticResource Primer.Chevron}" Width="10" Height="10" Margin="8,0,0,0" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                  <Path.RenderTransform><RotateTransform Angle="-90"/></Path.RenderTransform>
                </Path>
              </Grid>
            </Border>
            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}" Placement="Right" HorizontalOffset="0" VerticalOffset="-4" AllowsTransparency="True" Focusable="False" PopupAnimation="{StaticResource Primer.PopupAnimation}">
              <ContentControl Style="{StaticResource Primer.Elevated}" Margin="8,0,8,14">
                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
              </ContentControl>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
              <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
              <Setter TargetName="PART_Popup" Property="HorizontalOffset" Value="-8"/>
              <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="4"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsCheckable" Value="True">
              <Setter TargetName="IconHost" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True"/><Condition Property="Role" Value="TopLevelHeader"/></MultiTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="IsHighlighted" Value="True"/><Condition Property="Role" Value="TopLevelItem"/></MultiTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem" BasedOn="{StaticResource Primer.MenuItem}"/>
  <Style x:Key="Primer.Menu" TargetType="Menu">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Menu" BasedOn="{StaticResource Primer.Menu}"/>
  <Style x:Key="Primer.ContextMenu" TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <ContentControl Style="{StaticResource Primer.Elevated}" Margin="8,0,8,14" MinWidth="120">
            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True"/>
          </ContentControl>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ContextMenu" BasedOn="{StaticResource Primer.ContextMenu}"/>

  <!-- Ant Slider: colorFillSecondary rail, colorPrimary track and a 14px handle. -->
  <Style x:Key="Primer.SliderTrack" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border Background="Transparent">
        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.SliderHandle" TargetType="Thumb">
    <Setter Property="AutomationProperties.Name" Value="{l:Tr Access.ScrollPosition}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Grid Width="24" Height="24" Background="Transparent">
        <Ellipse x:Name="Handle" Width="14" Height="14" Fill="{DynamicResource Primer.card}" Stroke="{DynamicResource Ant.colorPrimary}" StrokeThickness="2"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="StrokeThickness" Value="3"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.Slider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Ant.colorFillSecondary}" VerticalAlignment="Center" Margin="12,0"/>
            <Track x:Name="PART_Track" Margin="0">
              <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{StaticResource Primer.SliderTrack}" Background="{DynamicResource Ant.colorPrimary}"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource Primer.SliderHandle}"/></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource Primer.SliderTrack}" Background="Transparent"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Slider" BasedOn="{StaticResource Primer.Slider}"/>

  <!-- Ant Card with a head: GroupBox. -->
  <Style x:Key="Primer.Card" TargetType="GroupBox">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{StaticResource Ui.Padding.Card}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ui.Radius.Large}">
            <DockPanel>
              <Border DockPanel.Dock="Top" MinHeight="48" Padding="16,0" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontSize="{DynamicResource Ui.FontSize.Section}" TextElement.FontWeight="SemiBold"/>
              </Border>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GroupBox" BasedOn="{StaticResource Primer.Card}"/>

  <!-- Ant Table on ListView/GridView. -->
  <Style TargetType="ListView">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="GridViewColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridViewColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Width="8" Cursor="SizeWE" Opacity="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListViewItem">
    <Setter Property="AutomationProperties.Name"><Setter.Value>
      <MultiBinding Converter="{StaticResource Primer.AccessibleName}">
        <Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
      </MultiBinding>
    </Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListViewItem">
          <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Primer.divider}" BorderThickness="0,0,0,1" MinHeight="36" Padding="{TemplateBinding Padding}">
            <Grid>
              <GridViewRowPresenter x:Name="Columns" Columns="{TemplateBinding GridView.ColumnCollection}" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
              <ContentPresenter x:Name="Single" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="GridView.ColumnCollection" Value="{x:Null}">
              <Setter TargetName="Columns" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="Single" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Primer.cardSel}"/></Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
          <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="ux:ContrastSelection.Active" Value="True"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
