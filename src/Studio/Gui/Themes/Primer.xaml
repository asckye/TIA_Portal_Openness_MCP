  -->
  <Style x:Key="Primer.Filter" TargetType="ToggleButton" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="ux:Ux.Variant" Value="Segment"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
        <Setter Property="Background" Value="{DynamicResource Primer.menuBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <ControlTemplate x:Key="Primer.TableButtonTemplate" TargetType="Button">
    <Grid>
      <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
      <Border x:Name="Hover" Background="{DynamicResource Primer.cardSoft}" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Primer.TableButton" TargetType="Button" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Template" Value="{StaticResource Primer.TableButtonTemplate}"/>
