<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <!--
    The workbench vocabulary, drawn to the Ant Design v5 specification.

    The keys keep their Primer.* names so pages, code-behind and tests resolve unchanged; the
    templates behind them are Ant components: Button, Input, Select, Checkbox, Radio, Switch,
    Segmented, Tag, Badge, Card, Alert, Table, Tabs, Menu, Tooltip, Progress, Collapse, Slider and
    Modal. Every colour is a palette token read by DynamicResource, so the light/dark/high-contrast
    swap repaints the live window. Shadows are drawn as translucent layers rather than effects,
    and only on pop-ups; in-window panels keep a colorBorderSecondary outline instead.
  -->
  <ux:AccessibleNameConverter x:Key="Primer.AccessibleName"/>
  <ux:DisplayValueConverter x:Key="Primer.Value"/>
  <ux:EnumIndexConverter x:Key="Primer.EnumIndex"/>
  <ux:ScrollCommandNameConverter x:Key="Primer.ScrollCommandName"/>

  <!-- Seed and map tokens that are not colours. -->
  <FontFamily x:Key="Ui.Font">Segoe UI, /TiaOpenness;component/Fonts/#Noto Sans SC</FontFamily>
  <FontFamily x:Key="Ui.FontMono">/TiaOpenness;component/Fonts/#JetBrains Mono, Consolas</FontFamily>
  <!-- fontSizeSM -->
  <sys:Double x:Key="Ui.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Small">12</sys:Double>
  <!-- fontSize -->
  <sys:Double x:Key="Ui.FontSize.Body">14</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Control">14</sys:Double>
  <sys:Double x:Key="Ui.FontSize.SmallTitle">14</sys:Double>
  <!-- fontSizeLG: card and modal titles -->
  <sys:Double x:Key="Ui.FontSize.Section">16</sys:Double>
  <sys:Double x:Key="Ui.FontSize.DialogTitle">16</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Large">16</sys:Double>
  <!-- fontSizeHeading4 / fontSizeXL: page titles -->
  <sys:Double x:Key="Ui.FontSize.Title">20</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Subtitle">20</sys:Double>
  <!-- fontSizeHeading3 -->
  <sys:Double x:Key="Ui.FontSize.Heading">24</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading1">38</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading2">30</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading3">24</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading4">20</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading5">16</sys:Double>
  <!-- lineHeight 1.5714 x 14, lineHeightSM 1.6667 x 12, lineHeightLG 1.5 x 16 -->
  <sys:Double x:Key="Ui.LineHeight">22</sys:Double>
  <sys:Double x:Key="Ui.LineHeight.Small">20</sys:Double>
  <sys:Double x:Key="Ui.LineHeight.Large">24</sys:Double>
  <sys:Double x:Key="Ui.GlyphSize.Small">8</sys:Double>
  <!-- controlHeight, controlHeightSM, controlHeightLG -->
  <sys:Double x:Key="Ui.ControlHeight">32</sys:Double>
  <sys:Double x:Key="Ui.ControlHeight.Small">24</sys:Double>
  <sys:Double x:Key="Ui.ControlHeight.Large">40</sys:Double>
  <!-- borderRadius, borderRadiusXS/SM/LG -->
  <CornerRadius x:Key="Ui.Radius">6</CornerRadius>
  <CornerRadius x:Key="Ui.Radius.XS">2</CornerRadius>
  <CornerRadius x:Key="Ui.Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Ui.Radius.Large">8</CornerRadius>
  <!-- paddingXXS, paddingXS, paddingSM, padding, paddingMD, paddingLG, paddingXL (margins share the scale) -->
  <sys:Double x:Key="Ui.Space.XXS">4</sys:Double>
  <sys:Double x:Key="Ui.Space.XS">8</sys:Double>
  <sys:Double x:Key="Ui.Space.SM">12</sys:Double>
  <sys:Double x:Key="Ui.Space">16</sys:Double>
  <sys:Double x:Key="Ui.Space.MD">20</sys:Double>
  <sys:Double x:Key="Ui.Space.LG">24</sys:Double>
  <sys:Double x:Key="Ui.Space.XL">32</sys:Double>
  <Thickness x:Key="Ui.Padding.Content">24</Thickness>
  <Thickness x:Key="Ui.Padding.Card">16</Thickness>
  <Thickness x:Key="Ui.Padding.Modal">24,20</Thickness>

  <!--
    Keyboard focus: the Ant focus-visible outline (colorPrimary ring, 1px offset), drawn as a
    2px ring outside a 1px gap so it keeps 3:1 against the control and the surface around it.
  -->
  <Style x:Key="Primer.Focus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Grid Margin="-3" IsHitTestVisible="False">
        <Border BorderBrush="{DynamicResource Primer.focusOuter}" BorderThickness="2" CornerRadius="8"/>
        <Border Margin="2" BorderBrush="{DynamicResource Primer.focusInner}" BorderThickness="1" CornerRadius="6"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control" BasedOn="{StaticResource Primer.Focus}"/>

  <DataTemplate x:Key="Primer.CommandText">
    <AccessText Text="{Binding}" TextWrapping="Wrap"/>
  </DataTemplate>
  <!-- Component vocabulary: all pages refer to these shared surfaces. -->
  <DataTemplate DataType="{x:Type sys:String}">
    <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  </DataTemplate>
  <PopupAnimation x:Key="Primer.PopupAnimation">None</PopupAnimation>

  <!--
    boxShadowSecondary for pop-ups, as three translucent layers (key, umbra, ambient) under an
    elevated surface. The ContentControl's Padding is the surface padding; the layers sit in the
    margin the caller leaves around it. High contrast drops them.
  -->
  <ControlTemplate x:Key="Primer.ElevatedTemplate" TargetType="ContentControl">
    <Grid>
      <Grid x:Name="Shadows" IsHitTestVisible="False">
        <Border Margin="-6,0,-6,-12" CornerRadius="14" Background="{DynamicResource Ant.boxShadowAmbient}"/>
        <Border Margin="-3,1,-3,-6" CornerRadius="11" Background="{DynamicResource Ant.boxShadowUmbra}"/>
        <Border Margin="-1,1,-1,-2" CornerRadius="9" Background="{DynamicResource Ant.boxShadowKey}"/>
      </Grid>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ui.Radius.Large}" Padding="{TemplateBinding Padding}">
        <ContentPresenter/>
      </Border>
    </Grid>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
        <Setter TargetName="Shadows" Property="Visibility" Value="Collapsed"/>
      </DataTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Primer.Elevated" TargetType="ContentControl">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Background" Value="{DynamicResource Primer.menuBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="Template" Value="{StaticResource Primer.ElevatedTemplate}"/>
    <Style.Triggers>
      <!-- Without the shadow the surface needs its outline back. -->
      <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
        <Setter Property="BorderThickness" Value="1"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Typography: Ant Typography over the colour tokens. -->
  <Style x:Key="Ui.Text.Body" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Ui.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
  </Style>
  <Style x:Key="Ui.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Ui.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Small}"/>
  </Style>
  <Style x:Key="Ui.Text.AppTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ui.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ui.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Heading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="Ui.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Primer.bg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="Primer.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Primer.Muted" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Primer.Mono" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
  </Style>
  <!-- Card title: fontSizeLG, weight 600. -->
  <Style x:Key="Primer.ContainerTitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Section}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <!-- Card: colorBgContainer, colorBorderSecondary outline, borderRadiusLG. -->
  <Style x:Key="Primer.Container" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource Ui.Radius.Large}"/>
    <Setter Property="Padding" Value="{StaticResource Ui.Padding.Card}"/>
  </Style>
  <!-- Tag: fontSizeSM, borderRadiusSM, colorBorder outline over colorFillAlter. -->
  <Style x:Key="Primer.Chip" TargetType="Border">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="TextElement.FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Primer.Tag" TargetType="Border" BasedOn="{StaticResource Primer.Chip}"/>
  <Style x:Key="Primer.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
  </Style>
  <Style x:Key="Primer.ListValue" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="TextAlignment" Value="Right"/>
  </Style>
  <Style x:Key="Primer.ListMonoValue" TargetType="TextBlock" BasedOn="{StaticResource Primer.ListValue}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Primer.CountText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}"/>
  </Style>
  <Style x:Key="Primer.ButtonCountText" TargetType="TextBlock" BasedOn="{StaticResource Primer.CountText}">
    <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>

  <!--
    Ant Button. One template draws every type; ux:Ux.Variant selects the hover, active and
    disabled treatment. "Hover" fades in over the surface (motion 0.12s) and carries the hover
    background and border, so a pressed or hovered solid button keeps its white text.
  -->
  <ControlTemplate x:Key="Primer.ButtonTemplate" TargetType="ButtonBase">
    <Grid>
      <Border x:Name="Surface" CornerRadius="{TemplateBinding ux:Ux.CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
      <Rectangle x:Name="Dash" Visibility="Collapsed" IsHitTestVisible="False" StrokeThickness="1" StrokeDashArray="4 3" Stroke="{DynamicResource Ant.colorBorder}" RadiusX="{Binding Path=(ux:Ux.CornerRadius).TopLeft,RelativeSource={RelativeSource TemplatedParent}}" RadiusY="{Binding Path=(ux:Ux.CornerRadius).TopLeft,RelativeSource={RelativeSource TemplatedParent}}"/>
      <Border x:Name="Hover" CornerRadius="{TemplateBinding ux:Ux.CornerRadius}" Background="{DynamicResource Primer.pill}" BorderBrush="{DynamicResource Ant.colorPrimary}" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <!-- Hover surfaces per type. The default button keeps colorBgContainer and gains a primary outline. -->
      <Trigger Property="ux:Ux.Variant" Value="Primary">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorPrimaryHover}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimaryHover}"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Outlined">
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorLinkHover}"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Danger">
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Primer.diffRed}"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="DangerSolid">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorErrorSolidHover}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolidHover}"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Dashed">
        <Setter TargetName="Dash" Property="Visibility" Value="Visible"/>
        <Setter TargetName="Hover" Property="BorderThickness" Value="0"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Text">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Primer.pillHover}"/>
        <Setter TargetName="Hover" Property="BorderThickness" Value="0"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Link">
        <Setter TargetName="Hover" Property="Background" Value="Transparent"/>
        <Setter TargetName="Hover" Property="BorderThickness" Value="0"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Segment">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorFillSecondary}"/>
        <Setter TargetName="Hover" Property="BorderThickness" Value="0"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Tag">
        <Setter TargetName="Hover" Property="Background" Value="Transparent"/>
      </Trigger>
      <Trigger Property="ux:Ux.Variant" Value="Badge">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Primer.warnBg}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Primer.warn}"/>
      </Trigger>
      <!-- Hover text: the primary hue, darkened so it keeps 4.5:1 (Ant uses the lighter colorPrimaryHover). -->
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value=""/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorLinkHover}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Outlined"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorLinkHover}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Dashed"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorLinkHover}"/>
        <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Ant.colorPrimary}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Link"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorLinkHover}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Tag"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorLinkHover}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Segment"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ux:Ux.Variant" Value="Danger"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Primer.diffRed}"/>
      </MultiTrigger>
      <!-- Active: colorPrimaryActive and its danger counterpart. Pressed buttons never fade. -->
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Primer.accent}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ux:Ux.Variant" Value="Primary"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ant.colorPrimaryActive}"/>
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimaryActive}"/>
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorPrimaryActive}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimaryActive}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ux:Ux.Variant" Value="DangerSolid"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ux:Ux.Variant" Value="Danger"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
        <Setter TargetName="Hover" Property="BorderBrush" Value="{DynamicResource Ant.colorErrorSolidActive}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ux:Ux.Variant" Value="Text"/></MultiTrigger.Conditions>
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Ant.colorFillSecondary}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsPressed" Value="True"/><Condition Property="ux:Ux.Variant" Value="Link"/></MultiTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
      </MultiTrigger>
      <!-- Disabled: colorBgContainerDisabled, colorBorder and colorTextDisabled; borderless types keep their ground. -->
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
        <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
        <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Ant.colorBorder}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="ux:Ux.Variant" Value="Text"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="ux:Ux.Variant" Value="Link"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="IsEnabled" Value="False"/><Condition Property="ux:Ux.Variant" Value="Segment"/></MultiTrigger.Conditions>
        <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
        <Setter TargetName="Surface" Property="BorderBrush" Value="Transparent"/>
      </MultiTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <!-- Default button: controlHeight, colorBorder outline on colorBgContainer, colorText. -->
  <Style x:Key="Primer.Secondary" TargetType="ButtonBase">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <!-- Ant buttons keep their control height instead of filling a taller row. -->
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ux:Ux.CornerRadius" Value="{StaticResource Ui.Radius}"/>
    <Setter Property="ux:Ux.Variant" Value=""/>
    <Setter Property="ContentTemplate" Value="{StaticResource Primer.CommandText}"/>
    <Setter Property="Template" Value="{StaticResource Primer.ButtonTemplate}"/>
  </Style>
  <!-- Primary button: blue-7 in light, dark colorPrimary in dark, white text. -->
  <Style x:Key="Primer.Run" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
