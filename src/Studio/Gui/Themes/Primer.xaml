    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Ui.Radius}" Padding="{TemplateBinding Padding}" MinHeight="32">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
              <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
              <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Ant.colorTextLightSolid}"/>
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Input.Password; the mask covers a stored secret until the field is focused. -->
  <Style x:Key="Primer.SecretInput" TargetType="PasswordBox">
    <Setter Property="MinHeight" Value="{StaticResource Ui.ControlHeight}"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primer.text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Grid>
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource Ui.Radius}">
              <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                <TextBlock x:Name="Mask" Text="••••" Margin="10,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
            </Border>
            <Border x:Name="FocusRing" CornerRadius="{StaticResource Ui.Radius}" BorderThickness="2" BorderBrush="{DynamicResource Ant.colorPrimary}" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="HasSecret"/>
                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="PART_ContentHost" Property="Opacity" Value="0"/>
              <Setter TargetName="Mask" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorPrimary}"/>
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/>
              <Setter TargetName="Field" Property="Background" Value="{DynamicResource Ant.colorBgContainerDisabled}"/>
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource Primer.SecretInput}"/>
  <Style TargetType="Border" x:Key="Primer.PendingRequest" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
