  <Style x:Key="Primer.ToneChip" TargetType="Border">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorBorder}"/>
    <Setter Property="Padding" Value="8,1"/>
    <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="CornerRadius" Value="{StaticResource Ui.Radius.Small}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Accent}">
        <Setter Property="Background" Value="{DynamicResource Primer.cardSel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.noteBorder}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}">
        <Setter Property="Background" Value="{DynamicResource Primer.warnBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorWarningBorder}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Success}">
        <Setter Property="Background" Value="{DynamicResource Primer.okBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ant.colorSuccessBorder}"/>
