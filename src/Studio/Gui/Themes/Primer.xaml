  </Style>
  <HierarchicalDataTemplate x:Key="Ui.DeviceNodeTemplate" DataType="{x:Type vm:DeviceNode}" ItemsSource="{Binding Children}">
    <TextBlock Text="{Binding Label}"/>
  </HierarchicalDataTemplate>
  <Style x:Key="Primer.VirtualList" TargetType="ListBox" BasedOn="{StaticResource Primer.List}">
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
