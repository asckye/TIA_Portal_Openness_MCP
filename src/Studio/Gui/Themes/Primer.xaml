  <!-- Drawer and Modal: colorBgElevated, borderRadiusLG; the outline stands in for boxShadowSecondary. -->
  <Style x:Key="Primer.Drawer" TargetType="Border" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="Background" Value="{DynamicResource Primer.menuBg}"/>
