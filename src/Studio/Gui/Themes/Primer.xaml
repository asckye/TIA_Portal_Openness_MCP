  <Style x:Key="Primer.StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="7"/>
    <Setter Property="Height" Value="7"/>
    <Setter Property="Fill" Value="{DynamicResource Primer.textMuted}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Unchecked}">
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource Primer.checkBorder}"/>
