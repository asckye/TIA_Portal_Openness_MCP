  <!--
    Ant Collapse panel: a colorFillAlter header with the arrow on the left and the extra on the right,
    the content below on the container surface. Panels start open; the header toggles them.
  -->
  <Style x:Key="Primer.Collapse" TargetType="Expander">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="IsExpanded" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent},TargetNullValue=''}" FocusVisualStyle="{StaticResource Primer.Focus}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Primer.text}" FontWeight="Normal" Cursor="Hand">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Header" Background="{DynamicResource Primer.cardSoft}" Padding="16,0" MinHeight="46">
                    <DockPanel>
                      <Path x:Name="Arrow" DockPanel.Dock="Left" Style="{StaticResource Primer.Icon}" Width="12" Height="12" Stroke="{DynamicResource Primer.textMuted}" Data="{DynamicResource Icon.ChevronRight}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="Data" Value="{DynamicResource Icon.ChevronDown}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
