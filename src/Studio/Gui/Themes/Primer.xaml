  <!-- Table header cell: colorText at weight 600. -->
  <Style x:Key="Primer.TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
