        <Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
      </MultiBinding>
    </Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <ContentPresenter VerticalAlignment="Center"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
          <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="ux:ContrastSelection.Active" Value="True"/>
      </MultiDataTrigger>
    </Style.Triggers></Style>
  <Style x:Key="Primer.LogTail" TargetType="controls:LogTailView" BasedOn="{StaticResource Primer.VirtualList}">
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource Primer.LogTailRow}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:LogTailView">
          <ScrollViewer x:Name="PART_ScrollViewer" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
            <ItemsPresenter/>
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <Grid Height="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}"/>
            <TextBlock Grid.Column="1" Text="{Binding Message}" ToolTip="{Binding Message}" Style="{StaticResource Primer.Mono.text}"/>
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="RowBackground" Value="{DynamicResource Primer.card}"/>
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Primer.cardSoft}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource Primer.AccessibleName}"><Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/></MultiBinding></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/><Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>
  <Style x:Key="Primer.FormLabel" TargetType="Label">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="Padding" Value="0,0,0,4"/>
  <Setter Property="ContentTemplate" Value="{StaticResource Primer.CommandText}"/>
  </Style>
  <Style x:Key="Primer.Switch" TargetType="ToggleButton" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="24" CornerRadius="12" BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="2" Background="{TemplateBinding Background}">
          <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="{DynamicResource Primer.text}" HorizontalAlignment="Left" Margin="4,0"/>
        </Border>
        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
      <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
        <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Primer.onAccent}"/>
        <Setter Property="Background" Value="{DynamicResource Primer.accent}"/>
      </Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ux:ScrollCommandNameConverter x:Key="Primer.ScrollCommandName"/>
  <Style TargetType="RepeatButton">
    <Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource Primer.ScrollCommandName}">
      <Binding Path="Command" RelativeSource="{RelativeSource Self}"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
    </MultiBinding></Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>

  <Style x:Key="Primer.ScrollButton" TargetType="RepeatButton" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="MinWidth" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="AutomationProperties.Name"><Setter.Value><MultiBinding Converter="{StaticResource Primer.ScrollCommandName}"><Binding Path="Command" RelativeSource="{RelativeSource Self}"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/></MultiBinding></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.ScrollThumb" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24"/><Setter Property="MinWidth" Value="24"/>
    <Setter Property="AutomationProperties.Name" Value="{l:Tr Access.ScrollPosition}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
      <Border Margin="4" CornerRadius="4" Background="{DynamicResource Primer.inputBorder}"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="Primer.VerticalScroll" TargetType="ScrollBar">
    <Grid Background="{DynamicResource Primer.pill}">
      <Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/><RowDefinition Height="24"/></Grid.RowDefinitions>
      <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Content="▴" Style="{StaticResource Primer.ScrollButton}"/>
      <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource Primer.ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="2" Command="{x:Static ScrollBar.LineDownCommand}" Content="▾" Style="{StaticResource Primer.ScrollButton}"/>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="Primer.HorizontalScroll" TargetType="ScrollBar">
    <Grid Background="{DynamicResource Primer.pill}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
      <RepeatButton Command="{x:Static ScrollBar.LineLeftCommand}" Content="◂" Style="{StaticResource Primer.ScrollButton}"/>
      <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb Style="{StaticResource Primer.ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource Primer.ScrollButton}"/></Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Column="2" Command="{x:Static ScrollBar.LineRightCommand}" Content="▸" Style="{StaticResource Primer.ScrollButton}"/>
    </Grid>
  </ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="24"/><Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template" Value="{StaticResource Primer.VerticalScroll}"/>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
      <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="24"/>
      <Setter Property="Template" Value="{StaticResource Primer.HorizontalScroll}"/>
    </Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.ContextToggle" TargetType="ToggleButton" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
  </Style>
</ResourceDictionary>
