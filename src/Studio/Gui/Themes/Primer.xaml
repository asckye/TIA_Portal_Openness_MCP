    <Setter Property="BorderBrush" Value="{DynamicResource Primer.primaryBg}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.primaryText}"/>
  </Style>
  <!-- color="primary" variant="outlined". -->
  <Style x:Key="Primer.OutlinedAccent" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
