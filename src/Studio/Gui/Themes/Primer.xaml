<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <ux:AccessibleNameConverter x:Key="Primer.AccessibleName"/>
  <Style x:Key="Primer.Focus" TargetType="Control">
    <Setter Property="Template"><Setter.Value><ControlTemplate>
      <Grid Margin="-4" IsHitTestVisible="False">
        <Border BorderBrush="{DynamicResource Primer.focusOuter}" BorderThickness="2"/>
        <Border Margin="2" BorderBrush="{DynamicResource Primer.focusInner}" BorderThickness="1"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}" TargetType="Control" BasedOn="{StaticResource Primer.Focus}"/>

  <DataTemplate x:Key="Primer.CommandText">
    <AccessText Text="{Binding}" TextWrapping="Wrap"/>
  </DataTemplate>
  <sys:Double x:Key="Ui.GlyphSize.Small">8</sys:Double>
  <!-- A value rather than prose: paths, versions, counts. -->
  <!-- The app name in the header. -->
  <!-- A pane or row label: bold body text, normally preceded by a Ui.SectionMark. -->
  <!-- The title of an empty state. -->
  <!-- Component vocabulary: all pages refer to these shared surfaces. -->
  <DataTemplate DataType="{x:Type sys:String}">
    <TextBlock Text="{Binding}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
  </DataTemplate>
  <FontFamily x:Key="Ui.Font">Segoe UI, /TiaOpenness;component/Fonts/#Noto Sans SC</FontFamily>
  <FontFamily x:Key="Ui.FontMono">/TiaOpenness;component/Fonts/#JetBrains Mono, Consolas</FontFamily>
  <sys:Double x:Key="Ui.FontSize.Caption">12</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Small">12</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Body">12</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Control">12.5</sys:Double>
  <sys:Double x:Key="Ui.FontSize.SmallTitle">13</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Section">14</sys:Double>
  <sys:Double x:Key="Ui.FontSize.DialogTitle">15</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Subtitle">20</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Title">18</sys:Double>
  <sys:Double x:Key="Ui.FontSize.Heading">22</sys:Double>
  <Style x:Key="Ui.Text.Body" TargetType="TextBlock">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Ui.Text.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
  </Style>
  <Style x:Key="Ui.Text.Caption" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Ui.Text.Mono" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Secondary}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Small}"/>
  </Style>
  <Style x:Key="Ui.Text.AppTitle" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Title}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ui.Text.Section" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Ui.Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Ui.Text.Body}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Heading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="Ui.Window" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource Primer.bg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.Font}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Body}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <PopupAnimation x:Key="Primer.PopupAnimation">None</PopupAnimation>
  <Style x:Key="Primer.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Primer.Muted" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Primer.Mono" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
  </Style>
  <Style x:Key="Primer.ContainerTitle" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Section}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Primer.Container" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="18,16"/>
  </Style>
  <Style x:Key="Primer.Chip" TargetType="Border">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
  </Style>
  <Style x:Key="Primer.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Primer.ListValue" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="TextAlignment" Value="Right"/>
  </Style>
  <Style x:Key="Primer.ListMonoValue" TargetType="TextBlock" BasedOn="{StaticResource Primer.ListValue}">
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Primer.CountText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}"/>
  </Style>
  <Style x:Key="Primer.ButtonCountText" TargetType="TextBlock" BasedOn="{StaticResource Primer.CountText}">
    <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
  </Style>
  <ControlTemplate x:Key="Primer.ButtonTemplate" TargetType="ButtonBase">
    <Grid>
      <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
      <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource Primer.pillHover}" Opacity="0" IsHitTestVisible="False"/>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource Primer.textFaint}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
      </Trigger>
      <Trigger Property="Tag" Value="RunAction">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Primer.accent}"/>
      </Trigger>
      <Trigger Property="Tag" Value="PrimaryAction">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
      </Trigger>
      <Trigger Property="Tag" Value="WarningAction">
        <Setter TargetName="Hover" Property="Background" Value="{DynamicResource Primer.warn}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Primer.Secondary" TargetType="ButtonBase">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ContentTemplate" Value="{StaticResource Primer.CommandText}"/>
    <Setter Property="Template" Value="{StaticResource Primer.ButtonTemplate}"/>
  </Style>
  <Style x:Key="Primer.Run" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Tag" Value="RunAction"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.onAccent}"/>
  </Style>
  <Style x:Key="Primer.OutlinedAccent" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.pill}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.cardBorder}"/>
  </Style>
  <Style x:Key="Primer.Quiet" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Secondary}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="FontWeight" Value="Normal"/>
  </Style>
  <Style x:Key="Primer.CaptionButton" TargetType="ButtonBase" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
  </Style>
  <Style x:Key="Primer.Input" TargetType="TextBox">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Primer.text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Primer.accent}"/>
    <Setter Property="SelectionTextBrush" Value="{DynamicResource Primer.onAccent}"/>
    <Setter Property="SelectionOpacity" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="Field" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Primer.textMuted}" Margin="12,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Primer.textFaint}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Select" TargetType="ComboBox">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent},TargetNullValue=''}" FocusVisualStyle="{StaticResource Primer.Focus}" Focusable="False" Tag="{TemplateBinding Tag}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border CornerRadius="6" Background="{DynamicResource Primer.input}" BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1">
                    <Grid>
                      <TextBlock x:Name="Chevron" Text="" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource Ui.FontSize.Caption}" Foreground="{DynamicResource Primer.textMuted}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/>
                      <Path x:Name="Triangle" Data="M0,0 L5,0 L2.5,3 Z" Width="5" Height="3" Fill="{DynamicResource Primer.textMuted}" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="FilledTriangle">
                      <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="Triangle" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="12,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Primer.menuBg}" BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
                <ScrollViewer MaxHeight="320">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Primer.textFaint}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Checkbox" TargetType="CheckBox">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal">
            <Border x:Name="Mark" Width="16" Height="16" BorderThickness="1" BorderBrush="{DynamicResource Primer.checkBorder}" CornerRadius="3">
              <TextBlock x:Name="CheckMark" Text="✓" FontSize="{DynamicResource Ui.GlyphSize.Small}" Foreground="{DynamicResource Primer.onAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Primer.accent}"/>
              <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Mark" Property="BorderThickness" Value="2"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.List" TargetType="ListBox">
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
  </Style>
  <Style x:Key="Primer.TableItem" TargetType="ListBoxItem">
    <Setter Property="AutomationProperties.Name"><Setter.Value>
      <MultiBinding Converter="{StaticResource Primer.AccessibleName}">
        <Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
      </MultiBinding>
    </Setter.Value></Setter>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="12,0" MinHeight="36" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
        <Setter Property="BorderThickness" Value="3,0,0,1"/>
      </Trigger>

      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
          <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
        <Setter Property="ux:ContrastSelection.Active" Value="True"/>
      </MultiDataTrigger>
    </Style.Triggers>
</Style>
  <ux:DisplayValueConverter x:Key="Primer.Value"/>
  <ux:EnumIndexConverter x:Key="Primer.EnumIndex"/>
  <Style x:Key="Primer.Preference" TargetType="ComboBox" BasedOn="{StaticResource Primer.Select}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent},TargetNullValue=''}" FocusVisualStyle="{StaticResource Primer.Focus}" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{Binding SelectedItem.Content,RelativeSource={RelativeSource TemplatedParent}}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Top" AllowsTransparency="True">
              <Border Background="{DynamicResource Primer.bg}" BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1" Padding="6" CornerRadius="6">
                <ItemsPresenter/>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.WorkspacePicker" TargetType="ComboBox" BasedOn="{StaticResource Primer.Select}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent},TargetNullValue=''}" FocusVisualStyle="{StaticResource Primer.Focus}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="Transparent" BorderThickness="0">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
              <Border Background="{DynamicResource Primer.bg}" Padding="8" CornerRadius="6">
                <ItemsPresenter/>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Segment" TargetType="RadioButton" BasedOn="{StaticResource Primer.Secondary}">
