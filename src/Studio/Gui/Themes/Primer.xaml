              <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Tile" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Tile" Property="Padding" Value="8,0"/>
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.cardSel}"/>
              <Setter TargetName="Check" Property="Background" Value="{DynamicResource Primer.accent}"/>
              <Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
