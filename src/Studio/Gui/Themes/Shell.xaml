<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes">
  <Style x:Key="Workbench.Sider" TargetType="Border" BasedOn="{StaticResource Primer.Sider}">
    <Setter Property="Background" Value="{DynamicResource Primer.sidebar}"/>
  </Style>
  <Style x:Key="Workbench.MenuGroup" TargetType="TextBlock" BasedOn="{StaticResource Primer.MenuGroup}">
    <Setter Property="Margin" Value="20,16,12,6"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
  </Style>
  <Style x:Key="Workbench.NavItem" TargetType="RadioButton" BasedOn="{StaticResource Primer.NavItem}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Margin" Value="8,2"/>
    <Setter Property="Padding" Value="12,0,8,0"/>
    <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"/>
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,6" Background="{DynamicResource Primer.accent}" Visibility="Hidden"/>
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="GlyphBox" Width="18" Height="18" VerticalAlignment="Center">
                <Path x:Name="Glyph" AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Primer.Icon}" Data="{TemplateBinding ux:Ux.Icon}" Stroke="{TemplateBinding Foreground}" Width="18" Height="18"/>
              </Border>
              <ContentPresenter x:Name="Label" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Grid>
            <Border BorderBrush="{DynamicResource Primer.hcOutline}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.cardSel}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.selectedText}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/></Trigger>
            <Trigger Property="ux:Ux.Compact" Value="True">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="GlyphBox" Property="Grid.ColumnSpan" Value="2"/>
              <Setter TargetName="GlyphBox" Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="Padding" Value="0"/>
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsChecked,RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Workbench.SettingsSection" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Surface" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource Primer.hcOutline}" BorderThickness="1">
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.cardSel}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Workbench.PendingBadge" TargetType="Button" BasedOn="{StaticResource Primer.PendingBadge}">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource Self}}"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Compact" Value="True"><Setter Property="Margin" Value="0,0,0,0"/><Setter Property="VerticalAlignment" Value="Top"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Workbench.AttentionBadge" TargetType="Border" BasedOn="{StaticResource Primer.PendingCountBadge}">
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Compact" Value="True"><Setter Property="Margin" Value="0"/><Setter Property="VerticalAlignment" Value="Top"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Workbench.StatusButton" TargetType="Button" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Compact" Value="True"><Setter Property="HorizontalContentAlignment" Value="Center"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Workbench.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Caption}"/>
    <Style.Triggers><Trigger Property="ux:Ux.Compact" Value="True"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Workbench.SafetyBanner" TargetType="Border" BasedOn="{StaticResource Primer.HighContrastBorder}">
    <Setter Property="Background" Value="{DynamicResource Primer.noteBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.noteBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="24,8"/>
    <Style.Triggers><Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="{DynamicResource Primer.warnBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Ant.colorWarningBorder}"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
