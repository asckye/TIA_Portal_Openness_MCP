<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes">
  <Style x:Key="Primer.Workbench.Sider" TargetType="Border" BasedOn="{StaticResource Primer.Sider}">
    <Setter Property="Background" Value="{DynamicResource Primer.rail}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
  </Style>
  <Style x:Key="Primer.Workbench.NavItem" TargetType="RadioButton" BasedOn="{StaticResource Primer.NavItem}">
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="Margin" Value="6,0,6,4"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.10}"/>
    <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource Self}}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Surface" Margin="0" Background="{TemplateBinding Background}" CornerRadius="9"/>
            <Border x:Name="Bar" Margin="-6,0,0,0" Width="3" Height="24" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource Primer.primaryBg}" Visibility="Hidden"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border x:Name="GlyphBox" Width="17" Height="17">
                <Path x:Name="Glyph" Style="{StaticResource Primer.Icon}" Data="{TemplateBinding ux:Ux.Icon}"
                  AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent}}"
                  ToolTip="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource TemplatedParent}}"
                  Stroke="{TemplateBinding Foreground}" Width="17" Height="17"/>
              </Border>
              <ContentPresenter x:Name="Label" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Agent"><Setter TargetName="GlyphBox" Property="Margin" Value="-8,0,0,0"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.accentSoft}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Primer.accent}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Ant.colorTextDisabled}"/></Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsChecked,RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
              <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource Primer.onPrimary}"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.onPrimary}"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Workbench.SettingsSection" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.Control}"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="Padding" Value="12,8,6,8"/>
    <Setter Property="Margin" Value="0,2"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Surface" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource Primer.hcOutline}" BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="Bar" Width="3" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="1.5" Background="{DynamicResource Primer.accent}" Visibility="Hidden"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.pillHover}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.accentSoft}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.selectedText}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource Self}}" Value="True"/>
                <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
              <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource Primer.onPrimary}"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primer.Workbench.PendingBadge" TargetType="Button" BasedOn="{StaticResource Primer.PendingBadge}">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ux:Ux.Variant" Value="Primary"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.onPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="ToolTip" Value="{Binding Path=(AutomationProperties.Name),RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Border MinWidth="15" Height="15" CornerRadius="8" Padding="3,0" Background="{TemplateBinding Background}"
          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
          HorizontalAlignment="Left" VerticalAlignment="Center">
          <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource Ui.FontMono}"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.9_5}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.hcOutline}"/>
        <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Primer.onPrimary}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.AttentionBadge" TargetType="Border" BasedOn="{StaticResource Primer.PendingCountBadge}">
    <Setter Property="Background" Value="{DynamicResource Ant.colorErrorSolid}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="3,0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="MinWidth" Value="15"/>
    <Setter Property="MinHeight" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,5,6,0"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style x:Key="Primer.Workbench.StatusBar" TargetType="Border" BasedOn="{StaticResource Primer.StatusBar}">
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="12,0"/>
  </Style>
  <Style x:Key="Primer.Workbench.StatusButton" TargetType="Button" BasedOn="{StaticResource Primer.Quiet}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Setter Property="ux:Ux.Variant" Value="Status"/>
    <Setter Property="ux:Ux.CornerRadius" Value="5"/>
  </Style>
  <Style x:Key="Primer.Workbench.StatusText" TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.11}"/>
  </Style>
  <Style x:Key="Primer.Workbench.SafetyBanner" TargetType="Border" BasedOn="{StaticResource Primer.HighContrastBorder}">
    <Setter Property="Background" Value="{DynamicResource Primer.noteBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.noteBorder}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="20,6"/>
    <Style.Triggers><Trigger Property="Tag" Value="Warning"><Setter Property="Background" Value="{DynamicResource Primer.warnBg}"/><Setter Property="BorderBrush" Value="{DynamicResource Ant.colorWarningBorder}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.Toast" TargetType="Border" BasedOn="{StaticResource Primer.Toast}">
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="MaxHeight" Value="180"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Primer.text}"/>
    <Setter Property="ux:Ux.OnSpotlight" Value="False"/>
  </Style>
  <DataTemplate x:Key="Primer.Workbench.ToastCard">
    <Grid Margin="0,8,0,0" Visibility="{Binding Visibility,ElementName=ToastSurface}">
      <ContentControl Style="{DynamicResource Primer.Workbench.FloatShadow}"/>
      <Border x:Name="ToastSurface" Style="{StaticResource Primer.Workbench.Toast}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="24" Height="24" VerticalAlignment="Top">
            <Ellipse x:Name="ToastDot" Fill="{DynamicResource Primer.accent}" Visibility="Collapsed"/>
            <Border CornerRadius="6" Background="{Binding Fill,ElementName=ToastDot}" Opacity="0.12"/>
            <Path x:Name="ToastIcon" Stroke="{Binding Fill,ElementName=ToastDot}" StrokeThickness="1.6"
              Stretch="Uniform" Width="15" Height="15" StrokeLineJoin="Round"/>
          </Grid>
          <Grid Grid.Column="1" Margin="8,0,4,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="ToastTitle" FontSize="{DynamicResource Ui.FontSize.12_5}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <ScrollViewer x:Name="DescriptionScroll" Grid.Row="1" MaxHeight="64" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
              Focusable="False" KeyboardNavigation.IsTabStop="False">
              <TextBlock x:Name="ToastMessage" TextWrapping="Wrap" TextTrimming="None" FontSize="{DynamicResource Ui.FontSize.11_5}"
                Foreground="{DynamicResource Primer.textMuted}"/>
            </ScrollViewer>
            <WrapPanel Grid.Row="2">
              <Button x:Name="ToastAction" Style="{StaticResource Primer.Link}" Padding="0,3" Margin="0,0,10,0"
                AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self},TargetNullValue=''}"/>
              <Button x:Name="ToastSecondAction" Style="{StaticResource Primer.Link}" Padding="0,3"
                Foreground="{DynamicResource Primer.textMuted}"
                AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self},TargetNullValue=''}"/>
            </WrapPanel>
          </Grid>
          <Button x:Name="ToastClose" Grid.Column="2" VerticalAlignment="Top" Content="×" AutomationProperties.Name="{l:Tr Access.Dismiss}"
            Style="{StaticResource Primer.IdeToolButton}"/>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
  <Style x:Key="Primer.Workbench.Hairline" TargetType="Control">
    <Setter Property="Height" Value="2"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Control">
        <Viewbox Stretch="Fill" ClipToBounds="True">
          <Canvas Width="100" Height="2" Background="{DynamicResource Primer.input}" ClipToBounds="True">
            <Rectangle x:Name="Segment" Width="40" Height="2" Fill="{DynamicResource Primer.primaryBg}"/>
          </Canvas>
        </Viewbox>
        <ControlTemplate.Triggers>
          <Trigger Property="Visibility" Value="Visible">
            <Trigger.EnterActions><BeginStoryboard x:Name="Slide"><Storyboard>
              <DoubleAnimation Storyboard.TargetName="Segment" Storyboard.TargetProperty="(Canvas.Left)" From="-40" To="100"
                Duration="0:0:1.4" RepeatBehavior="Forever"/>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="Slide"/></Trigger.ExitActions>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.Workbench.FloatShadow" TargetType="ContentControl" BasedOn="{StaticResource Primer.Shadow}">
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ContentControl">
        <Grid>
          <Grid x:Name="Shade">
            <Border Margin="-12,-2,-12,-18" CornerRadius="22" Background="{DynamicResource Primer.floatShadow}" Opacity="0.12"/>
            <Border Margin="-7,-1,-7,-12" CornerRadius="17" Background="{DynamicResource Primer.floatShadow}" Opacity="0.20"/>
            <Border Margin="-3,0,-3,-6" CornerRadius="13" Background="{DynamicResource Primer.floatShadow}" Opacity="0.40"/>
          </Grid>
          <Border x:Name="Edge" Margin="-1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Primer.floatOutline}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <DataTrigger Binding="{Binding UseLowEffects,Source={x:Static themes:ThemeManager.Current}}" Value="True">
            <Setter TargetName="Shade" Property="Visibility" Value="Collapsed"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True">
            <Setter TargetName="Shade" Property="Visibility" Value="Collapsed"/>
            <Setter TargetName="Edge" Property="Margin" Value="-2"/>
            <Setter TargetName="Edge" Property="BorderThickness" Value="2"/>
          </DataTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.Workbench.BusyCard" TargetType="Border" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="Padding" Value="12"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.inputBorder}"/>
  </Style>
  <Style x:Key="Primer.Workbench.PageTitle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Primer.textMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.12}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Primer.Workbench.ProjectTree" TargetType="ContentControl">
    <Setter Property="Width" Value="262"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Panel.ZIndex" Value="2"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource Primer.Focus}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Border Background="{DynamicResource Primer.sidebar}" BorderBrush="{DynamicResource Primer.divider}" BorderThickness="0,0,1,0">
            <ContentPresenter x:Name="PaneContent" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="PaneContent" Property="Margin" Value="12"/>
              <Setter TargetName="PaneContent" Property="Content" Value="{Binding Path=(AutomationProperties.HelpText),RelativeSource={RelativeSource TemplatedParent}}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Style.Triggers>
      <MultiTrigger>
        <MultiTrigger.Conditions><Condition Property="HasContent" Value="False"/><Condition Property="Grid.Column" Value="0"/></MultiTrigger.Conditions>
        <Setter Property="Visibility" Value="Collapsed"/>
      </MultiTrigger>
      <Trigger Property="ux:Ux.Narrow" Value="True"><Setter Property="Width" Value="214"/></Trigger>
      <Trigger Property="ux:Ux.LeftPaneOpen" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.SettingsCard" TargetType="Border" BasedOn="{StaticResource Primer.Dialog}">
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{DynamicResource Primer.bg}"/>
  </Style>
  <Style x:Key="Primer.Workbench.SettingsPane" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Background" Value="{DynamicResource Primer.sidebar}"/>
    <Setter Property="Width" Value="204"/>
    <Setter Property="Panel.ZIndex" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="Primer.Workbench.DiagnosticStrip" TargetType="Border" BasedOn="{StaticResource Primer.Container}">
    <Setter Property="CornerRadius" Value="{StaticResource Ui.Radius}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
  <Style x:Key="Primer.Workbench.Brand" TargetType="Border" BasedOn="{StaticResource Primer.HighContrastBorder}">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource Primer.brandGradient}"/>
  </Style>
  <Style x:Key="Primer.Workbench.Search" TargetType="Button" BasedOn="{StaticResource Primer.IdeToolButton}">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Background" Value="{DynamicResource Primer.card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Primer.divider}"/>
    <Setter Property="Foreground" Value="{DynamicResource Primer.textFaint}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FontSize" Value="{DynamicResource Ui.FontSize.11_5}"/>
    <Setter Property="Width" Value="350"/>
    <Style.Triggers>
      <Trigger Property="ux:Ux.Narrow" Value="True"><Setter Property="Width" Value="240"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.KeyCap" TargetType="Border" BasedOn="{StaticResource Primer.Plain}">
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Background" Value="{DynamicResource Primer.input}"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style x:Key="Primer.Workbench.PaneToggle" TargetType="Button" BasedOn="{StaticResource Primer.HeaderIconButton}">
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.ThemeButton" TargetType="Button" BasedOn="{StaticResource Primer.HeaderIconButton}">
    <Setter Property="ux:Ux.Icon" Value="{DynamicResource Icon.WorkbenchSun}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}" Value="True">
        <Setter Property="ux:Ux.Icon" Value="{DynamicResource Icon.WorkbenchMoon}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.MaximizeButton" TargetType="Button" BasedOn="{StaticResource Primer.WindowButton}">
    <Style.Triggers>
      <Trigger Property="Tag" Value="MouseOver">
        <Setter Property="Background" Value="{DynamicResource Primer.pillHover}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Primer.hcOutline}"/>
      </Trigger>
      <Trigger Property="Tag" Value="Pressed">
        <Setter Property="Background" Value="{DynamicResource Primer.cardSel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Primer.text}"/>
      </Trigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Tag,RelativeSource={RelativeSource Self}}" Value="Pressed"/>
          <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Primer.onPrimary}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Primer.Workbench.EmptyState" TargetType="ux:WorkbenchState">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ux:Ux.Icon" Value="{DynamicResource Icon.WorkbenchProject}"/>
    <Setter Property="MinHeight" Value="260"/>
    <Setter Property="Padding" Value="32"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ux:WorkbenchState">
        <Grid Margin="{TemplateBinding Padding}">
          <StackPanel MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource Primer.input}"
              BorderBrush="{DynamicResource Primer.divider}" BorderThickness="1" HorizontalAlignment="Center">
              <Path Width="22" Height="22" Style="{StaticResource Primer.Icon}" Data="{TemplateBinding ux:Ux.Icon}" Stroke="{DynamicResource Primer.textFaint}"/>
            </Border>
            <TextBlock Text="{TemplateBinding Title}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"
              FontWeight="SemiBold" FontSize="{DynamicResource Ui.FontSize.14_5}" AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock Text="{TemplateBinding Description}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
              Foreground="{DynamicResource Primer.textMuted}" FontSize="{DynamicResource Ui.FontSize.12_5}"/>
            <Button x:Name="Action" HorizontalAlignment="Center" Margin="0,16,0,0" Content="{TemplateBinding ActionLabel}"
              AutomationProperties.Name="{TemplateBinding ActionLabel}" Command="{TemplateBinding ActionCommand}" Style="{StaticResource Primer.Button.Primary.Medium}"/>
          </StackPanel>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="ActionCommand" Value="{x:Null}"><Setter TargetName="Action" Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="Primer.Workbench.ErrorState" TargetType="ux:WorkbenchState">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="24"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ux:WorkbenchState">
        <Grid x:Name="ErrorColumn" Style="{StaticResource Primer.PageColumn}" MaxWidth="720">
          <Border Style="{StaticResource Primer.Container}" CornerRadius="12" Padding="24">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Left" VerticalAlignment="Top" Width="32" Height="32" Margin="0,0,12,0" CornerRadius="8"
                  BorderThickness="1" BorderBrush="{DynamicResource Ant.colorError}" Background="{DynamicResource Ant.colorErrorBg}">
                  <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource Ant.colorError}"/>
                </Border>
                <StackPanel>
                  <WrapPanel>
                    <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Ui.FontSize.14_5}" AutomationProperties.HeadingLevel="Level2"/>
                    <Border Style="{StaticResource Primer.Tag}" Margin="8,0"><TextBlock Text="{l:Tr Shell.ErrorTag}"/></Border>
                  </WrapPanel>
                  <TextBlock Text="{TemplateBinding Description}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                  <TextBlock x:Name="Hint" Text="{TemplateBinding Hint}" TextWrapping="Wrap" Foreground="{DynamicResource Primer.textMuted}" Margin="0,4,0,0"/>
                </StackPanel>
              </DockPanel>
              <Border x:Name="DetailsBox" Margin="0,16,0,0" Padding="12,4" CornerRadius="10"
                Background="{DynamicResource Primer.codeBg}" BorderBrush="{DynamicResource Primer.divider}" BorderThickness="1">
                <Expander Header="{l:Tr Shell.ErrorDetails}" AutomationProperties.Name="{l:Tr Shell.ErrorDetails}" Style="{StaticResource Primer.Expander}">
                  <TextBlock Text="{TemplateBinding Details}" FontFamily="{DynamicResource Ui.FontMono}" TextWrapping="Wrap" Margin="4,8"/>
                </Expander>
              </Border>
              <WrapPanel>
                <Button x:Name="Action" Margin="0,16,8,0" Content="{TemplateBinding ActionLabel}" Command="{TemplateBinding ActionCommand}"
                  AutomationProperties.Name="{TemplateBinding ActionLabel}" Style="{StaticResource Primer.Button.Primary.Medium}"/>
                <Button x:Name="Export" Margin="0,16,0,0" Content="{l:Tr Shell.Diagnostics}" Command="{TemplateBinding ExportCommand}"
                  AutomationProperties.Name="{l:Tr Shell.Diagnostics}" Style="{StaticResource Primer.Button.Secondary.Medium}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Details" Value=""><Setter TargetName="DetailsBox" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="Hint" Value=""><Setter TargetName="Hint" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="ActionCommand" Value="{x:Null}"><Setter TargetName="Action" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="ExportCommand" Value="{x:Null}"><Setter TargetName="Export" Property="Visibility" Value="Collapsed"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
