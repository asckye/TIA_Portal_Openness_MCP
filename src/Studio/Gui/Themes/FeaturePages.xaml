<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels">
  <Style x:Key="Feature.VirtualList" TargetType="ListBox" BasedOn="{StaticResource Glass.List}">
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="Feature.Text" TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}">
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Muted}"><Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Unchecked}"><Setter Property="Foreground" Value="{DynamicResource Ui.TertiaryLabel}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Accent}"><Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}"><Setter Property="Foreground" Value="{DynamicResource Ui.Orange}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Success}"><Setter Property="Foreground" Value="{DynamicResource Ui.Green}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Feature.Tint" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Accent}"><Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}"><Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Success}"><Setter Property="Background" Value="{DynamicResource Ui.OkSoft}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Feature.Dot" TargetType="Ellipse">
    <Setter Property="Width" Value="9"/><Setter Property="Height" Value="9"/>
    <Setter Property="Fill" Value="{DynamicResource Ui.TertiaryLabel}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Unchecked}"><Setter Property="Fill" Value="Transparent"/><Setter Property="Stroke" Value="{DynamicResource Ui.CheckBorder}"/><Setter Property="StrokeThickness" Value="1.5"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Accent}"><Setter Property="Fill" Value="{DynamicResource Ui.Accent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}"><Setter Property="Fill" Value="{DynamicResource Ui.Orange}"/></DataTrigger>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Success}"><Setter Property="Fill" Value="{DynamicResource Ui.Green}"/></DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Feature.Filter" TargetType="ToggleButton" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="Height" Value="26"/><Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/><Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Feature.Row" TargetType="Button" BasedOn="{StaticResource Glass.Button}">
    <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ContentTemplate" Value="{x:Null}"/>
    <Style.Triggers><DataTrigger Binding="{Binding Pending}" Value="True"><Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Feature.Header" TargetType="TextBlock" BasedOn="{StaticResource Glass.Muted}">
    <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
  </Style>
  <Style x:Key="Feature.Code" TargetType="TextBlock" BasedOn="{StaticResource Glass.Mono}">
    <Setter Property="Foreground" Value="{DynamicResource Ui.CodeText}"/><Setter Property="FontSize" Value="10.5"/>
    <Setter Property="LineHeight" Value="16"/><Setter Property="TextTrimming" Value="None"/>
  </Style>
  <Style x:Key="Feature.Progress" TargetType="ProgressBar">
    <Setter Property="Height" Value="4"/><Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
    <Setter Property="Background" Value="{DynamicResource Ui.ControlBackground}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track" Background="{TemplateBinding Background}"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2"/></Grid></ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static vm:FeatureTone.Warning}"><Setter Property="Foreground" Value="{DynamicResource Ui.Orange}"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="Feature.Expander" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource Ui.Label}"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Expander">
        <StackPanel>
          <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalContentAlignment="Stretch" Background="Transparent" Foreground="{DynamicResource Ui.Label}" FontWeight="Normal">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter x:Name="Detail" Visibility="Collapsed" Margin="38,0,12,12"/>
        </StackPanel>
        <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Detail" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
