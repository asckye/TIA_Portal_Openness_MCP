<Window x:Class="TiaOpenness.Gui.Controls.PortalProcessPicker" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
        Title="{l:Tr ProcessPicker.Title}" AutomationProperties.Name="{l:Tr ProcessPicker.Title}"
        AutomationProperties.IsDialog="True" Style="{DynamicResource Ui.Window}"
        Width="800" Height="440" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
        PreviewKeyDown="OnPreviewKeyDown">
    <Border Style="{DynamicResource Primer.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr ProcessPicker.Title}" Style="{DynamicResource Primer.Text}"
                       FontSize="{DynamicResource Ui.FontSize.DialogTitle}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Grid.Row="1" Text="{l:Tr ProcessPicker.Hint}" Style="{DynamicResource Primer.Text}"
                       TextWrapping="Wrap" Margin="0,8,0,16"/>
            <ListBox x:Name="ProcessList" Grid.Row="2" ItemsSource="{Binding Processes}"
                     SelectedItem="{Binding SelectedProcess}" SelectionMode="Single"
                     AutomationProperties.Name="{l:Tr ProcessPicker.List}" Style="{DynamicResource Primer.VirtualList}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Width="{Binding ViewportWidth, ElementName=ProcessScroll}" HorizontalAlignment="Left">
                                <Grid Margin="12,0,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="144"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="PID" Style="{DynamicResource Primer.Text}"/>
                                    <TextBlock Grid.Column="1" Text="{l:Tr ProcessPicker.Project}" Style="{DynamicResource Primer.Text}"/>
                                    <TextBlock Grid.Column="2" Text="{l:Tr ProcessPicker.Release}" Style="{DynamicResource Primer.Text}"/>
                                    <TextBlock Grid.Column="3" Text="{l:Tr ProcessPicker.Mode}" Style="{DynamicResource Primer.Text}"/>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="ProcessScroll" Grid.Row="1" Focusable="False"
                                          CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Primer.TableItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="Height" Value="{StaticResource Ui.RowHeight}"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="144"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding ProcessId}" Style="{DynamicResource Primer.Mono}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProjectPath}" ToolTip="{Binding ProjectPath}" Style="{DynamicResource Primer.Mono}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Release}" Style="{DynamicResource Primer.Text}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding UiMode}" Style="{DynamicResource Primer.Text}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="{l:Tr ProcessPicker.Cancel}" AutomationProperties.Name="{l:Tr ProcessPicker.Cancel}"
                        Command="{Binding Cancel}" IsDefault="True" IsCancel="True" MinWidth="96" HorizontalAlignment="Left"
                        Style="{DynamicResource Primer.Secondary}"/>
                <Button x:Name="ConnectButton" Content="{l:Tr ProcessPicker.Connect}" AutomationProperties.Name="{l:Tr ProcessPicker.Connect}"
                        Command="{Binding Connect}" MinWidth="96" HorizontalAlignment="Right" Style="{DynamicResource Primer.Run}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
