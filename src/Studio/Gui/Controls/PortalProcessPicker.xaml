<Window x:Class="TiaOpenness.Gui.Controls.PortalProcessPicker" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
        Title="{l:Tr Overlay.PickerTitle}" AutomationProperties.Name="{l:Tr ProcessPicker.Title}"
        AutomationProperties.IsDialog="True" Style="{DynamicResource Ui.Window}"
        Width="592" SizeToContent="Height" AllowsTransparency="True" Background="Transparent" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources><ResourceDictionary Source="OverlayTiles.xaml"/></Window.Resources>
    <Grid Margin="16">
      <ContentControl Style="{StaticResource Primer.Workbench.FloatShadow}"/>
      <Border x:Name="Surface" Style="{StaticResource Primer.Dialog}" Padding="20" CornerRadius="14" Background="{DynamicResource Primer.window}"
            BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource Primer.IdeToolButton}" Content="×" Command="{Binding Cancel}"
                        AutomationProperties.Name="{l:Tr Overlay.Close}" ToolTip="{l:Tr Overlay.Close}" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{l:Tr Overlay.PickerTitle}" Style="{StaticResource Primer.ContainerTitle}" FontSize="{StaticResource Ui.FontSize.DialogTitle}"
                               AutomationProperties.HeadingLevel="Level1"/>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Primer.Muted}" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding ScanError}" Foreground="{DynamicResource Primer.destructiveText}" TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Text}">
                            <Style.Triggers><DataTrigger Binding="{Binding ScanError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <ListBox x:Name="ProcessList" Grid.Row="1" ItemsSource="{Binding Processes}" MaxHeight="380"
                     SelectedItem="{Binding SelectedProcess}" SelectionMode="Single" AutomationProperties.Name="{l:Tr ProcessPicker.List}"
                     AutomationProperties.HelpText="{Binding ChoiceHint}"
                     Style="{StaticResource Primer.VirtualList}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
                        <Setter Property="Height" Value="94"/>
                        <Setter Property="Padding" Value="14"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate><DataTemplate>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
                                <Setter Property="Text" Value="○"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter Property="Text" Value="✓"/><Setter Property="Foreground" Value="{DynamicResource Primer.accent}"/>
                                </DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource Primer.accentSoft}" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" TextElement.FontFamily="{StaticResource Ui.FontMono}"
                                                TextElement.FontSize="{StaticResource Ui.FontSize.12}" TextElement.FontWeight="Bold" TextElement.Foreground="{DynamicResource Primer.accent}">
                                        <TextBlock Text="{Binding Release}" ToolTip="{l:Tr ProcessPicker.Release}"/><TextBlock Text=" · PID "/><TextBlock Text="{Binding ProcessId}"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" TextElement.FontSize="{StaticResource Ui.FontSize.11}"
                                            TextElement.FontFamily="{StaticResource Ui.FontMono}" TextElement.Foreground="{DynamicResource Primer.textFaint}">
                                    <TextBlock Text="{Binding Thread}"/><TextBlock Text=" · "/><TextBlock Text="{Binding UiMode}" ToolTip="{l:Tr ProcessPicker.Mode}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding ProjectPath}" AutomationProperties.ItemType="{l:Tr ProcessPicker.Project}" ToolTip="{Binding ProjectPath}" Margin="0,6,0,0" Style="{StaticResource Primer.Mono}"
                                       FontSize="{StaticResource Ui.FontSize.12}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Style="{StaticResource Primer.Muted}" FontSize="{StaticResource Ui.FontSize.11}" Margin="0,2,0,0">
                                <Run Text="{l:Tr Overlay.Lease}"/><Run Text=" —"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button x:Name="RescanButton" Content="{l:Tr Overlay.Rescan}" AutomationProperties.Name="{l:Tr Overlay.Rescan}"
                        HorizontalAlignment="Left" Command="{Binding Rescan}" Style="{StaticResource Primer.Button.Secondary.Medium}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="{l:Tr ProcessPicker.Cancel}" AutomationProperties.Name="{l:Tr ProcessPicker.Cancel}"
                            Command="{Binding Cancel}" IsDefault="True" IsCancel="True" Style="{StaticResource Primer.Button.Secondary.Medium}"/>
                    <Button x:Name="ConnectButton" Content="{Binding AttachText}" Margin="8,0,0,0" Command="{Binding Connect}"
                            Style="{StaticResource Primer.Button.Primary.Medium}"/>
                </StackPanel>
            </Grid>
        </Grid>
      </Border>
    </Grid>
</Window>
