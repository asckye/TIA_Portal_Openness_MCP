<UserControl x:Class="TiaOpenness.Gui.Controls.SessionPopover"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Width="312" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False"
    AutomationProperties.Name="{l:Tr Overlay.Session}">
  <Border CornerRadius="12" Padding="16" Background="{DynamicResource Primer.window}"
      BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="{l:Tr Overlay.Session}" Style="{StaticResource Primer.ContainerTitle}"/>
      <Border Background="{DynamicResource Primer.codeBg}" CornerRadius="8" Padding="12" Margin="0,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Common.PortalName}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,4"/>
          <TextBlock x:Name="Release" Grid.Column="1" Style="{StaticResource Primer.Mono}"/>
          <TextBlock Grid.Row="1" Text="{l:Tr Project.Label}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,4"/>
          <TextBlock x:Name="Project" Grid.Row="1" Grid.Column="1" Style="{StaticResource Primer.Mono}" TextTrimming="CharacterEllipsis"
              ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          <TextBlock Grid.Row="2" Text="{l:Tr Common.Plc}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,4"/>
          <TextBlock x:Name="Plc" Grid.Row="2" Grid.Column="1" Style="{StaticResource Primer.Mono}" TextTrimming="CharacterEllipsis"
              ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          <TextBlock Grid.Row="3" Text="{l:Tr Overlay.Client}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
          <TextBlock x:Name="Client" Grid.Row="3" Grid.Column="1" Style="{StaticResource Primer.Text}" TextWrapping="Wrap"
              ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
        </Grid>
      </Border>
      <Button x:Name="AiSettings" HorizontalAlignment="Left" Style="{StaticResource Primer.Link}"
          AutomationProperties.Name="{l:Tr Overlay.AiSettings}" Content="{l:Tr Overlay.AiSettings}" Click="OnAiSettings"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="SwitchVersion" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Overlay.SwitchVersion}"
            AutomationProperties.Name="{l:Tr Overlay.SwitchVersion}" Click="OnSwitchVersion"/>
        <Button x:Name="Disconnect" Margin="8,0,0,0" Style="{StaticResource Primer.Secondary}" Content="{l:Tr Pages.Disconnect}"
            AutomationProperties.Name="{l:Tr Pages.Disconnect}" Command="{Binding Session.Disconnect}" Click="OnDisconnect"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
