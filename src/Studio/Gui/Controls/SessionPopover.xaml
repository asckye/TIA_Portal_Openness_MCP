<UserControl x:Class="TiaOpenness.Gui.Controls.SessionPopover"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Width="312" Margin="12,0,0,32" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False"
    AutomationProperties.Name="{Binding Text,ElementName=SessionHeading}">
  <Grid>
    <ContentControl Style="{StaticResource Primer.Shadow}"/>
    <Border CornerRadius="{StaticResource Ui.Radius.Large}" Padding="16" Background="{DynamicResource Primer.window}"
        BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1">
      <StackPanel>
        <DockPanel>
          <Border x:Name="ConnectedTag" DockPanel.Dock="Right" Style="{StaticResource Primer.Tag}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Style="{StaticResource Primer.StatusDot}" Fill="{DynamicResource Primer.ok}" Margin="0,0,6,0"/>
              <TextBlock Text="{l:Tr Overlay.Connected}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SessionHeading" Style="{StaticResource Primer.ContainerTitle}"/>
        </DockPanel>
        <Border Style="{StaticResource Primer.CodeBlock}" BorderBrush="{DynamicResource Primer.divider}" Padding="12" Margin="0,12">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Common.PortalName}" Style="{StaticResource Primer.Muted}"
                Foreground="{DynamicResource Primer.textFaint}" Margin="0,0,8,0"/>
            <TextBlock x:Name="Release" Grid.Column="1" Style="{StaticResource Primer.ListMonoValue}"
                ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" FontWeight="Medium"/>
            <TextBlock Grid.Row="2" Text="{l:Tr Project.Label}" Style="{StaticResource Primer.Muted}"
                Foreground="{DynamicResource Primer.textFaint}" Margin="0,0,8,0"/>
            <TextBlock x:Name="Project" Grid.Row="2" Grid.Column="1" MaxWidth="176" HorizontalAlignment="Right" Style="{StaticResource Primer.ListMonoValue}"
                ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            <TextBlock Grid.Row="4" Text="{l:Tr Common.Plc}" Style="{StaticResource Primer.Muted}"
                Foreground="{DynamicResource Primer.textFaint}" Margin="0,0,8,0"/>
            <TextBlock x:Name="Plc" Grid.Row="4" Grid.Column="1" Style="{StaticResource Primer.ListMonoValue}"
                ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            <TextBlock Grid.Row="6" Text="{l:Tr Overlay.Client}" Style="{StaticResource Primer.Muted}"
                Foreground="{DynamicResource Primer.textFaint}" Margin="0,0,8,0"/>
            <TextBlock x:Name="Client" Grid.Row="6" Grid.Column="1" Style="{StaticResource Primer.ListValue}"
                ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"
                FontWeight="Medium" TextWrapping="Wrap" TextTrimming="None"/>
          </Grid>
        </Border>
        <Border BorderBrush="{DynamicResource Primer.divider}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
          <Button x:Name="AiSettings" HorizontalAlignment="Left" Style="{StaticResource Primer.Link}" MinHeight="28" Padding="0"
              Content="{l:Tr Overlay.AiSettings}" AutomationProperties.Name="{l:Tr Overlay.AiSettings}" Click="OnAiSettings"/>
        </Border>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Button x:Name="SwitchVersion" Style="{StaticResource Primer.Button.Secondary.Small}" Content="{l:Tr Overlay.SwitchVersion}"
              AutomationProperties.Name="{l:Tr Overlay.SwitchVersion}" Click="OnSwitchVersion"/>
          <Button x:Name="Disconnect" Grid.Column="2" Style="{StaticResource Primer.Button.Danger.Small}" Content="{l:Tr Overlay.Disconnect}"
              AutomationProperties.Name="{l:Tr Overlay.Disconnect}" Command="{Binding Session.Disconnect}" Click="OnDisconnect"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
