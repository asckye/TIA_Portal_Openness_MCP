<UserControl x:Class="TiaOpenness.Gui.Controls.SessionPopover"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
    Width="372" Margin="12,0,0,32" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsTabStop="False">
  <UserControl.Resources><ResourceDictionary Source="OverlayTiles.xaml"/></UserControl.Resources>
  <Grid>
    <ContentControl Style="{StaticResource Primer.Workbench.FloatShadow}"/>
    <Border CornerRadius="{StaticResource Ui.Radius.Large}" Padding="16" Background="{DynamicResource Primer.window}"
        BorderBrush="{DynamicResource Primer.inputBorder}" BorderThickness="1">
      <StackPanel>
        <DockPanel>
          <Border x:Name="ConnectedTag" DockPanel.Dock="Right" Style="{StaticResource Primer.Tag.Ok}">
            <TextBlock x:Name="SessionState" FontSize="{StaticResource Ui.FontSize.11}"/>
          </Border>
          <TextBlock x:Name="SessionHeading" Style="{StaticResource Primer.ContainerTitle}" FontSize="{StaticResource Ui.FontSize.13}"/>
        </DockPanel>
        <DockPanel Margin="0,12,0,0">
          <Grid DockPanel.Dock="Right" Width="140">
            <Button x:Name="SwitchVersion" Width="140" Height="28" ContentTemplate="{x:Null}" Style="{StaticResource Primer.Button.Secondary.Small}"
                AutomationProperties.Name="{l:Tr Overlay.SwitchVersion}" Click="OnSwitchVersion">
              <TextBlock x:Name="Release" FontFamily="{StaticResource Ui.FontMono}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
            </Button>
            <Button x:Name="VersionMenuButton" HorizontalAlignment="Right" Width="24" Height="24" Content="⌄"
                Style="{StaticResource Primer.IdeToolButton}" AutomationProperties.Name="{l:Tr Overlay.Release}"
                ToolTip="{l:Tr Overlay.Release}" Click="OnVersionMenu">
              <Button.ContextMenu><ContextMenu Placement="Bottom" Opened="OnReleaseMenuOpened"/></Button.ContextMenu>
            </Button>
          </Grid>
          <TextBlock Text="{l:Tr Overlay.Release}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center"/>
        </DockPanel>
        <StackPanel x:Name="Discovery" Margin="0,12,0,0">
          <DockPanel>
            <Button x:Name="Discover" DockPanel.Dock="Right" Content="{l:Tr Overlay.Discover}" AutomationProperties.Name="{l:Tr Overlay.Discover}"
                Command="{Binding Panel.Refresh}" Style="{StaticResource Primer.Link}" Padding="0"/>
            <TextBlock x:Name="SessionCount" Style="{StaticResource Primer.Muted}" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox x:Name="SessionList" Margin="0,4,0,0" ItemsSource="{Binding Panel.Sessions}" SelectedItem="{Binding Panel.Selected}"
              Style="{StaticResource Primer.VirtualList}" MaxHeight="175" AutomationProperties.LabeledBy="{Binding ElementName=SessionCount}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="AutomationProperties.Name" Value="{Binding Summary}"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding WorkerState}" Margin="6,0,0,0">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Mono}">
                      <Setter Property="FontSize" Value="{StaticResource Ui.FontSize.10_5}"/>
                      <Setter Property="Foreground" Value="{DynamicResource Primer.textFaint}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding WorkerState}" Value="IDLE">
                          <Setter Property="Foreground" Value="{DynamicResource Primer.ok}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WorkerState}" Value="BUSY">
                          <Setter Property="Foreground" Value="{DynamicResource Primer.warn}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style></TextBlock.Style>
                  </TextBlock>
                  <WrapPanel ToolTip="{Binding Summary}">
                    <WrapPanel.Resources>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Mono}">
                        <Setter Property="FontSize" Value="{StaticResource Ui.FontSize.11_5}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                      </Style>
                    </WrapPanel.Resources>
                    <TextBlock Text="{Binding ClientIdentity}" Margin="0,0,4,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{l:Tr Session.Unverified}"/>
                  </WrapPanel>
                </DockPanel>
                <TextBlock Text="{Binding ProjectAndParticipants}" ToolTip="{Binding ProjectAndParticipants}" Style="{StaticResource Primer.Muted}"
                    FontSize="{StaticResource Ui.FontSize.11}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
              </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{l:Tr Overlay.EmptySessions}" Margin="0,4,0,6">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Primer.Muted}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding HasItems,ElementName=SessionList}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
        <TextBlock Visibility="{Binding HasMcpPanel,Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
          <Hyperlink x:Name="SessionDetailsLink" Click="OnSessionDetails" AutomationProperties.Name="{l:Tr Session.Title}">
            <Run Text="{l:Tr Session.Title}"/>
          </Hyperlink>
        </TextBlock>
        <ContentControl x:Name="SessionDetails"/>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Button x:Name="Attach" Height="28" Style="{StaticResource Primer.Button.Primary.Small}" Content="{l:Tr Overlay.Attach}"
              AutomationProperties.Name="{l:Tr Overlay.Attach}" Command="{Binding Panel.Attach}" Click="OnSessionAction"/>
          <Button x:Name="Create" Height="28" Grid.Column="2" Style="{StaticResource Primer.Button.Secondary.Small}" Content="{l:Tr Overlay.Create}"
              AutomationProperties.Name="{l:Tr Overlay.Create}" Command="{Binding Panel.Create}" Click="OnSessionAction"/>
          <Button x:Name="Detach" Height="28" Grid.Row="1" Margin="0,6,0,0" Style="{StaticResource Primer.Button.Secondary.Small}" Content="{l:Tr Overlay.Detach}"
              AutomationProperties.Name="{l:Tr Overlay.Detach}" Command="{Binding Panel.Detach}" Click="OnSessionAction"/>
          <Button x:Name="Disconnect" Height="28" Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Style="{StaticResource Primer.Button.Danger.Small}"
              Content="{l:Tr Overlay.Disconnect}" AutomationProperties.Name="{l:Tr Overlay.Disconnect}"
              Command="{Binding Session.Disconnect}" Click="OnSessionAction"/>
        </Grid>

      </StackPanel>
    </Border>
  </Grid>
</UserControl>
