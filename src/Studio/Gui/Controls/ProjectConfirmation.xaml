<UserControl x:Class="TiaOpenness.Gui.Controls.ProjectConfirmation" x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" IsTabStop="False">
  <Grid Margin="16">
    <ContentControl Style="{StaticResource Primer.Workbench.FloatShadow}"/>
    <Border Padding="24" Background="{DynamicResource Primer.window}" BorderBrush="{DynamicResource Primer.inputBorder}"
      BorderThickness="1" CornerRadius="14">
    <StackPanel>
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Margin="0,0,12,0" VerticalAlignment="Top"
            Background="{DynamicResource Primer.accentSoft}">
          <TextBlock Text="i" Foreground="{DynamicResource Primer.accent}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="Heading" Style="{StaticResource Primer.ContainerTitle}" FontSize="{StaticResource Ui.FontSize.DialogTitle}" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1"/>
          <TextBlock x:Name="Body" Style="{StaticResource Primer.Muted}" FontSize="{StaticResource Ui.FontSize.12_5}" Foreground="{DynamicResource Primer.textMuted}"
              TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="20"/>
        </StackPanel>
      </DockPanel>
      <Border Style="{StaticResource Primer.CodeBlock}" Padding="12" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock x:Name="FirstLabel" Style="{StaticResource Primer.Muted}"/>
          <TextBlock x:Name="FirstValue" Grid.Column="2" Style="{StaticResource Primer.ListMonoValue}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          <TextBlock x:Name="SecondLabel" Grid.Row="2" Style="{StaticResource Primer.Muted}"/>
          <TextBlock x:Name="SecondValue" Grid.Row="2" Grid.Column="2" Style="{StaticResource Primer.ListMonoValue}"
              ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
        </Grid>
      </Border>
      <WrapPanel x:Name="Actions" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
    </Border>
  </Grid>
</UserControl>
