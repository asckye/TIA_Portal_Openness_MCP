<UserControl x:Class="TiaOpenness.Gui.Views.BlocksView" x:Name="PageRoot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <Grid>
    <Grid x:Name="BlockBackdrop">
    <Border Style="{StaticResource Primer.Plain}" Margin="28,28,28,0" MaxWidth="920" x:Name="BlocksCard">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Primer.Plain}" x:Name="BlocksHeaderCard" MinHeight="44">
          <StackPanel>
            <WrapPanel VerticalAlignment="Center">
              <Border DataContext="{Binding Engineering.FocusedBlock}" Style="{StaticResource Primer.BlkBadge}" Margin="0,0,8,0"
                Visibility="{Binding IsFocused,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}">
                <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.BlkBadgeText}"/>
              </Border>
              <TextBlock x:Name="BlockTitle" Style="{StaticResource Primer.ProjectBlockTitle}" FontFamily="{DynamicResource Ui.FontMono}"
                FontSize="{DynamicResource Ui.FontSize.15_5}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
              <Border Style="{StaticResource Primer.Tag}" Margin="8,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding Engineering.FocusedBlock.IsFocused,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Engineering.SelectedDevice.Name}"/><TextBlock Text=" · "/>
                  <TextBlock Text="{Binding Engineering.FocusedBlock.Subtitle}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Primer.Tag.Warn}" Margin="8,0,0,0" VerticalAlignment="Center"
                Visibility="{Binding Engineering.FocusedBlock.IsModified,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}">
                <TextBlock Text="{l:Tr Project.Modified}"/>
              </Border>
              <Border Style="{StaticResource Primer.Tag.Warn}" Margin="6,0,0,0"
                Visibility="{Binding Engineering.FocusedBlock.HasStatus,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}">
                <TextBlock Text="{Binding Engineering.FocusedBlock.Status}"/>
              </Border>
            </WrapPanel>
            <TextBlock x:Name="BlocksSummary" Text="{Binding Tag.BlocksSummary,ElementName=PageRoot}" Style="{StaticResource Project.Caption}"
              TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" Visibility="{Binding Tag.HasSelection,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="1">
          <ListBox x:Name="BlockChooser" ItemsSource="{Binding Engineering.BlocksView}" AutomationProperties.Name="{l:Tr Tree.ProgramBlocks}"
            Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.BlockItem}" MaxHeight="136" Margin="0,6,0,0"
            PreviewKeyDown="OnChooserKey" MouseDoubleClick="OnChooseBlock" ToolTip="{l:Tr Pages.Filter}">
            <ListBox.ItemTemplate><DataTemplate>
              <DockPanel MinHeight="28">
                <Border Style="{StaticResource Primer.BlkBadge}" Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.BlkBadgeText}"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Project.Caption}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="None" TextWrapping="Wrap" Style="{StaticResource Primer.Mono}"/>
              </DockPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ux:PrefillMarker x:Name="FilterMarker" Tag="BlockFilter" ClearRequested="OnClearPrefill"/>
          <ux:PrefillMarker x:Name="SelectionMarker" Tag="BlockSelection" ClearRequested="OnClearPrefill"/>
        </StackPanel>
        <Grid Grid.Row="2" x:Name="Editor" Margin="0,8,0,20">
          <Border Style="{StaticResource Primer.ProjectCodePanel}" x:Name="CodePanel" Padding="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <DockPanel>
              <Border Style="{StaticResource Primer.ProjectHeaderLine}" DockPanel.Dock="Top" Padding="16,9">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Engineering.LineCountLabel}" Style="{StaticResource Project.Caption}"/>
                  <TextBlock Text="{Binding Engineering.SourcePath}" Style="{StaticResource Project.Caption}" ToolTip="{Binding Engineering.SourcePath}"/>
                </DockPanel>
              </Border>
              <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SourceRows" Margin="14,12" ItemsSource="{Binding Engineering.SourceLines}" AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <DockPanel MinHeight="24" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Primer.CodeLineNumber}"
                          Text="{Binding (ItemsControl.AlternationIndex),RelativeSource={RelativeSource AncestorType=ContentPresenter},
                            Converter={StaticResource Project.LineNumber}}"/>
                        <views:ProjectSourceLine SourceText="{Binding}" LanguageName="{Binding DataContext.Engineering.FocusedBlock.Language,
                          RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource Primer.CodeText}"/>
                      </DockPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Engineering.SourceStatus}" Style="{StaticResource Primer.Muted}" Margin="16,12" TextWrapping="Wrap"
                  AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Engineering.SourceStatus}"/>
              </Grid>
            </DockPanel>
          </Border>
          <Border x:Name="InterfacePanel" Style="{StaticResource Primer.Container}" VerticalAlignment="Top" Padding="20" Visibility="Collapsed">
            <TextBlock Text="{l:Tr Project.NoInterface}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
          </Border>
        </Grid>
        <Border x:Name="AtlasFooter" Style="{StaticResource Primer.FooterStrip}" Grid.Row="3" Visibility="{Binding Atlas.HasOutputOrProgress,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
          <Border x:Name="AtlasBar" Padding="12,8" Visibility="{Binding Atlas.HasOutputOrProgress,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.AtlasState}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}"/>
              <TextBlock Grid.Column="1" Visibility="{Binding Atlas.Running,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Atlas.Label,ElementName=PageRoot}" Text="{Binding Atlas.Label,ElementName=PageRoot}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Atlas.Detail,ElementName=PageRoot}" ToolTip="{Binding Atlas.Detail,ElementName=PageRoot}" Style="{StaticResource Primer.Mono}"/>
              <Button Grid.Column="3" Content="{l:Tr Session.Cancel}" AutomationProperties.Name="{l:Tr Session.Cancel}" Click="OnCancelAtlas" Style="{StaticResource Primer.Secondary}" Visibility="{Binding Atlas.Running,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
              <ProgressBar Grid.Column="2" IsIndeterminate="{Binding Atlas.Indeterminate,ElementName=PageRoot}" Width="120" Height="4" Maximum="100" Value="{Binding Atlas.Percent,ElementName=PageRoot,Mode=OneWay}" Margin="12,0,0,0" Visibility="{Binding Atlas.Running,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
              <Button AutomationProperties.Name="{l:Tr Common.Open}" Grid.Column="3" Content="{l:Tr Common.Open}" Click="OnOpenAtlas" Style="{StaticResource Primer.Secondary}" Margin="12,0,0,0" Visibility="{Binding Atlas.Done,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Border>
    <ux:WorkbenchState x:Name="EmptyBlocks" Style="{StaticResource Primer.Workbench.EmptyState}" Visibility="Collapsed"
      Title="{l:Tr Shell.EmptyBlocks}" Description="{l:Tr Shell.ImportBlocksHint}" ActionLabel="{l:Tr Shell.ImportBlocks}" ActionCommand="{Binding Engineering.Import}"/>
    <ux:WorkbenchState x:Name="SourceError" Style="{StaticResource Primer.Workbench.ErrorState}" Visibility="Collapsed"
      Title="{Binding Engineering.SourceErrorTitle}" Description="{Binding Engineering.SourceStatus}" Details="{Binding Engineering.SourcePath}"
      Hint="{l:Tr Shell.SourceHint}" ActionLabel="{l:Tr Shell.RetryRead}" ActionCommand="{Binding Engineering.RetrySource}"
      ExportCommand="{x:Static ux:WorkbenchCommands.ExportDiagnostics}"/>
    </Grid>
    <views:EngineeringOptionsView x:Name="Options"/>
  </Grid>
</UserControl>
