<UserControl x:Class="TiaOpenness.Gui.Views.BlocksView" x:Name="PageRoot"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <Grid>
    <Grid x:Name="BlockBackdrop">
    <Border x:Name="BlocksCard" Style="{StaticResource Primer.PageColumn}" >
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="1">
          <ListBox x:Name="BlockChooser" ItemsSource="{Binding Engineering.BlocksView}" AutomationProperties.Name="{l:Tr Tree.ProgramBlocks}"
            Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.BlockItem}" MaxHeight="136" Margin="0,6,0,0"
            PreviewKeyDown="OnChooserKey" MouseDoubleClick="OnChooseBlock" ToolTip="{l:Tr Pages.Filter}">
            <ListBox.ItemTemplate><DataTemplate>
              <DockPanel MinHeight="28">
                <Border Style="{StaticResource Primer.BlkBadge}" Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.BlkBadgeText}"/>
                </Border>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Subtitle}" Style="{StaticResource Project.Caption}"/>
                <TextBlock Text="{Binding Name}" TextTrimming="None" TextWrapping="Wrap" Style="{StaticResource Primer.Mono}"/>
              </DockPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <ux:PrefillMarker x:Name="FilterMarker" Margin="24,0" Tag="BlockFilter"/>
          <ux:PrefillMarker x:Name="SelectionMarker" Margin="24,0" Tag="BlockSelection"/>
        </StackPanel>
        <Grid Grid.Row="2" x:Name="Editor">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border x:Name="BlocksHeaderCard" Style="{StaticResource Primer.ProjectFileBar}">
              <DockPanel x:Name="LadderToolbar" VerticalAlignment="Center">
                <Border x:Name="LadderModes" DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="VisualTab" Content="{l:Tr Project.LadVisual}" AutomationProperties.Name="{l:Tr Project.LadVisual}"
                      Click="OnLadderMode" IsChecked="True" Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="XmlTab" Content="{Binding Engineering.LogicModeLabel}" AutomationProperties.Name="{Binding Engineering.LogicModeLabel}"
                      Click="OnLadderMode" Style="{StaticResource Primer.Segment}"/>
                  </StackPanel>
                </Border>
                <StackPanel x:Name="TextActions" DockPanel.Dock="Right" Orientation="Horizontal">
                  <TextBlock Text="{Binding Engineering.LineCountLabel}" Style="{StaticResource Project.Caption}" Margin="8,0"/>
                  <Button x:Name="CopySource" Click="OnCopySource" Content="{l:Tr Project.CopySource}" AutomationProperties.Name="{l:Tr Project.CopySource}"
                    IsEnabled="{Binding Engineering.HasTextLines}" Style="{StaticResource Primer.IdeToolButton}"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Engineering.SourcePath}" Style="{StaticResource Project.Caption}"
                  MaxWidth="320" ToolTip="{Binding Engineering.SourcePath}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="BlocksSummary" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"
                  Margin="8,0" Style="{StaticResource Primer.ProjectFileSummary}" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Border>
            <ScrollViewer x:Name="LadderPanel" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="{Binding Engineering.SourceStatus}" Style="{StaticResource Project.SourceNotice}"/>
                <ItemsControl ItemsSource="{Binding Engineering.Networks}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource Primer.ProjectResultCard}" Padding="0" Margin="0,0,0,12">
                      <StackPanel>
                        <Border Style="{StaticResource Primer.ProjectNetworkHeader}" Padding="14,8">
                          <DockPanel>
                            <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                              <TextBlock Text="{Binding CallIdentity}" Style="{StaticResource Project.Caption}"/>
                              <StackPanel Orientation="Horizontal" Style="{StaticResource Project.NetworkLanguage}">
                                <TextBlock Text="{Binding Language}" Style="{StaticResource Project.Caption}"/>
                                <TextBlock Text=" · " Style="{StaticResource Project.Caption}"/><TextBlock Text="{l:Tr Calls.Execution.ReadOnly}" Style="{StaticResource Project.Caption}"/>
                              </StackPanel>
                            </Grid>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding NumberLabel}" Style="{StaticResource Project.LadderOperand}" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                          </DockPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rungs}" Margin="28,16">
                          <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,5">
                              <TextBlock Text="{Binding Description}" Style="{StaticResource Primer.Mono}" Margin="8,12"
                                Visibility="{Binding IsText,Converter={StaticResource BoolToVisibility}}"/>
                              <Border Style="{StaticResource Primer.ProjectRail}" Padding="0,6" ToolTip="{Binding Description}"
                                Visibility="{Binding IsBox,Converter={StaticResource BoolToVisibility}}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="196"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="236"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="30"/>
                                      <RowDefinition Height="26"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Instance}" Style="{StaticResource Project.LadderInstance}"/>
                                    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Primer.ProjectFunctionBox}"/>
                                    <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Primer.ProjectFunctionTitle}">
                                      <TextBlock Text="{Binding Box}" Style="{StaticResource Project.LadderOperand}" TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold" ToolTip="{Binding Box}"/>
                                    </Border>
                                    <Grid Grid.Row="2">
                                      <Border Height="1" Style="{StaticResource Primer.ProjectWire}"/>
                                      <TextBlock Text="{Binding Enable}" Style="{StaticResource Project.LadderArgument}" Background="{DynamicResource Primer.card}"
                                        HorizontalAlignment="Center" ToolTip="{Binding Enable}" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="EN" Style="{StaticResource Project.LadderPin}" Margin="8,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="ENO" Style="{StaticResource Project.LadderPin}" HorizontalAlignment="Right" Margin="8,0"/>
                                    <ItemsControl Grid.Row="3" Grid.ColumnSpan="2" ItemsSource="{Binding Inputs}" Margin="0,0,0,8">
                                      <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Height="26">
                                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="60"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding Parameter}" Style="{StaticResource Project.LadderArgument}" HorizontalAlignment="Right"/>
                                          <Border Grid.Column="1" Height="1" Style="{StaticResource Primer.ProjectWire}"/>
                                          <TextBlock Grid.Column="2" Text="{Binding Label}" Style="{StaticResource Project.LadderPin}" Margin="8,0"/>
                                        </Grid>
                                      </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" ItemsSource="{Binding Outputs}" Margin="0,0,0,8">
                                      <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Height="26">
                                          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                          <TextBlock Text="{Binding Label}" Style="{StaticResource Project.LadderPin}" HorizontalAlignment="Right" Margin="8,0"/>
                                          <Border Grid.Column="1" Height="1" Style="{StaticResource Primer.ProjectWire}"/>
                                          <TextBlock Grid.Column="2" Text="{Binding Parameter}" Style="{StaticResource Project.LadderArgument}"/>
                                        </Grid>
                                      </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="4" Margin="14,6"
                                      Visibility="{Binding HasUnclassified,Converter={StaticResource BoolToVisibility}}">
                                      <TextBlock Text="{l:Tr Project.PinDirectionUnknown}" Style="{StaticResource Project.Caption}"/>
                                      <ItemsControl ItemsSource="{Binding Unclassified}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Style="{StaticResource Primer.Mono}"><Run Text="{Binding Name,Mode=OneWay}"/> = <Run Text="{Binding Parameter,Mode=OneWay}"/></TextBlock>
                                      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                    </StackPanel>
                                  </Grid>
                                </Viewbox>
                              </Border>
                              <Border Style="{StaticResource Primer.ProjectRail}" Padding="0,8" MinHeight="84"
                                Visibility="{Binding HasElements,Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Description}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><ItemsControl ItemsSource="{Binding Elements}">
                                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel MinWidth="166">
                                      <TextBlock Text="{Binding Operand}" Style="{StaticResource Project.LadderOperand}" HorizontalAlignment="Center" Margin="8,0"/>
                                      <Grid Height="38">
                                        <Border Height="1.6" VerticalAlignment="Center" Style="{StaticResource Primer.ProjectWire}"/>
                                        <Grid Background="{DynamicResource Primer.card}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                          <Path Style="{StaticResource Project.LadderContact}" AutomationProperties.Name="{Binding Symbol}"/>
                                          <TextBlock Text="{Binding CoilMark}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            FontSize="{DynamicResource Ui.FontSize.9}" Style="{StaticResource Primer.Mono}"/>
                                        </Grid>
                                      </Grid>
                                      <TextBlock Text="{Binding Address}" Style="{StaticResource Project.Caption}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                  </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl></Viewbox>
                              </Border>
                            </Grid>
                          </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          <Border Grid.Row="1" Style="{StaticResource Primer.ProjectCodePanel}" x:Name="CodePanel" Padding="0"
            HorizontalAlignment="Stretch">
            <DockPanel>
              <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <ItemsControl x:Name="SourceRows" Margin="14,12" ItemsSource="{Binding Engineering.TextLines}" AlternationCount="2147483647">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <DockPanel MinHeight="24" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Primer.CodeLineNumber}"
                          Text="{Binding (ItemsControl.AlternationIndex),RelativeSource={RelativeSource AncestorType=ContentPresenter},
                            Converter={StaticResource Project.LineNumber}}"/>
                        <views:ProjectSourceLine SourceText="{Binding}" LanguageName="{Binding DataContext.Engineering.FocusedBlock.Language,
                          RelativeSource={RelativeSource AncestorType=ItemsControl}}" Style="{StaticResource Primer.CodeText}"/>
                      </DockPanel>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding Engineering.SourceStatus}" Style="{StaticResource Primer.Muted}" Margin="16,12" TextWrapping="Wrap"
                  AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Engineering.SourceStatus}"/>
              </Grid>
            </DockPanel>
          </Border>
          </Grid>
          <Border x:Name="InterfacePanel" Style="{StaticResource Primer.ProjectLayoutSurface}" Visibility="Collapsed">
            <Grid>
              <DataGrid ItemsSource="{Binding Engineering.Members}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                AutomationProperties.Name="{l:Tr Project.Interface}" HeadersVisibility="Column" ColumnHeaderStyle="{StaticResource Project.TagHeader}"
                Visibility="{Binding Engineering.HasMembers,Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="{l:Tr Project.Section}" Binding="{Binding Section}" Width="110"/>
                  <DataGridTextColumn Header="{l:Tr Primer.Name}" Binding="{Binding Name}" Width="200"/>
                  <DataGridTextColumn Header="{l:Tr Primer.Type}" Binding="{Binding Datatype}" Width="120"/>
                  <DataGridTextColumn Header="{l:Tr Project.Comment}" Binding="{Binding Comment}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{l:Tr Project.NoInterface}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"
                Visibility="{Binding Engineering.HasMembers,Converter={StaticResource NotBoolToVisibility}}"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Border>
    <DockPanel x:Name="NodeDocument" Visibility="Collapsed">
      <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}"><DockPanel>
        <Border DockPanel.Dock="Left" x:Name="NodeBadge" Style="{StaticResource Primer.ProjectNodeBadge}" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
          <TextBlock x:Name="NodeKind" FontWeight="SemiBold" Style="{StaticResource Primer.Mono}"/>
        </Border>
        <Border x:Name="HmiReadOnlyBadge" DockPanel.Dock="Right" Style="{StaticResource Primer.Tag}" VerticalAlignment="Center">
          <TextBlock Text="{l:Tr Project.ReadOnlyHmi}"/>
        </Border>
        <TextBlock x:Name="NodeSubtitle" DockPanel.Dock="Right" Style="{StaticResource Project.Caption}" Margin="8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="NodeTitle" Style="{StaticResource Primer.Mono}" FontWeight="SemiBold"/>
      </DockPanel></Border>
      <ScrollViewer x:Name="NodeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="NodeColumn" Style="{StaticResource Primer.PageColumn}" Margin="24">
      <Border x:Name="HmiMetrics" Style="{StaticResource Primer.ProjectResultCard}" Margin="0,0,0,24" Padding="0">
        <UniformGrid Columns="3">
          <StackPanel Margin="16"><TextBlock Text="{l:Tr Project.HmiScreens}" Style="{StaticResource Project.Caption}"/>
            <TextBlock Text="{Binding Engineering.HmiScreens,TargetNullValue=—}" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.18}" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Margin="16"><TextBlock Text="{l:Tr Project.HmiTags}" Style="{StaticResource Project.Caption}"/>
            <TextBlock Text="{Binding Engineering.HmiTags,TargetNullValue=—}" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.18}" FontWeight="SemiBold"/>
          </StackPanel>
          <StackPanel Margin="16"><TextBlock Text="{l:Tr Project.HmiAlarms}" Style="{StaticResource Project.Caption}"/>
            <TextBlock Text="{Binding Engineering.HmiAlarms,TargetNullValue=—}" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.18}" FontWeight="SemiBold"/>
          </StackPanel>
        </UniformGrid>
      </Border>
      <Border Style="{StaticResource Primer.ProjectResultCard}" Padding="20">
        <StackPanel>
          <TextBlock x:Name="NodeHeading" Style="{StaticResource Primer.ContainerTitle}"/>
          <TextBlock x:Name="NodeDescription" Style="{StaticResource Project.Caption}"/>
          <ItemsControl x:Name="UnitMembers" ItemsSource="{Binding Engineering.SelectedUnit.Children}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Click="OnOpenUnitMember" ContentTemplate="{x:Null}" HorizontalAlignment="Left"
                Style="{StaticResource Primer.Button.Primary.Small}" Margin="0,8,0,0"
                AutomationProperties.Name="{Binding Name}" ToolTip="{l:Tr Project.OpenUnitBlock}">
                <TextBlock><TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} {1} →">
                    <Binding Source="{x:Static l:Loc.Current}" Path="[Project.OpenUnitBlock]"/>
                    <Binding Path="Name"/>
                  </MultiBinding>
                </TextBlock.Text></TextBlock>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl x:Name="NodeItems"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Style="{StaticResource Primer.ProjectHeaderLine}" Padding="16,10"><TextBlock Text="{Binding}" Style="{StaticResource Primer.Mono}"/></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{Binding Engineering.UnitSourceFile}" Style="{StaticResource Project.Caption}" TextWrapping="Wrap"/>
          <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding Engineering.UnitSource}" Style="{StaticResource Primer.Mono}"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
      </StackPanel></ScrollViewer>
    </DockPanel>
    <ux:WorkbenchState x:Name="EmptyBlocks" Style="{StaticResource Primer.Workbench.EmptyState}" Visibility="Collapsed"
      Title="{l:Tr Shell.EmptyBlocks}" Description="{l:Tr Shell.ImportBlocksHint}" ActionLabel="{l:Tr Shell.ImportBlocks}"/>
    <ux:WorkbenchState x:Name="SourceError" Style="{StaticResource Primer.Workbench.ErrorState}" Visibility="Collapsed"
      Title="{Binding Engineering.SourceErrorTitle}" Description="{Binding Engineering.SourceStatus}" Details="{Binding Engineering.SourcePath}"
      Hint="{l:Tr Shell.SourceHint}" ActionLabel="{l:Tr Shell.RetryRead}" ActionCommand="{Binding Engineering.RetrySource}"
      ExportCommand="{x:Static ux:WorkbenchCommands.ExportDiagnostics}"/>
    </Grid>
    <views:EngineeringOptionsView x:Name="Options"/>
  </Grid>
</UserControl>
