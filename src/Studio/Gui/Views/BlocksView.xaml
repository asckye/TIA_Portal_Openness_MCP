<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PageRoot" x:Class="TiaOpenness.Gui.Views.BlocksView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border x:Name="BlocksHeaderCard" Style="{StaticResource Primer.Container}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="160"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="{l:Tr Tree.ProgramBlocks}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Tag.BlocksSubtitle,ElementName=PageRoot}" Style="{StaticResource Primer.Muted}" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBox x:Name="ControlFilter" Grid.Column="1" Text="{Binding Engineering.BlockFilter,UpdateSourceTrigger=PropertyChanged}" Tag="{l:Tr Pages.Filter}" Style="{StaticResource Primer.Input}" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="{l:Tr Primer.SelectAll}" Click="OnSelectAll" Style="{StaticResource Primer.Secondary}" Margin="14,0,0,0"/>
        <Button Grid.Column="3" Content="{l:Tr Primer.Clear}" Click="OnSelectNone" Style="{StaticResource Primer.Secondary}" Margin="14,0,0,0"/>
      </Grid>
    </Border>
    <Border x:Name="BlocksCard" Grid.Row="2" Style="{StaticResource Primer.TableContainer}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Primer.HeaderStrip}">
          <Grid>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{l:Tr Pages.Options}" Click="OnExportOptions" Style="{StaticResource Primer.Quiet}"/>
              <Button DockPanel.Dock="Right" Content="{l:Tr Common.Reload}" Command="{Binding Engineering.Refresh}" Style="{StaticResource Primer.Quiet}" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Tag.BlocksSummary,ElementName=PageRoot}" Style="{StaticResource Primer.Muted}" FontSize="11.5"/>
            </DockPanel>
          </Grid>
        </Border>
        <Border Style="{StaticResource Primer.ColumnHeaderStrip}" Grid.Row="1">
          <Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width=".45*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width=".45*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width=".6*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width=".8*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Primer.Name}" Style="{StaticResource Primer.Muted}" Grid.Column="2" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Primer.Type}" Style="{StaticResource Primer.Muted}" Grid.Column="4" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Primer.Number}" Style="{StaticResource Primer.Muted}" Grid.Column="6" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Primer.Language}" Style="{StaticResource Primer.Muted}" Grid.Column="8" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Primer.Group}" Style="{StaticResource Primer.Muted}" Grid.Column="10" FontSize="10" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Primer.Consistent}" Style="{StaticResource Primer.Muted}" Grid.Column="12" FontSize="10" FontWeight="SemiBold"/>
            </Grid>
          </Grid>
        </Border>
        <ListBox x:Name="BlocksList" Grid.Row="2" ItemsSource="{Binding Engineering.BlocksView}" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.BlockItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="1.5*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width=".45*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width=".45*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width=".6*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="1.4*"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width=".8*"/>
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected}" Style="{StaticResource Primer.Checkbox}"/>
                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontWeight="Medium" ToolTip="{Binding Name}"/>
                <TextBlock Grid.Column="4" Text="{Binding Kind}" Style="{StaticResource Primer.Text}"/>
                <TextBlock Grid.Column="6" Text="{Binding Number}" Style="{StaticResource Primer.Mono.text}"/>
                <TextBlock Grid.Column="8" Text="{Binding Language}" Style="{StaticResource Primer.Text}"/>
                <TextBlock Grid.Column="10" Style="{StaticResource Primer.Muted}" FontSize="12" Text="{Binding Path,Converter={StaticResource Primer.Value},ConverterParameter=group}" ToolTip="{Binding Path}"/>
                <TextBlock Grid.Column="12" Style="{StaticResource Primer.ConsistencyText}">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="consistent">
                      <Binding Path="Info.IsConsistent"/>
                      <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Style="{StaticResource Primer.FooterStrip}" Grid.Row="3">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel>
              <Button x:Name="ExportButton" Click="OnExport" IsEnabled="{Binding Tag.HasSelection,ElementName=PageRoot}" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0">
                <Button.Content>
                  <MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="export">
                    <Binding Path="Engineering.SourceFormat"/>
                    <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                  </MultiBinding>
                </Button.Content>
              </Button>
              <Button Content="{l:Tr Pages.Import}" Command="{Binding Engineering.Import}" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
              <Border Width="1" Height="22" Margin="0,0,8,0" Style="{StaticResource Primer.Plain}"/>
              <Button x:Name="ViewLadderButton" Content="{l:Tr Pages.ViewLadder}" Click="OnViewLadder" IsEnabled="{Binding Atlas.CanViewBlock,ElementName=PageRoot}" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
              <Button x:Name="GenerateAtlasButton" Content="{l:Tr Pages.GenerateAtlas}" Click="OnGenerateAtlas" IsEnabled="{Binding Atlas.CanGenerate,ElementName=PageRoot}" Style="{StaticResource Primer.Secondary}"/>
            </WrapPanel>
            <Button Grid.Column="1" Content="{l:Tr Primer.CompileSoftware}" Command="{Binding Engineering.Compile}" Style="{StaticResource Primer.OutlinedAccent}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
          </Grid>
        </Border>
        <Border x:Name="AtlasFooter" Style="{StaticResource Primer.FooterStrip}" Grid.Row="4" Visibility="{Binding Atlas.Visible,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
          <Border x:Name="AtlasBar" Padding="12,10" Visibility="{Binding Atlas.Visible,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.AtlasState}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Ellipse Width="8" Height="8" Fill="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}"/>
              <TextBlock Grid.Column="1" Text="{Binding Atlas.Label,ElementName=PageRoot}" FontSize="11.5" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding Atlas.Detail,ElementName=PageRoot}" ToolTip="{Binding Atlas.Detail,ElementName=PageRoot}" Style="{StaticResource Primer.Mono}"/>
              <ProgressBar Grid.Column="3" Width="120" Height="4" Maximum="100" Value="{Binding Atlas.Percent,ElementName=PageRoot,Mode=OneWay}" Margin="12,0,0,0" Visibility="{Binding Atlas.Running,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
              <Button Grid.Column="3" Content="{l:Tr Common.Open}" Click="OnOpenAtlas" Style="{StaticResource Primer.OutlinedAccent}" Margin="12,0,0,0" Visibility="{Binding Atlas.Done,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
          </Border>
        </Border>
      </Grid>
    </Border>
    <views:EngineeringOptionsView x:Name="Options" Grid.RowSpan="3"/>
  </Grid>
</UserControl>
