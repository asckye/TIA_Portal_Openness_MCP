<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PageRoot" x:Class="TiaOpenness.Gui.Views.BlocksView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="14" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Border x:Name="BlocksHeaderCard" Style="{StaticResource Glass.Card}" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <TextBlock Text="{l:Tr Tree.ProgramBlocks}" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="{Binding Tag.BlocksSubtitle,ElementName=PageRoot}" Style="{StaticResource Glass.Muted}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <TextBox Grid.Column="1" Text="{Binding Engineering.BlockFilter,UpdateSourceTrigger=PropertyChanged}" Tag="{l:Tr Pages.Filter}" Style="{StaticResource Glass.Field}" VerticalAlignment="Center" />
        <Button Grid.Column="2" Content="{l:Tr Glass.SelectAll}" Click="OnSelectAll" Style="{StaticResource Glass.Button}" Margin="14,0,0,0" Padding="12,0" />
        <Button Grid.Column="3" Content="{l:Tr Glass.Clear}" Click="OnSelectNone" Style="{StaticResource Glass.Button}" Margin="14,0,0,0" Padding="12,0" />
      </Grid>
    </Border>
    <Border x:Name="BlocksCard" Grid.Row="2" Style="{StaticResource Glass.Card}" Padding="20,14,20,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="24" />
          <RowDefinition Height="28" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Tr Pages.Options}" Click="OnExportOptions" Style="{StaticResource Glass.Quiet}" />
          <Button DockPanel.Dock="Right" Content="{l:Tr Common.Reload}" Command="{Binding Engineering.Refresh}" Style="{StaticResource Glass.Quiet}" Margin="0,0,12,0" />
          <TextBlock Text="{Binding Tag.BlocksSummary,ElementName=PageRoot}" Style="{StaticResource Glass.Muted}" FontSize="11.5" />
        </DockPanel>
        <Grid Grid.Row="1" Margin="12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width=".45*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width=".45*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width=".6*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width=".8*" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{l:Tr Glass.Name}" Style="{StaticResource Glass.Muted}" Grid.Column="2" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="{l:Tr Glass.Type}" Style="{StaticResource Glass.Muted}" Grid.Column="4" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="{l:Tr Glass.Number}" Style="{StaticResource Glass.Muted}" Grid.Column="6" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="{l:Tr Glass.Language}" Style="{StaticResource Glass.Muted}" Grid.Column="8" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="{l:Tr Glass.Group}" Style="{StaticResource Glass.Muted}" Grid.Column="10" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="{l:Tr Glass.Consistent}" Style="{StaticResource Glass.Muted}" Grid.Column="12" FontSize="10" FontWeight="Bold" />
        </Grid>
        <ListBox x:Name="BlocksList" Grid.Row="2" ItemsSource="{Binding Engineering.BlocksView}" Style="{StaticResource Glass.List}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Glass.Row}">
              <Setter Property="Height" Value="36" />
              <Setter Property="Margin" Value="0,3,0,0" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnBlockRowClick" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Ui.BlockSelection}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="1.5*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width=".45*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width=".45*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width=".6*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width=".8*" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected}" Style="{StaticResource Glass.Check}" />
                <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Glass.Text}" FontWeight="Medium" ToolTip="{Binding Name}" />
                <TextBlock Grid.Column="4" Text="{Binding Kind}" Style="{StaticResource Glass.Text}" />
                <TextBlock Grid.Column="6" Text="{Binding Number}" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.Label}" />
                <TextBlock Grid.Column="8" Text="{Binding Language}" Style="{StaticResource Glass.Text}" />
                <TextBlock Grid.Column="10" Style="{StaticResource Glass.Muted}" FontSize="12" Text="{Binding Path,Converter={StaticResource Glass.Value},ConverterParameter=group}" ToolTip="{Binding Path}" />
                <TextBlock Grid.Column="12">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Muted}">
                      <Setter Property="FontSize" Value="12" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Info.IsConsistent}" Value="False">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.Orange}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="consistent">
                      <Binding Path="Info.IsConsistent" />
                      <Binding Source="{x:Static l:Loc.Current}" Path="Language" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <WrapPanel>
            <Button x:Name="ExportButton" Click="OnExport" IsEnabled="{Binding Tag.HasSelection,ElementName=PageRoot}" Style="{StaticResource Glass.Button}" Padding="14,0" Margin="0,0,8,0">
              <Button.Content>
                <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="export">
                  <Binding Path="Engineering.SourceFormat" />
                  <Binding Source="{x:Static l:Loc.Current}" Path="Language" />
                </MultiBinding>
              </Button.Content>
            </Button>
            <Button Content="{l:Tr Pages.Import}" Command="{Binding Engineering.Import}" Style="{StaticResource Glass.Button}" Padding="14,0" Margin="0,0,8,0" />
            <Border Width="1" Height="22" Background="{DynamicResource Ui.Separator}" Margin="0,0,8,0" />
            <Button x:Name="ViewLadderButton" Content="{l:Tr Pages.ViewLadder}" Click="OnViewLadder" IsEnabled="{Binding Atlas.CanViewBlock,ElementName=PageRoot}" Style="{StaticResource Glass.Button}" Padding="14,0" Margin="0,0,8,0" />
            <Button x:Name="GenerateAtlasButton" Content="{l:Tr Pages.GenerateAtlas}" Click="OnGenerateAtlas" IsEnabled="{Binding Atlas.CanGenerate,ElementName=PageRoot}" Style="{StaticResource Glass.Button}" Padding="14,0" />
          </WrapPanel>
          <Button Grid.Column="1" Content="{l:Tr Glass.CompileSoftware}" Command="{Binding Engineering.Compile}" Style="{StaticResource Glass.Outline}" Padding="16,0" FontWeight="Bold" BorderThickness="1.5" Margin="8,0,0,0" VerticalAlignment="Bottom" />
        </Grid>
        <Border x:Name="AtlasBar" Grid.Row="4" Margin="0,10,0,0" Padding="12,10" CornerRadius="10" Visibility="{Binding Atlas.Visible,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}" />
              <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Accent}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Atlas.Failed,ElementName=PageRoot}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}" />
                  <Setter Property="TextElement.Foreground" Value="{DynamicResource Ui.Orange}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="8" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8" Fill="{Binding Path=(TextElement.Foreground),RelativeSource={RelativeSource AncestorType=Border}}" />
            <TextBlock Grid.Column="1" Text="{Binding Atlas.Label,ElementName=PageRoot}" FontSize="11.5" FontWeight="SemiBold" Margin="12,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Atlas.Detail,ElementName=PageRoot}" ToolTip="{Binding Atlas.Detail,ElementName=PageRoot}" Style="{StaticResource Glass.Mono}" />
            <ProgressBar Grid.Column="3" Width="120" Height="4" Maximum="100" Value="{Binding Atlas.Percent,ElementName=PageRoot,Mode=OneWay}" Margin="12,0,0,0" Visibility="{Binding Atlas.Running,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}" />
            <Button Grid.Column="3" Content="{l:Tr Common.Open}" Click="OnOpenAtlas" Style="{StaticResource Glass.Outline}" Height="26" Margin="12,0,0,0" Visibility="{Binding Atlas.Done,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}" />
          </Grid>
        </Border>
      </Grid>
    </Border>
    <views:EngineeringOptionsView x:Name="Options" Grid.RowSpan="3" />
  </Grid>
</UserControl>
