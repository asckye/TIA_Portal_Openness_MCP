<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.ApprovalsDrawer">
  <Grid Margin="22,14,22,22">
    <Border Padding="16,24" Visibility="{Binding RequestsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Inset}">
      <StackPanel>
        <TextBlock Text="{l:Tr Shell.NoPending}" FontSize="{DynamicResource Ui.FontSize.SmallTitle}" FontWeight="SemiBold"/>
        <TextBlock Text="{l:Tr Shell.NoPendingDescription}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <ListBox AutomationProperties.Name="{l:Tr Shell.PendingTitle}" x:Name="RequestList" Style="{StaticResource Primer.VirtualList}" ItemsSource="{Binding Requests}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="0" Margin="0,0,0,16" Style="{StaticResource Primer.PendingRequest}">
            <StackPanel>
              <Border Padding="12,0" MinHeight="38" Style="{StaticResource Primer.CardHead}">
                <DockPanel VerticalAlignment="Center">
                  <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding Tone}">
                    <TextBlock Text="{Binding State}" Style="{StaticResource Primer.StatusText}"/>
                  </ContentControl>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Client}" FontWeight="SemiBold"/>
                    <Border Padding="6,1" Margin="8,0" Style="{StaticResource Primer.Chip}">
                      <TextBlock Text="{Binding Request.Transport}" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Request.Host}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" ToolTip="{Binding Request.Host}"/>
                </DockPanel>
              </Border>
              <StackPanel Margin="12,12,12,12">
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="72"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition MinHeight="24"/>
                  <RowDefinition MinHeight="24"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Tr Approval.Project}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Request.Project}" Style="{StaticResource Primer.Mono.text}" FontSize="{DynamicResource Ui.FontSize.Caption}" ToolTip="{Binding Request.Project}"/>
                <TextBlock Grid.Row="1" Text="{l:Tr Common.Plc}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Request.Plc}" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              </Grid>
              <Border Padding="10,6" Style="{StaticResource Primer.InputSurface}" Visibility="{Binding IsToolRequest, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Request.Operations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="29">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="106"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Action}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Primer.Text.warn}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Object}" FontSize="{DynamicResource Ui.FontSize.Caption}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Object}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Tool}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}" ToolTip="{Binding Tool}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding IsGenerationPlan, Converter={StaticResource BoolToVisibility}}">
                <TreeView AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationDifferences}" MaxHeight="180" Background="Transparent" BorderThickness="0">
                  <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/></HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <DataGrid AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationSteps}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200" Margin="0,6,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Common.Id}" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="{l:Tr Approval.Phase}" Binding="{Binding Phase}" Width="100"/>
                    <DataGridTextColumn Header="{l:Tr Calls.Target}" Binding="{Binding Key}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr Calls.Tool}" Binding="{Binding Tool}" Width="180"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Button AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Content="{l:Tr Approval.CompletePlan}" Style="{StaticResource Primer.Quiet}" Click="OnPlan"/>
                <Border Padding="12" Margin="0,8,0,0" Style="{StaticResource Primer.CodeBlock}" Visibility="{Binding PlanOpen, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=AccessibleField1}" x:Name="AccessibleLabel1" Content="{l:Tr Approval.CompletePlan}" Target="{Binding ElementName=AccessibleField1}" Style="{StaticResource Primer.FormLabel}"/>
<TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel1}" x:Name="AccessibleField1" AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Text="{Binding CompletePlan, Mode=OneWay}" IsReadOnly="True" MaxHeight="300" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Primer.Input}"/></StackPanel>
                </Border>
              </StackPanel>
              <DockPanel Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Metadata}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}" Margin="4,0,0,0"/>
                <ItemsControl ItemsSource="{Binding Request.Risks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="7,3" Margin="0,0,5,4" Style="{StaticResource Primer.WarningBadge}">
                        <TextBlock Text="{Binding}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold" Style="{StaticResource Primer.Text.warn}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <StackPanel Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding CountdownTone}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                  <TextBlock Text="{l:Tr Approval.AutoReject}" Style="{StaticResource Primer.Muted}"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource Primer.Progress}" Value="{Binding Percent, Mode=OneWay}" Tag="{Binding CountdownTone}" Margin="0,6,0,10"/>
              </StackPanel>
              <StackPanel>
                <Button AutomationProperties.Name="{l:Tr Approval.Parameters}" Content="{l:Tr Approval.Parameters}" Style="{StaticResource Primer.Link}" Click="OnParameters" HorizontalAlignment="Right"/>
                <Grid Margin="0,8,0,0" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button AutomationProperties.Name="{l:Tr Approval.Deny}" x:Name="DenyRequest" Content="{l:Tr Approval.Deny}" Style="{StaticResource Primer.Answer}" IsDefault="False" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnDeny"/>
                  <Button Grid.Column="2" AutomationProperties.Name="{l:Tr Approval.Approve}" x:Name="ApproveRequest" Content="{l:Tr Approval.Approve}" Style="{StaticResource Primer.Answer}" IsDefault="False" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnApprove"/>
                </Grid>
              </StackPanel>
              <Border Padding="10,8" Margin="0,8,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Inset}">
                <TextBlock Text="{Binding Note}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
              </Border>
              <Border Padding="12" Margin="0,10,0,0" Visibility="{Binding JsonOpen, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.CodeBlock}">
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/>
                </ScrollViewer>
              </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
