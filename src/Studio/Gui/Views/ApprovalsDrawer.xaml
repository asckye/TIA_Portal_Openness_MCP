<UserControl x:Class="TiaOpenness.Gui.Views.ApprovalsDrawer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <Grid Margin="22,14,22,22">
      <Border Padding="16,24" Background="{DynamicResource Ui.ControlBackground}" CornerRadius="12" Visibility="{Binding RequestsEmpty, Converter={StaticResource BoolToVisibility}}">
        <StackPanel><TextBlock Text="{l:Tr Shell.NoPending}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{l:Tr Shell.NoPendingDescription}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
      </Border>
      <ListBox x:Name="RequestList" Style="{StaticResource Feature.VirtualList}" ItemsSource="{Binding Requests}"><ListBox.ItemTemplate><DataTemplate>
        <Border CornerRadius="14" Padding="16,14" Margin="0,0,0,12" BorderThickness="1">
          <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Ui.FieldBorder}"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Pending}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Ui.AccentSoftBorder}"/><Setter Property="Background" Value="{DynamicResource Ui.CardBackground}"/></DataTrigger></Style.Triggers></Style></Border.Style>
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Right" Style="{StaticResource Feature.Tint}" Tag="{Binding Tone}" Padding="8,3"><TextBlock Text="{Binding State}" Style="{StaticResource Feature.Text}" Tag="{Binding Tone}" FontSize="10" FontWeight="Bold"/></Border>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding Request.Client}" FontSize="13" FontWeight="Bold"/><Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="8" Padding="6,2" Margin="8,0"><TextBlock Text="{Binding Request.Transport}" Style="{StaticResource Glass.Mono}" FontSize="9"/></Border></StackPanel>
              <TextBlock Text="{Binding Request.Host}" Style="{StaticResource Glass.Muted}" FontSize="10.5" ToolTip="{Binding Request.Host}"/>
            </DockPanel>
            <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="18"/><RowDefinition Height="18"/></Grid.RowDefinitions>
              <TextBlock Text="{l:Tr Approval.Project}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Column="1" Text="{Binding Request.Project}" Style="{StaticResource Glass.Mono}" FontSize="10.5" Foreground="{DynamicResource Ui.Label}" ToolTip="{Binding Request.Project}"/>
              <TextBlock Grid.Row="1" Text="PLC" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Request.Plc}" Style="{StaticResource Glass.Text}" FontSize="11"/>
            </Grid>
            <Border Background="{DynamicResource Ui.FieldBackground}" CornerRadius="10" Padding="10,6">
              <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Request.Operations}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Grid Height="29"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="106"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Action}" Foreground="{DynamicResource Ui.Orange}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Object}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Object}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Tool}" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="10" ToolTip="{Binding Tool}"/>
                  </Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </ScrollViewer>
            </Border>
            <DockPanel Margin="0,12,0,0">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Metadata}" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="9.5" Margin="4,0,0,0"/>
              <ItemsControl ItemsSource="{Binding Request.Risks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Ui.WarningSoft}" CornerRadius="10" Padding="7,3" Margin="0,0,5,4"><TextBlock Text="{Binding}" Foreground="{DynamicResource Ui.Orange}" FontSize="10.5" FontWeight="SemiBold"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </DockPanel>
            <StackPanel Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Remaining, StringFormat={}{0}s}" Style="{StaticResource Feature.Text}" Tag="{Binding CountdownTone}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11"/><TextBlock Text="{l:Tr Approval.AutoReject}" Style="{StaticResource Glass.Muted}"/></DockPanel>
              <ProgressBar Style="{StaticResource Feature.Progress}" Value="{Binding Percent, Mode=OneWay}" Tag="{Binding CountdownTone}" Margin="0,6,0,10"/>
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="{l:Tr Approval.Parameters}" Style="{StaticResource Glass.Quiet}" Foreground="{DynamicResource Ui.Accent}" FontWeight="Bold" Click="OnParameters"/>
              <StackPanel Orientation="Horizontal" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="ApproveRequest" Content="{l:Tr Approval.Approve}" Style="{StaticResource Glass.Primary}" Tag="" Height="32" IsEnabled="{Binding CanDecide}" Click="OnApprove"/>
                <Button Content="{l:Tr Approval.Deny}" Style="{StaticResource Glass.Button}" Height="32" IsEnabled="{Binding CanDecide}" Margin="8,0,0,0" Click="OnDeny"/>
              </StackPanel>
            </DockPanel>
            <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="8" Padding="10,8" Margin="0,8,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding Note}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/></Border>
            <Border Background="{DynamicResource Ui.CodeBackground}" CornerRadius="10" Padding="12" Margin="0,10,0,0" Visibility="{Binding JsonOpen, Converter={StaticResource BoolToVisibility}}"><ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Parameters}" Style="{StaticResource Feature.Code}"/></ScrollViewer></Border>
          </StackPanel>
        </Border>
      </DataTemplate></ListBox.ItemTemplate></ListBox>
  </Grid>
</UserControl>
