<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.ApprovalsDrawer">
  <Grid Margin="22,14,22,22">
    <Border Padding="16,24" Visibility="{Binding RequestsEmpty, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Inset}">
      <StackPanel>
        <TextBlock Text="{l:Tr Shell.NoPending}" FontSize="13" FontWeight="SemiBold"/>
        <TextBlock Text="{l:Tr Shell.NoPendingDescription}" Style="{StaticResource Primer.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
    <ListBox x:Name="RequestList" Style="{StaticResource Primer.VirtualList}" ItemsSource="{Binding Requests}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="16,14" Margin="0,0,0,12" Style="{StaticResource Primer.PendingRequest}">
            <StackPanel>
              <DockPanel>
                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding Tone}">
                  <TextBlock Text="{Binding State}" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Client}" FontSize="13" FontWeight="SemiBold"/>
                  <Border Padding="6,2" Margin="8,0" Style="{StaticResource Primer.Chip}">
                    <TextBlock Text="{Binding Request.Transport}" Style="{StaticResource Primer.Mono}" FontSize="9"/>
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Request.Host}" Style="{StaticResource Primer.Muted}" FontSize="10.5" ToolTip="{Binding Request.Host}"/>
              </DockPanel>
              <Grid Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="18"/>
                  <RowDefinition Height="18"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Tr Approval.Project}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding Request.Project}" Style="{StaticResource Primer.Mono.text}" FontSize="10.5" ToolTip="{Binding Request.Project}"/>
                <TextBlock Grid.Row="1" Text="PLC" Style="{StaticResource Primer.Muted}"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Request.Plc}" Style="{StaticResource Primer.Text}" FontSize="11"/>
              </Grid>
              <Border Padding="10,6" Style="{StaticResource Primer.InputSurface}">
                <ScrollViewer MaxHeight="118" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Request.Operations}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="29">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="106"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Action}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Primer.Text.warn}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Object}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{Binding Object}"/>
                          <TextBlock Grid.Column="2" Text="{Binding Tool}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="10" ToolTip="{Binding Tool}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <DockPanel Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Metadata}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="9.5" Margin="4,0,0,0"/>
                <ItemsControl ItemsSource="{Binding Request.Risks}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="7,3" Margin="0,0,5,4" Style="{StaticResource Primer.WarningBadge}">
                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" Style="{StaticResource Primer.Text.warn}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <StackPanel Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Remaining, StringFormat={}{0}s}" Style="{StaticResource Primer.ToneText}" Tag="{Binding CountdownTone}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11"/>
                  <TextBlock Text="{l:Tr Approval.AutoReject}" Style="{StaticResource Primer.Muted}"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource Primer.Progress}" Value="{Binding Percent, Mode=OneWay}" Tag="{Binding CountdownTone}" Margin="0,6,0,10"/>
              </StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Approval.Parameters}" Style="{StaticResource Primer.Quiet}" Click="OnParameters"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
                  <Button x:Name="ApproveRequest" Content="{l:Tr Approval.Approve}" Style="{StaticResource Primer.Run}" IsEnabled="{Binding CanDecide}" Click="OnApprove"/>
                  <Button Content="{l:Tr Approval.Deny}" Style="{StaticResource Primer.Secondary}" IsEnabled="{Binding CanDecide}" Margin="8,0,0,0" Click="OnDeny"/>
                </StackPanel>
              </DockPanel>
              <Border Padding="10,8" Margin="0,8,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Inset}">
                <TextBlock Text="{Binding Note}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
              </Border>
              <Border Padding="12" Margin="0,10,0,0" Visibility="{Binding JsonOpen, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.CodeBlock}">
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
