<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.ApprovalsDrawer" PreviewKeyDown="OnDecisionKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Style="{StaticResource Primer.IdeBar}">
      <ux:PageHeadPanel VerticalAlignment="Center">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Pages.AgentTabs}"/>
        <Border Style="{StaticResource Primer.Chip}" Height="26">
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding ApprovalPolicyTone}" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding ApprovalPolicy}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
      </ux:PageHeadPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="PageBody">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="RequestListPane" Width="262" Panel.ZIndex="2" HorizontalAlignment="Left" Style="{StaticResource Primer.ApprovalListPane}">
        <ListBox x:Name="RequestList" Margin="10" AutomationProperties.Name="{l:Tr Shell.PendingTitle}"
          Style="{StaticResource Primer.VirtualList}" ItemContainerStyle="{StaticResource Primer.ApprovalItem}"
          ItemsSource="{Binding Requests}" SelectedItem="{Binding SelectedRequest, Mode=OneWay}" SelectionChanged="OnSelectionChanged"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding FeedTime}" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.FeedMetadata}"/>
                  <Ellipse DockPanel.Dock="Left" Style="{StaticResource Primer.StatusDot}" Tag="{Binding Tone}" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding FeedKind}" Style="{StaticResource Primer.FeedMetadata}"/>
                </DockPanel>
                <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="SemiBold" Margin="0,4,0,2"/>
                <TextBlock Text="{Binding ObjectPreview}" ToolTip="{Binding FirstObject}" Style="{StaticResource Primer.FeedMetadata}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Grid Grid.Column="1" MaxWidth="820" Margin="28" VerticalAlignment="Top">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer x:Name="DetailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
          Visibility="{Binding RequestsEmpty, Converter={StaticResource NotBoolToVisibility}}">
          <StackPanel x:Name="Detail" DataContext="{Binding SelectedRequest}">
            <DockPanel Margin="0,0,0,16">
              <Border x:Name="TimerChip" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Primer.ApprovalTimerChip}" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding Tone}" Margin="0,0,5,0"/>
                  <TextBlock x:Name="CountdownCaption" Text="{Binding TimerLabel}" Foreground="{Binding Path=(TextElement.Foreground),ElementName=TimerChip}" ToolTip="{l:Tr Approval.AutoReject}"
                    TextWrapping="Wrap" VerticalAlignment="Center" FontFamily="{DynamicResource Ui.FontMono}"/>
                </StackPanel>
              </Border>
              <StackPanel>
                <TextBlock Text="{Binding Metadata}" ToolTip="{Binding Context}" Style="{StaticResource Primer.Mono.textFaint}" TextWrapping="Wrap"/>
                <TextBlock x:Name="RequestTitle" Text="{Binding Summary}" AutomationProperties.Name="{Binding Summary}" Focusable="True"
                  FontSize="{DynamicResource Ui.FontSize.18}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Style="{StaticResource Primer.Container}" Padding="0" Margin="0,0,0,16">
              <UniformGrid Rows="1">
                <Border Style="{StaticResource Primer.FeatureCell}">
                  <StackPanel>
                    <TextBlock Text="{l:Tr Approval.Controller}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock Text="{Binding Target}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,3,0,0" ToolTip="{Binding Request.ProjectIdentity}"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Primer.FeatureCell}">
                  <StackPanel>
                    <TextBlock Text="{l:Tr Approval.Change}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock Text="{Binding Change}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Primer.Plain}" Padding="16,10">
                  <StackPanel>
                    <TextBlock Text="{l:Tr Approval.Safeguard}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock Text="{Binding Safeguard}" TextWrapping="Wrap" FontWeight="Medium" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
            </Border>
            <Border Style="{StaticResource Primer.Container}" Padding="0">
              <StackPanel>
                <Border Style="{StaticResource Primer.IdeSubBar}" Padding="16,0">
                  <TextBlock Text="{l:Tr Approval.Operations}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>
                <ItemsControl x:Name="ToolOperations" ItemsSource="{Binding Request.Operations}" Margin="16,8"
                  Visibility="{Binding IsToolRequest, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Object}" TextTrimming="None" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.textFaint}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding DestructiveFields}" Margin="16,0" ItemTemplate="{StaticResource Approval.FieldRow}"/>
                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsGenerationPlan, Converter={StaticResource BoolToVisibility}}">
                  <TreeView AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationDifferences}" MaxHeight="180" Background="Transparent" BorderThickness="0">
                    <TreeView.ItemTemplate>
                      <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/></HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                  </TreeView>
                  <DataGrid AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationSteps}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200" Margin="0,6,0,0">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="{l:Tr Common.Id}" Binding="{Binding Id}" Width="70"/>
                      <DataGridTextColumn Header="{l:Tr Approval.Phase}" Binding="{Binding Phase}" Width="100"/>
                      <DataGridTextColumn Header="{l:Tr Calls.Target}" Binding="{Binding Key}" Width="*"/>
                      <DataGridTextColumn Header="{l:Tr Calls.Tool}" Binding="{Binding Tool}" Width="180" ElementStyle="{StaticResource Primer.Mono.textFaint}"/>
                    </DataGrid.Columns>
                  </DataGrid>
                  <Button AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Content="{l:Tr Approval.CompletePlan}" Style="{StaticResource Primer.Quiet}" Click="OnPlan"/>
                  <Border Padding="12" Margin="0,8,0,0" Style="{StaticResource Primer.CodeBlock}" Visibility="{Binding PlanOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                      <Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=AccessibleField1}" x:Name="AccessibleLabel1" Content="{l:Tr Approval.CompletePlan}" Target="{Binding ElementName=AccessibleField1}" Style="{StaticResource Primer.FormLabel}"/>
                      <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel1}" x:Name="AccessibleField1" AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Text="{Binding CompletePlan, Mode=OneWay}" IsReadOnly="True" MaxHeight="300" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Primer.Input}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <DockPanel Margin="16,8">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Request.PlanHash}" ToolTip="{Binding Request.PlanHash}" MaxWidth="100"
                    Style="{StaticResource Primer.Mono.textFaint}" Margin="8,0,0,0"/>
                  <Expander AutomationProperties.Name="{l:Tr Approval.Parameters}" Header="{l:Tr Approval.Parameters}"
                    IsExpanded="{Binding JsonOpen, Mode=TwoWay}" Style="{StaticResource Primer.Expander}">
                    <StackPanel>
                      <TextBlock Text="{l:Tr Approval.DataOnly}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" Margin="0,6"/>
                      <TextBlock Text="{Binding Context}" TextWrapping="Wrap" Style="{StaticResource Primer.Mono.textFaint}"/>
                      <Border Style="{StaticResource Primer.CodeBlock}" Padding="12" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                          <TextBlock Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/>
                        </ScrollViewer>
                      </Border>
                    </StackPanel>
                  </Expander>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Padding="12" Margin="0,12,0,0" Style="{StaticResource Primer.Inset}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/></Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Padding="16,12" Style="{StaticResource Primer.ApprovalDecisionPane}"
          Visibility="{Binding SelectedRequest.Pending, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <Grid x:Name="DecisionArea" DataContext="{Binding SelectedRequest}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MaxWidth="200"/><ColumnDefinition Width="Auto" MaxWidth="220"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding DecisionHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <Button x:Name="DenyRequest" MaxWidth="200" Grid.Column="1" AutomationProperties.Name="{Binding DenyLabel}" Content="{Binding DenyLabel}" Style="{StaticResource Primer.DenyRequest}" MinHeight="32" IsDefault="{Binding Destructive}" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnDeny"/>
            <Button x:Name="ApproveRequest" MaxWidth="212" Grid.Column="2" Margin="8,0,0,0" AutomationProperties.Name="{Binding ApproveLabel}" Content="{Binding ApproveLabel}" Style="{StaticResource Primer.ApproveRequest}" MinHeight="32" IsDefault="False" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnApprove"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.Column="1" Margin="24" Padding="32" Style="{StaticResource Primer.Inset}" Visibility="{Binding RequestsEmpty, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="✓" HorizontalAlignment="Center" FontSize="{DynamicResource Ui.FontSize.Heading}"/>
          <TextBlock Text="{Binding RequestsEmptyTitle}" FontSize="{DynamicResource Ui.FontSize.SmallTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
          <TextBlock Text="{l:Tr Shell.NoPendingDescription}" Visibility="{Binding HandledRequests, Converter={StaticResource NotBoolToVisibility}}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmationSheet" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Ant.colorBgMask}" DataContext="{Binding SelectedRequest}" AutomationProperties.Name="{Binding ConfirmationTitle}">
      <!-- Centre on the window, accounting for the rail and the difference between title and status bar heights. -->
      <Border Margin="-36,12,24,24" Padding="24" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Primer.DangerSheet}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <Border Style="{StaticResource Primer.Tag.Err}" Width="28" Height="28" Margin="0,0,10,0">
              <TextBlock Text="!" FontSize="{DynamicResource Ui.FontSize.Heading}" Foreground="{DynamicResource Ant.colorError}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{Binding ConfirmationTitle}" FontSize="{DynamicResource Ui.FontSize.15_5}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </DockPanel>
          <TextBlock Text="{Binding ConfirmationConsequence}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{Binding DestructiveFields}" ItemTemplate="{StaticResource Approval.FieldRow}" Margin="0,12,0,0" Style="{StaticResource Primer.DestructiveFields}"/>
          <TextBlock Text="{l:Tr Approval.SheetHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,12,0,20"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="CancelDestructive" AutomationProperties.Name="{l:Tr Approval.CancelDefault}" Content="{l:Tr Approval.CancelDefault}" Style="{StaticResource Primer.Button.Primary.Large}" MinHeight="36" IsDefault="True" IsCancel="True" Click="OnCancelDestructive"/>
            <Button x:Name="ConfirmDestructive" Grid.Column="2" AutomationProperties.Name="{Binding ConfirmationAccessible}" Content="{Binding ConfirmationAction}" Style="{StaticResource Primer.ApprovalConfirm}" MinHeight="36" IsDefault="False" IsCancel="False" Click="OnConfirmDestructive"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
