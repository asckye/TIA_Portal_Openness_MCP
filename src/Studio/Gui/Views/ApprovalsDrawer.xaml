<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.ApprovalsDrawer" PreviewKeyDown="OnDecisionKeyDown">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Border Margin="16,8,16,12" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="WaitingTab" AutomationProperties.Name="{Binding WaitingLabel}" Content="{Binding WaitingLabel}" Style="{StaticResource Primer.Segment}" GroupName="ApprovalHistory" IsChecked="True" Checked="OnWaiting"/>
        <RadioButton x:Name="HandledTab" AutomationProperties.Name="{l:Tr Approval.Handled}" Content="{l:Tr Approval.Handled}" Style="{StaticResource Primer.Segment}" GroupName="ApprovalHistory" Checked="OnHandled"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" x:Name="PageBody">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="RequestListPane" BorderBrush="{DynamicResource Primer.divider}" BorderThickness="0,0,1,0">
        <ListBox x:Name="RequestList" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Style="{StaticResource Primer.VirtualList}" ItemContainerStyle="{StaticResource Primer.ApprovalItem}" ItemsSource="{Binding VisibleRequests}" SelectedItem="{Binding SelectedRequest, Mode=TwoWay}" SelectionChanged="OnSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Primer.Chip}"><TextBlock Text="{Binding RiskIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding UnverifiedClient}" FontSize="{DynamicResource Ui.FontSize.Caption}" Margin="0,4,0,4"/>
                  <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Ui.FontSize.Caption}"/><TextBlock Text="{Binding Risk}" FontSize="{DynamicResource Ui.FontSize.Caption}"/></DockPanel>
                  <TextBlock Text="{Binding State}" FontSize="{DynamicResource Ui.FontSize.Caption}" Visibility="{Binding Pending, Converter={StaticResource NotBoolToVisibility}}"/>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding RequestsEmpty, Converter={StaticResource NotBoolToVisibility}}">
        <StackPanel x:Name="Detail" Margin="24,12,24,24" DataContext="{Binding SelectedRequest}">
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
          <TextBlock x:Name="RequestTitle" Text="{Binding Summary}" AutomationProperties.Name="{Binding Summary}" Focusable="True" FontSize="{DynamicResource Ui.FontSize.Title}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"/>
          <WrapPanel Margin="0,12,0,16">
            <Border Style="{StaticResource Primer.Chip}" Margin="0,0,8,4"><TextBlock Text="{Binding Risk}"/></Border>
            <Border Style="{StaticResource Primer.Chip}" Margin="0,0,8,4"><TextBlock Text="{Binding Actor}"/></Border>
            <Border Style="{StaticResource Primer.Chip}" Margin="0,0,0,4"><TextBlock Text="{Binding Request.Id}" Style="{StaticResource Primer.Mono}" ToolTip="{Binding Request.Id}"/></Border>
          </WrapPanel>
            </StackPanel>
          <StackPanel Grid.Column="1" Width="120" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
            <Grid Width="64" Height="64" HorizontalAlignment="Center" AutomationProperties.Name="{Binding RemainingText}" AutomationProperties.LiveSetting="Off">
              <Ellipse Stroke="{DynamicResource Primer.divider}" StrokeThickness="3" Margin="1.5"/>
              <Path Data="{Binding CountdownArc}" StrokeThickness="3" Style="{StaticResource Primer.ApprovalRing}"/>
              <TextBlock Text="{Binding Remaining}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Primer.Mono}"/>
            </Grid>
            <TextBlock x:Name="CountdownCaption" Text="{l:Tr Approval.AutoReject}" Width="120" TextAlignment="Center" Margin="0,8,0,0" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
          </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition MinHeight="28"/><RowDefinition MinHeight="28"/><RowDefinition MinHeight="28"/><RowDefinition MinHeight="28"/></Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Approval.Project}" Style="{StaticResource Primer.Muted}" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="1" Text="{Binding Request.Project}" ToolTip="{Binding Request.ProjectIdentity}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{l:Tr Common.Plc}" Style="{StaticResource Primer.Muted}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Request.Plc}"/>
            <TextBlock Grid.Row="2" Text="{l:Tr Approval.Transport}" Style="{StaticResource Primer.Muted}" Margin="0,0,16,0"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Request.Transport}"/>
            <TextBlock Grid.Row="3" Text="{l:Tr Approval.HostVersion}" Style="{StaticResource Primer.Muted}" Margin="0,0,16,0"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HostVersion}" TextWrapping="Wrap"/>
          </Grid>
          <ItemsControl x:Name="ToolOperations" ItemsSource="{Binding Request.Operations}" Visibility="{Binding IsToolRequest, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Primer.Inset}" Padding="12" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Action}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1"><TextBlock Text="{Binding Object}" TextWrapping="Wrap"/><TextBlock Text="{Binding Tool}" Style="{StaticResource Primer.Mono.textFaint}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding IsGenerationPlan, Converter={StaticResource BoolToVisibility}}">
                <TreeView AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationDifferences}" MaxHeight="180" Background="Transparent" BorderThickness="0">
                  <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Text}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/></HierarchicalDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
                <DataGrid AutomationProperties.Name="{l:Tr Approval.CompletePlan}" ItemsSource="{Binding GenerationSteps}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200" Margin="0,6,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr Common.Id}" Binding="{Binding Id}" Width="70"/>
                    <DataGridTextColumn Header="{l:Tr Approval.Phase}" Binding="{Binding Phase}" Width="100"/>
                    <DataGridTextColumn Header="{l:Tr Calls.Target}" Binding="{Binding Key}" Width="*"/>
                    <DataGridTextColumn Header="{l:Tr Calls.Tool}" Binding="{Binding Tool}" Width="180" ElementStyle="{StaticResource Primer.Mono.textFaint}"/>
                  </DataGrid.Columns>
                </DataGrid>
                <Button AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Content="{l:Tr Approval.CompletePlan}" Style="{StaticResource Primer.Quiet}" Click="OnPlan"/>
                <Border Padding="12" Margin="0,8,0,0" Style="{StaticResource Primer.CodeBlock}" Visibility="{Binding PlanOpen, Converter={StaticResource BoolToVisibility}}">
                  <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=AccessibleField1}" x:Name="AccessibleLabel1" Content="{l:Tr Approval.CompletePlan}" Target="{Binding ElementName=AccessibleField1}" Style="{StaticResource Primer.FormLabel}"/>
<TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel1}" x:Name="AccessibleField1" AutomationProperties.Name="{l:Tr Approval.CompletePlan}" Text="{Binding CompletePlan, Mode=OneWay}" IsReadOnly="True" MaxHeight="300" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{StaticResource Primer.Input}"/></StackPanel>
                </Border>
              </StackPanel>

          <ItemsControl ItemsSource="{Binding Request.Risks}" Margin="0,8,0,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Primer.WarningBadge}" Padding="8,4" Margin="0,0,8,4"><TextBlock Text="{Binding}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Metadata}" Style="{StaticResource Primer.Mono.textFaint}" TextWrapping="Wrap" Margin="0,8,0,8"/>
          <TextBlock Text="{l:Tr Approval.DataOnly}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" Margin="0,8,0,12"/>
          <Expander AutomationProperties.Name="{l:Tr Approval.Parameters}" Header="{l:Tr Approval.Parameters}" IsExpanded="{Binding JsonOpen, Mode=TwoWay}">
            <Border Style="{StaticResource Primer.CodeBlock}" Padding="12" Margin="0,8,0,0"><ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/></ScrollViewer></Border>
          </Expander>
          <Border Padding="12" Margin="0,12,0,0" Style="{StaticResource Primer.Inset}" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding Note}" TextWrapping="Wrap"/></Border>
        </StackPanel>
      </ScrollViewer>
        <Border Grid.Row="1" Padding="24,16" Background="{DynamicResource Primer.bg}" BorderBrush="{DynamicResource Primer.divider}" BorderThickness="0,1,0,0" Visibility="{Binding SelectedRequest.Pending, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
          <Grid x:Name="DecisionArea" DataContext="{Binding SelectedRequest}" Visibility="{Binding Pending, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="DenyRequest" AutomationProperties.Name="{l:Tr Approval.Deny}" Content="{l:Tr Approval.Deny}" Style="{StaticResource Primer.Answer}" MinHeight="44" IsDefault="{Binding Destructive}" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnDeny"/>
            <Button x:Name="ApproveRequest" Grid.Column="2" AutomationProperties.Name="{Binding ApproveLabel}" Content="{Binding ApproveLabel}" Style="{StaticResource Primer.Answer}" MinHeight="44" IsDefault="False" IsCancel="False" IsEnabled="{Binding CanDecide}" Click="OnApprove"/>
          </Grid>
        </Border>
      </Grid>
      <Border Grid.ColumnSpan="2" Margin="24" Padding="32" Style="{StaticResource Primer.Inset}" Visibility="{Binding RequestsEmpty, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="✓" HorizontalAlignment="Center" FontSize="{DynamicResource Ui.FontSize.Heading}"/>
          <TextBlock Text="{l:Tr Shell.NoPending}" FontSize="{DynamicResource Ui.FontSize.SmallTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,8"/>
          <TextBlock Text="{l:Tr Shell.NoPendingDescription}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmationSheet" Grid.RowSpan="2" Visibility="Collapsed" Background="{DynamicResource Ant.colorBgMask}" DataContext="{Binding SelectedRequest}" AutomationProperties.Name="{Binding ConfirmationTitle}">
      <Border Margin="24" Padding="24" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Primer.Inset}">
        <StackPanel>
          <TextBlock Text="!" FontSize="{DynamicResource Ui.FontSize.Heading}" Foreground="{DynamicResource Ant.colorError}"/>
          <TextBlock Text="{Binding ConfirmationTitle}" FontSize="{DynamicResource Ui.FontSize.DialogTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,8"/>
          <TextBlock Text="{Binding ConfirmationConsequence}" TextWrapping="Wrap" Margin="0,0,0,20"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="CancelDestructive" AutomationProperties.Name="{l:Tr Approval.Cancel}" Content="{l:Tr Approval.Cancel}" Style="{StaticResource Primer.Answer}" MinHeight="44" IsDefault="True" IsCancel="True" Click="OnCancelDestructive"/>
            <Button x:Name="ConfirmDestructive" Grid.Column="2" AutomationProperties.Name="{Binding ConfirmationAccessible}" Content="{Binding ConfirmationAction}" Style="{StaticResource Primer.ApprovalConfirm}" MinHeight="44" IsDefault="False" IsCancel="False" Click="OnConfirmDestructive"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
