<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.AuditLogView">
  <Grid SizeChanged="OnPageSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Grid.Row="1" KeyboardNavigation.TabIndex="1">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.TableContainer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Primer.ColumnHeaderStrip}">
            <Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.1*" MinWidth="116"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.6*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width=".8*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Audit.SequenceTime}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="2" Text="{l:Tr Audit.Event}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="4" Text="{l:Tr Audit.Object}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="6" Text="{l:Tr Calls.Result}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="8" Text="{l:Tr Audit.Hash}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="10" Text="{l:Tr Actor.Title}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
              </Grid>
            </Grid>
          </Border>
          <ListBox AutomationProperties.Name="{l:Tr Shell.Audit}" x:Name="AuditList" Grid.Row="1" Style="{StaticResource Primer.VirtualList}" ItemContainerStyle="{StaticResource Primer.TableItem}" ItemsSource="{Binding AuditRows}" SelectedItem="{Binding SelectedAudit, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="0" Height="{DynamicResource Ui.RowHeight}" Style="{StaticResource Primer.AuditSelectionRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="1.1*" MinWidth="116"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width=".8*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Sequence}" Style="{StaticResource Primer.Mono.text}"/>
                      <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="{Binding Record.ToolObject}" Style="{StaticResource Primer.Mono}" ToolTip="{Binding Record.ToolObject}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Result}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock Grid.Column="8" Text="{Binding ShortHash}" Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Grid.Column="10" Text="{Binding Actor}" Style="{StaticResource Primer.Muted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ContentControl Grid.Row="1" Style="{StaticResource Primer.Empty}" Content="{Binding AuditEmptyText}" Visibility="{Binding AuditEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
      </Border>
      <Border x:Name="AuditInspector" Grid.Row="1" Style="{StaticResource Primer.AuditInspector}"
        AutomationProperties.Name="{l:Tr Audit.Inspector}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="True" IsTabStop="True" AutomationProperties.Name="{l:Tr Audit.Inspector}">
          <StackPanel DataContext="{Binding SelectedAudit}">
            <WrapPanel>
              <TextBlock Text="{Binding Sequence}" Style="{StaticResource Primer.Mono.text}" FontWeight="SemiBold" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Type}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}"/>
            </WrapPanel>
            <TextBlock Text="{Binding Record.ToolObject}" Style="{StaticResource Primer.ContainerTitle}" TextWrapping="Wrap" Margin="0,4"/>
            <WrapPanel Margin="0,0,0,8">
              <TextBlock Text="{Binding Record.Time, StringFormat=yyyy-MM-dd HH:mm:ss zzz}" Style="{StaticResource Primer.Mono}" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
              <TextBlock Text="{Binding Actor}" Style="{StaticResource Primer.Muted}"/>
            </WrapPanel>
            <Border Style="{StaticResource Primer.CodeBlock}" Padding="12,8">
              <StackPanel>
                <TextBlock Text="{l:Tr Audit.PreviousHash}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock x:Name="PreviousHashText" Text="{Binding PreviousHash}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None"/>
                <TextBlock Text="{l:Tr Audit.CurrentHash}" Style="{StaticResource Primer.Muted}" Margin="0,8,0,0"/>
                <TextBlock x:Name="HashText" Text="{Binding Hash}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <StackPanel KeyboardNavigation.TabIndex="0">
      <Border Style="{StaticResource Primer.IdeBar}">
        <ux:PageHeadPanel VerticalAlignment="Center" Spacing="4">
          <WrapPanel VerticalAlignment="Center">
            <Button AutomationProperties.Name="{l:Tr Audit.Latest}" Content="{l:Tr Audit.Latest}" Style="{StaticResource Primer.IdeToolButton}" Click="OnLatest" Margin="0,0,4,0"/>
            <Button AutomationProperties.Name="{l:Tr Audit.Older}" Content="{l:Tr Audit.Older}" Style="{StaticResource Primer.IdeToolButton}" Click="OnOlder" Margin="0,0,8,0"/>
            <ToggleButton x:Name="ChainToggle" AutomationProperties.Name="{l:Tr Audit.About}" Content="{l:Tr Audit.About}" Style="{StaticResource Primer.Filter}"/>
            <TextBlock Text="{Binding AuditCount}" Style="{StaticResource Primer.Muted}" Margin="8,0"/>
          </WrapPanel>
          <WrapPanel VerticalAlignment="Center">
            <Label x:Name="AuditSearchLabel" Target="{Binding ElementName=AuditSearchBox}" Content="{l:Tr Audit.Search}" AutomationProperties.Name="{l:Tr Audit.Search}" Style="{StaticResource Primer.FormLabel}" Visibility="Collapsed"/>
            <TextBox x:Name="AuditSearchBox" AutomationProperties.Name="{l:Tr Audit.Search}" AutomationProperties.LabeledBy="{Binding ElementName=AuditSearchLabel}"
              Tag="{l:Tr Audit.Search}" Style="{StaticResource Primer.IdeSearch}" Width="184" Height="28" Text="{Binding AuditSearch, UpdateSourceTrigger=PropertyChanged}"/>
            <ToggleButton x:Name="DetailsToggle" AutomationProperties.Name="{l:Tr Audit.Inspector}" Content="{l:Tr Audit.Inspector}" Style="{StaticResource Primer.Filter}" IsChecked="True" Margin="4,0"/>
            <Button AutomationProperties.Name="{l:Tr Audit.Verify}" x:Name="VerifyButton" ToolTip="{l:Tr Pages.AuditPurpose}" AutomationProperties.HelpText="{l:Tr Pages.AuditPurpose}" Content="{l:Tr Audit.Verify}" Style="{StaticResource Primer.IdeToolButton}" ContentTemplate="{StaticResource Primer.CommandText}" Click="OnVerify"/>
          </WrapPanel>
        </ux:PageHeadPanel>
      </Border>
      <Border x:Name="ChainHint" Style="{StaticResource Primer.IdeSubBar}" Padding="12,8" Visibility="{Binding IsChecked, ElementName=ChainToggle, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <TextBlock Text="{l:Tr Audit.AboutText}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
          <TextBlock Text="{l:Tr Audit.Limitation}" Style="{StaticResource Primer.Muted.textFaint}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border x:Name="VerificationBanner" Style="{StaticResource Primer.ToneChip}" Tag="{Binding VerificationTone}" MinHeight="38" Padding="12,10" Margin="0,4" Visibility="{Binding HasVerification, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button AutomationProperties.Name="{l:Tr Audit.Jump}" x:Name="JumpButton" DockPanel.Dock="Right" Content="{l:Tr Audit.Jump}" Style="{StaticResource Primer.Quiet}" MinHeight="24" Visibility="{Binding VerificationBroken, Converter={StaticResource BoolToVisibility}}" Click="OnJump"/>
          <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding VerificationTone}" Margin="0,0,10,0"/>
          <TextBlock Text="{Binding VerificationText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding VerificationTone}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        </DockPanel>
      </Border>
      <ProgressBar Value="{Binding VerificationProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding Verifying, Converter={StaticResource BoolToVisibility}}"/>
    </StackPanel>
  </Grid>
</UserControl>
