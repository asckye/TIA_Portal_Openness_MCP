<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.AuditLogView">
  <Grid ux:ResponsiveLayout.Enabled="True">
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="16"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="0"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.PageHead}">
        <StackPanel>
          <ux:PageHeadPanel MinHeight="32">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Tr Shell.Audit}" FontSize="{DynamicResource Ui.FontSize.Title}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
              <TextBlock Text="{Binding AuditCount}" Style="{StaticResource Primer.Muted}" Margin="12,0,0,0"/>
            </StackPanel>
            <Button AutomationProperties.Name="{l:Tr Audit.Verify}" x:Name="VerifyButton" Content="{l:Tr Audit.Verify}" Style="{StaticResource Primer.OutlinedAccent}" Click="OnVerify"/>
          </ux:PageHeadPanel>
          <Border x:Name="VerificationBanner" Style="{StaticResource Primer.ToneChip}" Tag="{Binding VerificationTone}" MinHeight="38" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding HasVerification, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button AutomationProperties.Name="{l:Tr Audit.Jump}" x:Name="JumpButton" DockPanel.Dock="Right" Content="{l:Tr Audit.Jump}" Style="{StaticResource Primer.Quiet}" MinHeight="24" Visibility="{Binding VerificationBroken, Converter={StaticResource BoolToVisibility}}" Click="OnJump"/>
              <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding VerificationTone}" Margin="0,0,10,0"/>
              <TextBlock Text="{Binding VerificationText}" Style="{StaticResource Primer.ToneText}" Tag="{Binding VerificationTone}" FontWeight="SemiBold" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            </DockPanel>
          </Border>
          <ProgressBar Value="{Binding VerificationProgress, Mode=OneWay}" Maximum="100" Height="4" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding Verifying, Converter={StaticResource BoolToVisibility}}"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button AutomationProperties.Name="{l:Tr Audit.Older}" Content="{l:Tr Audit.Older}" Style="{StaticResource Primer.Quiet}" Click="OnOlder"/>
            <Button AutomationProperties.Name="{l:Tr Audit.Latest}" Content="{l:Tr Audit.Latest}" Style="{StaticResource Primer.Quiet}" Margin="14,0,0,0" Click="OnLatest"/>
          </StackPanel>
          <TextBlock Text="{l:Tr Audit.Limitation}" Style="{StaticResource Primer.Muted.textFaint}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Primer.TableContainer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Primer.ColumnHeaderStrip}">
            <Grid>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.1*" MinWidth="116"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="1.6*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width=".8*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="70"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="74"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="2" Text="{l:Tr Audit.Event}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="4" Text="{l:Tr Audit.Object}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="6" Text="{l:Tr Calls.Result}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="8" Text="{l:Tr Audit.Hash}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
                <TextBlock Grid.Column="10" Text="{l:Tr Actor.Title}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
              </Grid>
            </Grid>
          </Border>
          <ListBox AutomationProperties.Name="{l:Tr Shell.Audit}" x:Name="AuditList" Grid.Row="1" Style="{StaticResource Primer.VirtualList}" ItemsSource="{Binding AuditRows}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,0" Height="34" Style="{StaticResource Primer.AuditSelectionRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="62"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="1.1*" MinWidth="116"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width=".8*"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="70"/>
                      <ColumnDefinition Width="10"/>
                      <ColumnDefinition Width="74"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Type}" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="4" Text="{Binding Record.ToolObject}" Style="{StaticResource Primer.Mono}" ToolTip="{Binding Record.ToolObject}"/>
                    <TextBlock Grid.Column="6" Text="{Binding Result}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock Grid.Column="8" Text="{Binding Record.Hash}" Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Grid.Column="10" Text="{Binding Actor}" Style="{StaticResource Primer.Muted}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ContentControl Grid.Row="1" Style="{StaticResource Primer.Empty}" Content="{l:Tr Shell.AuditEmpty}" Visibility="{Binding AuditEmpty, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.Container}">
        <StackPanel>
          <TextBlock Text="{l:Tr Audit.Retention}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,0,12"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="74"/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="38"/>
              <RowDefinition Height="Auto" MinHeight="38"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Audit.FileSize}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
            <Border Grid.Column="1" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Primer.SegmentGroup}">
              <StackPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.Name="{l:Tr Audit.Size5}" x:Name="Size5" Tag="5" Content="{l:Tr Audit.Size5}" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditSize" Click="OnSize"/>
                <RadioButton AutomationProperties.Name="{l:Tr Audit.Size10}" x:Name="Size10" Tag="10" Content="{l:Tr Audit.Size10}" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditSize" Click="OnSize"/>
                <RadioButton AutomationProperties.Name="{l:Tr Audit.Size50}" x:Name="Size50" Tag="50" Content="{l:Tr Audit.Size50}" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditSize" Click="OnSize"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Text="{l:Tr Audit.Copies}" Style="{StaticResource Primer.Muted}"/>
            <Border Grid.Row="1" Grid.Column="1" Padding="3" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource Primer.SegmentGroup}">
              <StackPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.Name="3" x:Name="Copies3" Tag="3" Content="3" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditCopies" Click="OnCopies"/>
                <RadioButton AutomationProperties.Name="5" x:Name="Copies5" Tag="5" Content="5" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditCopies" Click="OnCopies"/>
                <RadioButton AutomationProperties.Name="10" x:Name="Copies10" Tag="10" Content="10" Style="{StaticResource Primer.Segment}" Padding="6,0" GroupName="AuditCopies" Click="OnCopies"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="2" Text="{l:Tr Audit.Coverage}" Style="{StaticResource Primer.Muted}"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Coverage}" TextWrapping="Wrap" Style="{StaticResource Primer.ListValue}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
          </Grid>
          <Button AutomationProperties.Name="{l:Tr Audit.OpenFolder}" Content="{l:Tr Audit.OpenFolder}" Style="{StaticResource Primer.Secondary}" Margin="0,4,0,0" Click="OnOpenFolder"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Primer.Container}">
        <StackPanel>
          <TextBlock Text="{l:Tr Audit.About}" Style="{StaticResource Primer.ContainerTitle}"/>
          <TextBlock Text="{l:Tr Audit.AboutText}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
