<UserControl x:Class="TiaOpenness.Gui.Views.PlcTagsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeSubBar}">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Label x:Name="TableLabel" Content="{l:Tr Project.Table}" Target="{Binding ElementName=TablePath}"
          Style="{StaticResource Primer.FormLabel}" VerticalAlignment="Center"/>
        <TextBox x:Name="TablePath" Text="{Binding Engineering.TagTable,UpdateSourceTrigger=PropertyChanged}" Width="240"
          AutomationProperties.Name="{l:Tr Project.Table}" AutomationProperties.LabeledBy="{Binding ElementName=TableLabel}"
          AutomationProperties.HelpText="{l:Tr Project.TableScope}" ToolTip="{l:Tr Project.TableScope}"
          Tag="{l:Tr Project.TableHint}" Style="{StaticResource Primer.IdeSearch}" Margin="8,0"/>
        <Button x:Name="ReloadTags" Content="{l:Tr Common.Reload}" AutomationProperties.Name="{l:Tr Common.Reload}" Click="OnRead"
          IsEnabled="{Binding Engineering.CanReadTags}" Style="{StaticResource Primer.IdeToolButton}"/>
      </StackPanel>
    </Border>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Engineering.TagStatus}" ux:AccessibleStatus.Text="{Binding Engineering.TagStatus}"
      AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
    <DataGrid x:Name="TagRows" ItemsSource="{Binding Engineering.PlcTags}" AutomationProperties.Name="{l:Tr Project.Tags}" AutoGenerateColumns="False"
      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:Tr Primer.Name}" Binding="{Binding Name}" Width="*"/>
        <DataGridTextColumn Header="{l:Tr Primer.Type}" Binding="{Binding DataType}" Width="Auto"/>
        <DataGridTextColumn Header="{l:Tr Project.Address}" Binding="{Binding LogicalAddress}" Width="Auto"/>
        <DataGridTextColumn Header="{l:Tr Project.Table}" Binding="{Binding TableName}" Width="2*"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
