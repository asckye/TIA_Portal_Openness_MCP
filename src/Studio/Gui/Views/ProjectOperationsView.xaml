<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels" x:Name="PageRoot" x:Class="TiaOpenness.Gui.Views.ProjectOperationsView">
  <!-- 项目 page head: the project title and tags, its release and path, and the software, save and disconnect actions. -->
  <DockPanel>
    <!-- The options pane covers the whole 项目 page, not only this head: a zero-height canvas lets it overflow downwards. -->
    <Canvas DockPanel.Dock="Top" Height="0" Panel.ZIndex="1">
      <views:EngineeringOptionsView x:Name="Options" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}"/>
    </Canvas>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Visibility="{Binding HasMcpPanel,Converter={StaticResource BoolToVisibility}}">
      <Border Style="{StaticResource Primer.Container}">
        <StackPanel>
          <WrapPanel Margin="0,8,0,0">
            <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=SessionPicker}" x:Name="AccessibleLabel1" Content="{l:Tr Access.FieldSessionTitle}" Target="{Binding ElementName=SessionPicker}" Style="{StaticResource Primer.FormLabel}"/>
<ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel1}" AutomationProperties.Name="{l:Tr Session.Title}" x:Name="SessionPicker" ItemsSource="{Binding Panel.Sessions}" SelectedItem="{Binding Panel.Selected}" DisplayMemberPath="DisplayName" MinWidth="320" Style="{StaticResource Primer.Select}"/></StackPanel>
            <Button AutomationProperties.Name="{l:Tr Session.Refresh}" Content="{l:Tr Session.Refresh}" Command="{Binding Panel.Refresh}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
            <Button AutomationProperties.Name="{l:Tr Session.Attach}" Content="{l:Tr Session.Attach}" Command="{Binding Panel.Attach}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
            <Button AutomationProperties.Name="{l:Tr Session.Create}" Content="{l:Tr Session.Create}" Command="{Binding Panel.Create}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
            <Button AutomationProperties.Name="{l:Tr Session.Cancel}" Content="{l:Tr Session.Cancel}" Command="{Binding Panel.Cancel}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
            <Button AutomationProperties.Name="{l:Tr Session.Detach}" Content="{l:Tr Session.Detach}" Command="{Binding Panel.Detach}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
          </WrapPanel>
          <TextBlock Text="{Binding Panel.Participants}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          <TextBlock Text="{Binding Panel.Status}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Panel.Lane}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Panel.Ended}" TextWrapping="Wrap"/>
          <CheckBox AutomationProperties.Name="{l:Tr Session.Locked}" Style="{StaticResource Primer.Checkbox}" Content="{l:Tr Session.Locked}" IsChecked="{Binding Panel.Locked,Mode=OneWay}" IsHitTestVisible="False" Focusable="False"/>
        </StackPanel>
      </Border>
      <Expander AutomationProperties.Name="{l:Tr Session.Result}" Header="{l:Tr Session.Result}">
        <StackPanel>
        <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=AccessibleField2}" x:Name="AccessibleLabel2" Content="{l:Tr Access.FieldSessionResult}" Target="{Binding ElementName=AccessibleField2}" Style="{StaticResource Primer.FormLabel}"/>
<ComboBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel2}" x:Name="AccessibleField2" AutomationProperties.Name="{l:Tr Session.Result}" ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}" DisplayMemberPath="Label" Style="{StaticResource Primer.Select}"/></StackPanel>
        <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=McpEnvelopeResult}" x:Name="AccessibleLabel3" Content="{l:Tr Access.FieldSessionResult}" Target="{Binding ElementName=McpEnvelopeResult}" Style="{StaticResource Primer.FormLabel}"/>
<TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel3}" AutomationProperties.Name="{l:Tr Session.Result}" Style="{StaticResource Primer.Input}" x:Name="McpEnvelopeResult" Text="{Binding LastEnvelope,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Ui.FontMono}"/></StackPanel>
        </StackPanel>
      </Expander>
    </StackPanel>
  <Grid>
    <Border Style="{StaticResource Primer.Container}" Margin="0,0,0,16" Visibility="{Binding Tag.HasProject,ElementName=PageRoot,Converter={StaticResource NotBoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{l:Tr Blocks.Empty.Title}" Style="{StaticResource Primer.PageTitle}"/>
        <TextBlock Text="{l:Tr Pages.ConnectDescription}" Style="{StaticResource Primer.PageSubtitle}" TextWrapping="Wrap" Margin="0,4,0,16"/>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=ProjectPathInput}" x:Name="AccessibleLabel4" Content="{l:Tr Project.Label}" Target="{Binding ElementName=ProjectPathInput}" Style="{StaticResource Primer.FormLabel}"/>
<TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel4}" AutomationProperties.Name="{l:Tr Project.Label}" x:Name="ProjectPathInput" Text="{Binding Session.ProjectPath,UpdateSourceTrigger=PropertyChanged}" Tag="{l:Tr Project.Placeholder}" Style="{StaticResource Primer.Input}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Ui.FontSize.Caption}"/></StackPanel>
          <ux:PrefillMarker x:Name="ProjectPathMarker" Grid.Row="1" Target="{Binding ElementName=ProjectPathInput}" ClearRequested="OnClearProjectPrefill"/>
          <Button AutomationProperties.Name="{l:Tr Common.Browse}" Grid.Column="1" Content="{l:Tr Common.Browse}" Click="OnBrowseProject" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
          <Button AutomationProperties.Name="{l:Tr Toolbar.Connect}" x:Name="ConnectButton" Grid.Column="2" Content="{l:Tr Toolbar.Connect}" Click="OnConnect" Style="{StaticResource Primer.Run}" Margin="8,0,0,0" VerticalAlignment="Bottom" IsEnabled="{Binding Tag.CanConnect,ElementName=PageRoot}"/>
        </Grid>
        <DockPanel Margin="0,16,0,0">
          <Button AutomationProperties.Name="{l:Tr Pages.Options}" DockPanel.Dock="Right" Content="{l:Tr Pages.Options}" Click="OnProjectOptions" Style="{StaticResource Primer.Link}" MinHeight="24"/>
          <TextBlock Text="{l:Tr Pages.ConnectHint}" Style="{StaticResource Primer.Muted.textFaint}" TextWrapping="Wrap"/>
        </DockPanel>
      </StackPanel>
    </Border>
    <Border x:Name="ProjectCard" Style="{StaticResource Primer.PageHead}" Visibility="{Binding Tag.HasProject,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
      <!-- The actions stay beside the project name while it fits and wrap below the head otherwise. -->
      <ux:PageHeadPanel Spacing="16" Title="{Binding ElementName=ProjectTitle}">
        <StackPanel VerticalAlignment="Center">
          <WrapPanel>
            <TextBlock x:Name="ProjectTitle" Text="{Binding Session.ProjectName}" Style="{StaticResource Primer.PageTitle}" ToolTip="{Binding Session.ProjectName}" Margin="0,0,12,0"/>
            <ContentControl Style="{StaticResource Primer.StatusChip}" Tag="{x:Static vm:FeatureTone.Success}" Margin="0,0,8,0">
              <TextBlock Text="{l:Tr Primer.Bound}" Style="{StaticResource Primer.StatusText}"/>
            </ContentControl>
            <Border Style="{StaticResource Primer.Chip}">
              <TextBlock Text="{Binding Tag.ProjectKind,ElementName=PageRoot}" Style="{StaticResource Primer.Text.text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            </Border>
          </WrapPanel>
        </StackPanel>
        <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="560">
          <Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=SoftwarePicker}" x:Name="SoftwareLabel" Content="{l:Tr Access.Software}" Target="{Binding ElementName=SoftwarePicker}" Style="{StaticResource Primer.FormLabel}" VerticalAlignment="Center" Padding="0,0,8,0"/><ComboBox AutomationProperties.LabeledBy="{Binding ElementName=SoftwareLabel}" AutomationProperties.Name="{l:Tr Access.Software}" x:Name="SoftwarePicker" ItemsSource="{Binding Engineering.Devices}" SelectedItem="{Binding Engineering.SelectedDevice}" Style="{StaticResource Primer.Select}" VerticalAlignment="Center" MinWidth="150">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <TextBlock>
                  <Run Text="{Binding Name}"/>
                  <Run Text="{l:Tr Common.SoftwareSuffix}"/>
                </TextBlock>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button AutomationProperties.Name="{l:Tr Pages.Save}" Content="{l:Tr Pages.Save}" ToolTip="Ctrl+S" AutomationProperties.AcceleratorKey="Ctrl+S" Command="{Binding Engineering.Save}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
          <Button AutomationProperties.Name="{l:Tr Pages.Disconnect}" x:Name="DisconnectButton" Content="{l:Tr Pages.Disconnect}" Command="{Binding Session.Disconnect}" Style="{StaticResource Primer.Danger}" Margin="8,0,0,0"/>
          <Button AutomationProperties.Name="{l:Tr Pages.Options}" Click="OnProjectOptions" ToolTip="{l:Tr Pages.Options}" Style="{StaticResource Primer.IconButton}" Width="32" Height="32" Margin="4,0,0,0"><Path Style="{StaticResource Primer.ButtonIcon.Ellipsis}"/></Button>
        </WrapPanel>
      </ux:PageHeadPanel>
      <!-- The path line spans the whole head so long project paths trim at the right edge, not under the actions. -->
      <TextBlock Text="{Binding Session.ProjectPath}" Style="{StaticResource Primer.PageSubtitle}" FontFamily="{DynamicResource Ui.FontMono}" ToolTip="{Binding Session.ProjectPath}"/>
      </StackPanel>
    </Border>
  </Grid>
  </DockPanel>
</UserControl>
