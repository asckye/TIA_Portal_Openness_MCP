<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels" x:Name="PageRoot" x:Class="TiaOpenness.Gui.Views.ProjectOperationsView">
  <!-- 项目 page head: the project title and tags, its release and path, and the software, save and disconnect actions. -->
  <DockPanel>
    <!-- The options pane covers the whole 项目 page, not only this head: a zero-height canvas lets it overflow downwards. -->
    <Canvas DockPanel.Dock="Top" Height="0" Panel.ZIndex="1">
      <views:EngineeringOptionsView x:Name="Options" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=Grid}}" Height="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=Grid}}"/>
    </Canvas>
    <DockPanel x:Name="ProjectBackdrop">
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}"
      Visibility="{Binding Session.ShowConnectionForm,Converter={StaticResource BoolToVisibility}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="{l:Tr Project.Advanced}" AutomationProperties.Name="{l:Tr Project.Advanced}"
          Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnProjectOptions"/>
        <Button DockPanel.Dock="Right" Content="{l:Tr Project.Scan}" AutomationProperties.Name="{l:Tr Project.Scan}" Click="OnScan"
          Style="{StaticResource Primer.IdeToolButton}" IsEnabled="{Binding Session.ProcessScanAvailable}" Margin="0,0,8,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{l:Tr Project.ConnectTitle}" ToolTip="{l:Tr Pages.ConnectDescription}" Style="{StaticResource Primer.ContainerTitle}" Margin="0"/>
          <Border Style="{StaticResource Primer.Tag}" Margin="12,0"><TextBlock Text="{Binding Session.ConnectionLabel}"/></Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" x:Name="ProjectToolbar" Style="{StaticResource Primer.IdeBar}">
      <DockPanel VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="Reconnect" Content="{l:Tr Project.OfflineReconnect}" AutomationProperties.Name="{l:Tr Project.OfflineReconnect}"
            Visibility="{Binding Session.LostConnection,Converter={StaticResource BoolToVisibility}}"
            IsEnabled="{Binding Session.ProcessScanAvailable}" Click="OnReconnect"
            Style="{StaticResource Primer.ProjectReconnect}"/>
          <Button IsEnabled="{Binding Session.IsConnected}" x:Name="ExportMenuButton" Style="{StaticResource Primer.ProjectToolButton}"
            Tag="{StaticResource Icon.Link}" AutomationProperties.Name="{l:Tr Blocks.Export}"
            Click="OnExportMenu" ToolTip="{l:Tr Pages.TransferDescription}">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Download}" Style="{StaticResource Project.ButtonGlyph}"/><TextBlock Text="{l:Tr Project.TransferMenu}"/>
            </StackPanel>
            <Button.ContextMenu><ContextMenu Placement="Bottom">
              <MenuItem Header="{l:Tr Primer.Transfer}" Click="OnTransfer" ToolTip="{l:Tr Pages.NoSelection}"/>
              <MenuItem Header="{l:Tr Pages.Import}" HeaderTemplate="{StaticResource Primer.CommandText}" Click="OnImportDrawer"/>
              <MenuItem x:Name="ViewLadderAtlas" Header="{l:Tr Project.GenerateViewAtlas}" HeaderTemplate="{StaticResource Primer.CommandText}"/>
              <MenuItem Header="{l:Tr Project.ExportXml}" Click="OnExportXml"
                IsEnabled="{Binding Engineering.CanExportXml}"/>
              <MenuItem Header="{l:Tr Project.OpenXml}" Click="OnOpenXml"/>
              <Separator/>
              <MenuItem Header="{l:Tr Project.OpenConnect}" Command="{x:Static ux:WorkbenchCommands.Open}"
                CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+O"/>
              <MenuItem Header="{l:Tr Common.Reload}" Click="OnRefresh"/>
              <MenuItem Header="{l:Tr Pages.ViewLadder}" Click="OnRender" IsEnabled="{Binding Engineering.FocusedBlock.HasLadderOrFbd,FallbackValue=False}"/>
              <MenuItem Header="{l:Tr Pages.Options}" Click="OnProjectOptions"/>
              <MenuItem Header="{l:Tr Pages.Disconnect}" Command="{Binding Session.Disconnect}"/>
            </ContextMenu></Button.ContextMenu>
          </Button>
          <Button Tag="{StaticResource Icon.WorkbenchLayers}" ToolTip="{l:Tr Project.Atlas}"
            x:Name="GenerateAtlasItem" Content="{l:Tr Project.Atlas}" AutomationProperties.Name="{l:Tr Project.Atlas}"
            Style="{StaticResource Primer.ProjectToolButton}"/>
          <Button Tag="{StaticResource Icon.Audit}" ToolTip="{l:Tr Project.Rules}"
            x:Name="RulesButton" Content="{l:Tr Project.Rules}" AutomationProperties.Name="{l:Tr Project.Rules}" Click="OnOpenRules"
            Style="{StaticResource Primer.ProjectToolButton}"/>
          <Button Tag="{StaticResource Icon.Download}" ToolTip="{l:Tr Project.DownloadOptions}"
            x:Name="DownloadButton" Content="{l:Tr Project.DownloadOptions}" AutomationProperties.Name="{l:Tr Project.DownloadOptions}"
            IsEnabled="{Binding Session.IsConnected}" Click="OnDownload" Style="{StaticResource Primer.ProjectToolButton}"/>
          <Border Style="{StaticResource Primer.ProjectDivider}" Width="1" Margin="6,4"/>
          <Button x:Name="ToolbarCompile" IsDefault="{Binding IsChecked,ElementName=CompileTab}" AutomationProperties.Name="{l:Tr Pages.CompileSoftware}"
            Command="{Binding Engineering.Compile}" Content="{l:Tr Pages.CompileSoftware}" ContentTemplate="{StaticResource Primer.CommandText}"
            AutomationProperties.AcceleratorKey="Ctrl+B" ToolTip="Ctrl+B" Style="{StaticResource Primer.Button.Secondary.Small}"/>
          <Button x:Name="SaveButton" ContentTemplate="{x:Null}" AutomationProperties.Name="{l:Tr Pages.Save}" Command="{Binding Engineering.Save}"
            AutomationProperties.AcceleratorKey="Ctrl+S" ToolTip="Ctrl+S" Style="{StaticResource Primer.ProjectSave}" Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Project.ButtonGlyph}" Data="M2,2 H11 L14,5 V14 H2 Z M5,2 V6 H10 V2 M5,14 V9 H11 V14"/>
              <TextBlock Text="{l:Tr Project.Save}"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Border x:Name="DocumentTabs" DockPanel.Dock="Left" Style="{StaticResource Primer.SegmentGroup}" VerticalAlignment="Center"
          IsEnabled="{Binding Session.IsConnected}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RenderTab" GroupName="ProjectDocument" Content="{l:Tr Project.NetworkTab}"
              AutomationProperties.Name="{l:Tr Project.NetworkTab}" Style="{StaticResource Primer.ProjectRenderTab}" Click="OnRender"/>
            <RadioButton x:Name="InterfaceTab" GroupName="ProjectDocument" Content="{l:Tr Project.Interface}"
              AutomationProperties.Name="{l:Tr Project.Interface}" Style="{StaticResource Primer.ProjectInterfaceTab}" Click="OnInterface"/>
            <RadioButton x:Name="CompileTab" GroupName="ProjectDocument" AutomationProperties.Name="{l:Tr Toolbar.Compile}"
              ToolTip="{l:Tr Pages.CompileDescription}" Style="{StaticResource Primer.ProjectCompileTab}" Click="OnCompileResults">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Tr Project.DiagnosticTab}"/>
                <TextBlock Text="{Binding Engineering.DiagnosticCount}" Style="{StaticResource Primer.ProjectCompileCount}"/>
              </StackPanel>
            </RadioButton>
          </StackPanel>
        </Border>
        <Button x:Name="BlockReviewButton" DockPanel.Dock="Right" Visibility="Collapsed"
          Content="{l:Tr Project.PendingReview}" AutomationProperties.Name="{l:Tr Project.PendingReview}"
          Style="{StaticResource Primer.ProjectReviewCapsule}" Margin="6,0"/>
        <DockPanel x:Name="BlockIdentity" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0" ClipToBounds="True">
          <Border Style="{StaticResource Primer.ProjectDivider}" Width="1" Margin="0,2,8,2"/>
          <Border DataContext="{Binding Engineering.FocusedBlock}" Style="{StaticResource Primer.BlkBadge}" VerticalAlignment="Center">
            <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.BlkBadgeText}"/>
          </Border>
          <Ellipse DockPanel.Dock="Right" Style="{StaticResource Project.Dot}" ToolTip="{l:Tr Project.Modified}"
            Visibility="{Binding Engineering.FocusedBlock.IsModified,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}"/>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Engineering.FocusedBlock.Subtitle}" Style="{StaticResource Project.Caption}" Margin="5,0"/>
          <TextBlock Text="{Binding Engineering.FocusedBlock.Name}" Style="{StaticResource Primer.Mono}" Margin="6,0,0,0" FontWeight="SemiBold"
            ToolTip="{Binding Engineering.FocusedBlock.Path}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </DockPanel>
    </Border>
    <Border x:Name="EmptyToolbar" DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}" Visibility="Collapsed">
      <DockPanel><Button DockPanel.Dock="Right" Click="OnProjectOptions" Content="{l:Tr Project.OptionsTitle}"
          AutomationProperties.Name="{l:Tr Project.OptionsTitle}" Style="{StaticResource Primer.Button.Secondary.Small}"/>
        <TextBlock Text="{l:Tr Project.BlockWorkspace}" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
  <StackPanel x:Name="CrashDocument" DockPanel.Dock="Top" Visibility="{Binding Session.LostConnection,Converter={StaticResource BoolToVisibility}}">
    <Grid>
      <StackPanel x:Name="SnapshotColumn" Style="{StaticResource Primer.PageColumn}" Margin="24">
        <StackPanel Orientation="Horizontal">
          <Border DataContext="{Binding Engineering.Snapshot}" Style="{StaticResource Primer.BlkBadge}" Margin="0,0,8,0"><TextBlock Text="{Binding Kind}"
            Style="{StaticResource Primer.BlkBadgeText}"/></Border>
          <TextBlock Text="{Binding Engineering.Snapshot.BlockName}" Style="{StaticResource Primer.Mono}" FontWeight="SemiBold"/>
          <TextBlock Text="{l:Tr Project.Snapshot}" Style="{StaticResource Project.Caption}" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding Engineering.Snapshot.File}" Style="{StaticResource Project.Caption}" Margin="0,4,0,16"/>
        <Border Style="{StaticResource Primer.ProjectCodePanel}" Padding="0"><DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource Primer.ProjectHeaderLine}" Padding="16,9">
            <TextBlock Text="{Binding Engineering.Snapshot.DocumentPath}" Style="{StaticResource Project.Caption}"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="420">
            <ItemsControl ItemsSource="{Binding Engineering.Snapshot.Lines}" AlternationCount="2147483647" Margin="14,12">
              <ItemsControl.ItemTemplate><DataTemplate><DockPanel MinHeight="24">
                <TextBlock Style="{StaticResource Primer.CodeLineNumber}" Text="{Binding (ItemsControl.AlternationIndex),
                  RelativeSource={RelativeSource AncestorType=ContentPresenter},Converter={StaticResource Project.LineNumber}}"/>
                <views:ProjectSourceLine SourceText="{Binding}" Style="{StaticResource Primer.CodeText}"
                  LanguageName="{Binding DataContext.Engineering.Snapshot.Language,RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
              </DockPanel></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel></Border>
      </StackPanel>
    </Grid>
  </StackPanel>
  <Grid Visibility="{Binding Session.ShowConnectionForm,Converter={StaticResource BoolToVisibility}}">
  <StackPanel x:Name="ConnectionForms" Style="{StaticResource Primer.PageColumn}" AutomationProperties.Name="{l:Tr Blocks.Empty.Title}" MaxWidth="820" Margin="24" Visibility="{Binding Session.ShowConnectionForm,Converter={StaticResource BoolToVisibility}}">
    <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,0,0,20">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="{l:Tr Project.OpenPicker}" AutomationProperties.Name="{l:Tr Project.OpenPicker}" Click="OnPick"
            IsEnabled="{Binding Session.ProcessScanAvailable}" Style="{StaticResource Primer.Button.Secondary.Small}"/>
          <StackPanel><TextBlock Text="{l:Tr Project.Instances}" Style="{StaticResource Primer.ContainerTitle}"/>
            <TextBlock Text="{l:Tr Project.AttachHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Session.ProcessListHint}" Style="{StaticResource Primer.Muted}" Margin="0,16,0,0" TextWrapping="Wrap"
          Visibility="{Binding Session.HasProcesses,Converter={StaticResource NotBoolToVisibility}}"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="248">
          <ItemsControl ItemsSource="{Binding Session.Processes}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Primer.CodeBlock}" Padding="14" Margin="0,8,0,0">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="{l:Tr Project.AttachProcess}" AutomationProperties.Name="{Binding AccessibleName}"
                    Click="OnAttach" Style="{StaticResource Primer.Button.Secondary.Small}"/>
                  <Border DockPanel.Dock="Left" Style="{StaticResource Primer.Tag.Accent}" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Release}"/></Border>
                  <StackPanel><TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Primer.Mono}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Details}" Style="{StaticResource Project.Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource Primer.Container}" Padding="20">
      <StackPanel>
        <TextBlock Text="{l:Tr Project.OpenFile}" Style="{StaticResource Primer.ContainerTitle}"/>
        <TextBlock Text="{l:Tr Project.PathHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,4,0,12"/>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,6,0">
            <Label x:Name="FileReleaseLabel" Visibility="Collapsed" Content="{l:Tr Config.Version}" Target="{Binding ElementName=FileRelease}" Style="{StaticResource Primer.FormLabel}"/>
            <ComboBox x:Name="FileRelease" ItemsSource="{Binding Releases}" TextSearch.TextPath="DisplayName" SelectedValuePath="Key"
              SelectedValue="{Binding SelectedReleaseKey}" IsEnabled="{Binding CanSelectRelease}" Style="{StaticResource Primer.ProjectSelect}"
              AutomationProperties.LabeledBy="{Binding ElementName=FileReleaseLabel}" AutomationProperties.Name="{l:Tr Config.Version}">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Primer.Mono}">
                <TextBlock.Text><MultiBinding StringFormat="{}{0} ({1})"><Binding Path="DisplayName"/><Binding Path="OwnerApartment"/></MultiBinding></TextBlock.Text>
              </TextBlock></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <Label x:Name="AccessibleLabel4" Visibility="Collapsed" Content="{l:Tr Project.Label}" Target="{Binding ElementName=ProjectPathInput}"
              AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=ProjectPathInput}" Style="{StaticResource Primer.FormLabel}"/>
            <TextBox x:Name="ProjectPathInput" AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel4}" AutomationProperties.Name="{l:Tr Project.Label}"
              Text="{Binding Session.ProjectPath,UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Session.ProjectFilePlaceholder}"
              Style="{StaticResource Primer.ProjectInput}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
          </StackPanel>
          <ux:PrefillMarker x:Name="ProjectPathMarker" Tag="ConnectProject" Grid.Row="1" Grid.Column="1"
            Target="{Binding ElementName=ProjectPathInput}"/>
          <Button AutomationProperties.Name="{l:Tr Common.Browse}" Grid.Column="2" Content="{l:Tr Common.Browse}" Click="OnBrowseProject" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
          <Button AutomationProperties.Name="{l:Tr Toolbar.Connect}" x:Name="ConnectButton" Grid.Column="3" Content="{l:Tr Project.OpenConnectFile}" Click="OnConnect" Style="{StaticResource Primer.Run}" Margin="8,0,0,0" VerticalAlignment="Bottom" IsEnabled="{Binding Tag.CanConnect,ElementName=PageRoot}"/>
        </Grid>
        <Border Style="{StaticResource Primer.Divider}" Margin="0,12,0,8"/>
        <DockPanel>
          <Button x:Name="GoToMcp" AutomationProperties.Name="{l:Tr Project.GoToMcp}" DockPanel.Dock="Right" Content="{l:Tr Project.GoToMcp}"
            Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp" Style="{StaticResource Primer.Link}" MinHeight="24"/>
          <TextBlock Text="{l:Tr Pages.ConnectHint}" Style="{StaticResource Primer.Muted.textFaint}" TextWrapping="Wrap"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </StackPanel>
  </Grid>
    </DockPanel>
  </DockPanel>
</UserControl>
