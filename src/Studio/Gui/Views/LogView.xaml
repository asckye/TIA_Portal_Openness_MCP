<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.LogView" x:Name="PageRoot">
  <Border x:Name="LogCard" Style="{StaticResource Glass.Card}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" />
        <RowDefinition Height="12" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="{l:Tr Log.Copy}" Click="OnCopyLog" Style="{StaticResource Glass.Button}" Height="32" Margin="0,0,8,0" />
          <Button Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Glass.Button}" Height="32" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Log.Title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Tag.LogCount,ElementName=PageRoot}" Style="{StaticResource Glass.Muted}" FontSize="12" Margin="12,0,0,0" />
        </StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" ScrollChanged="OnLogScrollChanged">
        <ItemsControl ItemsSource="{Binding Tag.LogRows,ElementName=PageRoot}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="82" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Style="{StaticResource Glass.Mono}" FontSize="11.5" Foreground="{DynamicResource Ui.TertiaryLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" ToolTip="{Binding Message}" FontSize="11.5">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Mono}">
                      <Setter Property="Foreground" Value="{DynamicResource Ui.LogText}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:LogLevel.Info}">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:LogLevel.Warning}">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.Orange}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:LogLevel.Error}">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.Red}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Level}" Value="{x:Static controls:LogLevel.Debug}">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
