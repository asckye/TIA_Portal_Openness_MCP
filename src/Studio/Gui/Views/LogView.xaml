<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.LogView" x:Name="PageRoot">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Border Style="{StaticResource Primer.PageHead}">
      <controls:PageHeadPanel MinHeight="32">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Log.Title}" Style="{StaticResource Primer.PageTitle}"/>
          <TextBlock Text="{Binding Tag.LogCount,ElementName=PageRoot}" Style="{StaticResource Primer.Muted}" Margin="12,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button AutomationProperties.Name="{l:Tr Log.Copy}" Content="{l:Tr Log.Copy}" Click="OnCopyLog" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
          <Button AutomationProperties.Name="{l:Tr Log.Clear}" Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Primer.Secondary}"/>
        </StackPanel>
      </controls:PageHeadPanel>
    </Border>
    <Border x:Name="LogCard" Grid.Row="1" Style="{StaticResource Primer.TableContainer}">
      <ListBox AutomationProperties.Name="{l:Tr Log.Title}" x:Name="LogList" Style="{StaticResource Primer.VirtualList}" ItemsSource="{Binding Tag.LogRows,ElementName=PageRoot}" ScrollViewer.ScrollChanged="OnLogScrollChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="10,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="82"/><ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource Primer.Mono}"><TextBlock.Text><MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="logLevel"><Binding Path="Level"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/></MultiBinding></TextBlock.Text></TextBlock>
              <TextBlock Grid.Column="2" Text="{Binding Message}" ToolTip="{Binding Message}" FontSize="{DynamicResource Ui.FontSize.Caption}" Style="{StaticResource Primer.LogLevelText}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>
