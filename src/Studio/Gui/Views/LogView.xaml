<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="TiaOpenness.Gui.Views.LogView" Margin="-16,-12" x:Name="PageRoot">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <ux:PageHeadPanel VerticalAlignment="Center" Spacing="4">
        <StackPanel Orientation="Horizontal">
          <Border Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AllLevels" GroupName="LogLevel" Tag="0" IsChecked="True" AutomationProperties.Name="{l:Tr Calls.All}"
                Style="{StaticResource Primer.Segment}" ContentTemplate="{x:Null}" Click="OnLevel">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Calls.All}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="AllLevelsCount" Text="0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="WarningsOnly" GroupName="LogLevel" Tag="1" AutomationProperties.Name="{l:Tr Pages.LogWarnings}"
                Style="{StaticResource Primer.Segment}" ContentTemplate="{x:Null}" Click="OnLevel">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Pages.LogWarnings}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="WarningsOnlyCount" Foreground="{DynamicResource Primer.warn}" Text="0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="ErrorsOnly" GroupName="LogLevel" Tag="2" AutomationProperties.Name="{l:Tr Pages.LogErrors}"
                Style="{StaticResource Primer.Segment}" ContentTemplate="{x:Null}" Click="OnLevel">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Pages.LogErrors}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ErrorsOnlyCount" Foreground="{DynamicResource Primer.diffRed}" Text="0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
              </RadioButton>
            </StackPanel>
          </Border>
          <Label x:Name="SearchLabel" Target="{Binding ElementName=LogSearch}" Content="{l:Tr Pages.LogSearch}"
            AutomationProperties.Name="{l:Tr Pages.LogSearch}" Style="{StaticResource Primer.FormLabel}" Visibility="Collapsed"/>
          <TextBox x:Name="LogSearch" AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" AutomationProperties.Name="{l:Tr Pages.LogSearch}"
            Style="{StaticResource Primer.IdeSearch}" Tag="{l:Tr Pages.LogSearch}" Margin="8,0,4,0" Width="180" Height="28" TextChanged="OnSearch"/>
          <Button x:Name="ClearSearch" Content="{l:Tr Log.ClearFilter}" AutomationProperties.Name="{l:Tr Log.ClearFilter}"
            Style="{StaticResource Primer.LogClearSearch}" Click="OnClearSearch"/>
        </StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <ToggleButton x:Name="FollowLatest" AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self}}" IsChecked="True"
            Style="{StaticResource Primer.LogFollowToggle}" Click="OnFollow"/>
          <Button x:Name="ClearLogButton" ToolTip="{l:Tr Pages.ClearLogPrompt}" Content="{l:Tr Pages.ClearLog}"
            AutomationProperties.Name="{l:Tr Pages.ClearLog}" Click="OnClearLog" Style="{StaticResource Primer.IdeToolButton}"
            ContentTemplate="{StaticResource Primer.CommandText}"/>
          <Button x:Name="StorageSettingsButton" Content="{l:Tr Log.StorageLink}" AutomationProperties.Name="{l:Tr Log.StorageLink}"
            Click="OnOpenStorageSettings" Style="{StaticResource Primer.IdeToolButton}" ContentTemplate="{StaticResource Primer.CommandText}"/>
          <Button x:Name="MoreActions" Content="⋯" AutomationProperties.Name="{l:Tr Log.More}" ToolTip="{l:Tr Log.More}"
            Style="{StaticResource Primer.IdeToolButton}" Click="OnMoreActions">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CopyLogButton" Header="{l:Tr Pages.CopyLog}" HeaderTemplate="{StaticResource Primer.CommandText}"
                  AutomationProperties.Name="{l:Tr Pages.CopyLog}" Click="OnCopyLog"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <Button x:Name="GenerateButton" Content="{l:Tr Env.Generate}" AutomationProperties.Name="{l:Tr Env.Generate}" Click="OnGenerate"
            Style="{StaticResource Primer.Button.Primary.Small}" ContentTemplate="{StaticResource Primer.CommandText}"/>
        </WrapPanel>
      </ux:PageHeadPanel>
    </Border>
    <DockPanel x:Name="MessageDetails" DockPanel.Dock="Top" Visibility="Collapsed" Margin="14,6">
      <Button DockPanel.Dock="Right" Content="×" AutomationProperties.Name="{l:Tr Access.Dismiss}" Click="OnCloseMessage"
        Style="{StaticResource Primer.IdeToolButton}"/>
      <TextBlock x:Name="MessageDetailsLabel" DockPanel.Dock="Top" Text="{l:Tr Toast.Details}" Foreground="{DynamicResource Primer.textMuted}"/>
      <TextBox x:Name="MessageText" AutomationProperties.LabeledBy="{Binding ElementName=MessageDetailsLabel}" IsReadOnly="True" TextWrapping="Wrap"
        MaxHeight="160" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:Tr Toast.Details}" Style="{StaticResource Primer.Input}"/>
    </DockPanel>
    <Border x:Name="LogCard" Style="{StaticResource Primer.TableContainer}">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Border x:Name="LogHeader" Style="{StaticResource Primer.TableHeaderBand}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
            <TextBlock Grid.Column="1" Text="{l:Tr Pages.LogLevel}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
            <TextBlock Grid.Column="2" Text="{l:Tr Pages.LogMessage}" Style="{StaticResource Primer.TableHeader}" Margin="0"/>
          </Grid>
        </Border>
        <ListBox Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
          AutomationProperties.Name="{l:Tr Log.Title}" x:Name="LogList" Style="{StaticResource Primer.VirtualList}"
          ItemsSource="{Binding LogRows,ElementName=PageRoot}" ScrollViewer.ScrollChanged="OnLogScrollChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Primer.LogRowDivider}">
                <Grid>
                  <Border Style="{StaticResource Primer.LogEntryRow}" IsHitTestVisible="False"/>
                  <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="92"/><ColumnDefinition Width="92"/>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                    <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Primer.Tag}">
                      <TextBlock AutomationProperties.Name="{l:Tr Pages.LogLevel}" Style="{StaticResource Primer.LogLevelToken}" FontWeight="SemiBold">
                        <TextBlock.ToolTip><MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="logLevel">
                            <Binding Path="Level"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                          </MultiBinding></TextBlock.ToolTip>
                      </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="2" AutomationProperties.Name="{l:Tr Pages.LogMessage}" Text="{Binding Message}" ToolTip="{Binding Message}"
                      FontSize="{DynamicResource Ui.FontSize.Caption}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None"/>
                    <Button Grid.Column="3" Content="⧉" Click="OnCopyRow" AutomationProperties.Name="{l:Tr Log.CopyRow}" ToolTip="{l:Tr Log.CopyRow}"
                      Style="{StaticResource Primer.LogCopyRow}"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ux:WorkbenchState Grid.Row="1" x:Name="EmptyLog" Style="{StaticResource Primer.Workbench.EmptyState}" ux:Ux.Icon="{DynamicResource Icon.WorkbenchLogs}"
          ActionLabel="{l:Tr Log.OpenDirectory}" Visibility="{Binding HasItems, ElementName=LogList, Converter={StaticResource NotBoolToVisibility}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
