<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.LogView" Margin="-16,-12" x:Name="PageRoot">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <ux:PageHeadPanel VerticalAlignment="Center" Spacing="4">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AllLevels" GroupName="LogLevel" Tag="0" IsChecked="True" AutomationProperties.Name="{l:Tr Calls.All}"
            Style="{StaticResource Primer.IdePill}" ContentTemplate="{x:Null}" Click="OnLevel">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Tr Calls.All}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"><TextBlock x:Name="AllLevelsCount" Text="0" VerticalAlignment="Center"/></Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="WarningsOnly" GroupName="LogLevel" Tag="1" AutomationProperties.Name="{l:Tr Pages.LogWarnings}"
            Style="{StaticResource Primer.IdePill}" ContentTemplate="{x:Null}" Click="OnLevel">
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource Primer.StatusDot}" Fill="{DynamicResource Primer.warn}" Margin="0,0,4,0"/>
              <TextBlock Text="{l:Tr Pages.LogWarnings}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"><TextBlock x:Name="WarningsOnlyCount" Text="0" VerticalAlignment="Center"/></Border>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="ErrorsOnly" GroupName="LogLevel" Tag="2" AutomationProperties.Name="{l:Tr Pages.LogErrors}"
            Style="{StaticResource Primer.IdePill}" ContentTemplate="{x:Null}" Click="OnLevel">
            <StackPanel Orientation="Horizontal">
              <Ellipse Style="{StaticResource Primer.StatusDot}" Fill="{DynamicResource Ant.colorError}" Margin="0,0,4,0"/>
              <TextBlock Text="{l:Tr Pages.LogErrors}" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Primer.IdePillCount}" Margin="6,0,0,0"><TextBlock x:Name="ErrorsOnlyCount" Text="0" VerticalAlignment="Center"/></Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
        <WrapPanel VerticalAlignment="Center">
          <Label x:Name="SearchLabel" Target="{Binding ElementName=LogSearch}" Content="{l:Tr Pages.LogSearch}"
            AutomationProperties.Name="{l:Tr Pages.LogSearch}" Style="{StaticResource Primer.FormLabel}" Visibility="Collapsed"/>
          <TextBox x:Name="LogSearch" AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" AutomationProperties.Name="{l:Tr Pages.LogSearch}"
            Style="{StaticResource Primer.IdeSearch}" Tag="{l:Tr Pages.LogSearch}" Width="180" Height="28" TextChanged="OnSearch" Margin="0,0,8,0"/>
          <ToggleButton x:Name="FollowLatest" Content="{l:Tr Calls.Follow}" AutomationProperties.Name="{l:Tr Calls.Follow}"
            IsChecked="True" Style="{StaticResource Primer.IdeToolToggle}" Click="OnFollow"/>
          <Button x:Name="CopyLogButton" Content="{l:Tr Pages.CopyLog}" ContentTemplate="{StaticResource Primer.CommandText}" AutomationProperties.Name="{l:Tr Pages.CopyLog}" Click="OnCopyLog"
            Style="{StaticResource Primer.IdeToolButton}" Margin="4,0"/>
          <Button x:Name="GenerateButton" Content="{l:Tr Env.Generate}" AutomationProperties.Name="{l:Tr Env.Generate}" Click="OnGenerate"
            Style="{StaticResource Primer.Button.Primary.Small}" ContentTemplate="{StaticResource Primer.CommandText}"/>
          <Button x:Name="ClearLogButton" ToolTip="{l:Tr Pages.ClearLogPrompt}" Content="{l:Tr Pages.ClearLog}" AutomationProperties.Name="{l:Tr Pages.ClearLog}" Click="OnClearLog"
            Style="{StaticResource Primer.Button.Secondary.Small}" ContentTemplate="{StaticResource Primer.CommandText}" Margin="6,0,0,0"/>
          <Button x:Name="StorageSettingsButton" Content="{l:Tr Log.StorageLink}" AutomationProperties.Name="{l:Tr Log.StorageLink}"
          Margin="6,0,0,0" Click="OnOpenStorageSettings" ToolTip="{l:Tr Pages.LogStorageSettings}" Style="{StaticResource Primer.Link}"/>
        </WrapPanel>
      </ux:PageHeadPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Primer.FooterStrip}" Padding="14,3">
      <DockPanel>

        <TextBlock x:Name="StorageSize" DockPanel.Dock="Right" Style="{StaticResource Primer.Mono.textFaint}" Margin="8,0" VerticalAlignment="Center"/>
        <TextBlock VerticalAlignment="Center" Style="{StaticResource Primer.Mono.textFaint}" Margin="0,0,12,0">
          <Run Text="{Binding Items.Count, ElementName=LogList, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Text, ElementName=AllLevelsCount, Mode=OneWay}"/>
        </TextBlock>
        <TextBlock Text="{l:Tr Pages.LogPurpose}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" MaxWidth="240"/>
        <TextBlock x:Name="StoragePath" TextAlignment="Right" Style="{StaticResource Primer.Mono.textFaint}" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <DockPanel x:Name="MessageDetails" DockPanel.Dock="Top" Visibility="Collapsed" Margin="14,6">
      <Button DockPanel.Dock="Right" Content="×" AutomationProperties.Name="{l:Tr Access.Dismiss}" Click="OnCloseMessage"
        Style="{StaticResource Primer.IdeToolButton}"/>
      <TextBlock x:Name="MessageDetailsLabel" DockPanel.Dock="Top" Text="{l:Tr Toast.Details}"
        Foreground="{DynamicResource Primer.textMuted}"/>
      <TextBox x:Name="MessageText" AutomationProperties.LabeledBy="{Binding ElementName=MessageDetailsLabel}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"
        AutomationProperties.Name="{l:Tr Toast.Details}" Style="{StaticResource Primer.Input}"/>
    </DockPanel>
    <StackPanel x:Name="DiagnosticStrip" DockPanel.Dock="Top" AutomationProperties.Name="{l:Tr Shell.Diagnostics}">
      <Border Style="{StaticResource Primer.Workbench.DiagnosticStrip}" Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Primer.Mono}"/>
            <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticStep}" Text="{Binding DiagnosticStep}" Style="{StaticResource Primer.Muted}"/>
          </DockPanel>
          <ProgressBar Style="{StaticResource Primer.Progress}" Height="4" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Primer.Workbench.DiagnosticStrip}" Visibility="{Binding DiagnosticDone, Converter={StaticResource BoolToVisibility}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Feature.OpenFolder}" Content="{l:Tr Feature.OpenFolder}" Style="{StaticResource Primer.Secondary}" Margin="12,0,0,0" Click="OnOpenFolder"/>
          <StackPanel>
            <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticPath}" Text="{Binding DiagnosticPath}" Style="{StaticResource Primer.Mono}" TextWrapping="Wrap"/>
            <TextBlock Text="{l:Tr Env.Redacted}" Style="{StaticResource Primer.Muted.ok}" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
    <Border x:Name="LogCard" Style="{StaticResource Primer.TableContainer}">
      <Grid>
        <ListBox AutomationProperties.Name="{l:Tr Log.Title}" x:Name="LogList" Style="{StaticResource Primer.VirtualList}" ItemsSource="{Binding LogRows,ElementName=PageRoot}" ScrollViewer.ScrollChanged="OnLogScrollChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Primer.LogEntryRow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/><ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                  <TextBlock Grid.Column="1" AutomationProperties.Name="{l:Tr Pages.LogLevel}" Style="{StaticResource Primer.LogLevelToken}" FontWeight="SemiBold">
                    <TextBlock.ToolTip><MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="logLevel">
                      <Binding Path="Level"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                    </MultiBinding></TextBlock.ToolTip>
                  </TextBlock>
                  <TextBlock Grid.Column="2" AutomationProperties.Name="{l:Tr Pages.LogMessage}" Text="{Binding Message}" ToolTip="{Binding Message}" FontSize="{DynamicResource Ui.FontSize.Caption}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ux:WorkbenchState x:Name="EmptyLog" Style="{StaticResource Primer.Workbench.EmptyState}" ux:Ux.Icon="{DynamicResource Icon.WorkbenchLogs}"
          ActionLabel="{l:Tr Log.OpenDirectory}" Visibility="{Binding HasItems, ElementName=LogList, Converter={StaticResource NotBoolToVisibility}}"/>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
