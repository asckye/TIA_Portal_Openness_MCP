<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.VersionControlView" x:Name="PageRoot">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="120"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="136"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Border x:Name="WorkspaceCard" Style="{StaticResource Primer.Container}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="48"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{l:Tr Vc.Empty.Title}" FontSize="18" FontWeight="SemiBold" Visibility="{Binding Tag.HasWorkspace,ElementName=PageRoot,Converter={StaticResource NotBoolToVisibility}}"/>
              <StackPanel Orientation="Horizontal" Visibility="{Binding Tag.HasWorkspace,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding VersionControl.Workspaces}" SelectedItem="{Binding VersionControl.SelectedWorkspace}" Style="{StaticResource Primer.WorkspacePicker}" MinWidth="190" MaxWidth="360">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Style="{StaticResource Primer.Chip}" Margin="10,0,0,0">
                  <TextBlock Text="TIA VCI"/>
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.WorkspaceSummary}" Style="{StaticResource Primer.Mono}"/>
            </StackPanel>
            <DockPanel Grid.Row="1" VerticalAlignment="Bottom">
              <Button DockPanel.Dock="Right" Click="OnWorkspaceAction" Style="{StaticResource Primer.WorkspaceAction}"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="{l:Tr Primer.ReadStatus}" Command="{Binding VersionControl.VcRefresh}" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Pages.GitTools}" Click="OnGitTools" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Pages.Options}" Click="OnWorkspaceOptions" Style="{StaticResource Primer.Quiet}"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}" IsEnabled="{Binding Tag.HasWorkspace,ElementName=PageRoot}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid>
          <Border x:Name="VciStatusCard" Style="{StaticResource Primer.Container}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="34"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{l:Tr Primer.Mapping}" Style="{StaticResource Primer.ContainerTitle}"/>
              <TextBlock Text="{l:Tr Primer.WholeProject}" Style="{StaticResource Primer.Muted}" HorizontalAlignment="Right" FontSize="10"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ElementName=PageRoot,Path=Tag.MappingSummary}">
                <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.Mapped}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Tr Primer.Mapped}" Style="{StaticResource Primer.Muted}" Margin="3,0,12,0"/>
                <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.Unsupported}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Tr Primer.Unsupported}" Style="{StaticResource Primer.Muted}" Margin="3,0,12,0"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="{l:Tr Primer.PreviewMapping}" Command="{Binding VersionControl.VcMap}" Click="OnPreview" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Primer.RunMapping}" Command="{Binding VersionControl.VcMap}" Click="OnRun" Style="{StaticResource Primer.OutlinedAccent}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Column="2">
          <Border x:Name="SyncCard" Style="{StaticResource Primer.Container}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="34"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{l:Tr Primer.Sync}" Style="{StaticResource Primer.ContainerTitle}"/>
              <TextBlock Text="{l:Tr Primer.NotGitPush}" Style="{StaticResource Primer.Muted}" FontSize="10" HorizontalAlignment="Right"/>
              <Border Grid.Row="1" Padding="3" Style="{StaticResource Primer.SegmentGroup}">
                <Grid x:Name="SyncStrip">
                  <UniformGrid Columns="2">
                    <RadioButton x:Name="ToWorkspace" Content="{l:Tr Primer.ToWorkspace}" IsChecked="True" GroupName="SyncDirection" Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="ToProject" Content="{l:Tr Primer.ToProject}" GroupName="SyncDirection" Style="{StaticResource Primer.Segment}"/>
                  </UniformGrid>
                </Grid>
              </Border>
              <DockPanel Grid.Row="3" Margin="0,6,0,0">
                <Button Content="{l:Tr Primer.RunSync}" Click="OnRun" Style="{StaticResource Primer.SyncRun}" DockPanel.Dock="Right" Height="30" Padding="8,0"/>
                <Button Content="{l:Tr Primer.PreviewSync}" Click="OnPreview" Margin="0,0,8,0" Style="{StaticResource Primer.SyncPreview}" DockPanel.Dock="Right" Height="30" Padding="8,0"/>
                <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.SyncSummary}" ToolTip="{Binding Tag.SyncSummary,ElementName=PageRoot}" Style="{StaticResource Primer.Muted}" FontSize="11" TextWrapping="NoWrap"/>
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Grid Grid.Row="4" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}" IsEnabled="{Binding Tag.HasWorkspace,ElementName=PageRoot}">
        <Border x:Name="MappedObjectsCard" Style="{StaticResource Primer.TableContainer}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Primer.HeaderStrip}">
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{l:Tr Primer.MappedObjects}" Style="{StaticResource Primer.ContainerTitle}"/>
                  <TextBlock Text="{Binding Tag.MappedMeta,ElementName=PageRoot}" Style="{StaticResource Primer.Muted}" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <CheckBox Content="{l:Tr Primer.All}" IsChecked="{Binding VersionControl.VcShowAll}" Click="OnMappedAll" ToolTip="{l:Tr Vc.ShowAll}" Style="{StaticResource Primer.Secondary}"/>
                  <Button Content="{Binding ElementName=PageRoot,Path=Tag.DifferenceLabel}" ToolTip="{l:Tr Primer.Differ}" Tag="Unequal" Click="OnMappedFilter" Style="{StaticResource Primer.Secondary}" Margin="6,0,0,0"/>
                  <Button Content="{Binding ElementName=PageRoot,Path=Tag.MissingLabel}" ToolTip="{l:Tr Primer.Missing}" Tag="WorkspaceFileMissing" Click="OnMappedFilter" Style="{StaticResource Primer.Secondary}" Margin="6,0,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Primer.ColumnHeaderStrip}" Grid.Row="1">
              <Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width=".9*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{l:Tr Col.Object}" Grid.Column="0" Style="{StaticResource Primer.Muted}" FontSize="10" FontWeight="SemiBold"/>
                  <TextBlock Text="{l:Tr Primer.File}" Grid.Column="1" Style="{StaticResource Primer.Muted}" FontSize="10" FontWeight="SemiBold"/>
                  <TextBlock Text="{l:Tr Col.State}" Grid.Column="2" Style="{StaticResource Primer.Muted}" FontSize="10" FontWeight="SemiBold"/>
                </Grid>
              </Grid>
            </Border>
            <ListBox x:Name="MappedList" Grid.Row="2" ItemsSource="{Binding VersionControl.VcStatusItems}" SelectedItem="{Binding VersionControl.SelectedVcItem}" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.MappingItem}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.4*"/>
                      <ColumnDefinition Width="1.6*"/>
                      <ColumnDefinition Width=".9*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding FilePath}" Style="{StaticResource Primer.Mono}" Margin="0,0,12,0" ToolTip="{Binding FilePath}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Primer.MappingState}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="compare">
                          <Binding Path="CompareState"/>
                          <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Margin="12,24" Visibility="{Binding VersionControl.HasVcItems, Converter={StaticResource NotBoolToVisibility}}">
              <TextBlock Text="{l:Tr Vc.Empty.Title}" Style="{StaticResource Primer.ContainerTitle}" FontSize="18"/>
              <TextBlock Text="{l:Tr Vc.Empty.Body}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Column="2">
      <Border x:Name="DiffCard" Style="{StaticResource Primer.Container}" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Primer.LocalDiff}" Style="{StaticResource Primer.ContainerTitle}"/>
          <Border Style="{StaticResource Primer.Chip}" HorizontalAlignment="Right">
            <TextBlock Text="{l:Tr Primer.WorkingTree}" Style="{StaticResource Primer.Text.textMuted}"/>
          </Border>
          <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffAdded}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" Margin="8,0,6,0" VerticalAlignment="Center" Style="{StaticResource Primer.Text.diffGreen}"/>
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffRemoved}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" VerticalAlignment="Center" Style="{StaticResource Primer.Text.diffRed}"/>
            </StackPanel>
            <TextBlock Text="{Binding Tag.DiffFileName,ElementName=PageRoot}" ToolTip="{Binding VersionControl.VcDiffCaption}" Style="{StaticResource Primer.Mono.textMuted}" FontWeight="SemiBold"/>
          </DockPanel>
          <Border Grid.Row="2" Padding="14,12" Margin="0,4,0,14" Style="{StaticResource Primer.CodeBlock}">
            <Grid>
              <TextBlock Text="{l:Tr Pages.NoDiff}" Style="{StaticResource Primer.Muted.textMuted}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource NotBoolToVisibility}}"/>
              <ListBox ItemsSource="{Binding VersionControl.VcDiffLines}" Style="{StaticResource Primer.List}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource BoolToVisibility}}" ItemContainerStyle="{StaticResource Primer.FileItem}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" LineHeight="17" Style="{StaticResource Primer.DiffLine}"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <StackPanel Grid.Row="3">
            <ItemsControl ItemsSource="{Binding ElementName=PageRoot,Path=Tag.OtherMappedFiles}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding FilePath}" Tag="{Binding}" Click="OnMappedFile" ToolTip="{l:Tr Primer.InspectFile}" Style="{StaticResource Primer.Quiet}" HorizontalContentAlignment="Left" Height="22"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:Tr Primer.DiffScope}" Style="{StaticResource Primer.Muted.textMuted}" TextWrapping="Wrap" FontSize="10.5"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <views:EngineeringOptionsView x:Name="Options" Grid.ColumnSpan="3"/>
  </Grid>
</UserControl>
