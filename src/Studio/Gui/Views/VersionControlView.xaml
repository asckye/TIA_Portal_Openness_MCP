<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.VersionControlView" x:Name="PageRoot">
  <Grid>
    <DockPanel x:Name="WorkspaceBackdrop">
      <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
        <DockPanel VerticalAlignment="Center">
          <Button Visibility="{Binding VersionControl.HasWorkspace,Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.Name="{l:Tr Pages.RunSync}" Content="{l:Tr Pages.RunSync}" Click="OnRun"
            Style="{StaticResource Primer.SyncRun}" DockPanel.Dock="Right" MinHeight="28" Padding="6,0"/>
          <Button Visibility="{Binding VersionControl.HasWorkspace,Converter={StaticResource BoolToVisibility}}"
            AutomationProperties.Name="{l:Tr Pages.PreviewSync}" Content="{l:Tr Pages.PreviewSync}" IsDefault="True" Click="OnPreview"
            Margin="0,0,4,0" Style="{StaticResource Primer.SyncPreview}" DockPanel.Dock="Right" MinHeight="28" Padding="6,0"/>
          <Button x:Name="WorkspaceOptionsButton" DockPanel.Dock="Right" Content="⋯" Click="OnWorkspaceOptions"
            Style="{StaticResource Primer.IdeToolButton}" AutomationProperties.Name="{l:Tr Pages.Options}"/>
          <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}" Padding="2" Margin="4,0"
            Visibility="{Binding VersionControl.HasWorkspace,Converter={StaticResource BoolToVisibility}}">
            <UniformGrid Columns="2" x:Name="SyncStrip" AutomationProperties.Name="{l:Tr Primer.Sync}" ToolTip="{l:Tr Primer.NotGitPush}">
              <RadioButton x:Name="ToWorkspace" Tag="{l:Tr Primer.ToWorkspace}"
                Content="{l:Tr Project.ToWorkspace}" AutomationProperties.Name="{l:Tr Project.ToWorkspace}"
                IsChecked="True" ToolTip="{l:Tr Project.ToWorkspace}" Click="OnDirection"
                GroupName="SyncDirection" Padding="3,0" Style="{StaticResource Primer.ProjectSyncDirection}"/>
              <RadioButton x:Name="ToProject" Tag="{l:Tr Primer.ToProject}"
                Content="{l:Tr Project.ToProject}" AutomationProperties.Name="{l:Tr Project.ToProject}"
                IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="{l:Tr Project.UnsupportedDirection}"
                Click="OnDirection" GroupName="SyncDirection" Padding="3,0" Style="{StaticResource Primer.ProjectSyncDirection}"/>
            </UniformGrid>
          </Border>
          <TextBlock DockPanel.Dock="Left" Text="Git / VCI" ToolTip="{l:Tr Vc.Subtitle}" Style="{StaticResource Primer.ContainerTitle}"
            Visibility="{Binding VersionControl.HasWorkspace,Converter={StaticResource NotBoolToVisibility}}"/>
          <Border x:Name="SyncCard" Style="{StaticResource Primer.SegmentGroup}" HorizontalAlignment="Left"
            Visibility="{Binding VersionControl.HasWorkspace,Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <RadioButton AutomationProperties.Name="{Binding VersionControl.AllMappingsLabel}" Content="{Binding VersionControl.AllMappingsLabel}"
                  IsChecked="True" GroupName="MappedFilter" Click="OnMappedAll" ToolTip="{l:Tr Vc.ShowAll}"
                  Padding="3,0" Style="{StaticResource Primer.Segment}"/>
                <RadioButton GroupName="MappedFilter" AutomationProperties.Name="{Binding ElementName=PageRoot,Path=Tag.DifferenceLabel}"
                  Content="{Binding ElementName=PageRoot,Path=Tag.DifferenceLabel}" ToolTip="{l:Tr Primer.Differ}" Tag="Unequal"
                  Click="OnMappedFilter" Padding="3,0" Style="{StaticResource Primer.Segment}"/>
                <RadioButton GroupName="MappedFilter" AutomationProperties.Name="{Binding ElementName=PageRoot,Path=Tag.MissingLabel}"
                  Content="{Binding ElementName=PageRoot,Path=Tag.MissingLabel}" ToolTip="{l:Tr Primer.Missing}" Tag="WorkspaceFileMissing"
                  Click="OnMappedFilter" Padding="3,0" Style="{StaticResource Primer.Segment}"/>
              </StackPanel>
          </Border>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="VciScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="VciColumn" Style="{StaticResource Primer.VciColumn}">
          <TextBlock Text="{Binding VersionControl.AccessNotice}" Style="{StaticResource Project.SourceNotice}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Border Style="{StaticResource Primer.ProjectResultCard}" Padding="20"
            Visibility="{Binding VersionControl.ShowCreateWorkspace,Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{l:Tr Project.NoWorkspace}" Style="{StaticResource Primer.ContainerTitle}"/>
              <TextBlock Text="{l:Tr Project.WorkspaceHint}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" Margin="0,4,0,16"/>
              <Label x:Name="WorkspaceNameLabel" Content="{l:Tr Vc.New}" Target="{Binding ElementName=CreateName}" Style="{StaticResource Primer.FormLabel}"/>
              <TextBox x:Name="CreateName" Text="{Binding VersionControl.NewWorkspaceName,UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{l:Tr Vc.New}" AutomationProperties.LabeledBy="{Binding ElementName=WorkspaceNameLabel}" Style="{StaticResource Primer.Input}"/>
              <Label x:Name="WorkspacePathLabel" Content="{l:Tr Vc.In}" Target="{Binding ElementName=CreateFolder}" Style="{StaticResource Primer.FormLabel}"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Common.Browse}" Click="OnBrowseWorkspace" Style="{StaticResource Primer.Secondary}"
                  AutomationProperties.Name="{l:Tr Common.Browse}" Margin="8,0,0,0"/>
                <TextBox x:Name="CreateFolder" Text="{Binding VersionControl.NewWorkspaceFolder,UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="{l:Tr Vc.In}" AutomationProperties.LabeledBy="{Binding ElementName=WorkspacePathLabel}" Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <Button Content="{l:Tr Vc.Create}" Command="{Binding VersionControl.VcCreate}" AutomationProperties.Name="{l:Tr Vc.Create}"
                Style="{StaticResource Primer.Run}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.ProjectResultCard}" Padding="20"
            Visibility="{Binding VersionControl.Synchronizing,Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{Binding VersionControl.SyncTitle}" Style="{StaticResource Primer.ContainerTitle}"/>
              <ProgressBar Height="5" IsIndeterminate="True" Margin="0,12"/>
              <TextBlock Text="{Binding VersionControl.SelectedWorkspace.RootPath}" Style="{StaticResource Project.Caption}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.ProjectResultCard}" Padding="20"
            Visibility="{Binding VersionControl.ShowSyncResult,Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{Binding VersionControl.SyncTitle}" Style="{StaticResource Primer.ContainerTitle}"/>
              <TextBlock Text="{Binding VersionControl.SyncCounts}" Style="{StaticResource Project.Caption}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding VersionControl.ElapsedLabel}" Style="{StaticResource Project.Caption}"/>
              <Border Style="{StaticResource Primer.CodeBlock}" Padding="14" Margin="0,12">
                <ItemsControl ItemsSource="{Binding VersionControl.SyncRows}">
                  <ItemsControl.ItemTemplate><DataTemplate>
                    <TextBlock ToolTip="{Binding RawOutcome}" Style="{StaticResource Primer.Mono}" TextWrapping="Wrap" Margin="0,3">
                    <Run Text="{Binding Outcome,Mode=OneWay}"/>  <Run Text="{Binding Name,Mode=OneWay}"/>  <Run Text="{Binding Error,Mode=OneWay}"/>
                    <Run Text="{Binding RefreshNote,Mode=OneWay}"/>
                  </TextBlock></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="{l:Tr Project.BackWorkspace}" AutomationProperties.Name="{l:Tr Project.BackWorkspace}"
                Click="OnBackToWorkspace" Style="{StaticResource Primer.Secondary}" HorizontalAlignment="Right"/>
              <Button Click="OnApplyPreview" Content="{l:Tr Project.ApplyPreview}" AutomationProperties.Name="{l:Tr Project.ApplyPreview}"
                Visibility="{Binding VersionControl.SyncResult.DryRun,Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource Primer.Run}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border x:Name="WorkspaceCard" Style="{StaticResource Primer.ProjectLayoutSurface}"
            Visibility="{Binding VersionControl.ShowWorkspace,Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Border x:Name="VciStatusCard" DockPanel.Dock="Top" Style="{StaticResource Primer.ProjectFileBar}">
                <StackPanel>
                  <DockPanel VerticalAlignment="Center">
                    <TextBlock DockPanel.Dock="Right" x:Name="MappedMeta" Text="{Binding Tag.MappedMeta,ElementName=PageRoot}"
                      Visibility="{Binding VersionControl.HasStatus,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Project.Caption}"/>
                    <TextBlock Text="{Binding VersionControl.WorkspaceRootDisplay}" ToolTip="{Binding VersionControl.WorkspaceRootDisplay}"
                      TextTrimming="CharacterEllipsis" Style="{StaticResource Primer.Mono}"/>
                  </DockPanel>
                  <TextBlock Text="{Binding VersionControl.StoredEqualNotice}" TextWrapping="Wrap" Style="{StaticResource Project.Caption}"
                    Visibility="{Binding VersionControl.HasStoredEqual,Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border x:Name="MappedObjectsCard" Style="{StaticResource Primer.ProjectLayoutSurface}" Padding="8">
                  <Grid>
                    <ListBox x:Name="MappedList" AutomationProperties.Name="{l:Tr Primer.MappedObjects}" Style="{StaticResource Primer.List}"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding VersionControl.VcStatusItems}"
                      SelectedItem="{Binding VersionControl.SelectedVcItem}"
                      ItemContainerStyle="{StaticResource Project.ChangedFile}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <DockPanel ToolTip="{Binding Name}">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Project.FileMark}" Margin="0,0,8,0"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Primer.MappingState}">
                              <TextBlock.ToolTip>
                                <MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="compareDetail">
                                  <Binding/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                                </MultiBinding>
                              </TextBlock.ToolTip>
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource Primer.Value}" ConverterParameter="compare">
                                  <Binding/>
                                  <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="{Binding FilePath}" AutomationProperties.Name="{l:Tr Primer.File}" ToolTip="{l:Tr Col.Object}"
                              Style="{StaticResource Primer.Mono}"/>
                          </DockPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock ToolTip="{l:Tr Vc.Empty.Title}" Text="{l:Tr Vc.Empty.Body}" TextWrapping="Wrap"
                      Style="{StaticResource Primer.Muted}"
                      Visibility="{Binding HasItems,ElementName=MappedList,Converter={StaticResource NotBoolToVisibility}}"/>
                  </Grid>
                </Border>
                <Border x:Name="DiffCard" Grid.Column="1" Style="{StaticResource Primer.ProjectLayoutSurface}" Padding="12,8">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" MinHeight="32"/>
                      <RowDefinition Height="Auto" MinHeight="28"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Primer.LocalDiff}" Style="{StaticResource Primer.ContainerTitle}"/>
                    <Border Style="{StaticResource Primer.Chip}" HorizontalAlignment="Right">
                      <TextBlock Text="{l:Tr Primer.WorkingTree}" Style="{StaticResource Primer.Text.textMuted}"/>
                    </Border>
                    <DockPanel Grid.Row="1">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffAdded}" FontFamily="{DynamicResource Ui.FontMono}"
                          FontSize="{DynamicResource Ui.FontSize.Caption}" Margin="8,0,6,0" VerticalAlignment="Center"
                          Style="{StaticResource Primer.Text.diffGreen}"/>
                        <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffRemoved}" FontFamily="{DynamicResource Ui.FontMono}"
                          FontSize="{DynamicResource Ui.FontSize.Caption}" VerticalAlignment="Center" Style="{StaticResource Primer.Text.diffRed}"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Tag.DiffFileName,ElementName=PageRoot}" ToolTip="{Binding VersionControl.VcDiffCaption}"
                        Style="{StaticResource Primer.Mono.textMuted}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Grid.Row="2" Padding="0,6" Margin="0,4,0,8" Style="{StaticResource Primer.ProjectLayoutSurface}">
                      <Grid>
                        <TextBlock Text="{Binding VersionControl.DiffHint}" Style="{StaticResource Primer.Muted.textMuted}" TextWrapping="Wrap"
                          VerticalAlignment="Top" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource NotBoolToVisibility}}"/>
                        <ListBox AutomationProperties.Name="{l:Tr Access.Diff}" ItemsSource="{Binding VersionControl.VcDiffLines}"
                          Style="{StaticResource Primer.List}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource BoolToVisibility}}"
                          ItemContainerStyle="{StaticResource Project.DiffRow}">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ui.FontMono}"
                                FontSize="{DynamicResource Ui.FontSize.Caption}" LineHeight="17" Style="{StaticResource Primer.DiffLine}"/>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Row="3">
                      <ItemsControl ItemsSource="{Binding ElementName=PageRoot,Path=Tag.OtherMappedFiles}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button AutomationProperties.Name="{Binding FilePath}" ContentTemplate="{x:Null}" Tag="{Binding}" Click="OnMappedFile"
                              ToolTip="{l:Tr Primer.InspectFile}" Style="{StaticResource Primer.Quiet}" HorizontalContentAlignment="Left"
                              MinHeight="24">
                              <TextBlock Text="{Binding FilePath}" TextWrapping="Wrap"/>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{l:Tr Primer.DiffScope}" Style="{StaticResource Primer.Muted.textMuted}" TextWrapping="Wrap"
                        FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DockPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
    <views:EngineeringOptionsView x:Name="Options" Tag="{Binding Tag,ElementName=PageRoot}"/>
  </Grid>
</UserControl>
