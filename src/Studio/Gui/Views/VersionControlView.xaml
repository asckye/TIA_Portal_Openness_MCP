<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.VersionControlView" x:Name="PageRoot">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="16" />
      <ColumnDefinition Width="284" />
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="120" />
        <RowDefinition Height="14" />
        <RowDefinition Height="136" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid>
        <Border x:Name="WorkspaceCard" Style="{StaticResource Glass.Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="48" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="{l:Tr Vc.Empty.Title}" FontSize="18" FontWeight="Bold" Visibility="{Binding Tag.HasWorkspace,ElementName=PageRoot,Converter={StaticResource NotBoolToVisibility}}" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding Tag.HasWorkspace,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
                <ComboBox ItemsSource="{Binding VersionControl.Workspaces}" SelectedItem="{Binding VersionControl.SelectedWorkspace}" Style="{StaticResource Glass.WorkspacePicker}" MinWidth="190" MaxWidth="360">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Style="{StaticResource Glass.Chip}" Margin="10,0,0,0">
                  <TextBlock Text="TIA VCI" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.WorkspaceSummary}" Style="{StaticResource Glass.Mono}" />
            </StackPanel>
            <DockPanel Grid.Row="1" VerticalAlignment="Bottom">
              <Button DockPanel.Dock="Right" Click="OnWorkspaceAction">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource Glass.Primary}">
                    <Setter Property="Content" Value="{l:Tr Glass.NewWorkspace}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tag.HasWorkspace,ElementName=PageRoot}" Value="True">
                        <Setter Property="Content" Value="{l:Tr Pages.OpenWorkspace}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <StackPanel Orientation="Horizontal">
                <Button Content="{l:Tr Glass.ReadStatus}" Command="{Binding VersionControl.VcRefresh}" Style="{StaticResource Glass.Button}" Margin="0,0,8,0" />
                <Button Content="{l:Tr Pages.GitTools}" Click="OnGitTools" Style="{StaticResource Glass.Button}" Margin="0,0,8,0" />
                <Button Content="{l:Tr Pages.Options}" Click="OnWorkspaceOptions" Style="{StaticResource Glass.Quiet}" />
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}" IsEnabled="{Binding Tag.HasWorkspace,ElementName=PageRoot}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
          <Border x:Name="VciStatusCard" Style="{StaticResource Glass.Card}" Padding="20,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="34" />
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="{l:Tr Glass.Mapping}" Style="{StaticResource Glass.Heading}" />
              <TextBlock Text="{l:Tr Glass.WholeProject}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right" FontSize="10" />
              <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ElementName=PageRoot,Path=Tag.MappingSummary}">
                <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.Mapped}" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{l:Tr Glass.Mapped}" Style="{StaticResource Glass.Muted}" Margin="3,0,12,0" />
                <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.Unsupported}" FontSize="16" FontWeight="Bold" />
                <TextBlock Text="{l:Tr Glass.Unsupported}" Style="{StaticResource Glass.Muted}" Margin="3,0,12,0" />
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Content="{l:Tr Glass.PreviewMapping}" Command="{Binding VersionControl.VcMap}" Click="OnPreview" Style="{StaticResource Glass.Button}" Margin="0,0,8,0" />
                <Button Content="{l:Tr Glass.RunMapping}" Command="{Binding VersionControl.VcMap}" Click="OnRun" Style="{StaticResource Glass.Outline}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Column="2">
          <Border x:Name="SyncCard" Style="{StaticResource Glass.Card}" Padding="20,14">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="32" />
                <RowDefinition Height="0" />
                <RowDefinition Height="34" />
              </Grid.RowDefinitions>
              <TextBlock Text="{l:Tr Glass.Sync}" Style="{StaticResource Glass.Heading}" />
              <TextBlock Text="{l:Tr Glass.NotGitPush}" Style="{StaticResource Glass.Muted}" FontSize="10" HorizontalAlignment="Right" />
              <Border Grid.Row="1" Background="{DynamicResource Ui.SegmentTrack}" CornerRadius="17" Padding="3">
                <Grid x:Name="SyncStrip">
                  <Border x:Name="SyncThumb" Width="{Binding ActualWidth,ElementName=ToWorkspace}" CornerRadius="14" Background="{DynamicResource Ui.Accent}" IsHitTestVisible="False">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsChecked,ElementName=ToWorkspace}" Value="False">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <UniformGrid Columns="2">
                    <RadioButton x:Name="ToWorkspace" Content="{l:Tr Glass.ToWorkspace}" IsChecked="True" GroupName="SyncDirection" Style="{StaticResource Glass.Segment}" />
                    <RadioButton x:Name="ToProject" Content="{l:Tr Glass.ToProject}" GroupName="SyncDirection" Style="{StaticResource Glass.Segment}" />
                  </UniformGrid>
                </Grid>
              </Border>
              <DockPanel Grid.Row="3" Margin="0,6,0,0">
                <Button Content="{l:Tr Glass.RunSync}" Click="OnRun" Style="{StaticResource Glass.SyncRun}" DockPanel.Dock="Right" Height="30" FontSize="10" Padding="8,0" />
                <Button Content="{l:Tr Glass.PreviewSync}" Click="OnPreview" Margin="0,0,8,0" Style="{StaticResource Glass.SyncPreview}" DockPanel.Dock="Right" Height="30" FontSize="10" Padding="8,0" />
                <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.SyncSummary}" ToolTip="{Binding Tag.SyncSummary,ElementName=PageRoot}" Style="{StaticResource Glass.Muted}" FontSize="11" TextWrapping="NoWrap" />
              </DockPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Grid Grid.Row="4" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}" IsEnabled="{Binding Tag.HasWorkspace,ElementName=PageRoot}">
        <Border x:Name="MappedObjectsCard" Style="{StaticResource Glass.Card}" Padding="20,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="32" />
              <RowDefinition Height="26" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{l:Tr Glass.MappedObjects}" Style="{StaticResource Glass.Heading}" />
              <TextBlock Text="{Binding Tag.MappedMeta,ElementName=PageRoot}" Style="{StaticResource Glass.Muted}" Margin="10,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <CheckBox Content="{l:Tr Glass.All}" IsChecked="{Binding VersionControl.VcShowAll}" Click="OnMappedAll" ToolTip="{l:Tr Vc.ShowAll}" Style="{StaticResource Glass.Button}" Height="26" Padding="10,2" FontSize="10" />
              <Button Content="{Binding ElementName=PageRoot,Path=Tag.DifferenceLabel}" ToolTip="{l:Tr Glass.Differ}" Tag="Unequal" Click="OnMappedFilter" Style="{StaticResource Glass.Button}" Foreground="{DynamicResource Ui.Orange}" Background="{DynamicResource Ui.WarningSoft}" Height="26" Padding="10,2" FontSize="10" Margin="6,0,0,0" />
              <Button Content="{Binding ElementName=PageRoot,Path=Tag.MissingLabel}" ToolTip="{l:Tr Glass.Missing}" Tag="WorkspaceFileMissing" Click="OnMappedFilter" Style="{StaticResource Glass.Button}" Height="26" Padding="10,2" FontSize="10" Margin="6,0,0,0" />
            </StackPanel>
            <Grid Grid.Row="1" Margin="12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width=".9*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Col.Object}" Grid.Column="0" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{l:Tr Glass.File}" Grid.Column="1" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold" />
              <TextBlock Text="{l:Tr Col.State}" Grid.Column="2" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold" />
            </Grid>
            <ListBox x:Name="MappedList" Grid.Row="2" ItemsSource="{Binding VersionControl.VcStatusItems}" SelectedItem="{Binding VersionControl.SelectedVcItem}" Style="{StaticResource Glass.List}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Glass.Row}">
                  <Setter Property="Margin" Value="0,0,0,3" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0" Height="34">
                          <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CompareState}" Value="Unequal">
                      <Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}" />
                    </DataTrigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}" />
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="1.4*" />
                      <ColumnDefinition Width="1.6*" />
                      <ColumnDefinition Width=".9*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Glass.Text}" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding FilePath}" Style="{StaticResource Glass.Mono}" Margin="0,0,12,0" ToolTip="{Binding FilePath}" />
                    <TextBlock Grid.Column="2">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Muted}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding CompareState}" Value="Unequal">
                              <Setter Property="Foreground" Value="{DynamicResource Ui.Orange}" />
                              <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="compare">
                          <Binding Path="CompareState" />
                          <Binding Source="{x:Static l:Loc.Current}" Path="Language" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Margin="12,24" Visibility="{Binding VersionControl.HasVcItems, Converter={StaticResource NotBoolToVisibility}}">
              <TextBlock Text="{l:Tr Vc.Empty.Title}" Style="{StaticResource Glass.Heading}" FontSize="18" />
              <TextBlock Text="{l:Tr Vc.Empty.Body}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid Grid.Column="2">
      <Border x:Name="DiffCard" Style="{StaticResource Glass.Card}" TextElement.Foreground="{DynamicResource Ui.DiffText}" Background="{DynamicResource Ui.DiffCardBackground}" Padding="20,18" Opacity="{Binding Tag.WorkspaceOpacity,ElementName=PageRoot}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Glass.LocalDiff}" Style="{StaticResource Glass.Heading}" />
          <Border Style="{StaticResource Glass.Chip}" Background="{DynamicResource Ui.DiffInset}" HorizontalAlignment="Right">
            <TextBlock Text="{l:Tr Glass.WorkingTree}" Foreground="{DynamicResource Ui.DiffMuted}" />
          </Border>
          <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffAdded}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" Foreground="{DynamicResource Ui.DiffGreen}" Margin="8,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.DiffRemoved}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" Foreground="{DynamicResource Ui.DiffRed}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="{Binding Tag.DiffFileName,ElementName=PageRoot}" ToolTip="{Binding VersionControl.VcDiffCaption}" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.DiffMuted}" FontWeight="SemiBold" />
          </DockPanel>
          <Border Grid.Row="2" Background="{DynamicResource Ui.DiffInset}" CornerRadius="10" Padding="14,12" Margin="0,4,0,14">
            <Grid>
              <TextBlock Text="{l:Tr Pages.NoDiff}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.DiffMuted}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource NotBoolToVisibility}}" />
              <ListBox ItemsSource="{Binding VersionControl.VcDiffLines}" Style="{StaticResource Glass.List}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" LineHeight="17">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource Ui.DiffMuted}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                              <Setter Property="Foreground" Value="{DynamicResource Ui.DiffGreen}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                              <Setter Property="Foreground" Value="{DynamicResource Ui.DiffRed}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <StackPanel Grid.Row="3">
            <ItemsControl ItemsSource="{Binding ElementName=PageRoot,Path=Tag.OtherMappedFiles}" Margin="0,0,0,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Content="{Binding FilePath}" Tag="{Binding}" Click="OnMappedFile" ToolTip="{l:Tr Glass.InspectFile}" Style="{StaticResource Glass.Quiet}" Foreground="{DynamicResource Ui.DiffMuted}" HorizontalContentAlignment="Left" Height="22" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{l:Tr Glass.DiffScope}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.DiffMuted}" TextWrapping="Wrap" FontSize="10.5" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <views:EngineeringOptionsView x:Name="Options" Grid.ColumnSpan="3" />
  </Grid>
</UserControl>
