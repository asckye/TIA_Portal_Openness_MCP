<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.EngineeringSideView" x:Name="PageRoot">
  <!-- PLC-wide compiler messages and inspection results share the Compile document. -->
  <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16" x:Name="Results" SizeChanged="OnResultsSizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition x:Name="Gutter" Width="16"/>
        <ColumnDefinition x:Name="SecondColumn"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.ProjectResultCard}" x:Name="CompileCard" Padding="20">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="{Binding Engineering.CompileSummary}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Engineering.CompilerMessages}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Style="{StaticResource Primer.CodeBlock}" Padding="14" Margin="0,8,0,0">
                <DockPanel>
                  <Ellipse DockPanel.Dock="Left" Style="{StaticResource Project.DiagnosticDot}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                  <TextBlock Style="{StaticResource Primer.CodeText}" TextWrapping="Wrap">
                    <Run Text="{Binding Severity,Mode=OneWay}"/> · <Run Text="{Binding Target,Mode=OneWay}"/>  <Run Text="{Binding Description,Mode=OneWay}"/>
                  </TextBlock>
                </DockPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:Tr Project.PreviousCompile}" Style="{StaticResource Project.PreviousCompile}" Margin="0,6,0,0"/>
          <ItemsControl ItemsSource="{Binding Tag.Diagnostics,ElementName=PageRoot}" Style="{StaticResource Project.Transcript}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Style="{StaticResource Primer.CodeText}" TextWrapping="Wrap" Margin="0,6">
              <Run Text="{Binding Name,Mode=OneWay}"/> · <Run Text="{Binding Message,Mode=OneWay}"/>
            </TextBlock></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding Tag.CompileTime,ElementName=PageRoot}" Style="{StaticResource Project.Caption}"/>
        </StackPanel>
      </Border>
      <Grid Grid.Column="2" x:Name="InspectionPane">
        <Border x:Name="InspectionCard" Style="{StaticResource Primer.Container}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" MinHeight="28"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{l:Tr Primer.Inspection}" Style="{StaticResource Primer.ContainerTitle}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.InspectionTime}" Style="{StaticResource Primer.Mono}" Margin="0,0,4,0"/>
              <Button AutomationProperties.Name="{l:Tr Pages.Rules}" Content="{l:Tr Pages.Rules}" Click="OnInspectionRules" Style="{StaticResource Primer.Link}" Padding="4,0" MinHeight="32"/>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding ElementName=PageRoot, Path=Tag.InspectionDisplay}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" Margin="0,8,0,8"/>
            <StackPanel Grid.Row="2">
              <ItemsControl ItemsSource="{Binding Engineering.EnabledRules}">
                <ItemsControl.ItemTemplate><DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Primer.Muted}" Margin="0,3" TextWrapping="Wrap"/>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ElementName=PageRoot, Path=Tag.Rules}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource Primer.Chip}" Margin="0,0,8,8">
                      <TextBlock Text="{Binding}" Style="{StaticResource Primer.Text.text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <Button Grid.Row="3" Content="{l:Tr Pages.Inspect}" AutomationProperties.Name="{l:Tr Pages.Inspect}" x:Name="InspectButton" Command="{Binding Engineering.Inspect}" Style="{StaticResource Primer.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
