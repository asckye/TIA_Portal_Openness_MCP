<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.EngineeringSideView" x:Name="PageRoot">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{Binding Tag.CompileCardHeight,ElementName=PageRoot}"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="{Binding Tag.InspectionCardHeight,ElementName=PageRoot}"/>
      <RowDefinition Height="14"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <Border x:Name="CompileCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Toolbar.Compile}" Style="{StaticResource Primer.ContainerTitle}"/>
          <ContentControl Style="{StaticResource Primer.StatusChip}" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.CompileBadge}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Height="54" VerticalAlignment="Center" Visibility="{Binding Tag.HasCompile,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.Errors}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{l:Tr Primer.Errors}" Style="{StaticResource Primer.Muted}" FontSize="12" Margin="4,0,12,0"/>
            <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.Warnings}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBlock Text="{l:Tr Primer.Warnings}" Style="{StaticResource Primer.Muted}" FontSize="12" Margin="4,0,0,0"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{l:Tr Pages.CompileHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="{Binding Tag.HasCompile,ElementName=PageRoot,Converter={StaticResource NotBoolToVisibility}}"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
            <ItemsControl ItemsSource="{Binding ElementName=PageRoot, Path=Tag.Diagnostics}" Margin="0,0,0,-8">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Style="{StaticResource Primer.ListRow}">
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontSize="11" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Message}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2">
      <Border x:Name="InspectionCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Primer.Inspection}" Style="{StaticResource Primer.ContainerTitle}"/>
          <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.InspectionTime}" Style="{StaticResource Primer.Muted}" HorizontalAlignment="Right"/>
          <TextBlock Grid.Row="1" Text="{Binding ElementName=PageRoot, Path=Tag.InspectionDisplay}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding ElementName=PageRoot, Path=Tag.Rules}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Primer.Chip}" Margin="0,0,6,6">
                  <TextBlock Text="{Binding}" Style="{StaticResource Primer.Text.text}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="4">
      <Border x:Name="BlocksLogCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Log.Title}" FontWeight="SemiBold" Style="{StaticResource Primer.Text.text}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Primer.Quiet}"/>
          </StackPanel>
          <controls:LogTailView x:Name="LogTail" Grid.Row="1" Style="{StaticResource Primer.LogTail}" ItemsSource="{Binding Tag.LogTail,ElementName=PageRoot}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
