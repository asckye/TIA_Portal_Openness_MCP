<UserControl xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TiaOpenness.Gui.Views.EngineeringSideView" x:Name="PageRoot">
  <!-- 项目 page, right column: small cards for compile, inspection, environment and the recent log, 16 px apart. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="{Binding Tag.CompileCardHeight,ElementName=PageRoot}"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="{Binding Tag.InspectionCardHeight,ElementName=PageRoot}"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="16"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid>
      <Border x:Name="CompileCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="24"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Toolbar.Compile}" Style="{StaticResource Primer.ContainerTitle}" ToolTip="{l:Tr Pages.CompileDescription}"/>
          <ContentControl Style="{StaticResource Primer.StatusChip}" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.CompileBadge}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
          <Grid Grid.Row="1" Margin="0,8,0,8" Visibility="{Binding Tag.HasCompile,ElementName=PageRoot,Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.Errors}" Style="{StaticResource Primer.StatisticValue}" Margin="0"/>
              <TextBlock Text="{l:Tr Primer.Errors}" Style="{StaticResource Primer.StatisticTitle}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock Text="{Binding ElementName=PageRoot, Path=Tag.Warnings}" Style="{StaticResource Primer.StatisticValue}" Margin="0"/>
              <TextBlock Text="{l:Tr Primer.Warnings}" Style="{StaticResource Primer.StatisticTitle}" VerticalAlignment="Bottom" Margin="4,0,0,4"/>
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Text="{l:Tr Pages.CompileHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,12,0,0" Visibility="{Binding Tag.HasCompile,ElementName=PageRoot,Converter={StaticResource NotBoolToVisibility}}"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
            <ItemsControl ItemsSource="{Binding ElementName=PageRoot, Path=Tag.Diagnostics}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Primer.ListRow}" Padding="0,8">
                    <DockPanel>
                      <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Row="2">
      <Border x:Name="InspectionCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Primer.Inspection}" Style="{StaticResource Primer.ContainerTitle}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="{Binding ElementName=PageRoot,Path=Tag.InspectionTime}" Style="{StaticResource Primer.Mono}" Margin="0,0,4,0"/>
            <Button AutomationProperties.Name="{l:Tr Pages.Rules}" Content="{l:Tr Pages.Rules}" Click="OnInspectionRules" Style="{StaticResource Primer.Link}" Padding="4,0" MinHeight="24"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Text="{Binding ElementName=PageRoot, Path=Tag.InspectionDisplay}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap" Margin="0,8,0,8"/>
          <ItemsControl Grid.Row="2" ItemsSource="{Binding ElementName=PageRoot, Path=Tag.Rules}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Primer.Chip}" Margin="0,0,8,8">
                  <TextBlock Text="{Binding}" Style="{StaticResource Primer.Text.text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
    <Border x:Name="EnvironmentCard" Grid.Row="4" Style="{StaticResource Primer.Container}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="28"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Tr Shell.Environment}" Style="{StaticResource Primer.ContainerTitle}"/>
        <Button AutomationProperties.Name="{l:Tr Pages.View}" x:Name="RunEnvironmentButton" Content="{l:Tr Pages.View}" Click="OnEnvironment" Style="{StaticResource Primer.Link}" Padding="4,0" MinHeight="24" HorizontalAlignment="Right"/>
        <DockPanel Grid.Row="1" Margin="0,8,0,0" ToolTip="{l:Tr Pages.EnvironmentDescription}">
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Margin="8,0,0,0">
            <TextBlock Text="{Binding Tag.EnvironmentState,ElementName=PageRoot}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
          <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Info}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding Tag.EnvironmentSummary,ElementName=PageRoot}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap"/>
        </DockPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="6">
      <Border x:Name="BlocksLogCard" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Log.Title}" Style="{StaticResource Primer.ContainerTitle}"/>
          <Button AutomationProperties.Name="{l:Tr Log.Clear}" Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Primer.Link}" Padding="4,0" MinHeight="24" HorizontalAlignment="Right"/>
          <controls:LogTailView AutomationProperties.Name="{l:Tr Log.Title}" x:Name="LogTail" Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource Primer.LogTail}" ItemsSource="{Binding Tag.LogTail,ElementName=PageRoot}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
