<UserControl x:Class="TiaOpenness.Gui.Views.ProjectTreeView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:s="clr-namespace:TiaOpenness.Gui.Services"
  xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels"
  xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls">
  <DockPanel>
    <Border Style="{StaticResource Primer.ProjectHeaderLine}" DockPanel.Dock="Top" Padding="12,10">
      <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,8">
          <TextBlock DockPanel.Dock="Left" Text="{l:Tr Project.Tree}" Style="{StaticResource Primer.Muted}"
            FontSize="{DynamicResource Ui.FontSize.11}" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2"/>
          <Button DockPanel.Dock="Right" Content="{l:Tr Pages.Options}" AutomationProperties.Name="{l:Tr Project.Options}"
            Click="OnProjectOptions" Style="{StaticResource Primer.IdeToolButton}"/>
        </DockPanel>
        <Grid>
          <Label x:Name="FilterLabel" Content="{l:Tr Project.Filter}" Target="{Binding ElementName=ControlFilter}" Visibility="Collapsed"/>
          <TextBox x:Name="ControlFilter" Style="{StaticResource Primer.IdeSearch}" Padding="25,0,6,0"
            Text="{Binding Engineering.BlockFilter,UpdateSourceTrigger=PropertyChanged}" Tag="{l:Tr Project.Filter}"
            AutomationProperties.Name="{l:Tr Project.Filter}" AutomationProperties.LabeledBy="{Binding ElementName=FilterLabel}"/>
        </Grid>
        <ux:PrefillMarker x:Name="FilterMarker" Target="{Binding ElementName=ControlFilter}"/>
      </StackPanel>
    </Border>
    <ux:PrefillMarker x:Name="SelectionMarker" DockPanel.Dock="Top" Target="{Binding ElementName=Nodes}" Margin="8,0"/>
    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Sidebar.Empty}" Margin="12" TextWrapping="Wrap" Style="{StaticResource Project.EmptySidebar}"/>
    <StackPanel DockPanel.Dock="Top" Margin="16,28,16,8" Visibility="{Binding Engineering.EmptyDeviceList,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{l:Tr Project.NoDevices}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
      <TextBlock Text="{l:Tr Project.AddDeviceHint}" Style="{StaticResource Project.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8"/>
      <Button x:Name="ReloadEmptyTree" Content="{l:Tr Project.ReloadTree}" AutomationProperties.Name="{l:Tr Project.ReloadTree}"
        IsEnabled="{Binding Session.CanOpenConnection}" Click="OnReloadTree" Style="{StaticResource Primer.Button.Secondary.Small}" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Visibility="{Binding Session.LostConnection,Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="{l:Tr Project.Snapshot}" Style="{StaticResource Project.Caption}" Margin="12,8"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="{Binding ActualHeight,RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl ItemsSource="{Binding Engineering.Snapshot.Tree}" Margin="12,0">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Primer.Mono}" TextTrimming="CharacterEllipsis"
            Margin="0,3" ToolTip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
    <TreeView x:Name="Nodes" ItemsSource="{Binding Engineering.ProjectDevices}" AutomationProperties.Name="{l:Tr Access.Software}"
      PreviewMouseLeftButtonDown="OnNodeClick" PreviewKeyDown="OnNodeKey" ItemContainerStyleSelector="{StaticResource Primer.ProjectNodeSelector}"
      Background="Transparent" BorderThickness="0" Padding="8" AlternationCount="2147483647" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
      PreviewMouseRightButtonDown="OnContextRow">
      <TreeView.ContextMenu>
        <ContextMenu Opened="OnContextOpening">
          <MenuItem Header="{l:Tr Primer.SelectAll}" Click="OnAll" InputGestureText="Ctrl+A"/>
          <MenuItem Header="{l:Tr Pages.ClearSelection}" Click="OnClear"/>
          <Separator/>
          <MenuItem x:Name="SelectGroup" Header="{l:Tr Project.SelectGroup}" Click="OnGroup"/>
          <MenuItem x:Name="ClearGroup" Header="{l:Tr Project.ClearGroup}" Click="OnGroup"/>
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:DeviceNode}" ItemsSource="{Binding ProjectChildren}"
          ItemContainerStyleSelector="{StaticResource Primer.ProjectNodeSelector}">
          <Border x:Name="DeviceSurface" Style="{StaticResource Primer.ProjectDeviceSurface}">
            <DockPanel>
              <Border Style="{StaticResource Primer.ProjectDeviceTile}" x:Name="Tile" Width="20" Height="20" Margin="0,0,6,0">
                <Path x:Name="PlcIcon" Data="M2,2 H14 V14 H2 Z M6,6 H10 V10 H6 Z M5,0 V2 M10,0 V2 M5,14 V16 M10,14 V16"
                  Stroke="{DynamicResource Primer.textMuted}" Stretch="Uniform" Width="12" Height="12"/>
              </Border>
              <Border x:Name="HmiBadge" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,6,0"
                Style="{StaticResource Primer.ProjectHmiBadge}" Padding="6,2">
                <TextBlock Text="HMI" Foreground="{DynamicResource Primer.blkHmFg}" Style="{StaticResource Primer.Mono}"/>
              </Border>
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="DeviceName" Text="{Binding Label}" Style="{StaticResource Primer.Mono}" FontWeight="SemiBold"
                    FontSize="{DynamicResource Ui.FontSize.12_5}" LineHeight="18.75" LineStackingStrategy="BlockLineHeight"/>
                  <Border Style="{StaticResource Primer.ProjectSafetyTag}" Margin="5,0" Padding="3,0"
                    Visibility="{Binding HasSafetyBlocks,Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="F" Foreground="{DynamicResource Primer.blkFsFg}" FontSize="{DynamicResource Ui.FontSize.9}"/>
                  </Border>
                </DockPanel>
                <TextBlock Text="{Binding Caption}" Style="{StaticResource Project.DeviceDetail}" ToolTip="{Binding Caption}"
                  LineHeight="13.125" LineStackingStrategy="BlockLineHeight"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="DeviceName" Property="Foreground" Value="{DynamicResource Primer.accent}"/>
              <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Primer.primaryBg}"/>
              <Setter TargetName="PlcIcon" Property="Stroke" Value="{DynamicResource Primer.onPrimary}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Category}" Value="Hmi">
              <Setter TargetName="Tile" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="HmiBadge" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="True">
              <Setter TargetName="PlcIcon" Property="Data" Value="{StaticResource Icon.WorkbenchProject}"/>
            </DataTrigger>
          </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:BlockNode}" ItemsSource="{Binding Children}"
          ItemContainerStyleSelector="{StaticResource Primer.ProjectNodeSelector}">
          <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding IsSelected,Mode=TwoWay}"
            Style="{StaticResource Primer.ProjectBlockChoice}" IsEnabled="{Binding Tag.CanOperate,RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Grid MinHeight="20">
              <DockPanel x:Name="FolderRow" LastChildFill="True">
                <Path Style="{StaticResource Project.Glyph}" Data="{StaticResource Icon.WorkbenchProject}" Stroke="{DynamicResource Primer.accent}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Project.Caption}"/>
                <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}"/>
              </DockPanel>
              <DockPanel x:Name="LeafRow" Visibility="Collapsed">
                <DockPanel.ToolTip>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock><Run Text="{l:Tr Primer.Number}"/> · <Run Text="{Binding Detail,Mode=OneWay}"/></TextBlock>
                    <TextBlock><Run Text="{l:Tr Primer.Language}"/> · <Run Text="{Binding Language,Mode=OneWay}"/></TextBlock>
                    <TextBlock><Run Text="{l:Tr Primer.Group}"/> · <Run Text="{Binding Row.Info.FolderPath,Mode=OneWay}"/></TextBlock>
                    <TextBlock><Run Text="{l:Tr Primer.Consistent}"/> · <Run>
                      <Run.Text><MultiBinding Mode="OneWay" Converter="{StaticResource Primer.Value}" ConverterParameter="consistent">
                        <Binding Path="Row.Info.IsConsistent"/><Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                      </MultiBinding></Run.Text></Run></TextBlock>
                  </StackPanel>
                </DockPanel.ToolTip>
                <Border Style="{StaticResource Primer.BlkBadge}" Margin="0,0,8,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Kind}" Style="{StaticResource Primer.BlkBadgeText}"/>
                </Border>
                <Ellipse DockPanel.Dock="Right" Style="{StaticResource Project.Dot}" ToolTip="{l:Tr Project.Modified}"
                  Visibility="{Binding IsModified,Converter={StaticResource BoolToVisibility}}"/>
                <Ellipse DockPanel.Dock="Right" Style="{StaticResource Project.Dot}" Fill="{DynamicResource Primer.destructiveText}"
                  ToolTip="{Binding Status}" Visibility="{Binding Row.Info.IsConsistent,Converter={StaticResource NotBoolToVisibility}}"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="BlockName" TextWrapping="Wrap" FontWeight="Medium" Text="{Binding Name}" ToolTip="{Binding Name}" Style="{StaticResource Primer.Mono}"
                    FontSize="{DynamicResource Ui.FontSize.12}" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                  <TextBlock Text="{Binding Row.Subtitle}" Style="{StaticResource Project.Caption}"
                    FontSize="{DynamicResource Ui.FontSize.10}" LineHeight="15" LineStackingStrategy="BlockLineHeight"/>
                </StackPanel>
              </DockPanel>
            </Grid>
          </CheckBox>
          <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
              <Setter TargetName="BlockName" Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="BlockName" Property="Foreground" Value="{DynamicResource Primer.text}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsFolder}" Value="False">
              <Setter TargetName="LeafRow" Property="Visibility" Value="Visible"/><Setter TargetName="FolderRow" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
          </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type s:SoftwareUnitInfo}" ItemsSource="{Binding Children}"
          ItemContainerStyleSelector="{StaticResource Primer.ProjectNodeSelector}">
          <DockPanel Margin="12,2,8,2">
            <Border DockPanel.Dock="Left" Style="{StaticResource Primer.SoftwareUnitBadge}" Padding="4,0" Margin="0,0,6,0">
              <TextBlock Text="SU" Foreground="{DynamicResource Primer.blkSuFg}" Style="{StaticResource Primer.Mono}"/>
            </Border>
            <TextBlock DockPanel.Dock="Right" Text="{Binding Blocks.Count}" Style="{StaticResource Project.Caption}"/>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Mono}"/>
          </DockPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type s:UnitBlockInfo}">
          <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Mono}" Margin="12,3"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectLink}">
          <DockPanel MinHeight="28">
            <Path x:Name="LinkIcon" Style="{StaticResource Project.Glyph}" Data="{StaticResource Icon.FileText}"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountLabel}" Style="{StaticResource Project.Caption}"/>
            <TextBlock Style="{StaticResource Primer.ProjectLinkLabel}"/>
          </DockPanel>
          <DataTemplate.Triggers><DataTrigger Binding="{Binding IsVersionControl}" Value="True">
            <Setter TargetName="LinkIcon" Property="Data" Value="{StaticResource Icon.Branch}"/>
          </DataTrigger></DataTemplate.Triggers>
        </DataTemplate>
      </TreeView.Resources>
    </TreeView>
  </DockPanel>
</UserControl>
