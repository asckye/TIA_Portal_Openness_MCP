<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.CallDetailDrawer">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,16,22,22" DataContext="{Binding SelectedCall}">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="24"/>
          <RowDefinition Height="24"/>
          <RowDefinition Height="24"/>
          <RowDefinition Height="24"/>
          <RowDefinition Height="24"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Primer.Muted}"/>
        <TextBlock Grid.Column="1" Text="{Binding Record.Time, StringFormat=yyyy-MM-dd HH:mm:ss zzz}" Style="{StaticResource Primer.Mono}"/>
        <TextBlock Grid.Row="1" Text="{l:Tr Calls.Host}" Style="{StaticResource Primer.Muted}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Host}" Style="{StaticResource Primer.Text}"/>
        <TextBlock Grid.Row="2" Text="{l:Tr Calls.ReadWrite}" Style="{StaticResource Primer.Muted}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReadWrite}" Style="{StaticResource Primer.ToneText}" Tag="{Binding WriteTone}"/>
        <TextBlock Grid.Row="3" Text="{l:Tr Calls.Duration}" Style="{StaticResource Primer.Muted}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Primer.Mono}"/>
        <TextBlock Grid.Row="4" Text="{l:Tr Calls.RequestId}" Style="{StaticResource Primer.Muted}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Record.RequestId}" Style="{StaticResource Primer.Mono}"/>
      </Grid>
      <DockPanel Margin="0,0,0,8">
        <Button DockPanel.Dock="Right" Content="{l:Tr Feature.Copy}" Style="{StaticResource Primer.Quiet}" Click="OnCopy"/>
        <TextBlock Text="{l:Tr Calls.Parameters}" Style="{StaticResource Primer.ContainerTitle}"/>
      </DockPanel>
      <Border Padding="12" Style="{StaticResource Primer.CodeBlock}">
        <ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ParametersCode" Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/>
        </ScrollViewer>
      </Border>
      <TextBlock Text="{l:Tr Calls.Summary}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,20,0,8"/>
      <Border Padding="12,10" Style="{StaticResource Primer.Inset}">
        <TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/>
      </Border>
      <TextBlock Text="{l:Tr Calls.ResultJson}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,20,0,8"/>
      <Border Padding="12" Style="{StaticResource Primer.CodeBlock}">
        <ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding ResultJson}" Style="{StaticResource Primer.CodeText}"/>
        </ScrollViewer>
      </Border>
      <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <Border Padding="12" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.WarningSurface}">
        <StackPanel>
          <TextBlock Text="{l:Tr Calls.Error}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource Primer.Text.warn}"/>
          <TextBlock Text="{Binding Error}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Primer.Text.warn}"/>
        </StackPanel>
      </Border>
      <TextBlock Text="{l:Tr Calls.ApprovalRecord}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,20,0,8"/>
      <Border Padding="12,10" Style="{StaticResource Primer.Inset}">
        <TextBlock Text="{Binding Approval}" Style="{StaticResource Primer.Muted}" FontSize="12" TextWrapping="Wrap"/>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
