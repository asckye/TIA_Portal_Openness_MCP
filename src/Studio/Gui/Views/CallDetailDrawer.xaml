<UserControl xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.CallDetailDrawer">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12,16,16" DataContext="{Binding SelectedCall}">
      <TextBlock x:Name="ControlActivity" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
      <Border Style="{StaticResource Primer.Container}" Padding="16">
        <DockPanel>
          <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" Content="{l:Tr Calls.CopyParameters}"
            AutomationProperties.Name="{l:Tr Calls.CopyParameters}" Style="{StaticResource Primer.Quiet}" Click="OnCopy"/>
          <StackPanel>
            <TextBlock Text="{l:Tr Calls.Target}" Style="{StaticResource Primer.Muted}"/>
            <TextBlock Text="{Binding Target}" Style="{StaticResource Primer.Mono.text}" TextWrapping="Wrap" TextTrimming="None"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Style="{StaticResource Primer.Container}" Padding="16" Margin="0,14">
        <StackPanel>
          <TextBlock Text="{l:Tr Calls.ResultJson}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,0,8"/>
          <Border Padding="12" Style="{StaticResource Primer.CodeBlock}">
            <ScrollViewer MaxHeight="540" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="ResultCode" TextWrapping="Wrap" TextTrimming="None" views:CallDetailDrawer.JsonPreview="{Binding ResultJson}"
                Style="{StaticResource Primer.CodeText}"/>
            </ScrollViewer>
          </Border>
          <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Expander Header="{l:Tr Calls.Detail}" AutomationProperties.Name="{l:Tr Calls.Detail}" Style="{StaticResource Primer.Expander}">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{l:Tr Calls.Host}" Style="{StaticResource Primer.Muted}" MinWidth="90" Margin="0,0,6,0"/>
            <TextBlock Text="{Binding Host}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap"/>
          </DockPanel>
          <UniformGrid Rows="1">
            <StackPanel>
              <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Primer.Muted}"/>
              <TextBlock Text="{Binding Time}" Style="{StaticResource Primer.Mono.text}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{l:Tr Calls.Duration}" Style="{StaticResource Primer.Muted}"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding Duration}" Style="{StaticResource Primer.Mono.text}"/>
                <TextBlock Text="{Binding ReadWrite}" Style="{StaticResource Primer.ToneText}" Tag="{Binding WriteTone}" Margin="8,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </UniformGrid>
          <Border Style="{StaticResource Primer.Container}" Padding="16"><StackPanel>
              <TextBlock Text="{l:Tr Calls.Parameters}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,0,8"/>
              <Border Padding="12" Style="{StaticResource Primer.CodeBlock}">
                <ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <TextBlock x:Name="ParametersCode" Text="{Binding Parameters}" Style="{StaticResource Primer.CodeText}"/>
                </ScrollViewer>
              </Border>
            </StackPanel></Border>
          <TextBlock Text="{l:Tr Calls.Summary}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,20,0,8"/>
          <Border Padding="12,10" Style="{StaticResource Primer.Inset}">
            <TextBlock Text="{Binding Summary}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap"/>
          </Border>
          <Border Padding="12" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
            Style="{StaticResource Primer.WarningSurface}">
            <StackPanel>
              <TextBlock Text="{l:Tr Calls.Error}" FontSize="{DynamicResource Ui.FontSize.Caption}" FontWeight="SemiBold"
                Style="{StaticResource Primer.Text.warn}"/>
              <TextBlock Text="{Binding Error}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap"
                Margin="0,8,0,0" Style="{StaticResource Primer.Text.warn}"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="16" Margin="0,14,0,0"><StackPanel>
              <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" MinWidth="90"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" MinHeight="24"/>
                  <RowDefinition Height="Auto" MinHeight="24"/>
                  <RowDefinition Height="Auto" MinHeight="24"/>
                  <RowDefinition Height="Auto" MinHeight="24"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Record.Time, StringFormat=yyyy-MM-dd HH:mm:ss zzz}" TextWrapping="Wrap"
                  Style="{StaticResource Primer.Mono}"/>
                <TextBlock Grid.Row="1" Text="{l:Tr Calls.RequestId}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Record.RequestId}" TextWrapping="Wrap" Style="{StaticResource Primer.Mono}"/>
                <TextBlock Grid.Row="2" Text="{l:Tr Actor.Title}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Actor}" Style="{StaticResource Primer.Text}"/>
                <TextBlock Grid.Row="3" Text="{l:Tr Calls.McpSession}" Style="{StaticResource Primer.Muted}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Record.McpSession}" TextWrapping="Wrap" ToolTip="{Binding Record.McpSession}"
                  Style="{StaticResource Primer.Mono}"/>
              </Grid>
            </StackPanel></Border>
          <TextBlock Text="{l:Tr Calls.ApprovalRecord}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,20,0,8"/>
          <Border Padding="12,10" Style="{StaticResource Primer.Inset}">
            <TextBlock Text="{Binding Approval}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
