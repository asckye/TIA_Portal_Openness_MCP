<UserControl x:Class="TiaOpenness.Gui.Views.CallDetailDrawer" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,16,22,22" DataContext="{Binding SelectedCall}">
      <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/><RowDefinition Height="24"/></Grid.RowDefinitions>
        <TextBlock Text="{l:Tr Calls.Time}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Column="1" Text="{Binding Record.Time, StringFormat=yyyy-MM-dd HH:mm:ss zzz}" Style="{StaticResource Glass.Mono}"/>
        <TextBlock Grid.Row="1" Text="{l:Tr Calls.Host}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Host}" Style="{StaticResource Glass.Text}"/>
        <TextBlock Grid.Row="2" Text="{l:Tr Calls.ReadWrite}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReadWrite}" Style="{StaticResource Feature.Text}" Tag="{Binding WriteTone}"/>
        <TextBlock Grid.Row="3" Text="{l:Tr Calls.Duration}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Glass.Mono}"/>
        <TextBlock Grid.Row="4" Text="{l:Tr Calls.RequestId}" Style="{StaticResource Glass.Muted}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Record.RequestId}" Style="{StaticResource Glass.Mono}"/>
      </Grid>
      <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="{l:Tr Feature.Copy}" Style="{StaticResource Glass.Quiet}" Click="OnCopy"/><TextBlock Text="{l:Tr Calls.Parameters}" Style="{StaticResource Glass.Heading}"/></DockPanel>
      <Border Background="{DynamicResource Ui.CodeBackground}" CornerRadius="10" Padding="12"><ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ParametersCode" Text="{Binding Parameters}" Style="{StaticResource Feature.Code}"/></ScrollViewer></Border>
      <TextBlock Text="{l:Tr Calls.Summary}" Style="{StaticResource Glass.Heading}" Margin="0,20,0,8"/>
      <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="10" Padding="12,10"><TextBlock Text="{Binding Summary}" FontSize="12" TextWrapping="Wrap"/></Border>
      <TextBlock Text="{l:Tr Calls.ResultJson}" Style="{StaticResource Glass.Heading}" Margin="0,20,0,8"/>
      <Border Background="{DynamicResource Ui.CodeBackground}" CornerRadius="10" Padding="12"><ScrollViewer MaxHeight="230" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ResultJson}" Style="{StaticResource Feature.Code}"/></ScrollViewer></Border>
      <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
      <Border Background="{DynamicResource Ui.WarningSoft}" CornerRadius="10" Padding="12" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"><StackPanel><TextBlock Text="{l:Tr Calls.Error}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Ui.Orange}"/><TextBlock Text="{Binding Error}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" Foreground="{DynamicResource Ui.Orange}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
      <TextBlock Text="{l:Tr Calls.ApprovalRecord}" Style="{StaticResource Glass.Heading}" Margin="0,20,0,8"/>
      <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="10" Padding="12,10"><TextBlock Text="{Binding Approval}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap"/></Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
