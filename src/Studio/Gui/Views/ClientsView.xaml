<UserControl x:Class="TiaOpenness.Gui.Views.ClientsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
    xmlns:views="clr-namespace:TiaOpenness.Gui.Views"
    xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes"
    Foreground="{DynamicResource Primer.text}" FontFamily="{DynamicResource Ui.Font}" FontSize="{DynamicResource Ui.FontSize.Body}">
  <DockPanel Margin="-16,-12">
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <DockPanel LastChildFill="False" VerticalAlignment="Center">
        <TextBlock Text="{l:Tr Shell.Clients}" Style="{StaticResource Primer.ContainerTitle}"
                   FontSize="{DynamicResource Ui.FontSize.13}" VerticalAlignment="Center"/>
        <Border Style="{StaticResource Primer.VerticalDivider}" Height="16" Margin="8,0"/>
        <Button x:Name="EditTarget" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"
                ContentTemplate="{x:Null}" Style="{StaticResource Primer.Button.Secondary.Small}" Height="28" AutomationProperties.Name="{l:Tr Config.EditTarget}" ToolTip="{l:Tr Config.EditTarget}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="TargetDot" Width="6" Height="6" Margin="0,0,6,0"/>
            <TextBlock x:Name="TargetEndpoint" Style="{StaticResource Primer.Mono}" MaxWidth="240" TextTrimming="CharacterEllipsis"
                       FontSize="{DynamicResource Ui.FontSize.11_5}"/>
            <TextBlock Text="{l:Tr Config.Edit}" Margin="6,0,0,0" Foreground="{DynamicResource Primer.accent}"/>
          </StackPanel>
        </Button>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="SelectDetected" AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self},TargetNullValue=''}"
                  Style="{StaticResource Primer.IdeToolButton}"/>
          <Button x:Name="ClearClients" Content="{l:Tr Primer.Clear}" AutomationProperties.Name="{l:Tr Primer.Clear}"
                  Style="{StaticResource Primer.IdeToolButton}" Margin="6,0,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24">
        <StackPanel MaxWidth="860">
          <StackPanel x:Name="ClientPane">
            <DockPanel Margin="2,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Ellipse x:Name="DetectedDot" Width="6" Height="6" Margin="0,0,6,0"/>
                <TextBlock x:Name="DetectedCount" Focusable="True" ToolTip="{Binding ToolTip,ElementName=ClientSelection}" AutomationProperties.Name="{l:Tr Config.ClientInstructionsCaption}"
                           FontSize="{DynamicResource Ui.FontSize.11_5}" Style="{StaticResource Primer.Muted.textFaint}" Cursor="Hand"/>
              </StackPanel>
              <TextBlock Text="{l:Tr Config.ChooseTargets}" FontSize="{DynamicResource Ui.FontSize.12_5}" Style="{StaticResource Primer.ContainerTitle}"/>
            </DockPanel>
            <ListBox x:Name="ClientChoices" SelectionMode="Multiple" AutomationProperties.Name="{l:Tr Mcp.Clients}"
                     Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.FileItem}" Margin="-5,5,-5,0" Padding="0" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid>
                    <UniformGrid.Columns>
                      <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=views:ClientsView}">
                        <Binding.Converter><views:ClientTileColumnsConverter/></Binding.Converter>
                      </Binding>
                    </UniformGrid.Columns>
                  </UniformGrid>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <ToggleButton x:Name="ClientTile" Style="{StaticResource Primer.Tile}" VerticalAlignment="Stretch" Padding="14" Margin="5" Focusable="False" MinHeight="68"
                                AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.HelpText="{Binding Tooltip}" ToolTip="{Binding Tooltip}"
                                IsChecked="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem},Mode=OneWay}">
                    <DockPanel>
                      <Border x:Name="Monogram" DockPanel.Dock="Left" Width="32" Height="32" Padding="0" Margin="0,0,12,0"
                              VerticalAlignment="Center" Style="{StaticResource Primer.IdeChip}" views:ClientsView.Monogram="{Binding}">
                        <TextBlock x:Name="MonogramText" Text="{Binding Tag,ElementName=Monogram}"
                                   Foreground="{Binding Path=(TextElement.Foreground),ElementName=Monogram}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource Ui.FontMono}"
                                   FontSize="{DynamicResource Ui.FontSize.11_5}" FontWeight="SemiBold"/>
                      </Border>
                      <Grid DockPanel.Dock="Right" Width="16" Height="16" Margin="6,0,0,0">
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource Primer.inputBorder}"/>
                        <Path x:Name="Tick" Width="8" Height="7" Data="M1,4 L3,6 L8,1" Stretch="Fill"
                              Stroke="{DynamicResource Primer.primaryText}" StrokeThickness="1.5" Visibility="Collapsed"/>
                      </Grid>
                      <StackPanel>
                        <Grid ToolTip="{Binding Tooltip}" HorizontalAlignment="Left">
                          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock x:Name="ClientName" Text="{Binding DisplayName}" MinWidth="40" TextWrapping="Wrap" TextTrimming="None"
                                     FontWeight="Medium" FontSize="{DynamicResource Ui.FontSize.13}" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                          <Ellipse Grid.Column="1" Width="6" Height="6" Margin="6,0,0,0" Fill="{DynamicResource Primer.ok}"
                                   Visibility="{Binding Detected,Converter={StaticResource BoolToVisibility}}"/>
                        </Grid>
                        <TextBlock Text="{Binding Path}" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                                     FontWeight="Normal" FontSize="{DynamicResource Ui.FontSize.11}" Margin="0,2,0,0" ToolTip="{Binding Path}"/>
                      </StackPanel>
                    </DockPanel>
                  </ToggleButton>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Primer.primaryBg}"/>
                      <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Primer.primaryBg}"/>
                      <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                      <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                        <Condition Binding="{Binding EffectivelyHighContrast,Source={x:Static themes:ThemeManager.Current}}" Value="True"/>
                      </MultiDataTrigger.Conditions>
                      <Setter TargetName="ClientTile" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                      <Setter TargetName="ClientTile" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                    </MultiDataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
          <ContentControl Style="{StaticResource Primer.Box}" Margin="0,11,0,0">
            <Border x:Name="ClientActionsBand" Style="{StaticResource Primer.Plain}" Padding="16,12">
              <StackPanel>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Expander x:Name="PreviewJson" Style="{StaticResource Primer.Expander}" VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Header,RelativeSource={RelativeSource Self},TargetNullValue=''}">
                      <Expander.HeaderTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" Height="28" VerticalAlignment="Center">
                            <Path Data="M8,5 L2,11 L8,17 M16,5 L22,11 L16,17" StrokeThickness="1.8"
                                  Stroke="{DynamicResource Primer.textMuted}" Width="13" Height="12" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </Expander.HeaderTemplate>
                    </Expander>
                    <Button x:Name="CopyJson" Style="{StaticResource Primer.Button.Secondary.Small}" IsEnabled="False"
                            Margin="6,0" AutomationProperties.Name="{Binding Content,RelativeSource={RelativeSource Self},TargetNullValue=''}"/>
                    <Button x:Name="SaveClient" Content="{l:Tr Config.Write}" Style="{StaticResource Primer.Button.Primary.Small}"
                            AutomationProperties.Name="{Binding Tag,RelativeSource={RelativeSource Self},TargetNullValue=''}"
                            AutomationProperties.HelpText="{Binding Content,RelativeSource={RelativeSource Self}}" ToolTip="{l:Tr Config.BackupWrite}">
                      <Button.ContentTemplate>
                        <DataTemplate><TextBlock Text="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate>
                      </Button.ContentTemplate>
                    </Button>
                  </StackPanel>
                  <TextBlock x:Name="WriteTargets" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.12_5}"
                             VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,8,0"/>
                </DockPanel>
                <Border Style="{StaticResource Primer.CodeBlock}" Padding="14" Margin="0,12,0,0"
                        Visibility="{Binding IsExpanded,ElementName=PreviewJson,Converter={StaticResource BoolToVisibility}}">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <Label x:Name="PreviewTargetLabel" Target="{Binding ElementName=PreviewTarget}" Content="{l:Tr Config.PreviewTarget}"
                             Style="{StaticResource Primer.FormLabel}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="PreviewTarget" MinWidth="140" DisplayMemberPath="DisplayName" Margin="8,0,0,0"
                                AutomationProperties.Name="{l:Tr Config.PreviewTarget}" AutomationProperties.LabeledBy="{Binding ElementName=PreviewTargetLabel}"/>
                    </DockPanel>
                    <TextBlock x:Name="JsonText" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.12}"
                               TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </ContentControl>
          <DockPanel x:Name="RemoteGuidance" Margin="2,12,0,0">
            <StackPanel DockPanel.Dock="Right" Margin="16,0,0,0">
              <TextBlock Text="{l:Tr Mcp.Clients}" Style="{StaticResource Primer.ContainerTitle}" FontSize="{DynamicResource Ui.FontSize.12_5}"/>
              <TextBlock x:Name="ClientSelection" Focusable="True" Cursor="Hand" Style="{StaticResource Primer.Muted}"
                         AutomationProperties.Name="{l:Tr Config.ClientInstructionsCaption}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{l:Tr Config.Write}" Style="{StaticResource Primer.ContainerTitle}" FontSize="{DynamicResource Ui.FontSize.12_5}"/>
              <TextBlock x:Name="RelayNote" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" Margin="0,2,0,0"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
