<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" x:Class="TiaOpenness.Gui.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,6,22,12">
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Approval}" FontSize="12.5" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Approval}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ApprovalOn" Content="{l:Tr Settings.On}" GroupName="Approval" Style="{StaticResource Primer.Segment}" Click="OnApprovalClick"/>
              <RadioButton x:Name="ApprovalOff" Content="{l:Tr Settings.Off}" GroupName="Approval" Style="{StaticResource Primer.Segment}" Click="OnApprovalClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Timeout}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Timeout60" Content="60s" Tag="60" GroupName="Timeout" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick"/>
              <RadioButton x:Name="Timeout120" Content="120s" Tag="120" GroupName="Timeout" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick"/>
              <RadioButton x:Name="Timeout300" Content="300s" Tag="300" GroupName="Timeout" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Appearance}" FontSize="12.5" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Language}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="English" Content="{l:Tr Settings.English}" GroupName="Language" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsEnglish,Source={x:Static l:Loc.Current}}"/>
              <RadioButton x:Name="Chinese" Content="{l:Tr Settings.Chinese}" GroupName="Language" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsChinese,Source={x:Static l:Loc.Current}}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Theme}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Auto" Content="{l:Tr Settings.Auto}" GroupName="Theme" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsAuto,Source={x:Static themes:ThemeManager.Current}}"/>
              <RadioButton x:Name="Light" Content="{l:Tr Settings.Light}" GroupName="Theme" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsLight,Source={x:Static themes:ThemeManager.Current}}"/>
              <RadioButton x:Name="Dark" Content="{l:Tr Settings.Dark}" GroupName="Theme" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Update}" FontSize="12.5" FontWeight="SemiBold"/>
        <TextBlock x:Name="PackageText" Style="{StaticResource Primer.Muted.textFaint}" FontSize="10.5" TextAlignment="Right"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Engine}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="CheckUpdate" DockPanel.Dock="Right" Content="{l:Tr Settings.CheckUpdate}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="UpdateInstalledItem" Style="{StaticResource Primer.Text}" FontSize="11.5"/>
              <TextBlock Grid.Column="1" Text=" · " FontSize="11.5"/>
              <TextBlock x:Name="UpdateStateItem" Grid.Column="2" Text="{l:Tr Config.NotChecked}" Style="{StaticResource Primer.Text}" FontSize="11.5" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Releases}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenReleases" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock Text="github.com/…/releases" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP/releases"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Button x:Name="RunUpdate" Content="{l:Tr Config.RunUpdate}" Style="{StaticResource Primer.OutlinedAccent}" IsEnabled="False" HorizontalAlignment="Right" Visibility="Collapsed"/>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Diagnostics}" FontSize="12.5" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.ConfigDirectory}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenConfig" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.LogDirectory}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenLog" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock x:Name="LogPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.About}" FontSize="12.5" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Config.Version}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <TextBlock x:Name="VersionText" Style="{StaticResource Primer.Mono}"/>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Primer.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenProjectPage" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock Text="github.com/asckye/TIA_Portal_Openness_MCP" Style="{StaticResource Primer.Mono}" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP"/>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
