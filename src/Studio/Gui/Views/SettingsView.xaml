<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" x:Class="TiaOpenness.Gui.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,6,22,22">
      <DockPanel Margin="0,14,0,10">
        <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="{l:Tr Settings.Approval}" FontSize="12.5" FontWeight="Bold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Approval}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="ApprovalOn" Content="{l:Tr Settings.On}" GroupName="Approval" Style="{StaticResource Shell.Segment}" Click="OnApprovalClick"/>
              <RadioButton x:Name="ApprovalOff" Content="{l:Tr Settings.Off}" GroupName="Approval" Style="{StaticResource Shell.Segment}" Click="OnApprovalClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Timeout}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Timeout60" Content="60s" Tag="60" GroupName="Timeout" Style="{StaticResource Shell.Segment}" Click="OnTimeoutClick"/>
              <RadioButton x:Name="Timeout120" Content="120s" Tag="120" GroupName="Timeout" Style="{StaticResource Shell.Segment}" Click="OnTimeoutClick"/>
              <RadioButton x:Name="Timeout300" Content="300s" Tag="300" GroupName="Timeout" Style="{StaticResource Shell.Segment}" Click="OnTimeoutClick"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.LowEffects}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Border Grid.Column="2" Background="{DynamicResource Ui.ControlBackground}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton Content="{l:Tr Settings.EffectsAuto}" GroupName="Effects" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsEffectsAuto, Source={x:Static themes:ThemeManager.Current}}"/>
            <RadioButton Content="{l:Tr Settings.On}" GroupName="Effects" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsEffectsOn, Source={x:Static themes:ThemeManager.Current}}"/>
            <RadioButton Content="{l:Tr Settings.Off}" GroupName="Effects" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsEffectsOff, Source={x:Static themes:ThemeManager.Current}}"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border Height="16"/>
      <DockPanel Margin="0,14,0,10">
        <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="{l:Tr Settings.Appearance}" FontSize="12.5" FontWeight="Bold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Language}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="English" Content="{l:Tr Settings.English}" GroupName="Language" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsEnglish,Source={x:Static l:Loc.Current}}"/>
              <RadioButton x:Name="Chinese" Content="{l:Tr Settings.Chinese}" GroupName="Language" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsChinese,Source={x:Static l:Loc.Current}}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Theme}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <Border Background="{DynamicResource Ui.ControlBackground}" CornerRadius="16" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Auto" Content="{l:Tr Settings.Auto}" GroupName="Theme" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsAuto,Source={x:Static themes:ThemeManager.Current}}"/>
              <RadioButton x:Name="Light" Content="{l:Tr Settings.Light}" GroupName="Theme" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsLight,Source={x:Static themes:ThemeManager.Current}}"/>
              <RadioButton x:Name="Dark" Content="{l:Tr Settings.Dark}" GroupName="Theme" Style="{StaticResource Shell.Segment}" IsChecked="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Height="16"/>
      <DockPanel Margin="0,14,0,10">
        <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="{l:Tr Settings.Update}" FontSize="12.5" FontWeight="Bold"/>
        <TextBlock x:Name="PackageText" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="10.5" TextAlignment="Right"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Engine}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="CheckUpdate" DockPanel.Dock="Right" Content="{l:Tr Settings.CheckUpdate}" Style="{StaticResource Glass.Outline}" Height="28" FontSize="11" Padding="10,0"/>
            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="UpdateInstalledItem" Style="{StaticResource Glass.Text}" FontSize="11.5"/>
              <TextBlock Grid.Column="1" Text=" · " FontSize="11.5"/>
              <TextBlock x:Name="UpdateStateItem" Grid.Column="2" Text="{l:Tr Config.NotChecked}" Style="{StaticResource Glass.Text}" FontSize="11.5" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Releases}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenReleases" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Glass.Outline}" Height="28" Padding="12,0" FontSize="11.5"/>
            <TextBlock Text="github.com/…/releases" Style="{StaticResource Glass.Mono}" FontWeight="SemiBold" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP/releases"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Button x:Name="RunUpdate" Content="{l:Tr Config.RunUpdate}" Style="{StaticResource Glass.Outline}" IsEnabled="False" HorizontalAlignment="Right" Height="28" Visibility="Collapsed"/>
      <Border Height="16"/>
      <DockPanel Margin="0,14,0,10">
        <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="{l:Tr Settings.Diagnostics}" FontSize="12.5" FontWeight="Bold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.ConfigDirectory}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenConfig" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Glass.Outline}" Height="28" Padding="12,0" FontSize="11.5"/>
            <TextBlock x:Name="ConfigPath" Style="{StaticResource Glass.Mono}" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.LogDirectory}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenLog" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Glass.Outline}" Height="28" Padding="12,0" FontSize="11.5"/>
            <TextBlock x:Name="LogPath" Style="{StaticResource Glass.Mono}" FontWeight="SemiBold" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Border Height="16"/>
      <DockPanel Margin="0,14,0,10">
        <Border Width="3" Height="14" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Margin="0,0,8,0"/>
        <TextBlock Text="{l:Tr Settings.About}" FontSize="12.5" FontWeight="Bold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Config.Version}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <TextBlock x:Name="VersionText" Style="{StaticResource Glass.Mono}"/>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Glass.Muted}" FontSize="12"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button x:Name="OpenProjectPage" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Glass.Outline}" Height="28" Padding="12,0"/>
            <TextBlock Text="github.com/asckye/TIA_Portal_Openness_MCP" Style="{StaticResource Glass.Mono}" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP"/>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
