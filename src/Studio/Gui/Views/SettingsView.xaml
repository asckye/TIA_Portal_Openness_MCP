<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" x:Class="TiaOpenness.Gui.Views.SettingsView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Style="{StaticResource Primer.Workbench.SettingsPane}">
      <ListBox x:Name="SectionList" Style="{StaticResource Primer.SettingsNavigation}" ItemContainerStyle="{StaticResource Primer.Workbench.SettingsSection}" AutomationProperties.Name="{l:Tr Settings.Sections}"
        SelectionChanged="OnSectionChanged" BorderThickness="0" Background="Transparent" Margin="8" HorizontalContentAlignment="Stretch">
        <ListBoxItem x:Name="AppearanceSection" ux:Ux.Icon="{DynamicResource Icon.Theme}" ToolTip="{l:Tr Settings.Appearance}" Content="{l:Tr Settings.AppearanceTitle}" Tag="Appearance" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
        <ListBoxItem x:Name="AiSection" ux:Ux.Icon="{DynamicResource Icon.WorkbenchAgent}" Content="{l:Tr Settings.SafetyTitle}" Tag="AI" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
        <ListBoxItem x:Name="ServiceSection" ux:Ux.Icon="{DynamicResource Icon.WorkbenchLogs}" Content="{l:Tr Settings.StorageTitle}" Tag="Service" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
        <ListBoxItem x:Name="AboutSection" ux:Ux.Icon="{DynamicResource Icon.Info}" Content="{l:Tr Settings.AboutTitle}" Tag="About" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
      </ListBox>
    </Border>
    <Border Grid.Column="1" MinHeight="48" Style="{StaticResource Primer.IdeBar}">
      <DockPanel>
        <Button x:Name="CloseSettingsButton" Content="✕" AutomationProperties.Name="{l:Tr Settings.Close}" ToolTip="{l:Tr Settings.Close}"
          Style="{StaticResource Primer.IdeToolButton}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        <StackPanel Margin="0,3,8,3" VerticalAlignment="Center">
          <TextBlock x:Name="SectionTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
          <TextBlock x:Name="SectionSubtitle" VerticalAlignment="Center" Style="{StaticResource Primer.SettingsSubtitle}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer x:Name="DetailScroll" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <Grid Margin="24"><StackPanel x:Name="SettingsColumn" Style="{StaticResource Primer.PageColumn}" MaxWidth="740" VerticalAlignment="Top">
        <StackPanel x:Name="AppearancePanel">
          <Border Style="{StaticResource Primer.Container}" Padding="20">
            <StackPanel>
              <TextBlock x:Name="GroupSettingsTheme" Text="{l:Tr Settings.ThemeHeading}" ToolTip="{l:Tr Settings.Theme}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,0,12"/>
              <UniformGrid Rows="1">
                <RadioButton x:Name="Light" AutomationProperties.Name="{l:Tr Settings.Light}" GroupName="Theme"
                  AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}" Style="{StaticResource Primer.Tile}" MinHeight="66" Margin="0,0,5,0"
                  Tag="{DynamicResource Primer.primaryBg}" IsChecked="{Binding IsLight,Source={x:Static themes:ThemeManager.Current}}">
                  <StackPanel>
                    <ContentControl Content="Light" ContentTemplate="{StaticResource Pages.ThemePreview}" Focusable="False">
                      <ContentControl.Resources><ResourceDictionary Source="/TiaOpenness;component/Themes/Palette.Light.xaml"/></ContentControl.Resources>
                    </ContentControl>
                    <TextBlock Text="{l:Tr Settings.LightTile}" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:Tr Settings.LightHint}" Style="{StaticResource Primer.Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Dark" AutomationProperties.Name="{l:Tr Settings.Dark}" GroupName="Theme"
                  AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}" Style="{StaticResource Primer.Tile}" MinHeight="66" Margin="5,0,0,0"
                  Tag="{DynamicResource Primer.primaryBg}" IsChecked="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}">
                  <StackPanel>
                    <ContentControl Content="Dark" ContentTemplate="{StaticResource Pages.ThemePreview}" Focusable="False">
                      <ContentControl.Resources><ResourceDictionary Source="/TiaOpenness;component/Themes/Palette.Dark.xaml"/></ContentControl.Resources>
                    </ContentControl>
                    <TextBlock Text="{l:Tr Settings.DarkTile}" FontWeight="SemiBold"/>
                    <TextBlock Text="{l:Tr Settings.DarkHint}" Style="{StaticResource Primer.Muted}" Margin="0,3,0,0"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
              <Border Height="1" Style="{StaticResource Primer.SettingsDivider}" Margin="0,16,0,8"/>
              <DockPanel Margin="0,6">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AccentCobalt" Content="{l:Tr Settings.AccentCobalt}" GroupName="Accent" IsChecked="{Binding IsCobalt,Source={x:Static themes:ThemeManager.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.AccentCobalt}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsAccent}"
                      Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="AccentPetrol" Content="{l:Tr Settings.AccentPetrol}" GroupName="Accent" IsChecked="{Binding IsPetrol,Source={x:Static themes:ThemeManager.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.AccentPetrol}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsAccent}"
                      Style="{StaticResource Primer.Segment}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="GroupSettingsAccent" Text="{l:Tr Settings.Accent}" FontWeight="SemiBold"/>
                  <TextBlock Text="{l:Tr Settings.AccentHint}" Style="{StaticResource Primer.Muted}"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20,16" Margin="0,16,0,0">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Chinese" Content="{l:Tr Settings.Chinese}" GroupName="Language" IsChecked="{Binding IsChinese,Source={x:Static l:Loc.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.Chinese}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"
                      Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="English" Content="{l:Tr Settings.English}" GroupName="Language" IsChecked="{Binding IsEnglish,Source={x:Static l:Loc.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.English}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"
                      Style="{StaticResource Primer.Segment}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="GroupSettingsLanguage" Text="{l:Tr Settings.LanguageHeading}" ToolTip="{l:Tr Settings.Language}" FontWeight="SemiBold"/>
                  <TextBlock Text="{l:Tr Settings.LanguageHint}" Style="{StaticResource Primer.Muted}"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ServicePanel" AutomationProperties.Name="{l:Tr Settings.StorageTitle}" Visibility="Collapsed">
          <Border Style="{StaticResource Primer.Container}" Padding="0">
            <StackPanel x:Name="StorageTools">
              <Border Style="{StaticResource Primer.StorageRow}" Padding="20,16">
                <StackPanel>
                  <Expander x:Name="RetentionDetails" Style="{StaticResource Primer.Expander}" AutomationProperties.Name="{l:Tr Audit.Coverage}"
                    ToolTip="{l:Tr Audit.Coverage}">
                    <Expander.Header>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Audit.Retention}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="RetentionUsageText" Text="{Binding JournalUsageLabel}" Style="{StaticResource Primer.Mono.textFaint}"
                          ToolTip="{l:Tr Settings.JournalScope}" VerticalAlignment="Center"/>
                      </Grid>
                    </Expander.Header>
                    <DockPanel Margin="0,6,0,0">
                      <Button DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Audit.OpenFolder}" Content="{l:Tr Audit.OpenFolder}"
                        Style="{StaticResource Primer.Button.Secondary.Small}" Margin="8,0,0,0" Click="OnRetentionFolder"/>
                      <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}"/>
                    </DockPanel>
                  </Expander>
                  <ProgressBar x:Name="RetentionUsageBar" Style="{StaticResource Primer.Progress}" Height="6" Margin="0,6,0,0"
                    AutomationProperties.Name="{l:Tr Settings.JournalScope}" Value="{Binding JournalPercent, Mode=OneWay}"
                    Visibility="{Binding HasJournalUsage, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Primer.StorageRow}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Size5" Tag="5" GroupName="AuditSize" Click="OnSize"
                        Content="{l:Tr Audit.Size5}" AutomationProperties.Name="{l:Tr Audit.Size5}" Style="{StaticResource Primer.Segment}"/>
                      <RadioButton x:Name="Size10" Tag="10" GroupName="AuditSize" Click="OnSize"
                        Content="{l:Tr Audit.Size10}" AutomationProperties.Name="{l:Tr Audit.Size10}" Style="{StaticResource Primer.Segment}"/>
                      <RadioButton x:Name="Size50" Tag="50" GroupName="AuditSize" Click="OnSize"
                        Content="{l:Tr Audit.Size50}" AutomationProperties.Name="{l:Tr Audit.Size50}" Style="{StaticResource Primer.Segment}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{l:Tr Audit.FileSize}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Primer.StorageRow}">
                <DockPanel>
                  <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Copies3" Tag="3" GroupName="AuditCopies" Click="OnCopies"
                        Content="{l:Tr Settings.Keep3}" AutomationProperties.Name="{l:Tr Settings.Keep3}" Style="{StaticResource Primer.Segment}"/>
                      <RadioButton x:Name="Copies5" Tag="5" GroupName="AuditCopies" Click="OnCopies"
                        Content="{l:Tr Settings.Keep5}" AutomationProperties.Name="{l:Tr Settings.Keep5}" Style="{StaticResource Primer.Segment}"/>
                      <RadioButton x:Name="Copies10" Tag="10" GroupName="AuditCopies" Click="OnCopies"
                        Content="{l:Tr Settings.Keep10}" AutomationProperties.Name="{l:Tr Settings.Keep10}" Style="{StaticResource Primer.Segment}"/>
                    </StackPanel>
                  </Border>
                  <TextBlock Text="{l:Tr Audit.Copies}" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <StackPanel Margin="20,14">
                <DockPanel>
                  <Button x:Name="SettingsGenerateButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                    AutomationProperties.Name="{l:Tr Settings.GenerateZip}" Content="{l:Tr Settings.GenerateZip}" Style="{StaticResource Primer.Button.Secondary.Small}"
                    Click="OnGenerateDiagnostics" IsEnabled="{Binding DiagnosticCanStart}"/>
                  <StackPanel>
                    <TextBlock Text="{l:Tr Env.Diagnostics}" FontWeight="Medium"/>
                    <TextBlock Text="{l:Tr Settings.DiagnosticZipHelp}" ToolTip="{l:Tr Env.DiagnosticHelp}"
                      Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </DockPanel>
                <StackPanel Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Primer.Mono}"/>
                    <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticStep}" Text="{Binding DiagnosticStep}" Style="{StaticResource Primer.Muted}"/>
                  </DockPanel>
                  <ProgressBar Style="{StaticResource Primer.Progress}" Height="4" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Visibility="{Binding DiagnosticDone, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Content="{l:Tr Feature.OpenFolder}" AutomationProperties.Name="{l:Tr Feature.OpenFolder}"
                    Style="{StaticResource Primer.Link}" Click="OnOpenDiagnosticsFolder" Margin="12,0,0,0"/>
                  <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticPath}" Text="{Binding DiagnosticPath}"
                    Style="{StaticResource Primer.Mono}" ToolTip="{l:Tr Env.Redacted}" TextWrapping="Wrap"/>
                </DockPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="0" Margin="0,16,0,0" AutomationProperties.Name="{l:Tr Settings.Folders}">
            <StackPanel>
              <Border Style="{StaticResource Primer.StorageRow}">
                <DockPanel>
                  <Button x:Name="OpenConfig" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:Tr Settings.StorageOpenFolder}"
                    AutomationProperties.Name="{l:Tr Settings.StorageOpenFolder}" AutomationProperties.HelpText="{Binding Text, ElementName=ConfigPath}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnOpenPath"/>
                  <Button x:Name="CopyConfig" DockPanel.Dock="Right" Content="{l:Tr Settings.CopyPath}" AutomationProperties.Name="{l:Tr Settings.CopyPath}"
                    Tag="{Binding Text, ElementName=ConfigPath}" AutomationProperties.HelpText="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue=''}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnCopyPath" Margin="0,0,6,0"/>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:Tr Settings.ConfigDirectory}" FontWeight="Medium"/>
                    <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Primer.StorageRow}">
                <DockPanel>
                  <Button x:Name="OpenLog" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:Tr Settings.StorageOpenFolder}"
                    AutomationProperties.Name="{l:Tr Pages.OpenRuntimeLog}" AutomationProperties.HelpText="{Binding Text, ElementName=LogPath}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnOpenPath"/>
                  <Button x:Name="CopyLog" DockPanel.Dock="Right" Content="{l:Tr Settings.CopyPath}" AutomationProperties.Name="{l:Tr Settings.CopyPath}"
                    Tag="{Binding Text, ElementName=LogPath}" AutomationProperties.HelpText="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue=''}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnCopyPath" Margin="0,0,6,0"/>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:Tr Settings.LogDirectory}" FontWeight="Medium"/>
                    <TextBlock x:Name="LogPath" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Primer.StorageRow}">
                <DockPanel>
                  <Button x:Name="OpenData" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:Tr Settings.StorageOpenFolder}"
                    AutomationProperties.Name="{l:Tr Settings.StorageOpenFolder}" AutomationProperties.HelpText="{Binding Text, ElementName=DataPath}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnOpenPath"/>
                  <Button x:Name="CopyData" DockPanel.Dock="Right" Content="{l:Tr Settings.CopyPath}" AutomationProperties.Name="{l:Tr Settings.CopyPath}"
                    Tag="{Binding Text, ElementName=DataPath}" AutomationProperties.HelpText="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue=''}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnCopyPath" Margin="0,0,6,0"/>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:Tr Settings.DataDirectory}" FontWeight="Medium"/>
                    <TextBlock x:Name="DataPath" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Primer.Plain}" Padding="20,12">
                <DockPanel>
                  <Button x:Name="OpenExports" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:Tr Settings.StorageOpenFolder}"
                    AutomationProperties.Name="{l:Tr Settings.StorageOpenFolder}" AutomationProperties.HelpText="{Binding Text, ElementName=ExportsPath}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnOpenPath"/>
                  <Button x:Name="CopyExports" DockPanel.Dock="Right" Content="{l:Tr Settings.CopyPath}" AutomationProperties.Name="{l:Tr Settings.CopyPath}"
                    Tag="{Binding Text, ElementName=ExportsPath}" AutomationProperties.HelpText="{Binding Tag, RelativeSource={RelativeSource Self}, TargetNullValue=''}"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnCopyPath" Margin="0,0,6,0"/>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{l:Tr Settings.ExportDirectory}" FontWeight="Medium"/>
                    <TextBlock x:Name="ExportsPath" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="AboutPanel" AutomationProperties.Name="{l:Tr Settings.About}" Visibility="Collapsed">
          <Border Style="{StaticResource Primer.Container}" Padding="20">
            <StackPanel>
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                  <Button x:Name="CheckUpdate" Content="{l:Tr Settings.CheckUpdate}" AutomationProperties.Name="{l:Tr Settings.CheckUpdate}"
                    Style="{StaticResource Primer.Button.Primary.Small}" Margin="0,0,8,0"/>
                  <Button x:Name="OpenReleases" Content="GitHub Releases ↗" AutomationProperties.Name="{l:Tr Settings.Releases}"
                    Style="{StaticResource Primer.Button.Secondary.Small}"/>
                </StackPanel>
                <Image x:Name="AboutIcon" Style="{StaticResource Primer.ProductIcon}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:Tr App.Title}" Style="{StaticResource Primer.ContainerTitle}" ToolTip="{Binding Text, ElementName=PackageText}"/>
                  <DockPanel Margin="0,2,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Text=" · " Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock x:Name="RuntimeText" Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Text=" · " Style="{StaticResource Primer.Mono.textFaint}"/>
                    <TextBlock Text="{l:Tr Settings.BundleCaption}" Style="{StaticResource Primer.Muted}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="UpdateInstalledItem" Style="{StaticResource Primer.Mono.textFaint}" TextTrimming="CharacterEllipsis"
                      AutomationProperties.Name="{l:Tr Settings.Engine}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                      AutomationProperties.HelpText="{Binding Text, ElementName=PackageText}"/>
                  </DockPanel>
                  <TextBlock x:Name="PackageText" Visibility="Collapsed"/>
                  <TextBlock x:Name="SourceCheckoutHint" Visibility="Collapsed" Style="{StaticResource Primer.Muted.textFaint}"
                    FontSize="{DynamicResource Ui.FontSize.Caption}" Text="{l:Tr Settings.SourceCheckoutHint}" ToolTip="{l:Tr Config.SourceRepositoryUpdate}"
                    AutomationProperties.HelpText="{l:Tr Config.SourceRepositoryUpdate}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
              </DockPanel>
              <DockPanel>
                <Button x:Name="RunUpdate" Content="{l:Tr Config.RunUpdate}" AutomationProperties.Name="{l:Tr Config.RunUpdate}"
                  DockPanel.Dock="Right" Style="{StaticResource Primer.Button.Primary.Small}" IsEnabled="False" Visibility="Collapsed" Margin="8,8,0,0"/>
                <TextBlock x:Name="UpdateStateItem" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="{l:Tr Settings.Update}"
                  Text="{l:Tr Config.NotChecked}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center"/>
                <Button x:Name="OpenProjectPage" HorizontalAlignment="Right" Content="github.com/asckye/automation-engineering-workbench"
                  AutomationProperties.Name="{l:Tr Settings.Homepage}" Style="{StaticResource Primer.Link}" FontFamily="{DynamicResource Ui.FontMono}"/>
              </DockPanel>
              <Border Style="{StaticResource Primer.SettingsDivider}" Height="1" Margin="0,8"/>
              <TextBlock Text="{l:Tr Settings.SupportedReleases}" Style="{StaticResource Primer.Muted}"/>
              <TextBlock x:Name="SupportedReleases" Style="{StaticResource Primer.Mono}" TextWrapping="Wrap" Margin="0,4,0,10"/>
              <TextBlock Text="{l:Tr Audit.AboutText}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
              <TextBlock Text="{l:Tr Audit.Limitation}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,10"/>
              <TextBlock Text="{l:Tr Settings.ServiceTrademark}" Style="{StaticResource Primer.Muted.textFaint}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="AiPanel" Visibility="Collapsed">
          <Border Style="{StaticResource Primer.Container}" Padding="20,6">
            <StackPanel>
              <DockPanel Margin="0,10,0,0">
                <Grid DockPanel.Dock="Right" Width="40" Height="28" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip="{l:Tr Settings.ApprovalRule}" PreviewKeyDown="OnPolicySwitchKeyDown">
                  <Border Style="{StaticResource Primer.PolicySwitchTrack}"/>
                  <RadioButton x:Name="ApprovalOff" GroupName="WriteApproval" Content="{l:Tr Settings.Off}" Style="{StaticResource Primer.PolicySwitchPosition}"
                    AutomationProperties.Name="{l:Tr Settings.Off}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}"
                    AutomationProperties.HelpText="{l:Tr Settings.ApprovalRuleHint}" Click="OnApprovalClick"/>
                  <RadioButton x:Name="ApprovalOn" GroupName="WriteApproval" Content="{l:Tr Settings.On}" Tag="On" Style="{StaticResource Primer.PolicySwitchPosition}"
                    AutomationProperties.Name="{l:Tr Settings.On}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}"
                    AutomationProperties.HelpText="{l:Tr Settings.ApprovalRuleHint}" Click="OnApprovalClick"/>
                </Grid>
                <ToggleButton x:Name="ShowPolicyDetails" DockPanel.Dock="Right" Style="{StaticResource Primer.Link}" Foreground="{DynamicResource Primer.textFaint}"
                  Content="{l:Tr Settings.PolicyDetails}" AutomationProperties.Name="{l:Tr Settings.PolicyDetails}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock ToolTip="{l:Tr Settings.Approval}" x:Name="GroupSettingsApproval" Text="{l:Tr Settings.ApprovalRule}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Visibility="{Binding IsChecked, ElementName=ShowPolicyDetails, Converter={StaticResource BoolToVisibility}}" Text="{l:Tr Settings.AlwaysConfirmed}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <TextBlock x:Name="ApprovalRuleHint" Text="{l:Tr Settings.ApprovalRuleHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
              <DockPanel Margin="0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Timeout60" Content="{l:Tr Settings.Timeout60}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout60}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="60" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="Timeout120" Content="{l:Tr Settings.Timeout120}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout120}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="120" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="Timeout300" Content="{l:Tr Settings.Timeout300}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout300}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="300" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="TimeoutCustom" Content="{l:Tr Settings.DurationCustom}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.DurationCustom}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="GroupSettingsTimeout" Text="{l:Tr Settings.Timeout}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{l:Tr Settings.ExpiryHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Visibility="{Binding IsChecked, ElementName=TimeoutCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Label x:Name="TimeoutLabel" AutomationProperties.Name="{l:Tr Settings.TimeoutSeconds}" Content="{l:Tr Settings.TimeoutSeconds}"
                  Target="{Binding ElementName=CustomTimeout}" Style="{StaticResource Primer.FormLabel}" Margin="0,0,12,0"/>
                <Button x:Name="ApplyTimeout" DockPanel.Dock="Right" Content="{l:Tr Settings.ApplySeconds}" AutomationProperties.Name="{l:Tr Settings.ApplySeconds}"
                  Style="{StaticResource Primer.Secondary}" Click="OnSaveTimeout" Margin="8,0,0,0"/>
                <TextBox x:Name="CustomTimeout" AutomationProperties.Name="{l:Tr Settings.TimeoutSeconds}" AutomationProperties.LabeledBy="{Binding ElementName=TimeoutLabel}"
                  AutomationProperties.HelpText="{Binding Text,ElementName=CustomTimeoutError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="CustomTimeoutError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>
              <Border Height="1" Style="{StaticResource Primer.SettingsDivider}"/>
              <DockPanel Margin="0,12">
              <ToggleButton DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Control.Enabled}" ToolTip="{l:Tr Control.Section}" x:Name="ControlEnabled"
                Style="{StaticResource Primer.Switch}" Click="OnControlEnabledClick" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{l:Tr Control.Enabled}" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Tr Control.Help}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,16,0,0"><StackPanel x:Name="SafetyEditors">
            <DockPanel Margin="0,0,0,8">
              <Button x:Name="SaveTargetChanges" Content="{l:Tr Settings.SaveTargets}" AutomationProperties.Name="{l:Tr Settings.SaveTargets}"
                  Style="{StaticResource Primer.Button.Primary.Small}" Click="OnSaveTargets" DockPanel.Dock="Right" IsEnabled="{Binding IsEnabled, ElementName=TargetEditor}"/>
              <Button x:Name="ReviewSafety" DockPanel.Dock="Right" Content="{l:Tr Settings.ReviewSafety}" AutomationProperties.Name="{l:Tr Settings.ReviewSafety}"
                IsEnabled="{Binding IsEnabled, ElementName=TargetEditor}" Click="OnSaveTargets" Style="{StaticResource Primer.SafetyReview}"/>
              <Button x:Name="ReloadSafety" Content="{l:Tr Settings.ReloadSafety}" AutomationProperties.Name="{l:Tr Settings.ReloadSafety}"
              Style="{StaticResource Primer.Link}" Click="OnReloadSafety" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Primer.textFaint}"/>
              <TextBlock x:Name="OnlineTargetsHeading" Text="{l:Tr Settings.OnlineTargets}" AutomationProperties.HeadingLevel="Level3"
                Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{l:Tr Settings.OnlineTargetsHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="SafetyStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Text}"
              TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button x:Name="ReplaceTargetFile" Content="{l:Tr Settings.ReplaceTargets}"
              AutomationProperties.Name="{l:Tr Settings.ReplaceTargets}" Style="{StaticResource Primer.OutlinedAccent}"
              Click="OnReplaceTargetFile" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <StackPanel x:Name="TargetEditor">
              <ListBox Style="{StaticResource Primer.List}" x:Name="OnlineTargets" AutomationProperties.LabeledBy="{Binding ElementName=OnlineTargetsHeading}" AutomationProperties.Name="{l:Tr Settings.OnlineTargets}"
                ItemContainerStyle="{StaticResource Primer.TableItem}" MaxHeight="180" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Primer.Chip}" Padding="8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding}" Style="{StaticResource Primer.Mono.text}"/>
                      <Button Content="×" AutomationProperties.Name="{l:Tr Settings.RemoveTarget}" ToolTip="{Binding}"
                        Style="{StaticResource Primer.Button.Ghost.Small}" Padding="4,0" Click="OnRemoveTarget"/>
                    </StackPanel>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Label x:Name="TargetAddressLabel" AutomationProperties.Name="{l:Tr Settings.TargetAddress}" Style="{StaticResource Primer.FormLabel}" Target="{Binding ElementName=OnlineTargetInput}" Content="{l:Tr Settings.TargetAddress}"/>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="AddTarget" Content="{l:Tr Settings.AddAndSave}" AutomationProperties.Name="{l:Tr Settings.AddAndSave}" DockPanel.Dock="Right"
                  Style="{StaticResource Primer.Button.Primary.Medium}" Click="OnAddTarget" Margin="8,0,0,0"/>
                <TextBox x:Name="OnlineTargetInput" AutomationProperties.LabeledBy="{Binding ElementName=TargetAddressLabel}" AutomationProperties.Name="{l:Tr Settings.TargetAddress}" AutomationProperties.HelpText="{Binding Text,ElementName=OnlineTargetInputError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="OnlineTargetInputError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>
            </StackPanel>

          </StackPanel></Border>
          <Border AutomationProperties.Name="{l:Tr Settings.DownloadSafety}" Style="{StaticResource Primer.Container}" Padding="20,8" Margin="0,16,0,0">
            <StackPanel>
              <DockPanel Margin="0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Plan5" Content="{l:Tr Settings.Plan5}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan5}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="300" Click="OnPlanPreset"/>
                    <RadioButton x:Name="Plan15" Content="{l:Tr Settings.Plan15}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan15}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="900" Click="OnPlanPreset"/>
                    <RadioButton x:Name="Plan30" Content="{l:Tr Settings.Plan30}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan30}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="1800" Click="OnPlanPreset"/>
                    <RadioButton x:Name="PlanCustom" Content="{l:Tr Settings.DurationCustom}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.DurationCustom}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock ToolTip="{l:Tr Settings.DownloadSafety}" x:Name="GroupPlanLifetime" Text="{l:Tr Settings.PlanDuration}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock ToolTip="{l:Tr Settings.DownloadSafetyHelp}" Text="{l:Tr Settings.PlanHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Visibility="{Binding IsChecked, ElementName=PlanCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Label x:Name="PlanLifetimeLabel" AutomationProperties.Name="{l:Tr Settings.PlanLifetime}" Content="{l:Tr Settings.PlanLifetime}"
                  Target="{Binding ElementName=OnlinePlanLifetime}" Style="{StaticResource Primer.FormLabel}" Margin="0,0,12,0"/>
                <Button x:Name="ApplyPlanLifetime" DockPanel.Dock="Right" Content="{l:Tr Settings.ApplySeconds}" AutomationProperties.Name="{l:Tr Settings.ApplySeconds}"
                  Style="{StaticResource Primer.Secondary}" ToolTip="{l:Tr Settings.SavePlanLifetime}" Click="OnSavePlanLifetime" Margin="8,0,0,0"/>
                <TextBox x:Name="OnlinePlanLifetime" AutomationProperties.Name="{l:Tr Settings.PlanLifetime}" AutomationProperties.LabeledBy="{Binding ElementName=PlanLifetimeLabel}"
                  AutomationProperties.HelpText="{Binding Text,ElementName=OnlinePlanLifetimeError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="OnlinePlanLifetimeError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>

            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel></Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
