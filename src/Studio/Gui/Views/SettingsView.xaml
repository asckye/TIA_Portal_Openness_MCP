<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" x:Class="TiaOpenness.Gui.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,6,22,12">
      <TextBlock Text="{l:Tr Control.Section}" Style="{StaticResource Primer.ContainerTitle}"/>
      <TextBlock Text="{l:Tr Control.Help}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/>
      <ToggleButton AutomationProperties.Name="{l:Tr Control.Enabled}" x:Name="ControlEnabled" Content="{l:Tr Control.Enabled}" Style="{StaticResource Primer.Switch}" Click="OnControlEnabledClick" Margin="0,8,0,12"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Approval}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="GroupSettingsApproval" Text="{l:Tr Settings.Approval}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton AutomationProperties.Name="{l:Tr Settings.On}" x:Name="ApprovalOn" Content="{l:Tr Settings.On}" Style="{StaticResource Primer.Segment}" Click="OnApprovalClick" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Off}" x:Name="ApprovalOff" Content="{l:Tr Settings.Off}" Style="{StaticResource Primer.Segment}" Click="OnApprovalClick" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="GroupSettingsTimeout" Text="{l:Tr Settings.Timeout}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Timeout60}" x:Name="Timeout60" Content="{l:Tr Settings.Timeout60}" Tag="60" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Timeout120}" x:Name="Timeout120" Content="{l:Tr Settings.Timeout120}" Tag="120" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Timeout300}" x:Name="Timeout300" Content="{l:Tr Settings.Timeout300}" Tag="300" Style="{StaticResource Primer.Segment}" Click="OnTimeoutClick" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Appearance}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="GroupSettingsLanguage" Text="{l:Tr Settings.Language}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton AutomationProperties.Name="{l:Tr Settings.English}" x:Name="English" Content="{l:Tr Settings.English}" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsEnglish,Source={x:Static l:Loc.Current}}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Chinese}" x:Name="Chinese" Content="{l:Tr Settings.Chinese}" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsChinese,Source={x:Static l:Loc.Current}}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="GroupSettingsTheme" Text="{l:Tr Settings.Theme}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <Border Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
            <StackPanel Orientation="Horizontal">
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Auto}" x:Name="Auto" Content="{l:Tr Settings.Auto}" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsAuto,Source={x:Static themes:ThemeManager.Current}}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Light}" x:Name="Light" Content="{l:Tr Settings.Light}" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsLight,Source={x:Static themes:ThemeManager.Current}}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}"/>
              <RadioButton AutomationProperties.Name="{l:Tr Settings.Dark}" x:Name="Dark" Content="{l:Tr Settings.Dark}" Style="{StaticResource Primer.Segment}" IsChecked="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Update}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
        <TextBlock x:Name="PackageText" Style="{StaticResource Primer.Muted.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextAlignment="Right"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Engine}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button AutomationProperties.Name="{l:Tr Settings.CheckUpdate}" x:Name="CheckUpdate" DockPanel.Dock="Right" Content="{l:Tr Settings.CheckUpdate}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <Grid VerticalAlignment="Center" Margin="0,0,8,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="UpdateInstalledItem" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              <TextBlock Grid.Column="1" Text=" · " FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              <TextBlock x:Name="UpdateStateItem" Grid.Column="2" Text="{l:Tr Config.NotChecked}" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Ui.FontSize.Caption}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            </Grid>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Releases}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenReleases" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock Text="github.com/…/releases" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP/releases"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Button AutomationProperties.Name="{l:Tr Config.RunUpdate}" x:Name="RunUpdate" Content="{l:Tr Config.RunUpdate}" Style="{StaticResource Primer.OutlinedAccent}" IsEnabled="False" HorizontalAlignment="Right" Visibility="Collapsed"/>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.Diagnostics}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.ConfigDirectory}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenConfig" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.LogDirectory}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenLog" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock x:Name="LogPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
          </DockPanel>
        </Grid>
      </Grid>
      <Border Height="4" Style="{StaticResource Primer.Plain}"/>
      <DockPanel Margin="0,8,0,8">
        <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
        <TextBlock Text="{l:Tr Settings.About}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
      </DockPanel>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Config.Version}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <TextBlock x:Name="VersionText" Style="{StaticResource Primer.Mono}"/>
        </Grid>
      </Grid>
      <Grid MinHeight="32" Margin="0,0,0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        <Grid Grid.Column="2">
          <DockPanel>
            <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenProjectPage" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
            <TextBlock Text="github.com/asckye/TIA_Portal_Openness_MCP" Style="{StaticResource Primer.Mono}" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP"/>
          </DockPanel>
        </Grid>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
