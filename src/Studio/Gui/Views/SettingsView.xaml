<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" x:Class="TiaOpenness.Gui.Views.SettingsView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.RowSpan="2" Style="{StaticResource Primer.Workbench.SettingsPane}">
      <ListBox x:Name="SectionList" Style="{StaticResource Primer.SettingsNavigation}" ItemContainerStyle="{StaticResource Primer.Workbench.SettingsSection}" AutomationProperties.Name="{l:Tr Settings.Sections}"
        SelectionChanged="OnSectionChanged" BorderThickness="0" Background="Transparent" Margin="8" HorizontalContentAlignment="Stretch">
        <ListBoxItem x:Name="AiSection" Content="{l:Tr Settings.SafetyTitle}" Tag="AI" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
        <ListBoxItem x:Name="AppearanceSection" ToolTip="{l:Tr Settings.Appearance}" Content="{l:Tr Settings.AppearanceTitle}" Tag="Appearance" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
        <ListBoxItem x:Name="ServiceSection" Content="{l:Tr Settings.StorageTitle}" Tag="Service" ContentTemplate="{StaticResource Pages.SettingsSectionLabel}" MinHeight="36"/>
      </ListBox>
    </Border>
    <Border Grid.Column="1" Style="{StaticResource Primer.IdeBar}">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="SectionTitle" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
        <TextBlock x:Name="SectionSubtitle" Style="{StaticResource Primer.Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="DetailScroll" Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <Grid Margin="24"><StackPanel MaxWidth="740" VerticalAlignment="Top">
        <StackPanel x:Name="AppearancePanel">
          <Border Style="{StaticResource Primer.Container}" Padding="20">
            <StackPanel>
              <TextBlock x:Name="GroupSettingsTheme" Text="{l:Tr Settings.Theme}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,0,12"/>
              <UniformGrid Rows="1">
                <RadioButton x:Name="Light" AutomationProperties.Name="{l:Tr Settings.Light}" GroupName="Theme"
                  AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}" Style="{StaticResource Primer.Tile}" Margin="0,0,5,0"
                  Tag="{DynamicResource Primer.primaryBg}" IsChecked="{Binding IsLight,Source={x:Static themes:ThemeManager.Current}}">
                  <StackPanel>
                    <ContentControl Content="" ContentTemplate="{StaticResource Pages.ThemePreview}">
                      <ContentControl.Resources><ResourceDictionary Source="/TiaOpenness;component/Themes/Palette.Light.xaml"/></ContentControl.Resources>
                    </ContentControl>
                    <TextBlock Text="{l:Tr Settings.Light}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="Dark" AutomationProperties.Name="{l:Tr Settings.Dark}" GroupName="Theme"
                  AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTheme}" Style="{StaticResource Primer.Tile}" Margin="5,0,0,0"
                  Tag="{DynamicResource Primer.primaryBg}" IsChecked="{Binding IsDark,Source={x:Static themes:ThemeManager.Current}}">
                  <StackPanel>
                    <ContentControl Content="" ContentTemplate="{StaticResource Pages.ThemePreview}">
                      <ContentControl.Resources><ResourceDictionary Source="/TiaOpenness;component/Themes/Palette.Dark.xaml"/></ContentControl.Resources>
                    </ContentControl>
                    <TextBlock Text="{l:Tr Settings.Dark}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <DockPanel Margin="0,6">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AccentCobalt" Content="{l:Tr Settings.AccentCobalt}" GroupName="Accent" IsChecked="{Binding IsCobalt,Source={x:Static themes:ThemeManager.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.AccentCobalt}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsAccent}"
                      Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="AccentPetrol" Content="{l:Tr Settings.AccentPetrol}" GroupName="Accent" IsChecked="{Binding IsPetrol,Source={x:Static themes:ThemeManager.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.AccentPetrol}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsAccent}"
                      Style="{StaticResource Primer.Segment}"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="GroupSettingsAccent" Text="{l:Tr Settings.Accent}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Margin="0,6">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Chinese" Content="{l:Tr Settings.Chinese}" GroupName="Language" IsChecked="{Binding IsChinese,Source={x:Static l:Loc.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.Chinese}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"
                      Style="{StaticResource Primer.Segment}"/>
                    <RadioButton x:Name="English" Content="{l:Tr Settings.English}" GroupName="Language" IsChecked="{Binding IsEnglish,Source={x:Static l:Loc.Current}}"
                      AutomationProperties.Name="{l:Tr Settings.English}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsLanguage}"
                      Style="{StaticResource Primer.Segment}"/>
                  </StackPanel>
                </Border>
                <TextBlock x:Name="GroupSettingsLanguage" Text="{l:Tr Settings.Language}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ServicePanel" Visibility="Collapsed">
          <Border Style="{StaticResource Primer.Container}" Padding="20"><StackPanel>
          <DockPanel Margin="0,8,0,8">
            <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
            <TextBlock Text="{l:Tr Settings.Update}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
            <TextBlock x:Name="PackageText" Style="{StaticResource Primer.Muted.textFaint}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextAlignment="Right"/>
          </DockPanel>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.Engine}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Settings.CheckUpdate}" x:Name="CheckUpdate" DockPanel.Dock="Right" Content="{l:Tr Settings.CheckUpdate}" Style="{StaticResource Primer.OutlinedAccent}"/>
                <Grid VerticalAlignment="Center" Margin="0,0,8,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="UpdateInstalledItem" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                  <TextBlock Grid.Column="1" Text=" · " FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                  <TextBlock x:Name="UpdateStateItem" Grid.Column="2" Text="{l:Tr Config.NotChecked}" Style="{StaticResource Primer.Text}" FontSize="{DynamicResource Ui.FontSize.Caption}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                </Grid>
              </DockPanel>
            </Grid>
          </Grid>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.Releases}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenReleases" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
                <TextBlock Text="github.com/…/releases" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP/releases"/>
              </DockPanel>
            </Grid>
          </Grid>
          <Button AutomationProperties.Name="{l:Tr Config.RunUpdate}" x:Name="RunUpdate" Content="{l:Tr Config.RunUpdate}" Style="{StaticResource Primer.OutlinedAccent}" IsEnabled="False" HorizontalAlignment="Right" Visibility="Collapsed"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,16,0,0"><StackPanel>
          <DockPanel Margin="0,8,0,8">
            <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
            <TextBlock Text="{l:Tr Settings.Folders}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
          </DockPanel>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.ConfigDirectory}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenConfig" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
                <TextBlock x:Name="ConfigPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
              </DockPanel>
            </Grid>
          </Grid>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.LogDirectory}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Pages.OpenRuntimeLog}" x:Name="OpenLog" DockPanel.Dock="Right" Content="{l:Tr Pages.OpenRuntimeLog}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
                <TextBlock x:Name="LogPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
              </DockPanel>
            </Grid>
          </Grid>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.DataDirectory}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenData" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Click="OnOpenPath" Style="{StaticResource Primer.OutlinedAccent}"/>
                <TextBlock x:Name="DataPath" Style="{StaticResource Primer.Mono}" FontWeight="Normal" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
              </DockPanel>
            </Grid>
          </Grid>
          </StackPanel></Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,16,0,0"><StackPanel x:Name="StorageTools">
            <DockPanel Margin="0,8,0,8">
              <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
              <TextBlock Text="{l:Tr Audit.Retention}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
            </DockPanel>
            <Grid MinHeight="32" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Audit.FileSize}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap" TextTrimming="None"/>
              <Border Grid.Column="2" Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton AutomationProperties.Name="{l:Tr Audit.Size5}" x:Name="Size5" Tag="5" Content="{l:Tr Audit.Size5}" Style="{StaticResource Primer.Segment}" GroupName="AuditSize" Click="OnSize"/>
                  <RadioButton AutomationProperties.Name="{l:Tr Audit.Size10}" x:Name="Size10" Tag="10" Content="{l:Tr Audit.Size10}" Style="{StaticResource Primer.Segment}" GroupName="AuditSize" Click="OnSize"/>
                  <RadioButton AutomationProperties.Name="{l:Tr Audit.Size50}" x:Name="Size50" Tag="50" Content="{l:Tr Audit.Size50}" Style="{StaticResource Primer.Segment}" GroupName="AuditSize" Click="OnSize"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Audit.Copies}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              <Border Grid.Column="2" Padding="3" HorizontalAlignment="Left" Style="{StaticResource Primer.SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton AutomationProperties.Name="3" x:Name="Copies3" Tag="3" Content="3" Style="{StaticResource Primer.Segment}" GroupName="AuditCopies" Click="OnCopies"/>
                  <RadioButton AutomationProperties.Name="5" x:Name="Copies5" Tag="5" Content="5" Style="{StaticResource Primer.Segment}" GroupName="AuditCopies" Click="OnCopies"/>
                  <RadioButton AutomationProperties.Name="10" x:Name="Copies10" Tag="10" Content="10" Style="{StaticResource Primer.Segment}" GroupName="AuditCopies" Click="OnCopies"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid MinHeight="32" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{l:Tr Audit.Coverage}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              <DockPanel Grid.Column="2">
                <Button DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Audit.OpenFolder}" Content="{l:Tr Audit.OpenFolder}" Style="{StaticResource Primer.OutlinedAccent}" Margin="8,0,0,0" Click="OnRetentionFolder"/>
                <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              </DockPanel>
            </Grid>
            <Border Height="4" Style="{StaticResource Primer.Plain}"/>
            <DockPanel Margin="0,8,0,8">
              <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
              <TextBlock Text="{l:Tr Env.Diagnostics}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
              <ContentControl HorizontalAlignment="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding DiagnosticTone}">
                <TextBlock Text="{Binding DiagnosticLabel}" Style="{StaticResource Primer.StatusText}"/>
              </ContentControl>
            </DockPanel>
            <TextBlock Text="{l:Tr Env.DiagnosticHelp}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="{Binding DiagnosticIdle, Converter={StaticResource BoolToVisibility}}"/>
            <Button x:Name="SettingsGenerateButton" AutomationProperties.Name="{l:Tr Env.Generate}" Content="{l:Tr Env.Generate}" Style="{StaticResource Primer.Secondary}" Click="OnGenerateDiagnostics" IsEnabled="{Binding DiagnosticCanStart}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <StackPanel Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Primer.Mono}"/>
                <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticStep}" Text="{Binding DiagnosticStep}" Style="{StaticResource Primer.Muted}"/>
              </DockPanel>
              <ProgressBar Style="{StaticResource Primer.Progress}" Height="4" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Visibility="{Binding DiagnosticDone, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
              <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding DiagnosticPath}" Text="{Binding DiagnosticPath}" Style="{StaticResource Primer.Mono}" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,6,0,0">
                <Button AutomationProperties.Name="{l:Tr Feature.OpenFolder}" Content="{l:Tr Feature.OpenFolder}" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0" Click="OnOpenDiagnosticsFolder"/>
                <TextBlock Text="{l:Tr Env.Redacted}" Style="{StaticResource Primer.Muted.ok}" VerticalAlignment="Center"/>
              </WrapPanel>
            </StackPanel>
          </StackPanel></Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20" Margin="0,16,0,0"><StackPanel>
          <TextBlock Text="{l:Tr Settings.About}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,16,0,8"/>
          <TextBlock Text="{l:Tr App.Title}" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Config.Version}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <TextBlock x:Name="VersionText" Style="{StaticResource Primer.Mono}"/>
            </Grid>
          </Grid>
          <Grid MinHeight="32" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="140"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:Tr Settings.Homepage}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
            <Grid Grid.Column="2">
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Common.Open}" x:Name="OpenProjectPage" DockPanel.Dock="Right" Content="{l:Tr Common.Open}" Style="{StaticResource Primer.OutlinedAccent}"/>
                <TextBlock Text="github.com/asckye/TIA_Portal_Openness_MCP" Style="{StaticResource Primer.Mono}" ToolTip="https://github.com/asckye/TIA_Portal_Openness_MCP"/>
              </DockPanel>
            </Grid>
          </Grid>
          </StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="AiPanel" Visibility="Collapsed">
          <Border Style="{StaticResource Primer.Container}" Padding="20,6">
            <StackPanel>
              <DockPanel Margin="0,10">
                <Grid DockPanel.Dock="Right" Width="40" Height="28" Margin="12,0,0,0" VerticalAlignment="Center"
                  ToolTip="{l:Tr Settings.ApprovalRule}" PreviewKeyDown="OnPolicySwitchKeyDown">
                  <Border Style="{StaticResource Primer.PolicySwitchTrack}"/>
                  <RadioButton x:Name="ApprovalOff" GroupName="WriteApproval" Content="{l:Tr Settings.Off}" Style="{StaticResource Primer.PolicySwitchPosition}"
                    AutomationProperties.Name="{l:Tr Settings.Off}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}" Click="OnApprovalClick"/>
                  <RadioButton x:Name="ApprovalOn" GroupName="WriteApproval" Content="{l:Tr Settings.On}" Tag="On" Style="{StaticResource Primer.PolicySwitchPosition}"
                    AutomationProperties.Name="{l:Tr Settings.On}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsApproval}" Click="OnApprovalClick"/>
                </Grid>
                <ToggleButton x:Name="ShowPolicyDetails" DockPanel.Dock="Right" Style="{StaticResource Primer.Link}" Foreground="{DynamicResource Primer.textFaint}"
                  Content="{l:Tr Settings.PolicyDetails}" AutomationProperties.Name="{l:Tr Settings.PolicyDetails}" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock ToolTip="{l:Tr Settings.Approval}" x:Name="GroupSettingsApproval" Text="{l:Tr Settings.ApprovalRule}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Visibility="{Binding IsChecked, ElementName=ShowPolicyDetails, Converter={StaticResource BoolToVisibility}}" Text="{l:Tr Settings.AlwaysConfirmed}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                  <TextBlock Text="{l:Tr Settings.ApprovalRuleHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Timeout60" Content="{l:Tr Settings.Timeout60}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout60}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="60" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="Timeout120" Content="{l:Tr Settings.Timeout120}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout120}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="120" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="Timeout300" Content="{l:Tr Settings.Timeout300}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Timeout300}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}" Tag="300" Click="OnTimeoutClick"/>
                    <RadioButton x:Name="TimeoutCustom" Content="{l:Tr Settings.DurationCustom}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.DurationCustom}" AutomationProperties.LabeledBy="{Binding ElementName=GroupSettingsTimeout}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="GroupSettingsTimeout" Text="{l:Tr Settings.Timeout}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{l:Tr Settings.ExpiryHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Visibility="{Binding IsChecked, ElementName=TimeoutCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Label x:Name="TimeoutLabel" AutomationProperties.Name="{l:Tr Settings.TimeoutSeconds}" Content="{l:Tr Settings.TimeoutSeconds}"
                  Target="{Binding ElementName=CustomTimeout}" Style="{StaticResource Primer.FormLabel}" Margin="0,0,12,0"/>
                <Button x:Name="ApplyTimeout" DockPanel.Dock="Right" Content="{l:Tr Settings.ApplySeconds}" AutomationProperties.Name="{l:Tr Settings.ApplySeconds}"
                  Style="{StaticResource Primer.Secondary}" Click="OnSaveTimeout" Margin="8,0,0,0"/>
                <TextBox x:Name="CustomTimeout" AutomationProperties.Name="{l:Tr Settings.TimeoutSeconds}" AutomationProperties.LabeledBy="{Binding ElementName=TimeoutLabel}"
                  AutomationProperties.HelpText="{Binding Text,ElementName=CustomTimeoutError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="CustomTimeoutError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>
              <DockPanel Margin="0,10">
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.SegmentGroup}" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Plan5" Content="{l:Tr Settings.Plan5}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan5}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="300" Click="OnPlanPreset"/>
                    <RadioButton x:Name="Plan15" Content="{l:Tr Settings.Plan15}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan15}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="900" Click="OnPlanPreset"/>
                    <RadioButton x:Name="Plan30" Content="{l:Tr Settings.Plan30}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.Plan30}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}" Tag="1800" Click="OnPlanPreset"/>
                    <RadioButton x:Name="PlanCustom" Content="{l:Tr Settings.DurationCustom}" Style="{StaticResource Primer.Segment}"
                      AutomationProperties.Name="{l:Tr Settings.DurationCustom}" AutomationProperties.LabeledBy="{Binding ElementName=GroupPlanLifetime}"/>
                  </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock ToolTip="{l:Tr Settings.DownloadSafety}" x:Name="GroupPlanLifetime" Text="{l:Tr Settings.PlanDuration}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock ToolTip="{l:Tr Settings.DownloadSafetyHelp}" Text="{l:Tr Settings.PlanHint}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Visibility="{Binding IsChecked, ElementName=PlanCustom, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                <Label x:Name="PlanLifetimeLabel" AutomationProperties.Name="{l:Tr Settings.PlanLifetime}" Content="{l:Tr Settings.PlanLifetime}"
                  Target="{Binding ElementName=OnlinePlanLifetime}" Style="{StaticResource Primer.FormLabel}" Margin="0,0,12,0"/>
                <Button x:Name="ApplyPlanLifetime" DockPanel.Dock="Right" Content="{l:Tr Settings.ApplySeconds}" AutomationProperties.Name="{l:Tr Settings.ApplySeconds}"
                  Style="{StaticResource Primer.Secondary}" ToolTip="{l:Tr Settings.SavePlanLifetime}" Click="OnSavePlanLifetime" Margin="8,0,0,0"/>
                <TextBox x:Name="OnlinePlanLifetime" AutomationProperties.Name="{l:Tr Settings.PlanLifetime}" AutomationProperties.LabeledBy="{Binding ElementName=PlanLifetimeLabel}"
                  AutomationProperties.HelpText="{Binding Text,ElementName=OnlinePlanLifetimeError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="OnlinePlanLifetimeError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>

            </StackPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20,14" Margin="0,16">
            <DockPanel>
              <ToggleButton DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Control.Enabled}" ToolTip="{l:Tr Control.Section}" x:Name="ControlEnabled"
                Style="{StaticResource Primer.Switch}" Click="OnControlEnabledClick" Margin="12,0,0,0"/>
              <StackPanel>
                <TextBlock Text="{l:Tr Control.Enabled}" FontWeight="SemiBold"/>
                <TextBlock Text="{l:Tr Control.Help}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="20"><StackPanel x:Name="SafetyEditors">
            <DockPanel Margin="0,0,0,8">
              <Border Style="{StaticResource Primer.Tag}" DockPanel.Dock="Right">
                <TextBlock Text="{Binding Items.Count, ElementName=OnlineTargets}" VerticalAlignment="Center"/>
              </Border>
              <Button x:Name="ReloadSafety" Content="{l:Tr Settings.ReloadSafety}" AutomationProperties.Name="{l:Tr Settings.ReloadSafety}"
              Style="{StaticResource Primer.Link}" Click="OnReloadSafety" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource Primer.textFaint}"/>
              <TextBlock x:Name="OnlineTargetsHeading" Text="{l:Tr Settings.OnlineTargets}" AutomationProperties.HeadingLevel="Level3"
                Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{l:Tr Settings.OnlineTargetsHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBlock x:Name="SafetyStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Text}"
              TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button x:Name="ReplaceTargetFile" Content="{l:Tr Settings.ReplaceTargets}"
              AutomationProperties.Name="{l:Tr Settings.ReplaceTargets}" Style="{StaticResource Primer.OutlinedAccent}"
              Click="OnReplaceTargetFile" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,8"/>
            <StackPanel x:Name="TargetEditor">
              <ListBox Style="{StaticResource Primer.List}" x:Name="OnlineTargets" AutomationProperties.LabeledBy="{Binding ElementName=OnlineTargetsHeading}" AutomationProperties.Name="{l:Tr Settings.OnlineTargets}"
                ItemContainerStyle="{StaticResource Primer.TableItem}" MaxHeight="180" Margin="0,0,0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate><DataTemplate>
                  <Border Style="{StaticResource Primer.Chip}" Padding="8,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding}" Style="{StaticResource Primer.Mono.text}"/>
                      <Button Content="×" AutomationProperties.Name="{l:Tr Settings.RemoveTarget}" ToolTip="{Binding}"
                        Style="{StaticResource Primer.Button.Ghost.Small}" Padding="4,0" Click="OnRemoveTarget"/>
                    </StackPanel>
                  </Border>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <Label x:Name="TargetAddressLabel" AutomationProperties.Name="{l:Tr Settings.TargetAddress}" Style="{StaticResource Primer.FormLabel}" Target="{Binding ElementName=OnlineTargetInput}" Content="{l:Tr Settings.TargetAddress}"/>
              <DockPanel Margin="0,0,0,8">
                <Button x:Name="AddTarget" Content="{l:Tr Settings.AddAndSave}" AutomationProperties.Name="{l:Tr Settings.AddAndSave}" DockPanel.Dock="Right"
                  Style="{StaticResource Primer.Button.Primary.Medium}" Click="OnAddTarget" Margin="8,0,0,0"/>
                <TextBox x:Name="OnlineTargetInput" AutomationProperties.LabeledBy="{Binding ElementName=TargetAddressLabel}" AutomationProperties.Name="{l:Tr Settings.TargetAddress}" AutomationProperties.HelpText="{Binding Text,ElementName=OnlineTargetInputError}" TextChanged="OnSafetyInputChanged"
                  Style="{StaticResource Primer.Input}"/>
              </DockPanel>
              <TextBlock x:Name="OnlineTargetInputError" AutomationProperties.LiveSetting="Polite" Visibility="Collapsed"
                Foreground="{DynamicResource Ant.colorError}" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,4,0,0">
                <Button x:Name="SaveTargetChanges" Content="{l:Tr Settings.SaveTargets}" AutomationProperties.Name="{l:Tr Settings.SaveTargets}"
                  Style="{StaticResource Primer.OutlinedAccent}" Click="OnSaveTargets" Margin="0,0,8,0"/>
              </WrapPanel>
            </StackPanel>

          </StackPanel></Border>
        </StackPanel>
      </StackPanel></Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
