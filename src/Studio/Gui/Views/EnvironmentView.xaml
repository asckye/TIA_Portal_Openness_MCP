<UserControl xmlns:vm="clr-namespace:TiaOpenness.Gui.ViewModels" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.EnvironmentView" Margin="-16,-12">
  <UserControl.Resources>

    <DataTemplate DataType="{x:Type vm:EnvironmentRow}">
      <Border Padding="16,12" Style="{StaticResource Primer.DoctorRowSurface}">

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Primer.DoctorFailureIcon}" Width="28" Height="28" VerticalAlignment="Top" Margin="0,0,12,0"
            Visibility="{Binding Warning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="×" Foreground="{DynamicResource Primer.onDanger}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="0,0,12,0">
            <WrapPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Border Style="{StaticResource Primer.Tag}"><TextBlock Text="{Binding Category}"/></Border>
            </WrapPanel>
            <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
            <Expander Header="{l:Tr Env.ManualSteps}" AutomationProperties.Name="{l:Tr Env.ManualSteps}" IsExpanded="False" Style="{StaticResource Primer.DoctorEvidence}">
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
            </Expander>
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Border Style="{StaticResource Primer.Tag}" Visibility="{Binding HasFix, Converter={StaticResource NotBoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" Foreground="{DynamicResource Primer.ok}" Margin="0,0,4,0" Visibility="{Binding Passed, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Primer.Muted}"/>
              </StackPanel>
            </Border>
            <Button Content="{Binding Fix}" AutomationProperties.Name="{Binding Fix}" Style="{StaticResource Primer.Button.Primary.Small}" CommandParameter="Mcp"
              Click="OnFix" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <ux:PageHeadPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Env.Doctor}" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ContentControl Style="{StaticResource Primer.StatusChip}" Tag="{Binding EnvironmentTone}" ToolTip="{l:Tr Env.AttentionGroup}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="{l:Tr Env.Generate}" AutomationProperties.Name="{l:Tr Env.Generate}" Style="{StaticResource Primer.IdeToolButton}" ContentTemplate="{StaticResource Primer.CommandText}"
            Click="OnGenerate" IsEnabled="{Binding DiagnosticCanStart}" Margin="0,0,8,0"/>
          <Button x:Name="RecheckButton" ToolTip="{l:Tr Pages.EnvironmentDescription}" AutomationProperties.HelpText="{l:Tr Pages.EnvironmentDescription}" Content="{l:Tr Env.Recheck}" AutomationProperties.Name="{l:Tr Env.Recheck}" Style="{StaticResource Primer.Button.Primary.Small}" ContentTemplate="{StaticResource Primer.CommandText}" IsDefault="True" Click="OnRecheck"/>
        </StackPanel>
      </ux:PageHeadPanel>
    </Border>
    <ScrollViewer x:Name="DoctorScroll" AutomationProperties.Name="{l:Tr Env.Checks}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="24">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
          <StackPanel Margin="0,0,0,16" Style="{StaticResource Primer.DoctorFailedGroup}">

            <TextBlock Text="{Binding FailedHeader}" Style="{StaticResource Primer.Muted}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Border Padding="0" Style="{StaticResource Primer.DoctorIssueGroup}">
              <ListBox x:Name="CheckList" AutomationProperties.Name="{Binding FailedHeader}" ItemsSource="{Binding FailedChecks}"
                SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.DoctorRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,0,0,16" Style="{StaticResource Primer.DoctorPendingGroup}">

            <TextBlock Text="{Binding PendingHeader}" Style="{StaticResource Primer.Muted}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Border Style="{StaticResource Primer.Container}" Padding="0">
              <ListBox x:Name="PendingList" AutomationProperties.Name="{Binding PendingHeader}" ItemsSource="{Binding PendingChecks}"
                SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.DoctorRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
          </StackPanel>
          <StackPanel Margin="0,0,0,16" Style="{StaticResource Primer.DoctorPassedGroup}">

            <TextBlock Text="{Binding PassedHeader}" Style="{StaticResource Primer.Muted}" FontWeight="SemiBold" Margin="2,0,0,8"/>
            <Border Style="{StaticResource Primer.Container}" Padding="0">
              <ListBox x:Name="PassedList" AutomationProperties.Name="{Binding PassedHeader}" ItemsSource="{Binding PassedChecks}"
                SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}" Style="{StaticResource Primer.List}" ItemContainerStyle="{StaticResource Primer.DoctorRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
          </StackPanel>
          <Expander Header="{l:Tr Env.FirstConnection}" AutomationProperties.Name="{l:Tr Env.FirstConnection}" Style="{StaticResource Primer.Expander}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{l:Tr Env.FirstConnectionHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,8"/>
              <Button x:Name="DiagnosticsLink" Content="{l:Tr Env.DiagnosticsLink}" AutomationProperties.Name="{l:Tr Env.DiagnosticsLink}"
                Style="{StaticResource Primer.Link}" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
