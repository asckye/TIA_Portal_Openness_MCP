<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.EnvironmentView">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.Container}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="RecheckButton" Content="{l:Tr Env.Recheck}" Style="{StaticResource Primer.Secondary}" Click="OnRecheck"/>
            <Button x:Name="GenerateButton" Content="{l:Tr Env.Generate}" Style="{StaticResource Primer.OutlinedAccent}" Margin="14,0,0,0" Click="OnGenerate" IsEnabled="{Binding DiagnosticCanStart}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{l:Tr Shell.Environment}" FontSize="18" FontWeight="SemiBold"/>
            <ContentControl Style="{StaticResource Primer.StatusChip}" Tag="{Binding EnvironmentTone}" HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Primer.StatusText}"/>
            </ContentControl>
          </StackPanel>
        </DockPanel>
      </Border>
      <ScrollViewer x:Name="GroupsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="GroupList" ItemsSource="{Binding EnvironmentGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Primer.TableContainer}" Margin="0,0,0,12">
                <StackPanel>
                  <Border Style="{StaticResource Primer.HeaderStrip}">
                    <DockPanel>
                      <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}">
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Primer.StatusText}"/>
                      </ContentControl>
                      <Border Width="3" Height="14" Margin="0,0,8,0" Style="{StaticResource Primer.SectionMark}"/>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.ContainerTitle}" FontSize="12.5"/>
                    </DockPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Primer.EnvironmentRow}">
                          <Expander Style="{StaticResource Primer.Expander}">
                            <Expander.Header>
                              <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="18"/>
                                  <ColumnDefinition Width="1.2*"/>
                                  <ColumnDefinition Width="1.6*"/>
                                  <ColumnDefinition Width="Auto"/>
                                  <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding Tone}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,12,0" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Result}" Style="{StaticResource Primer.ToneText}" Tag="{Binding ResultTone}" FontSize="11.5" ToolTip="{Binding Result}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="{Binding Fix}" Style="{StaticResource Primer.OutlinedAccent}" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" Click="OnFix"/>
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource Primer.ExpanderChevron.textFaint}"/>
                              </Grid>
                            </Expander.Header>
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="14"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Primer.Container}">
        <StackPanel>
          <DockPanel Margin="0,0,0,10">
            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding DiagnosticTone}">
              <TextBlock Text="{Binding DiagnosticLabel}" Style="{StaticResource Primer.StatusText}"/>
            </ContentControl>
            <TextBlock Text="{l:Tr Env.Diagnostics}" Style="{StaticResource Primer.ContainerTitle}"/>
          </DockPanel>
          <TextBlock Text="{l:Tr Env.DiagnosticHelp}" Style="{StaticResource Primer.Muted}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding DiagnosticIdle, Converter={StaticResource BoolToVisibility}}"/>
          <TextBlock Text="{Binding DiagnosticStep}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Visibility="{Binding DiagnosticIdle, Converter={StaticResource BoolToVisibility}}"/>
          <StackPanel Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Primer.Mono}"/>
              <TextBlock Text="{Binding DiagnosticStep}" Style="{StaticResource Primer.Muted}"/>
            </DockPanel>
            <ProgressBar Style="{StaticResource Primer.Progress}" Height="5" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,12,0,0"/>
          </StackPanel>
          <StackPanel Visibility="{Binding DiagnosticDone, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding DiagnosticPath}" Style="{StaticResource Primer.Mono}" TextWrapping="Wrap"/>
            <Button Content="{l:Tr Feature.OpenFolder}" Style="{StaticResource Primer.Secondary}" Margin="0,10,0,8" Click="OnOpenFolder"/>
            <TextBlock Text="{l:Tr Env.Redacted}" Style="{StaticResource Primer.Muted.ok}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Border Grid.Row="2" Style="{StaticResource Primer.Container}">
        <StackPanel>
          <TextBlock Text="{l:Tr Env.FirstConnection}" Style="{StaticResource Primer.ContainerTitle}"/>
          <TextBlock Text="{l:Tr Env.FirstConnectionHelp}" Style="{StaticResource Primer.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Row="4" Style="{StaticResource Primer.Container}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="{l:Tr Tab.Log}" Style="{StaticResource Primer.ContainerTitle}"/>
          <controls:LogTailView x:Name="LogTail" Grid.Row="1" Style="{StaticResource Primer.LogTail}" LogText="{Binding LogTail}"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
