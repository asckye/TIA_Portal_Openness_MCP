<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.EnvironmentView">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.PageHead}">
      <ux:PageHeadPanel>
        <StackPanel>
          <TextBlock Text="{l:Tr Pages.EnvironmentDescription}" Style="{StaticResource Primer.PageSubtitle}" TextWrapping="Wrap"/>
          <ContentControl Style="{StaticResource Primer.StatusChip}" Tag="{Binding EnvironmentTone}" HorizontalAlignment="Left" Margin="0,8,0,0">
            <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
        </StackPanel>
        <Button x:Name="RecheckButton" Content="{l:Tr Env.Recheck}" AutomationProperties.Name="{l:Tr Env.Recheck}" Style="{StaticResource Primer.Run}" IsDefault="True" Click="OnRecheck"/>
      </ux:PageHeadPanel>
    </Border>
    <Grid ux:ResponsiveLayout.Enabled="True" ux:ResponsiveLayout.ScrollWholePage="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Primer.TableContainer}">
        <ScrollViewer x:Name="GroupsScroll" Style="{StaticResource Primer.PageListScroll}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="GroupList">
            <TextBlock Text="{l:Tr Env.AttentionGroup}" Style="{StaticResource Primer.ContainerTitle}" Margin="12"/>
            <ListBox x:Name="AttentionList" AutomationProperties.Name="{l:Tr Env.AttentionGroup}" ItemsSource="{Binding AttentionChecks}" SelectedItem="{Binding SelectedEnvironment}" Style="{StaticResource Primer.List}" ItemTemplate="{StaticResource Pages.EnvironmentCheck}"/>
            <TextBlock Text="{l:Tr Env.Passed}" Style="{StaticResource Primer.ContainerTitle}" Margin="12"/>
            <ListBox x:Name="PassedList" AutomationProperties.Name="{l:Tr Env.Passed}" ItemsSource="{Binding PassedChecks}" SelectedItem="{Binding SelectedEnvironment}" Style="{StaticResource Primer.List}" ItemTemplate="{StaticResource Pages.EnvironmentCheck}"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <StackPanel Grid.Column="2">
        <Border x:Name="CheckDetail" Style="{StaticResource Primer.Container}" DataContext="{Binding SelectedEnvironment}">
          <StackPanel>
            <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.ContainerTitle}" TextWrapping="Wrap"/>
            <DockPanel Margin="0,12,0,12">
              <Path DockPanel.Dock="Left" Style="{StaticResource Primer.ToneIcon}" Tag="{Binding Tone}" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Result}" Style="{StaticResource Primer.Text}" TextWrapping="Wrap"/>
            </DockPanel>
            <Expander AutomationProperties.Name="{l:Tr Env.ManualButton}" Header="{l:Tr Env.ManualButton}" Style="{StaticResource Primer.Expander}" IsExpanded="True">
              <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap"/>
            </Expander>
            <Button x:Name="FixButton" AutomationProperties.Name="{Binding Fix}" Content="{Binding Fix}" Visibility="{Binding HasFix,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Secondary}" Click="OnFix" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Primer.Container}" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="{l:Tr Env.FirstConnection}" Style="{StaticResource Primer.ContainerTitle}"/>
            <TextBlock Text="{l:Tr Env.FirstConnectionHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button x:Name="DiagnosticsLink" Content="{l:Tr Env.DiagnosticsLink}" AutomationProperties.Name="{l:Tr Env.DiagnosticsLink}" Style="{StaticResource Primer.Link}" Click="OnLogs" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
