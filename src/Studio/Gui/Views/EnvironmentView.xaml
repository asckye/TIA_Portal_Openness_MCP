<UserControl xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" x:Class="TiaOpenness.Gui.Views.EnvironmentView" Margin="-16,-12">
  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <ux:PageHeadPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{l:Tr Env.Doctor}" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <ContentControl Style="{StaticResource Primer.StatusChip}" Tag="{Binding EnvironmentTone}" ToolTip="{l:Tr Env.AttentionGroup}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="{l:Tr Env.Generate}" AutomationProperties.Name="{l:Tr Env.Generate}" Style="{StaticResource Primer.IdeToolButton}" ContentTemplate="{StaticResource Primer.CommandText}"
            Click="OnGenerate" IsEnabled="{Binding DiagnosticCanStart}" Margin="0,0,8,0"/>
          <Button x:Name="RecheckButton" ToolTip="{l:Tr Pages.EnvironmentDescription}" AutomationProperties.HelpText="{l:Tr Pages.EnvironmentDescription}" Content="{l:Tr Env.Recheck}" AutomationProperties.Name="{l:Tr Env.Recheck}" Style="{StaticResource Primer.Button.Primary.Small}" ContentTemplate="{StaticResource Primer.CommandText}" IsDefault="True" Click="OnRecheck"/>
        </StackPanel>
      </ux:PageHeadPanel>
    </Border>
    <ScrollViewer x:Name="DoctorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=DoctorScroll}">
        <StackPanel MaxWidth="860" Margin="24">
          <Border Style="{StaticResource Primer.Container}" Padding="0" Margin="0,0,0,16" Visibility="{Binding HasEnvironmentStats, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl ItemsSource="{Binding EnvironmentStats}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource Primer.FeatureCell}" Padding="16,12">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Muted}"/>
                    <DockPanel Margin="0,4,0,0">
                      <Ellipse Style="{StaticResource Primer.StatusDot}" Tag="{Binding Tone}" Margin="0,0,6,0"/>
                      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
                    </DockPanel>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <Border Style="{StaticResource Primer.Container}" Padding="0">
            <ListBox x:Name="CheckList" AutomationProperties.Name="{l:Tr Env.Checks}" ItemsSource="{Binding EnvironmentRows}"
              SelectedItem="{Binding SelectedEnvironment, Mode=TwoWay}" Style="{StaticResource Primer.List}"
              ItemContainerStyle="{StaticResource Primer.TableItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate><DataTemplate>
                <!-- The native two-line row uses 49 epx including its disclosure target. -->
                <Grid Margin="8,10">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Border Style="{StaticResource Primer.DoctorIconTile}" Tag="{Binding Tone}" Padding="0" Width="32" Height="32" VerticalAlignment="Top" Margin="0,2,14,0">
                    <Path Style="{StaticResource Primer.ToneIcon}" Tag="{Binding Tone}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <WrapPanel>
                      <TextBlock Text="{Binding Name}" Style="{StaticResource Primer.Text}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <Border Style="{StaticResource Primer.Tag}"><TextBlock Text="{Binding Category}" VerticalAlignment="Center"/></Border>
                    </WrapPanel>
                    <Expander Header="{Binding Result}" AutomationProperties.Name="{Binding Name}" Style="{StaticResource Primer.Expander}"
                      IsExpanded="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}" Margin="0,3,0,0">
                      <TextBlock Text="{Binding Detail}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                    </Expander>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource Primer.DoctorStatusChip}" Tag="{Binding Tone}" VerticalAlignment="Center"
                    Visibility="{Binding HasFix, Converter={StaticResource NotBoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="✓" Margin="0,0,4,0" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}"
                        Visibility="{Binding Passed, Converter={StaticResource BoolToVisibility}}"/>
                      <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Style="{StaticResource Primer.ToneText}" Tag="{Binding Tone}"/>
                    </StackPanel>
                  </Border>
                  <Button Grid.Column="2" Content="{Binding Fix}" AutomationProperties.Name="{Binding Fix}" CommandParameter="Mcp"
                    Style="{StaticResource Primer.Button.Secondary.Small}" Click="OnFix" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Expander Header="{l:Tr Env.FirstConnection}" AutomationProperties.Name="{l:Tr Env.FirstConnection}" Style="{StaticResource Primer.Expander}" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="{l:Tr Env.FirstConnectionHelp}" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,8"/>
              <Button x:Name="DiagnosticsLink" Content="{l:Tr Env.DiagnosticsLink}" AutomationProperties.Name="{l:Tr Env.DiagnosticsLink}"
                Style="{StaticResource Primer.Link}" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log" HorizontalAlignment="Left"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</UserControl>
