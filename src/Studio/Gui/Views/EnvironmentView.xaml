<UserControl x:Class="TiaOpenness.Gui.Views.EnvironmentView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
      <Border Style="{StaticResource Glass.Card}" Padding="20,18"><DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RecheckButton" Content="{l:Tr Env.Recheck}" Style="{StaticResource Glass.Button}" Click="OnRecheck"/><Button x:Name="GenerateButton" Content="{l:Tr Env.Generate}" Style="{StaticResource Glass.Outline}" Margin="14,0,0,0" Click="OnGenerate" IsEnabled="{Binding DiagnosticCanStart}"/></StackPanel>
        <StackPanel><TextBlock Text="{l:Tr Shell.Environment}" FontSize="18" FontWeight="Bold"/><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><Ellipse Style="{StaticResource Feature.Dot}" Tag="{Binding EnvironmentTone}" Margin="0,0,8,0"/><TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource Feature.Text}" Tag="{Binding EnvironmentTone}" FontSize="11.5" FontWeight="SemiBold"/></StackPanel></StackPanel>
      </DockPanel></Border>
      <ScrollViewer x:Name="GroupsScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="GroupList" ItemsSource="{Binding EnvironmentGroups}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Glass.Card}" Padding="16,12" Margin="0,0,0,12"><StackPanel>
          <DockPanel Margin="4,0,4,10"><TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="10.5"/><Border Width="3" Height="14" Background="{DynamicResource Ui.Accent}" CornerRadius="1" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Style="{StaticResource Glass.Heading}" FontSize="12.5"/></DockPanel>
          <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border CornerRadius="12"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}"/></DataTrigger></Style.Triggers></Style></Border.Style>
              <Expander Style="{StaticResource Feature.Expander}">
                <Expander.Header><Grid Height="42" Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                  <Ellipse Style="{StaticResource Feature.Dot}" Tag="{Binding Tone}" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Glass.Text}" FontSize="12.5" FontWeight="SemiBold" Margin="6,0,12,0" ToolTip="{Binding Name}"/>
                  <TextBlock Grid.Column="2" Text="{Binding Result}" Style="{StaticResource Feature.Text}" Tag="{Binding ResultTone}" FontSize="11.5" ToolTip="{Binding Result}" Margin="0,0,8,0"/>
                  <Button Grid.Column="3" Content="{Binding Fix}" Style="{StaticResource Glass.Outline}" FontSize="10.5" Height="26" Padding="10,0" Visibility="{Binding HasFix, Converter={StaticResource BoolToVisibility}}" Click="OnFix"/>
                  <TextBlock Grid.Column="4" Foreground="{DynamicResource Ui.TertiaryLabel}" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="⌄"/><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="True"><Setter Property="Text" Value="⌃"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </Grid></Expander.Header>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/>
              </Expander>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
    </Grid>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition/></Grid.RowDefinitions>
      <Border Style="{StaticResource Glass.Card}" Padding="20,18"><StackPanel>
        <DockPanel Margin="0,0,0,10"><Border DockPanel.Dock="Right" Style="{StaticResource Feature.Tint}" Tag="{Binding DiagnosticTone}" Padding="8,3"><TextBlock Text="{Binding DiagnosticLabel}" Style="{StaticResource Feature.Text}" Tag="{Binding DiagnosticTone}" FontSize="10.5" FontWeight="Bold"/></Border><TextBlock Text="{l:Tr Env.Diagnostics}" Style="{StaticResource Glass.Heading}"/></DockPanel>
        <TextBlock Text="{l:Tr Env.DiagnosticHelp}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding DiagnosticIdle, Converter={StaticResource BoolToVisibility}}"/>
        <StackPanel Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}}"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Glass.Mono}"/><TextBlock Text="{Binding DiagnosticStep}" Style="{StaticResource Glass.Muted}"/></DockPanel><ProgressBar Style="{StaticResource Feature.Progress}" Height="5" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,12,0,0"/></StackPanel>
        <StackPanel Visibility="{Binding DiagnosticDone, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding DiagnosticPath}" Style="{StaticResource Glass.Mono}" TextWrapping="Wrap"/><Button Content="{l:Tr Feature.OpenFolder}" Style="{StaticResource Glass.Button}" Height="30" Margin="0,10,0,8" Click="OnOpenFolder"/><TextBlock Text="{l:Tr Env.Redacted}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.Green}"/></StackPanel>
      </StackPanel></Border>
      <Border Grid.Row="2" Style="{StaticResource Glass.Card}" Padding="20,18"><StackPanel><TextBlock Text="{l:Tr Env.FirstConnection}" Style="{StaticResource Glass.Heading}"/><TextBlock Text="{l:Tr Env.FirstConnectionHelp}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
      <Border Grid.Row="4" Style="{StaticResource Glass.Card}" Padding="20,18"><StackPanel><TextBlock Text="{l:Tr Tab.Log}" Style="{StaticResource Glass.Heading}" Margin="0,0,0,10"/><TextBlock Text="{Binding LogTail}" Style="{StaticResource Glass.Mono}" FontSize="10.5" LineHeight="24"/></StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
