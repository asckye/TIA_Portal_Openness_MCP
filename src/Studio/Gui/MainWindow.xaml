<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" x:Class="TiaOpenness.Gui.MainWindow" Title="{l:Tr App.Title}" Width="1200" Height="780" MinWidth="1024" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Ui.Window}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Open}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Engineering.Save}"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding Engineering.Compile}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Blocks"/>
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="VersionControl"/>
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls"/>
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
    <KeyBinding Key="D8" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Open}" Executed="OnOpenExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Engineering}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Configuration}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Navigate}" Executed="OnNavigateExecuted" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>
  <Grid x:Name="Root" Background="{DynamicResource Primer.bg}" ClipToBounds="True" TextElement.FontFamily="{DynamicResource Ui.Font}" TextElement.FontSize="{DynamicResource Ui.FontSize.Control}" TextElement.Foreground="{DynamicResource Primer.text}">
    <Border Style="{StaticResource Primer.Frame}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" MinHeight="44"/>
          <RowDefinition Height="Auto" MinHeight="40"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto" MinHeight="28"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Primer.HeaderBar}">
          <Grid x:Name="CaptionBar" Margin="20,0,10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border VerticalAlignment="Center" Style="{StaticResource Primer.BrandDot}"/>
              <TextBlock Text="{l:Tr Shell.Brand}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="{DynamicResource Ui.FontSize.SmallTitle}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button AutomationProperties.Name="{l:Tr Shell.Diagnostics}" x:Name="ExportDiagnostics" Content="{l:Tr Shell.Diagnostics}" Style="{StaticResource Primer.Secondary}" Click="OnDiagnostics" Margin="0,0,8,0"/>
              <Button AutomationProperties.Name="{l:Tr Shell.Settings}" x:Name="SettingsButton" Content="{l:Tr Shell.Settings}" Style="{StaticResource Primer.Secondary}" Click="OnSettings" Margin="0,0,8,0"/>
              <Button x:Name="MinimizeWindowButton" AutomationProperties.Name="{l:Tr Access.Minimize}" Style="{StaticResource Primer.WindowButton}" Click="OnMinimize">
                <Path Width="10" Height="10" Data="M0,5 L10,5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
              </Button>
              <Button x:Name="MaximizeWindowButton" AutomationProperties.Name="{l:Tr Access.Maximize}" Style="{StaticResource Primer.WindowButton}" Click="OnMaximize">
                <Path Width="10" Height="10" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
              </Button>
              <Button x:Name="CloseWindowButton" AutomationProperties.Name="{l:Tr Access.Close}" Style="{StaticResource Primer.WindowButton}" Click="OnClose">
                <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
              <TextBlock Text="/" Style="{StaticResource Primer.Text.textFaint}"/>
              <TextBlock x:Name="CurrentPageTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontSize="{DynamicResource Ui.FontSize.SmallTitle}" FontWeight="SemiBold" Margin="12,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource Primer.TabStrip}">
          <WrapPanel Margin="16,0">
            <RadioButton AutomationProperties.Name="{l:Tr Desktop.Configuration}" x:Name="RailMcp" Content="{l:Tr Desktop.Configuration}" GroupName="Pages" ToolTip="Ctrl+1" AutomationProperties.AcceleratorKey="Ctrl+1" Tag="Mcp" Style="{StaticResource Primer.Tab}" Click="OnRailClick"/>
            <RadioButton AutomationProperties.Name="{l:Tr Shell.Engineering}" x:Name="RailEngineering" Content="{l:Tr Shell.Engineering}" GroupName="Pages" ToolTip="Ctrl+2" AutomationProperties.AcceleratorKey="Ctrl+2" Tag="Engineering" Style="{StaticResource Primer.Tab}" Click="OnRailClick"/>
            <RadioButton x:Name="RailCalls" AutomationProperties.Name="{l:Tr Shell.Calls}" GroupName="Pages" ToolTip="Ctrl+5" AutomationProperties.AcceleratorKey="Ctrl+5" Tag="Calls" Style="{StaticResource Primer.Tab}" Click="OnRailClick">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:Tr Shell.Calls}"/>
                <Border x:Name="CallsCountBadge" Style="{StaticResource Primer.TabCountBadge}" Tag="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Margin="6,0,0,0">
                  <TextBlock Text="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Style="{StaticResource Primer.CountText}"/>
                </Border>
              </StackPanel>
            </RadioButton>
            <RadioButton AutomationProperties.Name="{l:Tr Shell.Audit}" x:Name="RailAudit" Content="{l:Tr Shell.Audit}" GroupName="Pages" ToolTip="Ctrl+6" AutomationProperties.AcceleratorKey="Ctrl+6" Tag="Audit" Style="{StaticResource Primer.Tab}" Click="OnRailClick"/>
            <RadioButton AutomationProperties.Name="{l:Tr Shell.Environment}" x:Name="RailEnvironment" Content="{l:Tr Shell.Environment}" GroupName="Pages" ToolTip="Ctrl+7" AutomationProperties.AcceleratorKey="Ctrl+7" Tag="Environment" Style="{StaticResource Primer.Tab}" Click="OnRailClick"/>
            <RadioButton AutomationProperties.Name="{l:Tr Tab.Log}" x:Name="RailLog" Content="{l:Tr Tab.Log}" GroupName="Pages" ToolTip="Ctrl+8" AutomationProperties.AcceleratorKey="Ctrl+8" Tag="Log" Style="{StaticResource Primer.Tab}" Click="OnRailClick"/>
          </WrapPanel>
        </Border>
        <Border x:Name="SubTabs" Grid.Row="2" Style="{StaticResource Primer.SubTabStrip}">
          <StackPanel Orientation="Horizontal" Margin="20,0">
            <RadioButton AutomationProperties.Name="{l:Tr Shell.Overview}" x:Name="RailOverview" Content="{l:Tr Shell.Overview}" ToolTip="Ctrl+2" AutomationProperties.AcceleratorKey="Ctrl+2" Tag="Engineering" GroupName="ProjectPages" Style="{StaticResource Primer.SubTab}" Click="OnRailClick"/>
            <RadioButton AutomationProperties.Name="{l:Tr Tree.ProgramBlocks}" x:Name="RailBlocks" Content="{l:Tr Tree.ProgramBlocks}" ToolTip="Ctrl+3" AutomationProperties.AcceleratorKey="Ctrl+3" Tag="Blocks" GroupName="ProjectPages" Style="{StaticResource Primer.SubTab}" Click="OnRailClick"/>
            <RadioButton AutomationProperties.Name="{l:Tr Shell.VersionControl}" x:Name="RailVersionControl" Content="{l:Tr Shell.VersionControl}" ToolTip="Ctrl+4" AutomationProperties.AcceleratorKey="Ctrl+4" Tag="VersionControl" GroupName="ProjectPages" Style="{StaticResource Primer.SubTab}" Click="OnRailClick"/>
          </StackPanel>
        </Border>
        <Grid Grid.Row="3" Margin="24,20">
          <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
          <views:AiCallsView x:Name="CallsContent" Visibility="Collapsed"/>
          <views:AuditLogView x:Name="AuditContent" Visibility="Collapsed"/>
          <views:EnvironmentView x:Name="EnvironmentContent" Visibility="Collapsed"/>
          <Grid x:Name="EngineeringPage" ux:ResponsiveLayout.Enabled="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <views:ProjectOperationsView x:Name="OperationsContent" Tag="{Binding Tag,ElementName=Root}"/>
            <views:BlocksView x:Name="BlocksContent" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
            <views:EngineeringSideView x:Name="EngineeringSideContent" Grid.Column="2" Tag="{Binding Tag,ElementName=Root}"/>
            <views:VersionControlView x:Name="VersionControlContent" Grid.ColumnSpan="3" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
            <views:LogView x:Name="LogContent" Grid.ColumnSpan="3" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource Primer.StatusBar}">
          <DockPanel LastChildFill="True" Margin="12,0">
            <WrapPanel x:Name="StatusActions" Orientation="Horizontal" DockPanel.Dock="Right">
              <StackPanel x:Name="ControlPrefillHint" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock Text="{l:Tr Control.Prefilled}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center"/>
                <Button AutomationProperties.Name="{l:Tr Control.Confirm}" Content="{l:Tr Control.Confirm}" Style="{StaticResource Primer.Quiet}" Click="OnConfirmControlPrefill"/>
                <Button AutomationProperties.Name="{l:Tr Control.Clear}" Content="{l:Tr Control.Clear}" Style="{StaticResource Primer.Quiet}" Click="OnClearControlPrefill"/>
              </StackPanel>
              <Button x:Name="PendingBadge" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Style="{StaticResource Primer.PendingBadge}" Click="OnApprovals" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
              <Border x:Name="ApprovalOffPill" AutomationProperties.Name="{l:Tr Shell.ApprovalOff}" Style="{StaticResource Primer.WarningBadge}" Visibility="Collapsed">
                <TextBlock x:Name="ApprovalOffText" AutomationProperties.LiveSetting="Polite" Text="{l:Tr Shell.ApprovalOff}" Style="{StaticResource Primer.Text.warn}"/>
              </Border>
              <TextBlock x:Name="RailVersion" Style="{StaticResource Primer.Mono}" Margin="8,0,0,0"/>
            </WrapPanel>
            <WrapPanel x:Name="StatusInformation" Orientation="Horizontal">
              <DockPanel VerticalAlignment="Center">
                <Ellipse x:Name="McpStatusDot" AutomationProperties.Name="{Binding Text,ElementName=McpStatusText}" Width="7" Height="7" Fill="{DynamicResource Primer.textMuted}" Margin="0,0,8,0"/>
                <TextBlock x:Name="McpStatusText" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
              </DockPanel>
              <Border Height="14" Margin="12,0" Style="{StaticResource Primer.VerticalDivider}"/>
              <TextBlock x:Name="SessionStatus" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource Primer.Mono}"/>
              <TextBlock x:Name="ControlStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400"/>
            </WrapPanel>
          </DockPanel>
        </Border>
      </Grid>
    </Border>
    <Border VerticalAlignment="Bottom" Margin="24,0,348,44" Visibility="{Binding Busy,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Container}">
      <StackPanel>
        <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Activity.Status}" Text="{Binding Activity.Status}" Style="{StaticResource Primer.Muted}"/>
        <ProgressBar Height="3" Margin="0,6,0,0" IsIndeterminate="{Binding Activity.ProgressIndeterminate}" Maximum="{Binding Activity.ProgressMax}" Value="{Binding Activity.ProgressValue,Mode=OneWay}"/>
      </StackPanel>
    </Border>
    <Grid x:Name="DrawerOverlay" AutomationProperties.Name="{Binding Text,ElementName=DrawerTitle}" Visibility="Collapsed">
      <Border MouseLeftButtonUp="OnDrawerBackdrop" Style="{StaticResource Primer.Overlay}"/>
      <Border x:Name="DrawerPanel" Width="400" Margin="0,96,16,44" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="58"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Padding="22,0" Style="{StaticResource Primer.Divider}">
            <DockPanel x:Name="DrawerHeading" DataContext="{x:Null}">
              <Button DockPanel.Dock="Right" Content="" AutomationProperties.Name="{l:Tr Access.CloseDrawer}" Style="{StaticResource Primer.CaptionButton}" Click="OnCloseDrawer"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DrawerTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontSize="{DynamicResource Ui.FontSize.Section}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="270"/>
                <Border Style="{StaticResource Primer.PendingCountBadge}" Tag="{Binding Approvals.PendingCount}" Margin="10,0,0,0">
                  <TextBlock x:Name="DrawerCount" Text="{Binding PendingCount}" Style="{StaticResource Primer.CountText}" Visibility="Collapsed"/>
                </Border>
                <ContentControl x:Name="DrawerCallResult" Style="{StaticResource Primer.StatusChip}" Tag="{Binding SelectedCall.Tone}" Margin="10,0,0,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding SelectedCall.Result}" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <views:SettingsView x:Name="SettingsContent" Grid.Row="1"/>
          <views:ApprovalsDrawer x:Name="ApprovalsContent" Grid.Row="1" Visibility="Collapsed"/>
          <views:CallDetailDrawer x:Name="CallDetailContent" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmOverlay" AutomationProperties.Name="{l:Tr Settings.ConfirmOffTitle}" Visibility="Collapsed">
      <Border Style="{StaticResource Primer.Overlay}"/>
      <Border Width="420" VerticalAlignment="Center" Style="{StaticResource Primer.Dialog}">
        <StackPanel>
          <TextBlock Text="{l:Tr Settings.ConfirmOffTitle}" FontSize="{DynamicResource Ui.FontSize.DialogTitle}" FontWeight="SemiBold"/>
          <TextBlock Text="{l:Tr Settings.ConfirmOffDescription}" FontSize="{DynamicResource Ui.FontSize.Control}" TextWrapping="Wrap" Margin="0,12,0,18" Style="{StaticResource Primer.Text.textMuted}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.Name="{l:Tr Shell.Cancel}" x:Name="CancelApprovalOff" IsDefault="True" IsCancel="True" Content="{l:Tr Shell.Cancel}" Style="{StaticResource Primer.Secondary}" Click="OnCancelApprovalOff" Margin="0,0,8,0"/>
            <Button AutomationProperties.Name="{l:Tr Settings.TurnOff}" x:Name="ConfirmApprovalOff" Content="{l:Tr Settings.TurnOff}" Style="{StaticResource Primer.WarningAction}" Click="OnConfirmApprovalOff"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="Toast" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,44" Visibility="Collapsed"  Style="{StaticResource Primer.Toast}">
      <DockPanel>
        <Button Content="" AutomationProperties.Name="{l:Tr Access.Dismiss}" DockPanel.Dock="Right" Style="{StaticResource Primer.CaptionButton}" Click="OnDismissToast"/>
        <Border Width="34" Height="34" Margin="0,0,12,0" Style="{StaticResource Primer.WarningIcon}">
          <TextBlock Text="!" FontSize="{DynamicResource Ui.FontSize.Section}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Primer.Text.warn}"/>
        </Border>
        <StackPanel>
          <Button x:Name="ToastAction" Content="{l:Tr Common.Open}" AutomationProperties.Name="{Binding Text,ElementName=ToastTitle}" Click="OnToastClick" Style="{StaticResource Primer.Quiet}"/>
          <TextBlock x:Name="ToastTitle" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
          <TextBlock x:Name="ToastMessage" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
