<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" x:Class="TiaOpenness.Gui.MainWindow" Title="{l:Tr App.Title}" Width="1200" Height="780" MinWidth="1024" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Ui.Window}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Open}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Engineering.Save}"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding Engineering.Compile}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Approvals"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="VersionControl"/>
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls"/>
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
    <KeyBinding Key="D8" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Settings"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Open}" Executed="OnOpenExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Engineering}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Configuration}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Navigate}" Executed="OnNavigateExecuted" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>
  <Grid x:Name="Root" ux:ResponsiveLayout.WindowWidth="{Binding ActualWidth,RelativeSource={RelativeSource Self}}" Background="{DynamicResource Primer.bg}" ClipToBounds="True" TextElement.FontFamily="{DynamicResource Ui.Font}" TextElement.FontSize="{DynamicResource Ui.FontSize.Control}" TextElement.Foreground="{DynamicResource Primer.text}">
    <Border Style="{StaticResource Primer.Frame}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="Sider" Width="232" Style="{StaticResource Primer.Workbench.Sider}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="64" Margin="16,0,12,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border VerticalAlignment="Center" Style="{StaticResource Primer.BrandDot}"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock x:Name="BrandTitle" Text="{l:Tr Shell.Brand}" FontWeight="SemiBold" TextWrapping="NoWrap" FontSize="{DynamicResource Ui.FontSize.Control}"/>
                <TextBlock x:Name="BrandVersion" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}">
                  <Run x:Name="RailVersion"/>
                </TextBlock>
              </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom">
              <RadioButton x:Name="SettingsButton" AutomationProperties.Name="{l:Tr Shell.Settings}" Content="{l:Tr Shell.Settings}" GroupName="Pages"
                AutomationProperties.AcceleratorKey="Ctrl+," Tag="Settings" ux:Ux.Icon="{DynamicResource Icon.Setting}"
                Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
              <StackPanel x:Name="StatusInformation" Margin="8,8,8,0">
                <Button x:Name="McpStatusButton" Style="{StaticResource Primer.Workbench.StatusButton}"
                  AutomationProperties.Name="{Binding Text,ElementName=McpStatusText}" ToolTip="{Binding Text,ElementName=McpStatusText}" Click="OnMcpStatus">
                  <DockPanel>
                    <Ellipse x:Name="McpStatusDot" AutomationProperties.Name="{Binding Text,ElementName=McpStatusText}" ToolTip="{Binding Text,ElementName=McpStatusText}" Style="{StaticResource Primer.StatusDot}" DockPanel.Dock="Left" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="McpStatusText" Style="{StaticResource Primer.Workbench.StatusText}" AutomationProperties.LiveSetting="Polite"
                      ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </DockPanel>
                </Button>
                <Button x:Name="SessionStatusButton" Style="{StaticResource Primer.Workbench.StatusButton}"
                  AutomationProperties.Name="{Binding Text,ElementName=SessionStatus}" ToolTip="{Binding Text,ElementName=SessionStatus}"
                  Click="OnProjectStatus">
                  <DockPanel>
                    <Ellipse x:Name="SessionStatusDot" AutomationProperties.Name="{Binding Text,ElementName=SessionStatus}" ToolTip="{Binding Text,ElementName=SessionStatus}" Style="{StaticResource Primer.StatusDot}" DockPanel.Dock="Left" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SessionStatus" Style="{StaticResource Primer.Workbench.StatusText}" AutomationProperties.LiveSetting="Polite"
                      ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                  </DockPanel>
                </Button>
                <Button x:Name="ApprovalStatusButton" Style="{StaticResource Primer.Workbench.StatusButton}"
                  AutomationProperties.Name="{Binding Text,ElementName=ApprovalStatusText}" ToolTip="{Binding Text,ElementName=ApprovalStatusText}"
                  Click="OnApprovalStatus">
                  <DockPanel>
                    <Ellipse x:Name="ApprovalStatusDot" AutomationProperties.Name="{Binding Text,ElementName=ApprovalStatusText}" ToolTip="{Binding Text,ElementName=ApprovalStatusText}" Style="{StaticResource Primer.StatusDot}" DockPanel.Dock="Left" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ApprovalStatusText" Style="{StaticResource Primer.Workbench.StatusText}"/>
                  </DockPanel>
                </Button>
              </StackPanel>
              <Button x:Name="SiderToggle" AutomationProperties.Name="{l:Tr Shell.CollapseMenu}" Content="{l:Tr Shell.CollapseMenu}" ux:Ux.Icon="{DynamicResource Icon.MenuFold}" Style="{StaticResource Primer.MenuButton}" Click="OnSiderToggle" Height="36" Margin="8,4,8,8"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel x:Name="SiderMenu">
                <Grid>
                  <RadioButton x:Name="RailApprovals" AutomationProperties.Name="{l:Tr Shell.Approvals}" Content="{l:Tr Shell.Approvals}" GroupName="Pages"
                    AutomationProperties.AcceleratorKey="Ctrl+1" Tag="Approvals" ux:Ux.Icon="{DynamicResource Icon.Bell}"
                    Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                  <Button x:Name="PendingBadge" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Style="{StaticResource Primer.Workbench.PendingBadge}"
                    Click="OnApprovals" Visibility="Collapsed"/>
                </Grid>
                <RadioButton x:Name="RailEngineering" AutomationProperties.Name="{l:Tr Shell.Engineering}" Content="{l:Tr Shell.Engineering}" GroupName="Pages"
                  AutomationProperties.AcceleratorKey="Ctrl+2" Tag="Engineering" ux:Ux.Icon="{DynamicResource Icon.Project}"
                  Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                <RadioButton x:Name="RailVersionControl" AutomationProperties.Name="{l:Tr Shell.VersionControl}" Content="{l:Tr Shell.VersionControl}"
                  GroupName="Pages" AutomationProperties.AcceleratorKey="Ctrl+3" Tag="VersionControl" ux:Ux.Icon="{DynamicResource Icon.Branch}"
                  Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                <TextBlock Text="{l:Tr Shell.GroupAi}" Style="{StaticResource Primer.Workbench.MenuGroup}"/>
                <RadioButton x:Name="RailCalls" AutomationProperties.Name="{l:Tr Shell.Calls}" GroupName="Pages" AutomationProperties.AcceleratorKey="Ctrl+4"
                  Tag="Calls" ux:Ux.Icon="{DynamicResource Icon.Robot}" Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick">
                  <DockPanel>
                    <Border x:Name="CallsCountBadge" DockPanel.Dock="Right" Style="{StaticResource Primer.TabCountBadge}" Tag="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Margin="6,0,0,0">
                      <TextBlock Text="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Style="{StaticResource Primer.CountText}"/>
                    </Border>
                    <TextBlock Text="{l:Tr Shell.Calls}"/>
                  </DockPanel>
                </RadioButton>
                <RadioButton x:Name="RailAudit" AutomationProperties.Name="{l:Tr Shell.Audit}" Content="{l:Tr Shell.Audit}" GroupName="Pages"
                  AutomationProperties.AcceleratorKey="Ctrl+5" Tag="Audit" ux:Ux.Icon="{DynamicResource Icon.Audit}"
                  Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                <TextBlock Text="{l:Tr Shell.GroupOperations}" Style="{StaticResource Primer.Workbench.MenuGroup}"/>
                <Grid>
                  <RadioButton x:Name="RailEnvironment" AutomationProperties.Name="{l:Tr Shell.Environment}" Content="{l:Tr Shell.Environment}"
                    GroupName="Pages" AutomationProperties.AcceleratorKey="Ctrl+6" Tag="Environment" ux:Ux.Icon="{DynamicResource Icon.Health}"
                    Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                  <Border x:Name="EnvironmentCountBadge" Style="{StaticResource Primer.Workbench.AttentionBadge}"
                    Tag="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}"
                    AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=RailEnvironment}"
                    ToolTip="{Binding Path=(AutomationProperties.Name),ElementName=RailEnvironment}">
                    <TextBlock Text="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}" Style="{StaticResource Primer.CountText}"/>
                  </Border>
                </Grid>
                <RadioButton x:Name="RailLog" AutomationProperties.Name="{l:Tr Shell.Logs}" Content="{l:Tr Shell.Logs}" GroupName="Pages"
                  AutomationProperties.AcceleratorKey="Ctrl+7" Tag="Log" ux:Ux.Icon="{DynamicResource Icon.FileText}"
                  Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
                <RadioButton x:Name="RailMcp" AutomationProperties.Name="{l:Tr Desktop.Configuration}" Content="{l:Tr Desktop.Configuration}" GroupName="Pages"
                  AutomationProperties.AcceleratorKey="Ctrl+8" Tag="Mcp" ux:Ux.Icon="{DynamicResource Icon.Api}"
                  Style="{StaticResource Primer.Workbench.NavItem}" Click="OnRailClick"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Primer.HeaderBar}">
            <DockPanel x:Name="CaptionBar" Height="64" Margin="24,0,8,0" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeWindowButton" AutomationProperties.Name="{l:Tr Access.Minimize}" Style="{StaticResource Primer.WindowButton}" Click="OnMinimize">
                  <Path Width="10" Height="10" Data="M0,5 L10,5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeWindowButton" AutomationProperties.Name="{l:Tr Access.Maximize}" Style="{StaticResource Primer.WindowButton}" Click="OnMaximize">
                  <Path Width="10" Height="10" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseWindowButton" AutomationProperties.Name="{l:Tr Access.Close}" Style="{StaticResource Primer.WindowButton}" Click="OnClose">
                  <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
              </StackPanel>
              <Button x:Name="ApprovalsButton" DockPanel.Dock="Right" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Style="{StaticResource Primer.PendingBadge}" Click="OnApprovals" Visibility="Collapsed" Margin="0,0,8,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
              <ContentControl x:Name="PageActions" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
              <TextBlock x:Name="CurrentPageTitle" Style="{StaticResource Primer.Workbench.PageTitle}" Focusable="True"
                FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1"/>
            </DockPanel>
          </Border>
          <Border x:Name="SafetyBanner" Grid.Row="1" Style="{StaticResource Primer.Workbench.SafetyBanner}" Visibility="Collapsed">
            <Grid>
              <Border Style="{StaticResource Primer.Plain}" x:Name="ApprovalOffPill" AutomationProperties.Name="{l:Tr Shell.ApprovalOff}"
                Visibility="Collapsed">
                <TextBlock x:Name="ApprovalOffText" AutomationProperties.LiveSetting="Polite" Text="{l:Tr Shell.ApprovalOff}"/>
              </Border>
              <StackPanel x:Name="ControlPrefillHint" Orientation="Horizontal" Visibility="Collapsed">
                <TextBlock x:Name="ControlPrefillText" Text="{l:Tr Control.Prefilled}" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
                <Button AutomationProperties.Name="{l:Tr Control.Confirm}" Content="{l:Tr Control.Confirm}" Style="{StaticResource Primer.Quiet}" Click="OnConfirmControlPrefill" Margin="12,0,0,0"/>
                <Button AutomationProperties.Name="{l:Tr Control.Clear}" Content="{l:Tr Control.Clear}" Style="{StaticResource Primer.Quiet}" Click="OnClearControlPrefill"/>
              </StackPanel>
              <TextBlock x:Name="ControlStatus" AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="24,20">
            <views:SettingsView x:Name="SettingsContent" Visibility="Collapsed"/>
            <views:ApprovalsDrawer x:Name="ApprovalsContent" Visibility="Collapsed"/>
            <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
            <views:AiCallsView x:Name="CallsContent" Visibility="Collapsed"/>
            <views:AuditLogView x:Name="AuditContent" Visibility="Collapsed"/>
            <views:EnvironmentView x:Name="EnvironmentContent" Visibility="Collapsed"/>
            <!-- 项目: page head and program blocks on the left, the result cards in a full-height column on the right. -->
            <Grid x:Name="EngineeringPage" ux:ResponsiveLayout.Enabled="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
              </Grid.ColumnDefinitions>
              <views:ProjectOperationsView x:Name="OperationsContent" Panel.ZIndex="1" Tag="{Binding Tag,ElementName=Root}"/>
              <views:BlocksView x:Name="BlocksContent" Grid.Row="1" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
              <views:EngineeringSideView x:Name="EngineeringSideContent" Grid.RowSpan="2" Grid.Column="2" Tag="{Binding Tag,ElementName=Root}"/>
            </Grid>
            <views:VersionControlView x:Name="VersionControlContent" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
            <views:LogView x:Name="LogContent" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Border VerticalAlignment="Bottom" Margin="240,0,348,24" Visibility="{Binding Busy,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Container}">
      <StackPanel>
        <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Activity.Status}" Text="{Binding Activity.Status}" Style="{StaticResource Primer.Muted}"/>
        <ProgressBar Height="3" Margin="0,6,0,0" IsIndeterminate="{Binding Activity.ProgressIndeterminate}" Maximum="{Binding Activity.ProgressMax}" Value="{Binding Activity.ProgressValue,Mode=OneWay}"/>
      </StackPanel>
    </Border>
    <Grid x:Name="DrawerOverlay" AutomationProperties.Name="{Binding Text,ElementName=DrawerTitle}" Visibility="Collapsed">
      <Border MouseLeftButtonUp="OnDrawerBackdrop" Style="{StaticResource Primer.Overlay}"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding Width,ElementName=DrawerPanel}" Margin="{Binding Margin,ElementName=DrawerPanel}" HorizontalAlignment="Right"/>
      <Border x:Name="DrawerPanel" Width="520" Margin="0,8,8,8" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Padding="24,0" Style="{StaticResource Primer.Divider}">
            <DockPanel x:Name="DrawerHeading" DataContext="{x:Null}">
              <Button DockPanel.Dock="Right" Content="" AutomationProperties.Name="{l:Tr Access.CloseDrawer}" Style="{StaticResource Primer.CaptionButton}" Click="OnCloseDrawer"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DrawerTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontSize="{DynamicResource Ui.FontSize.Section}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="300"/>
                <ContentControl x:Name="DrawerCallResult" Style="{StaticResource Primer.StatusChip}" Tag="{Binding SelectedCall.Tone}" Margin="10,0,0,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding SelectedCall.Result}" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <views:CallDetailDrawer x:Name="CallDetailContent" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmOverlay" AutomationProperties.Name="{l:Tr Settings.ConfirmOffTitle}" Visibility="Collapsed">
      <Border Style="{StaticResource Primer.Overlay}"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding ActualWidth,ElementName=ConfirmDialog}" Height="{Binding ActualHeight,ElementName=ConfirmDialog}" VerticalAlignment="Top" Margin="0,80,0,0"/>
      <Border x:Name="ConfirmDialog" Width="480" VerticalAlignment="Top" Margin="0,80,0,0" Style="{StaticResource Primer.Dialog}">
        <StackPanel>
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="22" Height="22" Margin="0,0,12,0"/>
            <TextBlock Text="{l:Tr Settings.ConfirmOffTitle}" FontSize="{DynamicResource Ui.FontSize.DialogTitle}" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBlock Text="{l:Tr Settings.ConfirmOffDescription}" FontSize="{DynamicResource Ui.FontSize.Control}" TextWrapping="Wrap" Margin="34,8,0,12" Style="{StaticResource Primer.Text.textMuted}"/>
          <TextBlock x:Name="ApprovalOffConfirmationLabel" Style="{StaticResource Primer.InputLabel}" TextWrapping="Wrap"/>
          <TextBox x:Name="ApprovalOffConfirmation" Style="{StaticResource Primer.Input}" Margin="0,0,0,16"
            AutomationProperties.Name="{Binding Text,ElementName=ApprovalOffConfirmationLabel}"
            AutomationProperties.LabeledBy="{Binding ElementName=ApprovalOffConfirmationLabel}"
            TextChanged="OnApprovalOffConfirmationChanged" PreviewKeyDown="OnConfirmApprovalKeyDown"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button AutomationProperties.Name="{l:Tr Shell.Cancel}" x:Name="CancelApprovalOff" HorizontalAlignment="Left" IsDefault="True" IsCancel="True" Content="{l:Tr Shell.Cancel}" Style="{StaticResource Primer.Secondary}" Click="OnCancelApprovalOff"/>
            <Button AutomationProperties.Name="{l:Tr Settings.TurnOff}" x:Name="ConfirmApprovalOff" Grid.Column="1" IsEnabled="False" PreviewKeyDown="OnConfirmApprovalKeyDown" Content="{l:Tr Settings.TurnOff}" Style="{StaticResource Primer.WarningAction}" Click="OnConfirmApprovalOff"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
    <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding ActualWidth,ElementName=Toast}" Height="{Binding ActualHeight,ElementName=Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{Binding Margin,ElementName=Toast}" Visibility="{Binding Visibility,ElementName=Toast}"/>
    <Border x:Name="Toast" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,16" Visibility="Collapsed"  Style="{StaticResource Primer.Toast}">
      <DockPanel>
        <Button Content="" AutomationProperties.Name="{l:Tr Access.Dismiss}" DockPanel.Dock="Right" Style="{StaticResource Primer.CaptionButton}" Click="OnDismissToast"/>
        <Border Width="34" Height="34" Margin="0,0,12,0" Style="{StaticResource Primer.WarningIcon}">
          <Path Style="{StaticResource Primer.AlertIcon.Warning}" Width="20" Height="20" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="ToastTitle" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
          <TextBlock x:Name="ToastMessage" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,4" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
          <Button x:Name="ToastAction" Content="{l:Tr Common.Open}" AutomationProperties.Name="{Binding Text,ElementName=ToastTitle}" Click="OnToastClick" Style="{StaticResource Primer.Link}" HorizontalAlignment="Left" Padding="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
