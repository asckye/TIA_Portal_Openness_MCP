<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:l="clr-namespace:TiaOpenness.Gui.Localization"
  xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes"
  xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  xmlns:views="clr-namespace:TiaOpenness.Gui.Views"
  xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls"
  x:Class="TiaOpenness.Gui.MainWindow" Title="{l:Tr App.Title}"
  Width="1360" Height="812" MinWidth="1024" MinHeight="640" WindowStartupLocation="CenterScreen"
  WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Ui.Window}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Open}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Engineering.Save}"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding Engineering.Compile}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Agent"/>
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Clients"/>
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
    <KeyBinding Key="J" Modifiers="Control+Shift" Command="{x:Static ux:WorkbenchCommands.ToastAction}"/>
    <KeyBinding Key="K" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.CommandPalette}"/>
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Settings"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.ExportDiagnostics}" Executed="OnDiagnostics"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.ToastAction}" Executed="OnToastClick" CanExecute="OnCanInvokeToastAction"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.CommandPalette}" Executed="OnCommandPalette" CanExecute="OnCanOpenPalette"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Open}" Executed="OnOpenExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Engineering}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Configuration}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Navigate}" Executed="OnNavigateExecuted" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>
  <Grid>
  <Grid x:Name="Root" ux:ResponsiveLayout.WindowWidth="{Binding ActualWidth,RelativeSource={RelativeSource Self}}" Background="{DynamicResource Primer.bg}" ClipToBounds="True" TextElement.FontFamily="{DynamicResource Ui.Font}" TextElement.FontSize="{DynamicResource Ui.FontSize.Control}" TextElement.Foreground="{DynamicResource Primer.text}">
    <Border x:Name="ShellFrame" Style="{StaticResource Primer.Frame}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Style="{StaticResource Primer.HeaderBar}">
          <Grid x:Name="CaptionBar">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="460"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Primer.divider}" IsHitTestVisible="False"/>
            <DockPanel Margin="12,0,8,0" MaxWidth="440">
              <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                <Image x:Name="BrandIcon" Style="{StaticResource Primer.Workbench.Brand}"/>
                <Border x:Name="BrandOutline" Style="{StaticResource Primer.Workbench.BrandOutline}"/>
              </Grid>
              <TextBlock FontSize="{DynamicResource Ui.FontSize.12}" x:Name="BrandTitle" Text="{l:Tr Shell.Brand}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <TextBlock Text="/" Foreground="{DynamicResource Primer.textFaint}" Margin="8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="CurrentPageTitle" Style="{StaticResource Primer.Workbench.PageTitle}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Focusable="True"
                FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1"/>
            </DockPanel>
            <Button x:Name="CommandPaletteButton" Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True"
              AutomationProperties.Name="{l:Tr Shell.CommandPalette}" AutomationProperties.AcceleratorKey="Ctrl+K"
              Style="{StaticResource Primer.Workbench.Search}" Command="{x:Static ux:WorkbenchCommands.CommandPalette}"
              HorizontalAlignment="Center" VerticalAlignment="Center">
              <DockPanel>
                <Path DockPanel.Dock="Left" Width="12" Height="12" Data="{StaticResource Icon.Search}" Style="{StaticResource Primer.Icon}" Margin="0,0,8,0"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource Primer.Workbench.KeyCap}">
                  <TextBlock Text="Ctrl K" Style="{StaticResource Primer.Mono}" FontSize="{DynamicResource Ui.FontSize.10}"/>
                </Border>
                <TextBlock Text="{l:Tr Shell.CommandPalette}"/>
              </DockPanel>
            </Button>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,12,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
              <Button x:Name="LeftPaneToggle" AutomationProperties.Name="{l:Tr Shell.LeftPane}" Content="{l:Tr Shell.LeftPane}"
                ux:Ux.Icon="{DynamicResource Icon.WorkbenchPane}" Style="{StaticResource Primer.Workbench.PaneToggle}" Click="OnLeftPaneToggle"/>
                <Button x:Name="QuickThemeButton" AutomationProperties.Name="{l:Tr Shell.ToggleTheme}" Content="{l:Tr Shell.ToggleTheme}" Style="{StaticResource Primer.Workbench.ThemeButton}" Click="OnToggleTheme" Margin="0,0,4,0"/>
                <Rectangle Width="1" Height="20" Fill="{DynamicResource Primer.divider}" Margin="0,0,6,0"/>
                <Button x:Name="MinimizeWindowButton" AutomationProperties.Name="{l:Tr Access.Minimize}" Style="{StaticResource Primer.WindowButton}" Click="OnMinimize">
                  <Path Width="8" Height="10" Data="M0,5 L8,5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeWindowButton" AutomationProperties.Name="{l:Tr Access.Maximize}" Style="{StaticResource Primer.Workbench.MaximizeButton}" Click="OnMaximize">
                  <Path x:Name="MaximizeGlyph" Width="10" Height="10" Data="{StaticResource Icon.Maximize}" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseWindowButton" AutomationProperties.Name="{l:Tr Access.Close}" Style="{StaticResource Primer.WindowButton}" Click="OnClose">
                  <Path Width="10" Height="10" Data="M1.5,1.5 L8.5,8.5 M8.5,1.5 L1.5,8.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
          <Control x:Name="BusyHairline" Style="{StaticResource Primer.Workbench.Hairline}"
            Visibility="{Binding Visibility,ElementName=BusyCard}" AutomationProperties.Name="{Binding Activity.ProgressLabel}"/>
        </StackPanel>
        <Border x:Name="Sider" Grid.Row="2" Width="60" Style="{StaticResource Primer.Workbench.Sider}">
          <Grid x:Name="SiderMenu" Margin="0,10" KeyboardNavigation.TabNavigation="Once" PreviewKeyDown="OnRailKeyDown">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <RadioButton x:Name="RailEngineering" Grid.Row="0" GroupName="Pages" Tag="Engineering"
              AutomationProperties.AcceleratorKey="Ctrl+1" AutomationProperties.Name="{l:Tr Rail.Project}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="1" Content="{l:Tr Rail.Project}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchProject}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
            <Grid Grid.Row="1">
              <RadioButton x:Name="RailAgent" GroupName="Pages" Tag="Agent"
                AutomationProperties.AcceleratorKey="Ctrl+2" AutomationProperties.Name="{l:Tr Rail.Agent}"
                AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="2" Content="{l:Tr Rail.Agent}"
                ux:Ux.Icon="{DynamicResource Icon.WorkbenchAgent}" Style="{StaticResource Primer.Workbench.NavItem}"
                Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Agent"/>
              <Button x:Name="PendingBadge" Focusable="False" Visibility="Collapsed"
                  AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{l:Tr Shell.PendingTitle}"
                  Style="{StaticResource Primer.Workbench.PendingBadge}" Click="OnApprovals"/>
            </Grid>
            <Rectangle Grid.Row="2" Width="24" Height="1" Margin="0,4,0,0" VerticalAlignment="Top" Fill="{DynamicResource Primer.inputBorder}"/>
            <RadioButton Margin="6,13,6,4" x:Name="RailMcp" Grid.Row="2" GroupName="Pages" Tag="Mcp" AutomationProperties.HelpText="{l:Tr Desktop.Configuration}"
              AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Path=(AutomationProperties.HelpText),RelativeSource={RelativeSource Self}}"
              AutomationProperties.AcceleratorKey="Ctrl+3" AutomationProperties.Name="{x:Static l:Strings.McpRailLabel}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="3" Content="{x:Static l:Strings.McpRailLabel}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchMcp}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
            <RadioButton x:Name="RailClients" Grid.Row="3" GroupName="Pages" Tag="Clients"
              AutomationProperties.AcceleratorKey="Ctrl+4" AutomationProperties.Name="{l:Tr Rail.Clients}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="4" Content="{l:Tr Rail.Clients}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchClients}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Clients"/>
            <Rectangle Grid.Row="4" Width="24" Height="1" Margin="0,4,0,0" VerticalAlignment="Top" Fill="{DynamicResource Primer.inputBorder}"/>
            <RadioButton Margin="6,13,6,4" x:Name="RailEnvironment" Grid.Row="4" GroupName="Pages" Tag="Environment"
              AutomationProperties.AcceleratorKey="Ctrl+5" AutomationProperties.Name="{l:Tr Rail.Doctor}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="5" Content="{l:Tr Rail.Doctor}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchDoctor}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
            <RadioButton x:Name="RailAudit" Grid.Row="5" GroupName="Pages" Tag="Audit"
              AutomationProperties.AcceleratorKey="Ctrl+6" AutomationProperties.Name="{l:Tr Rail.Audit}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="6" Content="{l:Tr Rail.Audit}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchAudit}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
            <RadioButton x:Name="RailLog" Grid.Row="6" GroupName="Pages" Tag="Log"
              AutomationProperties.AcceleratorKey="Ctrl+7" AutomationProperties.Name="{l:Tr Rail.Logs}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="7" Content="{l:Tr Rail.Logs}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchLogs}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
            <Rectangle Grid.Row="8" Height="1" VerticalAlignment="Top" Fill="{DynamicResource Primer.divider}"/>
            <RadioButton x:Name="SettingsButton" Grid.Row="8" Margin="6,8,6,0" GroupName="Pages" Tag="Settings"
              AutomationProperties.AcceleratorKey="Ctrl+," AutomationProperties.Name="{l:Tr Rail.Settings}"
              AutomationProperties.SizeOfSet="8" AutomationProperties.PositionInSet="8" Content="{l:Tr Rail.Settings}"
              ux:Ux.Icon="{DynamicResource Icon.WorkbenchSettings}" Style="{StaticResource Primer.Workbench.NavItem}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Settings"/>
            <Border x:Name="EnvironmentCountBadge" Grid.Row="4" Margin="0,17,10,0" Style="{StaticResource Primer.Workbench.AttentionBadge}"
              Tag="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}"
              AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=RailEnvironment}"
              ToolTip="{Binding Path=(AutomationProperties.Name),ElementName=RailEnvironment}">
              <TextBlock Text="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}" Foreground="{DynamicResource Primer.onDanger}" FontSize="{DynamicResource Ui.FontSize.9_5}" Style="{StaticResource Primer.CountText}"/>
            </Border>
          </Grid>
        </Border>
        <Grid Grid.Row="2" Grid.Column="1">
          <Grid Margin="16,12">
            <views:ApprovalsDrawer x:Name="ApprovalsContent" Margin="-16,-12" Visibility="Collapsed"/>
            <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
            <ContentControl x:Name="ClientsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
            <Grid x:Name="CallsPage" Margin="-16,-12,0,-12" Visibility="Collapsed">
              <Grid Grid.IsSharedSizeScope="True" Margin="0,0,-16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto" SharedSizeGroup="AgentToolbar"/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" SharedSizeGroup="AgentInspector"/></Grid.ColumnDefinitions>
                <views:AiCallsView x:Name="CallsContent" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"/>
                <Grid x:Name="DockedInspector" Grid.Row="1" Grid.Column="1" Width="348" AutomationProperties.Name="{l:Tr Calls.Detail}" Visibility="Collapsed"/>
              </Grid>
            </Grid>
            <views:AuditLogView x:Name="AuditContent" Visibility="Collapsed"/>
            <views:EnvironmentView x:Name="EnvironmentContent" Visibility="Collapsed"/>
            <Grid x:Name="EngineeringPage" Margin="-16,-12" Initialized="OnProjectPageInitialized">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <ContentControl x:Name="ProjectTree" Focusable="True" KeyboardNavigation.IsTabStop="False" AutomationProperties.Name="{l:Tr Rail.Project}"
                AutomationProperties.HelpText="{Binding Text,ElementName=SessionStatus}" Style="{StaticResource Primer.Workbench.ProjectTree}">
                <views:ProjectTreeView x:Name="ProjectExplorer" Tag="{Binding Tag,ElementName=Root}"/>
              </ContentControl>
              <Grid x:Name="ProjectOverview" Grid.Column="1">
                <ScrollViewer x:Name="ProjectScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <views:ProjectOperationsView x:Name="OperationsContent" Panel.ZIndex="1" Tag="{Binding Tag,ElementName=Root}"/>
                    <Grid x:Name="DocumentHost" Grid.Row="1">
                      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Grid x:Name="BlockDocument">
                        <views:BlocksView x:Name="BlocksContent" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
                      </Grid>
                      <Grid x:Name="CompileDocument" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Primer.PageColumn}" Margin="0"
                        Visibility="Collapsed">
                        <views:EngineeringSideView x:Name="EngineeringSideContent" Tag="{Binding Tag,ElementName=Root}"/>
                      </Grid>
                      <ContentControl x:Name="PlcTagsContent" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                        Visibility="Collapsed"><views:PlcTagsView/></ContentControl>
                    </Grid>
                  </Grid>
                </ScrollViewer>
              </Grid>
              <views:VersionControlView x:Name="VersionControlContent" Grid.Column="1" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
            </Grid>
            <views:LogView x:Name="LogContent" StorageSettingsRequested="OnStorageSettings" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
          </Grid>
        </Grid>
        <Border x:Name="IdeStatusBar" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Primer.Workbench.StatusBar}">
          <Grid x:Name="StatusInformation">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MaxWidth="350"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SessionStatusButton" Grid.Column="0" HorizontalAlignment="Left" Style="{StaticResource Primer.Workbench.StatusButton}"
              AutomationProperties.Name="{Binding Text,ElementName=SessionStatus}" ToolTip="{Binding Text,ElementName=SessionStatus}"
              Click="OnProjectStatus">
              <DockPanel>
                <TextBlock AutomationProperties.Name="{Binding Text,ElementName=SessionStatus}" ToolTip="{Binding Text,ElementName=SessionStatus}"
                  x:Name="SessionGlyph" FontWeight="SemiBold" FontSize="{DynamicResource Ui.FontSize.10}" DockPanel.Dock="Left"
                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="SessionStatus" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.Workbench.StatusText}" AutomationProperties.LiveSetting="Polite"
                  ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}"/>
              </DockPanel>
            </Button>
            <Button x:Name="ApprovalStatusButton" Grid.Column="2" HorizontalAlignment="Right" Margin="8,0,0,0" Style="{StaticResource Primer.Workbench.StatusButton}"
              AutomationProperties.Name="{Binding Text,ElementName=ApprovalStatusText}" ToolTip="{Binding Text,ElementName=ApprovalStatusText}"
              PreviewKeyDown="OnApprovalChipKeyDown" Click="OnApprovalStatus">
              <DockPanel>
                <Ellipse x:Name="ApprovalStatusDot" AutomationProperties.Name="{Binding Text,ElementName=ApprovalStatusText}" ToolTip="{Binding Text,ElementName=ApprovalStatusText}" Style="{StaticResource Primer.StatusDot}" DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock AutomationProperties.LiveSetting="Polite" x:Name="ApprovalStatusText" Style="{StaticResource Primer.Workbench.StatusText}"/>
              </DockPanel>
            </Button>
            <DockPanel x:Name="ParticipantStatus" Grid.Column="1" HorizontalAlignment="Left" Margin="8,0">
              <TextBlock DockPanel.Dock="Left" Text="·" Style="{StaticResource Primer.Workbench.StatusText}" Margin="0,0,8,0"/>
              <TextBlock x:Name="TiaProcessStatus" DockPanel.Dock="Right" Style="{StaticResource Primer.Workbench.StatusText}" Margin="4,0,0,0"/>
              <TextBlock x:Name="ClientStatus" Style="{StaticResource Primer.Workbench.StatusText}" MaxWidth="220"
                ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
            <Button x:Name="CompileStatusButton" Grid.Column="3" Style="{StaticResource Primer.Workbench.StatusButton}"
              Visibility="{Binding Visibility,ElementName=CompileStatus}" AutomationProperties.Name="{Binding Tag,ElementName=CompileStatus}" ToolTip="{Binding Tag,ElementName=CompileStatus}" Click="OnCompileStatus">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CompileStatus" Tag="" Style="{StaticResource Primer.Workbench.StatusText}" FontFamily="{DynamicResource Ui.FontMono}">
                  <TextBlock.TextEffects>
                    <TextEffect x:Name="CompileOkGlyph" PositionStart="0" Foreground="{DynamicResource Primer.ok}"/>
                    <TextEffect x:Name="CompileErrorGlyph" PositionStart="0" Foreground="{DynamicResource Ant.colorError}"/>
                    <TextEffect x:Name="CompileWarningGlyph" Foreground="{DynamicResource Primer.warn}" PositionCount="1"/>
                  </TextBlock.TextEffects>
                </TextBlock>
              </StackPanel>
            </Button>
            <Button x:Name="AuditHeadButton" Grid.Column="4" Style="{StaticResource Primer.Workbench.StatusButton}"
              Visibility="{Binding Visibility,ElementName=AuditHead}" AutomationProperties.Name="{Binding Tag,ElementName=AuditHead}" ToolTip="{Binding Tag,ElementName=AuditHead}"
              Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit">
              <TextBlock x:Name="AuditHead" Tag="" Style="{StaticResource Primer.Workbench.StatusText}" FontFamily="{DynamicResource Ui.FontMono}"/>
            </Button>
            <TextBlock x:Name="BrandVersion" FontFamily="{DynamicResource Ui.FontMono}" Grid.Column="5" Style="{StaticResource Primer.Workbench.StatusText}" Margin="8,0">
              <Run x:Name="RailVersion"/>
            </TextBlock>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <ux:WorkbenchScrim Source="{Binding ElementName=ShellFrame}" x:Name="ProjectOptionsRailScrim" Visibility="Collapsed" Style="{StaticResource Primer.Workbench.DrawerRailScrim}"/>
    <ux:WorkbenchScrim Source="{Binding ElementName=ShellFrame}" x:Name="BlockOptionsRailScrim" Visibility="Collapsed" Style="{StaticResource Primer.Workbench.DrawerRailScrim}"/>
    <ux:WorkbenchScrim Source="{Binding ElementName=ShellFrame}" x:Name="WorkspaceOptionsScrim" Visibility="Collapsed" Style="{StaticResource Primer.Workbench.DrawerRailScrim}"/>
    <ux:WorkbenchScrim Source="{Binding ElementName=ShellFrame}" x:Name="ConfirmationFrameScrim" Visibility="Collapsed" Style="{StaticResource Primer.Workbench.ConfirmationFrameScrim}"/>
    <ContentControl Style="{StaticResource Primer.Workbench.FloatShadow}" Width="{Binding ActualWidth,ElementName=BusyCard}"
      Height="{Binding ActualHeight,ElementName=BusyCard}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
      Margin="{Binding Margin,ElementName=BusyCard}" Visibility="{Binding Visibility,ElementName=BusyCard}"/>
    <Border x:Name="BusyCard" Width="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,34"
      Style="{StaticResource Primer.ProjectBusyCard}">
      <Grid>
      <StackPanel Visibility="{Binding Atlas.Running,ElementName=BlocksContent,Converter={StaticResource NotBoolToVisibility},FallbackValue=Visible}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource Primer.Mono}" Foreground="{DynamicResource Primer.accent}"
            FontSize="{DynamicResource Ui.FontSize.11}" Visibility="{Binding Activity.ProgressIndeterminate,Converter={StaticResource NotBoolToVisibility}}">
            <Run Text="{Binding Activity.ProgressValue,Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Activity.ProgressMax,Mode=OneWay}"/>
          </TextBlock>
          <TextBlock Text="{Binding Activity.BusyTitle}" ToolTip="{Binding Activity.ProgressLabel}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
            FontSize="{DynamicResource Ui.FontSize.12}" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Activity.ProgressLabel}"/>
        </DockPanel>
        <ProgressBar Margin="0,8" Style="{StaticResource Primer.Progress}" IsIndeterminate="{Binding Activity.ProgressIndeterminate}"
          Maximum="{Binding Activity.ProgressMax}" Value="{Binding Activity.ProgressValue,Mode=OneWay}"/>
        <DockPanel>
          <Button DockPanel.Dock="Right" Command="{Binding Panel.Cancel}" Content="{l:Tr Session.Cancel}" AutomationProperties.Name="{l:Tr Session.Cancel}"
            Style="{StaticResource Primer.ProjectSessionCancel}"/>
          <Button x:Name="CancelProjectRead" DockPanel.Dock="Right" Content="{l:Tr Session.Cancel}"
              AutomationProperties.Name="{l:Tr Session.Cancel}" Click="OnCancelProjectRead"
            Style="{StaticResource Primer.Link}" Visibility="{Binding Engineering.ReadingDocument,Converter={StaticResource BoolToVisibility}}"/>
          <TextBlock Style="{StaticResource Primer.ProjectProgressDetail}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
        </DockPanel>
      </StackPanel>
      <Border x:Name="AtlasFooter" Style="{StaticResource Primer.ProjectLayoutSurface}" DataContext="{Binding Atlas,ElementName=BlocksContent}"
        Visibility="{Binding Running,Converter={StaticResource BoolToVisibility},FallbackValue=Collapsed}">
        <StackPanel x:Name="AtlasBar">
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Label}"/>
          <ProgressBar Margin="0,8" Maximum="100" Value="{Binding Percent,Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"
            Style="{StaticResource Primer.Progress}"/>
          <DockPanel>
            <Button x:Name="CancelAtlas" DockPanel.Dock="Right" Click="OnCancelAtlas" Content="{l:Tr Session.Cancel}"
              AutomationProperties.Name="{l:Tr Session.Cancel}"
              Style="{StaticResource Primer.Link}"/>
            <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Project.Caption}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </StackPanel>
      </Border>
      </Grid>
    </Border>
    <Grid x:Name="DrawerOverlay" AutomationProperties.Name="{Binding Text,ElementName=DrawerTitle}" Visibility="Collapsed">
      <ux:WorkbenchScrim x:Name="CallDrawerScrim" Source="{Binding ElementName=ShellFrame}" BlurRadius="2" MouseLeftButtonUp="OnDrawerBackdrop"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding Width,ElementName=DrawerPanel}" Margin="{Binding Margin,ElementName=DrawerPanel}" HorizontalAlignment="Right"/>
      <Border x:Name="DrawerPanel" Width="520" Margin="0,8,8,8" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Padding="24,0" Style="{StaticResource Primer.Divider}">
            <DockPanel x:Name="DrawerHeading" DataContext="{x:Null}">
              <Button DockPanel.Dock="Right" Content="&#xE711;" AutomationProperties.Name="{l:Tr Access.CloseDrawer}"
                Style="{StaticResource Primer.CaptionButton}" Click="OnCloseDrawer"/>
              <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DrawerTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}"
                  KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontWeight="SemiBold"
                  FontSize="{DynamicResource Ui.FontSize.Section}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                <ContentControl x:Name="DrawerCallResult" Grid.Column="1" Style="{StaticResource Primer.StatusChip}"
                  Tag="{Binding SelectedCall.Tone}" Margin="8,0,0,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding SelectedCall.Result}" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
              </Grid>
            </DockPanel>
          </Border>
          <views:CallDetailDrawer x:Name="CallDetailContent" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock x:Name="DisplacedStickyAnnouncement" Width="0" Height="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Polite"/>
    <TextBlock x:Name="DroppedErrorAnnouncement" Width="0" Height="0" IsHitTestVisible="False" AutomationProperties.LiveSetting="Assertive"/>
    <Grid x:Name="SettingsOverlay" Visibility="Collapsed" AutomationProperties.Name="{l:Tr Settings.Sections}">
      <ux:WorkbenchScrim x:Name="SettingsScrim" Source="{Binding ElementName=ShellFrame}" BlurRadius="4" MouseLeftButtonUp="OnSettingsBackdrop"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" HorizontalAlignment="Center" VerticalAlignment="Center"
        Width="{Binding Width,ElementName=SettingsCard}" Height="{Binding Height,ElementName=SettingsCard}"/>
      <Border x:Name="SettingsCard" Width="840" Height="584" HorizontalAlignment="Center" VerticalAlignment="Center"
        Style="{StaticResource Primer.Workbench.SettingsCard}" SizeChanged="OnSettingsCardSizeChanged">
        <views:SettingsView x:Name="SettingsContent"/>
      </Border>
    </Grid>
    <StackPanel x:Name="ToastStack" Width="336" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,36">
      <Border x:Name="DiagnosticProgressCard" DataContext="{Binding DataContext,ElementName=CallsContent}"
        Style="{StaticResource Primer.Container}" Padding="14,10" Margin="0,0,0,6"
        Visibility="{Binding DiagnosticRunning, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding DiagnosticPercent, StringFormat={}{0}%}" Style="{StaticResource Primer.Mono}"/>
            <TextBlock Text="{Binding DiagnosticStep}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
              ux:AccessibleStatus.Text="{Binding DiagnosticStep}"/>
          </DockPanel>
          <ProgressBar Style="{StaticResource Primer.Progress}" Height="4" Value="{Binding DiagnosticPercent, Mode=OneWay}" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid x:Name="OverlayHost" Visibility="Collapsed"/>
  </Grid>
    <ux:WorkbenchScrim x:Name="OwnedDialogScrim" Source="{Binding ElementName=Root}" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Window>
