<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" x:Class="TiaOpenness.Gui.MainWindow" Title="{l:Tr App.Title}" Width="1200" Height="780" MinWidth="1024" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Ui.Window}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Open}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Engineering.Save}"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding Engineering.Compile}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Blocks"/>
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="VersionControl"/>
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls"/>
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
    <KeyBinding Key="D8" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Open}" Executed="OnOpenExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Engineering}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Configuration}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Navigate}" Executed="OnNavigateExecuted" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>
  <Grid x:Name="Root" Background="{DynamicResource Primer.bg}" ClipToBounds="True" TextElement.FontFamily="{DynamicResource Ui.Font}" TextElement.FontSize="{DynamicResource Ui.FontSize.Control}" TextElement.Foreground="{DynamicResource Primer.text}">
    <Border Style="{StaticResource Primer.Frame}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Ant Sider: brand, the grouped inline menu and the collapse trigger. -->
        <Border x:Name="Sider" Width="216" Style="{StaticResource Primer.Sider}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Height="56" Margin="18,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border VerticalAlignment="Center" Style="{StaticResource Primer.BrandDot}"/>
              <TextBlock x:Name="BrandTitle" Grid.Column="1" Text="{l:Tr Shell.Brand}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,8,0" FontSize="{DynamicResource Ui.FontSize.Large}"/>
              <Border x:Name="BrandVersion" Grid.Column="2" Style="{StaticResource Primer.Chip}">
                <TextBlock x:Name="RailVersion" Style="{StaticResource Primer.Mono.text}"/>
              </Border>
            </Grid>
            <Button x:Name="SiderToggle" DockPanel.Dock="Bottom" AutomationProperties.Name="{l:Tr Shell.CollapseMenu}" Content="{l:Tr Shell.CollapseMenu}" ux:Ux.Icon="{DynamicResource Icon.MenuFold}" Style="{StaticResource Primer.MenuButton}" Click="OnSiderToggle" Margin="4,4,4,8"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <StackPanel x:Name="SiderMenu">
                <TextBlock Text="{l:Tr Shell.GroupEngineering}" Style="{StaticResource Primer.MenuGroup}"/>
                <RadioButton AutomationProperties.Name="{l:Tr Shell.Engineering}" x:Name="RailEngineering" Content="{l:Tr Shell.Engineering}" GroupName="Pages" ToolTip="Ctrl+2" AutomationProperties.AcceleratorKey="Ctrl+2" Tag="Engineering" ux:Ux.Icon="{DynamicResource Icon.Project}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick"/>
                <RadioButton AutomationProperties.Name="{l:Tr Shell.VersionControl}" x:Name="RailVersionControl" Content="{l:Tr Shell.VersionControl}" ToolTip="Ctrl+4" AutomationProperties.AcceleratorKey="Ctrl+4" Tag="VersionControl" GroupName="ProjectPages" ux:Ux.Icon="{DynamicResource Icon.Branch}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick"/>
                <TextBlock Text="{l:Tr Shell.GroupAi}" Style="{StaticResource Primer.MenuGroup}"/>
                <RadioButton x:Name="RailCalls" AutomationProperties.Name="{l:Tr Shell.Calls}" GroupName="Pages" ToolTip="Ctrl+5" AutomationProperties.AcceleratorKey="Ctrl+5" Tag="Calls" ux:Ux.Icon="{DynamicResource Icon.Robot}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick">
                  <DockPanel>
                    <Border x:Name="CallsCountBadge" DockPanel.Dock="Right" Style="{StaticResource Primer.TabCountBadge}" Tag="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Margin="6,0,0,0">
                      <TextBlock Text="{Binding DataContext.Calls.Count,ElementName=CallsContent}" Style="{StaticResource Primer.CountText}"/>
                    </Border>
                    <TextBlock Text="{l:Tr Shell.Calls}"/>
                  </DockPanel>
                </RadioButton>
                <TextBlock Text="{l:Tr Shell.GroupOperations}" Style="{StaticResource Primer.MenuGroup}"/>
                <RadioButton AutomationProperties.Name="{l:Tr Shell.Audit}" x:Name="RailAudit" Content="{l:Tr Shell.Audit}" GroupName="Pages" ToolTip="Ctrl+6" AutomationProperties.AcceleratorKey="Ctrl+6" Tag="Audit" ux:Ux.Icon="{DynamicResource Icon.Audit}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick"/>
                <RadioButton AutomationProperties.Name="{l:Tr Shell.Environment}" x:Name="RailEnvironment" GroupName="Pages" ToolTip="Ctrl+7" AutomationProperties.AcceleratorKey="Ctrl+7" Tag="Environment" ux:Ux.Icon="{DynamicResource Icon.Health}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick">
                  <DockPanel>
                    <Border x:Name="EnvironmentCountBadge" DockPanel.Dock="Right" Style="{StaticResource Primer.PendingCountBadge}" Tag="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}" Margin="6,0,0,0">
                      <TextBlock Text="{Binding DataContext.EnvironmentAttentionCount,ElementName=EnvironmentContent}" Style="{StaticResource Primer.CountText}"/>
                    </Border>
                    <TextBlock Text="{l:Tr Shell.Environment}"/>
                  </DockPanel>
                </RadioButton>
                <RadioButton AutomationProperties.Name="{l:Tr Tab.Log}" x:Name="RailLog" Content="{l:Tr Tab.Log}" GroupName="Pages" ToolTip="Ctrl+8" AutomationProperties.AcceleratorKey="Ctrl+8" Tag="Log" ux:Ux.Icon="{DynamicResource Icon.FileText}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick"/>
                <TextBlock Text="{l:Tr Shell.GroupConnection}" Style="{StaticResource Primer.MenuGroup}"/>
                <RadioButton AutomationProperties.Name="{l:Tr Desktop.Configuration}" x:Name="RailMcp" Content="{l:Tr Desktop.Configuration}" GroupName="Pages" ToolTip="Ctrl+1" AutomationProperties.AcceleratorKey="Ctrl+1" Tag="Mcp" ux:Ux.Icon="{DynamicResource Icon.Api}" Style="{StaticResource Primer.NavItem}" Click="OnRailClick"/>
                <Button AutomationProperties.Name="{l:Tr Shell.Settings}" x:Name="SettingsButton" Content="{l:Tr Shell.Settings}" ux:Ux.Icon="{DynamicResource Icon.Setting}" Style="{StaticResource Primer.MenuButton}" Click="OnSettings"/>
                <!-- The overview and program blocks share the 项目 page; these keep Ctrl+2 and Ctrl+3 as navigation targets. -->
                <Border x:Name="SubTabs" Visibility="Collapsed" Style="{StaticResource Primer.Plain}">
                  <StackPanel>
                    <RadioButton AutomationProperties.Name="{l:Tr Shell.Overview}" x:Name="RailOverview" Content="{l:Tr Shell.Overview}" ToolTip="Ctrl+2" AutomationProperties.AcceleratorKey="Ctrl+2" Tag="Engineering" GroupName="ProjectPages" Style="{StaticResource Primer.SubTab}" Click="OnRailClick"/>
                    <RadioButton AutomationProperties.Name="{l:Tr Tree.ProgramBlocks}" x:Name="RailBlocks" Content="{l:Tr Tree.ProgramBlocks}" ToolTip="Ctrl+3" AutomationProperties.AcceleratorKey="Ctrl+3" Tag="Blocks" GroupName="ProjectPages" Style="{StaticResource Primer.SubTab}" Click="OnRailClick"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- Ant Header: breadcrumb, MCP status and connection, approvals, diagnostics, language, window buttons. -->
          <Border Style="{StaticResource Primer.HeaderBar}">
            <DockPanel x:Name="CaptionBar" Height="56" Margin="24,0,8,0" LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinimizeWindowButton" AutomationProperties.Name="{l:Tr Access.Minimize}" Style="{StaticResource Primer.WindowButton}" Click="OnMinimize">
                  <Path Width="10" Height="10" Data="M0,5 L10,5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="MaximizeWindowButton" AutomationProperties.Name="{l:Tr Access.Maximize}" Style="{StaticResource Primer.WindowButton}" Click="OnMaximize">
                  <Path Width="10" Height="10" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
                <Button x:Name="CloseWindowButton" AutomationProperties.Name="{l:Tr Access.Close}" Style="{StaticResource Primer.WindowButton}" Click="OnClose">
                  <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
                </Button>
              </StackPanel>
              <StackPanel x:Name="StatusActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel x:Name="ControlPrefillHint" Orientation="Horizontal" Visibility="Collapsed">
                  <TextBlock Text="{l:Tr Control.Prefilled}" Style="{StaticResource Primer.Muted}" VerticalAlignment="Center"/>
                  <Button AutomationProperties.Name="{l:Tr Control.Confirm}" Content="{l:Tr Control.Confirm}" Style="{StaticResource Primer.Quiet}" Click="OnConfirmControlPrefill"/>
                  <Button AutomationProperties.Name="{l:Tr Control.Clear}" Content="{l:Tr Control.Clear}" Style="{StaticResource Primer.Quiet}" Click="OnClearControlPrefill"/>
                </StackPanel>
                <Border x:Name="ApprovalOffPill" AutomationProperties.Name="{l:Tr Shell.ApprovalOff}" Style="{StaticResource Primer.WarningBadge}" Visibility="Collapsed" Margin="0,0,8,0">
                  <TextBlock x:Name="ApprovalOffText" AutomationProperties.LiveSetting="Polite" Text="{l:Tr Shell.ApprovalOff}" Style="{StaticResource Primer.Text.warn}"/>
                </Border>
                <Button x:Name="PendingBadge" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Style="{StaticResource Primer.PendingBadge}" Click="OnApprovals" Visibility="Collapsed" Margin="0,0,4,0"/>
                <Button x:Name="ApprovalsButton" AutomationProperties.Name="{l:Tr Shell.PendingTitle}" Content="{l:Tr Shell.PendingTitle}" ux:Ux.Icon="{DynamicResource Icon.Bell}" Style="{StaticResource Primer.HeaderIconButton}" Click="OnApprovals"/>
                <Button AutomationProperties.Name="{l:Tr Shell.Diagnostics}" x:Name="ExportDiagnostics" Content="{l:Tr Shell.Diagnostics}" ux:Ux.Icon="{DynamicResource Icon.Download}" Style="{StaticResource Primer.HeaderIconButton}" Click="OnDiagnostics" Margin="4,0,0,0"/>
                <Button AutomationProperties.Name="{l:Tr Shell.Language}" x:Name="LanguageButton" Content="{l:Tr Shell.Language}" ux:Ux.Icon="{DynamicResource Icon.Translate}" Style="{StaticResource Primer.HeaderIconButton}" Click="OnLanguage" Margin="4,0,8,0"/>
              </StackPanel>
              <DockPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock x:Name="BreadcrumbGroup" DockPanel.Dock="Left" Style="{StaticResource Primer.Breadcrumb}"/>
                <TextBlock Text="/" DockPanel.Dock="Left" Margin="8,0" Style="{StaticResource Primer.Breadcrumb}"/>
                <TextBlock x:Name="CurrentPageTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource Primer.Text}"/>
              </DockPanel>
              <!--
                Status in priority order: the MCP state keeps its width, then the session chip, then the control
                status; each trims at its right edge, so the row never overflows its slot or clips on the left.
              -->
              <DockPanel x:Name="StatusInformation" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,8,0" ClipToBounds="True">
                <DockPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                  <Ellipse x:Name="McpStatusDot" AutomationProperties.Name="{Binding Text,ElementName=McpStatusText}" Width="7" Height="7" Fill="{DynamicResource Primer.textMuted}" Margin="0,0,8,0"/>
                  <TextBlock x:Name="McpStatusText" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource Primer.Text}"/>
                </DockPanel>
                <Border DockPanel.Dock="Left" Margin="12,0,0,0" MaxWidth="280" Style="{StaticResource Primer.Chip}">
                  <DockPanel>
                    <Path Style="{StaticResource Primer.Icon}" Data="{DynamicResource Icon.Link}" Width="12" Height="12" Margin="0,0,6,0"/>
                    <TextBlock x:Name="SessionStatus" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource Primer.Mono.text}"/>
                  </DockPanel>
                </Border>
                <TextBlock x:Name="ControlStatus" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="320" VerticalAlignment="Center"/>
              </DockPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1" Margin="24">
            <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
            <views:AiCallsView x:Name="CallsContent" Visibility="Collapsed"/>
            <views:AuditLogView x:Name="AuditContent" Visibility="Collapsed"/>
            <views:EnvironmentView x:Name="EnvironmentContent" Visibility="Collapsed"/>
            <!-- 项目: page head and program blocks on the left, the result cards in a full-height column on the right. -->
            <Grid x:Name="EngineeringPage" ux:ResponsiveLayout.Enabled="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
              </Grid.ColumnDefinitions>
              <views:ProjectOperationsView x:Name="OperationsContent" Panel.ZIndex="1" Tag="{Binding Tag,ElementName=Root}"/>
              <views:BlocksView x:Name="BlocksContent" Grid.Row="1" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
              <views:EngineeringSideView x:Name="EngineeringSideContent" Grid.RowSpan="2" Grid.Column="2" Tag="{Binding Tag,ElementName=Root}"/>
              <views:VersionControlView x:Name="VersionControlContent" Grid.RowSpan="2" Grid.ColumnSpan="3" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
              <views:LogView x:Name="LogContent" Grid.RowSpan="2" Grid.ColumnSpan="3" Tag="{Binding Tag,ElementName=Root}" Visibility="Collapsed"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
    <Border VerticalAlignment="Bottom" Margin="240,0,348,24" Visibility="{Binding Busy,Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Primer.Container}">
      <StackPanel>
        <TextBlock AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Activity.Status}" Text="{Binding Activity.Status}" Style="{StaticResource Primer.Muted}"/>
        <ProgressBar Height="3" Margin="0,6,0,0" IsIndeterminate="{Binding Activity.ProgressIndeterminate}" Maximum="{Binding Activity.ProgressMax}" Value="{Binding Activity.ProgressValue,Mode=OneWay}"/>
      </StackPanel>
    </Border>
    <Grid x:Name="DrawerOverlay" AutomationProperties.Name="{Binding Text,ElementName=DrawerTitle}" Visibility="Collapsed">
      <Border MouseLeftButtonUp="OnDrawerBackdrop" Style="{StaticResource Primer.Overlay}"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding Width,ElementName=DrawerPanel}" Margin="{Binding Margin,ElementName=DrawerPanel}" HorizontalAlignment="Right"/>
      <Border x:Name="DrawerPanel" Width="400" Margin="0,8,8,8" HorizontalAlignment="Right" Style="{StaticResource Primer.Drawer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Padding="24,0" Style="{StaticResource Primer.Divider}">
            <DockPanel x:Name="DrawerHeading" DataContext="{x:Null}">
              <Button DockPanel.Dock="Right" Content="" AutomationProperties.Name="{l:Tr Access.CloseDrawer}" Style="{StaticResource Primer.CaptionButton}" Click="OnCloseDrawer"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="DrawerTitle" Focusable="True" FocusVisualStyle="{StaticResource Primer.Focus}" KeyboardNavigation.IsTabStop="False" AutomationProperties.HeadingLevel="Level1" FontSize="{DynamicResource Ui.FontSize.Section}" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="300"/>
                <Border Style="{StaticResource Primer.PendingCountBadge}" Tag="{Binding Approvals.PendingCount}" Margin="10,0,0,0">
                  <TextBlock x:Name="DrawerCount" Text="{Binding PendingCount}" Style="{StaticResource Primer.CountText}" Visibility="Collapsed"/>
                </Border>
                <ContentControl x:Name="DrawerCallResult" Style="{StaticResource Primer.StatusChip}" Tag="{Binding SelectedCall.Tone}" Margin="10,0,0,0" Visibility="Collapsed">
                  <TextBlock Text="{Binding SelectedCall.Result}" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
              </StackPanel>
            </DockPanel>
          </Border>
          <views:SettingsView x:Name="SettingsContent" Grid.Row="1"/>
          <views:ApprovalsDrawer x:Name="ApprovalsContent" Grid.Row="1" Visibility="Collapsed"/>
          <views:CallDetailDrawer x:Name="CallDetailContent" Grid.Row="1" Visibility="Collapsed"/>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmOverlay" AutomationProperties.Name="{l:Tr Settings.ConfirmOffTitle}" Visibility="Collapsed">
      <Border Style="{StaticResource Primer.Overlay}"/>
      <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding ActualWidth,ElementName=ConfirmDialog}" Height="{Binding ActualHeight,ElementName=ConfirmDialog}" VerticalAlignment="Center"/>
      <Border x:Name="ConfirmDialog" Width="420" VerticalAlignment="Center" Style="{StaticResource Primer.Dialog}">
        <StackPanel>
          <DockPanel>
            <Path DockPanel.Dock="Left" Style="{StaticResource Primer.AlertIcon.Warning}" Width="22" Height="22" Margin="0,0,12,0"/>
            <TextBlock Text="{l:Tr Settings.ConfirmOffTitle}" FontSize="{DynamicResource Ui.FontSize.DialogTitle}" FontWeight="SemiBold"/>
          </DockPanel>
          <TextBlock Text="{l:Tr Settings.ConfirmOffDescription}" FontSize="{DynamicResource Ui.FontSize.Control}" TextWrapping="Wrap" Margin="34,8,0,12" Style="{StaticResource Primer.Text.textMuted}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button AutomationProperties.Name="{l:Tr Shell.Cancel}" x:Name="CancelApprovalOff" IsDefault="True" IsCancel="True" Content="{l:Tr Shell.Cancel}" Style="{StaticResource Primer.Secondary}" Click="OnCancelApprovalOff" Margin="0,0,8,0"/>
            <Button AutomationProperties.Name="{l:Tr Settings.TurnOff}" x:Name="ConfirmApprovalOff" Content="{l:Tr Settings.TurnOff}" Style="{StaticResource Primer.WarningAction}" Click="OnConfirmApprovalOff"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <ContentControl Style="{StaticResource Primer.Shadow}" Width="{Binding ActualWidth,ElementName=Toast}" Height="{Binding ActualHeight,ElementName=Toast}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{Binding Margin,ElementName=Toast}" Visibility="{Binding Visibility,ElementName=Toast}"/>
    <Border x:Name="Toast" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,16" Visibility="Collapsed"  Style="{StaticResource Primer.Toast}">
      <DockPanel>
        <Button Content="" AutomationProperties.Name="{l:Tr Access.Dismiss}" DockPanel.Dock="Right" Style="{StaticResource Primer.CaptionButton}" Click="OnDismissToast"/>
        <Border Width="34" Height="34" Margin="0,0,12,0" Style="{StaticResource Primer.WarningIcon}">
          <Path Style="{StaticResource Primer.AlertIcon.Warning}" Width="20" Height="20" HorizontalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="ToastTitle" AutomationProperties.LiveSetting="Polite" ux:AccessibleStatus.Text="{Binding Text,RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource Ui.FontSize.Control}" FontWeight="SemiBold"/>
          <TextBlock x:Name="ToastMessage" AutomationProperties.LiveSetting="Polite" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" Margin="0,2,0,4" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
          <Button x:Name="ToastAction" Content="{l:Tr Common.Open}" AutomationProperties.Name="{Binding Text,ElementName=ToastTitle}" Click="OnToastClick" Style="{StaticResource Primer.Link}" HorizontalAlignment="Left" Padding="0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
