<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:themes="clr-namespace:TiaOpenness.Gui.Themes" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:views="clr-namespace:TiaOpenness.Gui.Views" xmlns:glass="clr-namespace:TiaDesktop.Glass" x:Class="TiaOpenness.Gui.MainWindow" Title="{l:Tr App.Title}" Width="1200" Height="780" MinWidth="1200" MinHeight="780" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Style="{StaticResource Ui.Window}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Open}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding Engineering.Save}"/>
    <KeyBinding Key="B" Modifiers="Control" Command="{Binding Engineering.Compile}"/>
    <KeyBinding Key="D1" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Mcp"/>
    <KeyBinding Key="D2" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Engineering"/>
    <KeyBinding Key="D3" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Blocks"/>
    <KeyBinding Key="D4" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="VersionControl"/>
    <KeyBinding Key="D5" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Calls"/>
    <KeyBinding Key="D6" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Audit"/>
    <KeyBinding Key="D7" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Environment"/>
    <KeyBinding Key="D8" Modifiers="Control" Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Log"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Open}" Executed="OnOpenExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Engineering}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Configuration}" Executed="OnPageExecuted"/>
    <CommandBinding Command="{x:Static ux:WorkbenchCommands.Navigate}" Executed="OnNavigateExecuted" CanExecute="OnCanNavigate"/>
  </Window.CommandBindings>
  <Grid x:Name="Root" Background="{DynamicResource Ui.WindowBackground}" ClipToBounds="True" TextElement.FontFamily="{DynamicResource Ui.Font}" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Ui.Label}">
    <Ellipse Fill="{DynamicResource Glass.GlowOne}" Width="1200" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-420,-322,0,0" IsHitTestVisible="False"/>
    <Ellipse Fill="{DynamicResource Glass.GlowTwo}" Width="1000" Height="760" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-380,-302" IsHitTestVisible="False"/>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid x:Name="CaptionBar" Margin="18,0,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Border Width="16" Height="16" CornerRadius="5" Background="{DynamicResource Ui.Accent}" VerticalAlignment="Center"/>
          <TextBlock Text="{l:Tr Shell.Brand}" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <DockPanel VerticalAlignment="Center">
            <Ellipse x:Name="McpStatusDot" Width="6" Height="6" Fill="{DynamicResource Ui.StatusIdle}" Margin="0,0,8,0"/>
            <TextBlock x:Name="McpStatusText" Style="{StaticResource Glass.Muted}" FontSize="11.5"/>
          </DockPanel>
          <Button x:Name="PendingBadge" Grid.Column="1" Style="{StaticResource Shell.WarningPill}" Click="OnApprovals" Visibility="Collapsed" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Border x:Name="ApprovalOffPill" Grid.Column="2" Style="{StaticResource Glass.Chip}" Background="{DynamicResource Ui.WarningSoft}" Visibility="Collapsed">
            <TextBlock Text="{l:Tr Shell.ApprovalOff}" Foreground="{DynamicResource Ui.Orange}"/>
          </Border>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="ExportDiagnostics" Content="{l:Tr Shell.Diagnostics}" Style="{StaticResource Glass.Button}" Height="28" FontSize="11.5" Click="OnDiagnostics" Margin="0,0,8,0"/>
          <Button x:Name="SettingsButton" Content="{l:Tr Shell.Settings}" Style="{StaticResource Glass.Button}" Height="28" FontSize="11.5" Padding="11.5,0" Click="OnSettings" Margin="0,0,8,0"/>
          <Button x:Name="MinimizeWindowButton" Style="{StaticResource Shell.WindowButton}" Click="OnMinimize">
            <Path Width="10" Height="10" Data="M0,5 L10,5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
          </Button>
          <Button x:Name="MaximizeWindowButton" Style="{StaticResource Shell.WindowButton}" Click="OnMaximize">
            <Path Width="10" Height="10" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
          </Button>
          <Button x:Name="CloseWindowButton" Style="{StaticResource Shell.WindowButton}" Click="OnClose">
            <Path Width="10" Height="10" Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="20,8,20,20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="184"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="RailCard" Style="{StaticResource Glass.Card}" Effect="{x:Null}" Background="{DynamicResource Ui.SidebarBackground}" Padding="8,12">
          <DockPanel>
            <TextBlock x:Name="RailVersion" DockPanel.Dock="Bottom" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="10.5" Margin="12,8,12,2"/>
            <StackPanel>
              <TextBlock Text="{l:Tr Shell.Pages}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.TertiaryLabel}" FontSize="10" FontWeight="Bold" Height="14" Margin="12,4,12,10"/>
              <RadioButton x:Name="RailMcp" Content="{l:Tr Desktop.Configuration}" GroupName="Rail" Tag="Mcp" Style="{StaticResource Shell.RailItem}" Click="OnRailClick"/>
              <RadioButton x:Name="RailEngineering" Content="{l:Tr Shell.Engineering}" GroupName="Rail" Tag="Engineering" Style="{StaticResource Shell.RailItem}" Click="OnRailClick"/>
              <Border BorderBrush="{DynamicResource Ui.Separator}" BorderThickness="1,0,0,0" CornerRadius="10" Margin="14,0,0,4">
                <RadioButton x:Name="RailBlocks" Content="{l:Tr Tree.ProgramBlocks}" GroupName="Rail" Tag="Blocks" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Margin="0" Height="28" FontSize="12" Padding="10,0"/>
              </Border>
              <Border BorderBrush="{DynamicResource Ui.Separator}" BorderThickness="1,0,0,0" CornerRadius="10" Margin="14,0,0,4">
                <RadioButton x:Name="RailVersionControl" Content="{l:Tr Shell.VersionControl}" GroupName="Rail" Tag="VersionControl" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Margin="0" Height="28" FontSize="12" Padding="10,0"/>
              </Border>
              <RadioButton x:Name="RailCalls" Content="{l:Tr Shell.Calls}" GroupName="Rail" Tag="Calls" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Height="34" Margin="0,0,0,3"/>
              <RadioButton x:Name="RailAudit" Content="{l:Tr Shell.Audit}" GroupName="Rail" Tag="Audit" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Height="34" Margin="0,0,0,3"/>
              <RadioButton x:Name="RailEnvironment" Content="{l:Tr Shell.Environment}" GroupName="Rail" Tag="Environment" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Height="34" Margin="0,0,0,3"/>
              <RadioButton x:Name="RailLog" Content="{l:Tr Tab.Log}" GroupName="Rail" Tag="Log" Style="{StaticResource Shell.RailItem}" Click="OnRailClick" Height="34" Margin="0,0,0,3"/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Column="2">
          <ContentControl x:Name="ConfigurationHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed"/>
          <Grid x:Name="EngineeringPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="42"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <WrapPanel>
              <Button Content="{l:Tr Project.Label}" Click="OnProjectOptions" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
              <Button Content="{l:Tr Glass.Software}" Click="OnSoftware" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
              <Button Content="{l:Tr Glass.Transfer}" Click="OnExportOptions" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
              <Button x:Name="CompileButton" Content="{l:Tr Toolbar.Compile}" Command="{Binding Engineering.Compile}" Style="{StaticResource Glass.Outline}" Margin="0,0,8,0"/>
              <Button Content="{l:Tr Toolbar.Inspect}" Click="OnInspectOptions" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
              <Button Content="{l:Tr Glass.NewWorkspace}" Click="OnWorkspaceOptions" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
              <Button Content="{l:Tr Glass.Git}" Click="OnGit" Style="{StaticResource Glass.Button}"/>
            </WrapPanel>
            <Grid x:Name="EngineeringWorkspace" Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition x:Name="DetailColumn" Width="284"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Visibility="{Binding IsBlocksTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="84"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                  <Border x:Name="ProjectCard" Style="{StaticResource Glass.Card}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Session.ProjectName}" FontWeight="Bold" FontSize="20" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                          <Border Style="{StaticResource Glass.Chip}" Margin="10,0,0,0" Visibility="{Binding Session.IsConnected, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{l:Tr Glass.Bound}"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Session.ProjectPath}" Style="{StaticResource Glass.Mono}" Margin="0,5,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SoftwarePicker" Width="140" ItemsSource="{Binding Engineering.Devices}" SelectedItem="{Binding Engineering.SelectedDevice}" Style="{StaticResource Glass.Combo}" Margin="12,0,8,0">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="SaveButton" Content="{l:Tr Toolbar.Save}" ToolTip="{l:Tr Toolbar.Save.Tip}" Command="{Binding Engineering.Save}" Style="{StaticResource Glass.Primary}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="2">
                  <Border x:Name="BlocksCard" Style="{StaticResource Glass.Card}" Padding="22,18">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="13"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="36"/>
                      </Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Engineering.BlockFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Glass.Field}" Tag="{l:Tr Blocks.Filter}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=Root,Path=Tag.BlocksSummary}" Style="{StaticResource Glass.Muted}" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                          <Button Content="{l:Tr Glass.SelectAll}" Style="{StaticResource Glass.Button}" Click="OnSelectAll" Margin="0,0,8,0"/>
                          <Button Content="{l:Tr Glass.Clear}" Style="{StaticResource Glass.Button}" Click="OnSelectNone"/>
                        </StackPanel>
                      </Grid>
                      <Grid Grid.Row="2" Margin="12,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="28"/>
                          <ColumnDefinition Width="1.5*"/>
                          <ColumnDefinition Width=".45*"/>
                          <ColumnDefinition Width=".45*"/>
                          <ColumnDefinition Width=".6*"/>
                          <ColumnDefinition Width="1.4*"/>
                          <ColumnDefinition Width=".85*"/>
                          <ColumnDefinition Width=".9*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Glass.Name}" Grid.Column="1" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.Type}" Grid.Column="2" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.Number}" Grid.Column="3" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.Language}" Grid.Column="4" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.Group}" Grid.Column="5" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.Consistent}" Grid.Column="6" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                        <TextBlock Text="{l:Tr Glass.KnowHow}" Grid.Column="7" Style="{StaticResource Glass.Muted}" FontSize="9" FontWeight="Bold" Margin="10,0,0,0"/>
                      </Grid>
                      <ListBox Grid.Row="3" ItemsSource="{Binding Engineering.BlocksView}" Style="{StaticResource Glass.List}" Visibility="{Binding Engineering.HasBlocks, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem" BasedOn="{StaticResource Glass.Row}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width=".45*"/>
                                <ColumnDefinition Width=".45*"/>
                                <ColumnDefinition Width=".6*"/>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width=".85*"/>
                                <ColumnDefinition Width=".9*"/>
                              </Grid.ColumnDefinitions>
                              <CheckBox IsChecked="{Binding Selected}" Style="{StaticResource Glass.Check}"/>
                              <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"/>
                              <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" Text="{Binding Kind}" FontSize="12"/>
                              <TextBlock Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" Text="{Binding Number}" FontSize="12" FontFamily="{DynamicResource Ui.FontMono}"/>
                              <TextBlock Grid.Column="4" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" Text="{Binding Language}" FontSize="12"/>
                              <TextBlock Grid.Column="5" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" Text="{Binding Path,Converter={StaticResource Glass.Value},ConverterParameter=group}" FontSize="12" Foreground="{DynamicResource Ui.SecondaryLabel}" ToolTip="{Binding Path}"/>
                              <TextBlock Grid.Column="6" Margin="10,0,0,0" FontSize="12">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Text}">
                                    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Info.IsConsistent}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource Ui.Orange}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                  <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="consistent">
                                    <Binding Path="Info.IsConsistent"/>
                                    <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                              <TextBlock Grid.Column="7" Margin="10,0,0,0" Style="{StaticResource Glass.Text}" FontSize="12" Foreground="{DynamicResource Ui.SecondaryLabel}">
                                <TextBlock.Text>
                                  <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="protected">
                                    <Binding Path="Info.IsKnowHowProtected"/>
                                    <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <StackPanel Grid.Row="3" VerticalAlignment="Center" Margin="24" Visibility="{Binding Engineering.HasBlocks, Converter={StaticResource NotBoolToVisibility}}">
                        <TextBlock Text="{l:Tr Blocks.Empty.Title}" Style="{StaticResource Ui.Text.Heading}"/>
                        <TextBlock Text="{l:Tr Blocks.Empty.Body}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" LineHeight="20"/>
                        <Button Content="{l:Tr Toolbar.Connect}" Command="{Binding Session.Connect}" Style="{StaticResource Glass.Primary}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                      </StackPanel>
                      <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Click="OnExportClicked" Style="{StaticResource Glass.Button}" Margin="0,0,8,0">
                          <Button.Content>
                            <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="export">
                              <Binding Path="Engineering.SourceFormat"/>
                              <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                            </MultiBinding>
                          </Button.Content>
                        </Button>
                        <Button Grid.Column="1" Content="{l:Tr Glass.ImportXml}" MinWidth="158" Command="{Binding Engineering.Import}" Style="{StaticResource Glass.Button}"/>
                        <Button Grid.Column="2" Content="{l:Tr Glass.CompileSoftware}" Command="{Binding Engineering.Compile}" Style="{StaticResource Glass.Outline}" HorizontalAlignment="Right"/>
                      </Grid>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Column="2" Visibility="{Binding IsBlocksTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="289"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="156"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                  <Border x:Name="CompileCard" Style="{StaticResource Glass.Card}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="54"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{l:Tr Toolbar.Compile}" Style="{StaticResource Glass.Heading}"/>
                      <Border Style="{StaticResource Glass.Chip}" HorizontalAlignment="Right" Background="{DynamicResource Ui.WarningSoft}">
                        <TextBlock Text="{Binding ElementName=Root, Path=Tag.CompileState}" Foreground="{DynamicResource Ui.Orange}"/>
                      </Border>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ElementName=Root, Path=Tag.Errors}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Glass.Errors}" Style="{StaticResource Glass.Muted}" FontSize="12" Margin="4,0,12,0"/>
                        <TextBlock Text="{Binding ElementName=Root, Path=Tag.Warnings}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Glass.Warnings}" Style="{StaticResource Glass.Muted}" FontSize="12" Margin="4,0,0,0"/>
                      </StackPanel>
                      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
                        <ItemsControl ItemsSource="{Binding ElementName=Root, Path=Tag.Diagnostics}" Margin="0,0,0,-8">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border CornerRadius="10" Background="{DynamicResource Ui.PanelBackground}" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                  <TextBlock Text="{Binding Name}" Style="{StaticResource Glass.Text}" FontSize="11" FontWeight="SemiBold"/>
                                  <TextBlock Text="{Binding Message}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="2">
                  <Border x:Name="InspectionCard" Style="{StaticResource Glass.Card}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{l:Tr Glass.Inspection}" Style="{StaticResource Glass.Heading}"/>
                      <TextBlock Text="{Binding ElementName=Root,Path=Tag.InspectionTime}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Row="1" Text="{Binding ElementName=Root, Path=Tag.InspectionSummary}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/>
                      <ItemsControl Grid.Row="2" ItemsSource="{Binding ElementName=Root, Path=Tag.Rules}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource Glass.Chip}" Background="{DynamicResource Ui.ControlBackground}" Margin="0,0,6,6">
                              <TextBlock Text="{Binding}" Foreground="{DynamicResource Ui.Label}"/>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="4">
                  <Border x:Name="BlocksLogCard" Style="{StaticResource Glass.Card}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{l:Tr Log.Title}" Foreground="{DynamicResource Ui.Label}" FontWeight="Bold"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:Tr Log.Copy}" Click="OnCopyLog" Style="{StaticResource Glass.Quiet}" Margin="0,0,10,0"/>
                        <Button Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Glass.Quiet}"/>
                      </StackPanel>
                      <glass:GlassLogView Grid.Row="1" LogText="{Binding Activity.Log}" Foreground="{DynamicResource Ui.LogText}"/>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Column="0" Visibility="{Binding IsVcTab, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="132"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="193"/>
                  <RowDefinition Height="14"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                  <Border x:Name="WorkspaceCard" Style="{StaticResource Glass.Card}">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <StackPanel>
                        <StackPanel Orientation="Horizontal">
                          <ComboBox ItemsSource="{Binding VersionControl.Workspaces}" SelectedItem="{Binding VersionControl.SelectedWorkspace}" Style="{StaticResource Glass.WorkspacePicker}" MinWidth="190" MaxWidth="360">
                            <ComboBox.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <Border Style="{StaticResource Glass.Chip}" Margin="10,0,0,0">
                            <TextBlock Text="TIA VCI"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ElementName=Root,Path=Tag.WorkspaceSummary}" Style="{StaticResource Glass.Mono}"/>
                      </StackPanel>
                      <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="{l:Tr Common.Reload}" Command="{Binding VersionControl.VcRefresh}" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
                        <Button Content="{l:Tr Glass.ReadStatus}" Command="{Binding VersionControl.VcStatus}" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
                        <Button Content="{l:Tr Glass.NewWorkspace}" Click="OnWorkspaceOptions" Style="{StaticResource Glass.Primary}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <Border x:Name="VciStatusCard" Style="{StaticResource Glass.Card}" Padding="20,14">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="28"/>
                          <RowDefinition Height="36"/>
                          <RowDefinition Height="36"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr Glass.Mapping}" Style="{StaticResource Glass.Heading}"/>
                        <TextBlock Text="{l:Tr Glass.WholeProject}" Style="{StaticResource Glass.Muted}" HorizontalAlignment="Right" FontSize="10"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ElementName=Root,Path=Tag.MappingSummary}">
                          <TextBlock Text="{Binding ElementName=Root,Path=Tag.Mapped}" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="{l:Tr Glass.Mapped}" Style="{StaticResource Glass.Muted}" Margin="3,0,12,0"/>
                          <TextBlock Text="{Binding ElementName=Root,Path=Tag.Unsupported}" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="{l:Tr Glass.Unsupported}" Style="{StaticResource Glass.Muted}" Margin="3,0,12,0"/>
                          <TextBlock Text="{Binding ElementName=Root,Path=Tag.Failed}" FontSize="16" FontWeight="Bold"/>
                          <TextBlock Text="{l:Tr Glass.Failed}" Style="{StaticResource Glass.Muted}" Margin="3,0,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                          <Button Content="{l:Tr Glass.PreviewMapping}" Command="{Binding VersionControl.VcMap}" Click="OnPreview" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
                          <Button Content="{l:Tr Glass.RunMapping}" Command="{Binding VersionControl.VcMap}" Click="OnRun" Style="{StaticResource Glass.Outline}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                  <Grid Grid.Column="0">
                    <Border x:Name="SyncCard" Style="{StaticResource Glass.Card}" Padding="20,14">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="30"/>
                          <RowDefinition Height="34"/>
                          <RowDefinition Height="58"/>
                          <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{l:Tr Glass.Sync}" Style="{StaticResource Glass.Heading}"/>
                        <TextBlock Text="{l:Tr Glass.NotGitPush}" Style="{StaticResource Glass.Muted}" FontSize="10" HorizontalAlignment="Right"/>
                        <Border Grid.Row="1" Background="{DynamicResource Ui.SegmentTrack}" CornerRadius="17" Padding="3">
                          <Grid x:Name="SyncStrip">
                            <Border x:Name="SyncThumb" Width="{Binding ActualWidth,ElementName=ToWorkspace}" HorizontalAlignment="Left" CornerRadius="14" Background="{DynamicResource Ui.Accent}" IsHitTestVisible="False">
                              <Border.RenderTransform>
                                <TranslateTransform/>
                              </Border.RenderTransform>
                            </Border>
                            <UniformGrid Columns="2">
                              <RadioButton x:Name="ToWorkspace" Content="{l:Tr Glass.ToWorkspace}" IsChecked="True" GroupName="SyncDirection" Style="{StaticResource Glass.Segment}"/>
                              <RadioButton x:Name="ToProject" Content="{l:Tr Glass.ToProject}" GroupName="SyncDirection" Style="{StaticResource Glass.Segment}"/>
                            </UniformGrid>
                          </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" Text="{Binding ElementName=Root, Path=Tag.SyncSummary}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                          <Button Content="{l:Tr Glass.PreviewSync}" Click="OnPreview" Margin="0,0,8,0" Style="{StaticResource Glass.SyncPreview}"/>
                          <Button Content="{l:Tr Glass.RunSync}" Click="OnRun" Style="{StaticResource Glass.SyncRun}"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
                <Grid Grid.Row="4">
                  <Border x:Name="MappedObjectsCard" Style="{StaticResource Glass.Card}" Padding="22,12">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="{l:Tr Glass.MappedObjects}" Style="{StaticResource Glass.Heading}"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox Content="{l:Tr Glass.All}" IsChecked="{Binding VersionControl.VcShowAll}" Click="OnMappedAll" ToolTip="{l:Tr Vc.ShowAll}" Style="{StaticResource Glass.Button}" Height="26" Padding="10,2" FontSize="10"/>
                        <Button Content="{Binding ElementName=Root,Path=Tag.DifferenceLabel}" ToolTip="{l:Tr Glass.Differ}" Tag="Unequal" Click="OnMappedFilter" Style="{StaticResource Glass.Button}" Foreground="{DynamicResource Ui.Orange}" Background="{DynamicResource Ui.WarningSoft}" Height="26" Padding="10,2" FontSize="10" Margin="6,0,0,0"/>
                        <Button Content="{Binding ElementName=Root,Path=Tag.MissingLabel}" ToolTip="{l:Tr Glass.Missing}" Tag="WorkspaceFileMissing" Click="OnMappedFilter" Style="{StaticResource Glass.Button}" Height="26" Padding="10,2" FontSize="10" Margin="6,0,0,0"/>
                      </StackPanel>
                      <Grid Grid.Row="1" Margin="12,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="1.4*"/>
                          <ColumnDefinition Width="1.6*"/>
                          <ColumnDefinition Width=".7*"/>
                          <ColumnDefinition Width=".9*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr Col.Object}" Grid.Column="0" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Glass.File}" Grid.Column="1" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Col.Format}" Grid.Column="2" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{l:Tr Col.State}" Grid.Column="3" Style="{StaticResource Glass.Muted}" FontSize="10" FontWeight="Bold"/>
                      </Grid>
                      <ListBox x:Name="MappedList" Grid.Row="2" ItemsSource="{Binding VersionControl.VcStatusItems}" SelectedItem="{Binding VersionControl.SelectedVcItem}" Style="{StaticResource Glass.List}">
                        <ListBox.ItemContainerStyle>
                          <Style TargetType="ListBoxItem" BasedOn="{StaticResource Glass.Row}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CompareState}" Value="Unequal">
                                <Setter Property="Background" Value="{DynamicResource Ui.WarningSoft}"/>
                              </DataTrigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width=".7*"/>
                                <ColumnDefinition Width=".9*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Name}" Style="{StaticResource Glass.Text}" FontWeight="SemiBold" Margin="0,0,12,0"/>
                              <TextBlock Grid.Column="1" Text="{Binding FilePath}" Style="{StaticResource Glass.Mono}" Margin="0,0,12,0" ToolTip="{Binding FilePath}"/>
                              <TextBlock Grid.Column="2" Text="{Binding FileFormat}" Style="{StaticResource Glass.Muted}" Margin="0,0,12,0"/>
                              <TextBlock Grid.Column="3">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock" BasedOn="{StaticResource Glass.Muted}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding CompareState}" Value="Unequal">
                                        <Setter Property="Foreground" Value="{DynamicResource Ui.Orange}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                                <TextBlock.Text>
                                  <MultiBinding Converter="{StaticResource Glass.Value}" ConverterParameter="compare">
                                    <Binding Path="CompareState"/>
                                    <Binding Source="{x:Static l:Loc.Current}" Path="Language"/>
                                  </MultiBinding>
                                </TextBlock.Text>
                              </TextBlock>
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <StackPanel Grid.Row="2" Margin="12,24" Visibility="{Binding VersionControl.HasVcItems, Converter={StaticResource NotBoolToVisibility}}">
                        <TextBlock Text="{l:Tr Vc.Empty.Title}" Style="{StaticResource Ui.Text.Heading}"/>
                        <TextBlock Text="{l:Tr Vc.Empty.Body}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>
              </Grid>
              <Grid Grid.Column="2" Visibility="{Binding IsVcTab, Converter={StaticResource BoolToVisibility}}">
                <Border x:Name="DiffCard" Style="{StaticResource Glass.Card}" TextElement.Foreground="{DynamicResource Ui.Label}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="30"/>
                      <RowDefinition Height="28"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Glass.LocalDiff}" Style="{StaticResource Glass.Heading}"/>
                    <Border Style="{StaticResource Glass.Chip}" Background="{DynamicResource Ui.ChipBackground}" HorizontalAlignment="Right">
                      <TextBlock Text="{l:Tr Glass.WorkingTree}" Foreground="{DynamicResource Ui.LogText}"/>
                    </Border>
                    <DockPanel Grid.Row="1">
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding ElementName=Root,Path=Tag.DiffAdded}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" Foreground="{DynamicResource Ui.Green}" Margin="8,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=Root,Path=Tag.DiffRemoved}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" Foreground="{DynamicResource Ui.Red}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock Text="{Binding VersionControl.VcDiffCaption}" Style="{StaticResource Glass.Mono}" Foreground="{DynamicResource Ui.SecondaryLabel}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Border Grid.Row="2" Background="{DynamicResource Ui.InsetBackground}" CornerRadius="10" Padding="14,12" Margin="0,4,0,14">
                      <Grid>
                        <TextBlock Text="{l:Tr Vc.Diff.Empty}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" VerticalAlignment="Top" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource NotBoolToVisibility}}"/>
                        <ListBox ItemsSource="{Binding VersionControl.VcDiffLines}" Style="{StaticResource Glass.List}" ScrollViewer.HorizontalScrollBarVisibility="Auto" Visibility="{Binding VersionControl.HasVcDiff, Converter={StaticResource BoolToVisibility}}">
                          <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                              <Setter Property="Padding" Value="0"/>
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </ListBox.ItemContainerStyle>
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Text}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="10.5" LineHeight="17">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Ui.SecondaryLabel}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Kind}" Value="Added">
                                        <Setter Property="Foreground" Value="{DynamicResource Ui.Green}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                        <Setter Property="Foreground" Value="{DynamicResource Ui.Red}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                      </Grid>
                    </Border>
                    <StackPanel Grid.Row="3">
                      <ItemsControl ItemsSource="{Binding ElementName=Root,Path=Tag.OtherMappedFiles}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Content="{Binding FilePath}" Tag="{Binding}" Click="OnMappedFile" ToolTip="{l:Tr Glass.InspectFile}" Style="{StaticResource Glass.Quiet}" Foreground="{DynamicResource Ui.SecondaryLabel}" HorizontalContentAlignment="Left" Height="22"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Text="{l:Tr Glass.DiffScope}" Style="{StaticResource Glass.Muted}" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" FontSize="10.5"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <Grid Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding IsLogTab, Converter={StaticResource BoolToVisibility}}">
                <Border x:Name="LogCard" Style="{StaticResource Glass.Card}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="28"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{l:Tr Log.Title}" Foreground="{DynamicResource Ui.Label}" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <Button Content="{l:Tr Log.Copy}" Click="OnCopyLog" Style="{StaticResource Glass.Quiet}" Margin="0,0,10,0"/>
                      <Button Content="{l:Tr Log.Clear}" Click="OnClearLog" Style="{StaticResource Glass.Quiet}"/>
                    </StackPanel>
                    <glass:GlassLogView Grid.Row="1" LogText="{Binding Activity.Log}" Foreground="{DynamicResource Ui.LogText}"/>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Grid>
          <Border x:Name="EmptyPage" Style="{StaticResource Glass.Card}" VerticalAlignment="Top" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="EmptyPageTitle" FontSize="18" FontWeight="Bold"/>
              <TextBlock x:Name="EmptyPageMessage" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Margin="0,20,0,12"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="OptionsOverlay" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
      <Border x:Name="OptionsPanel" Style="{StaticResource Glass.Card}" Background="{DynamicResource Ui.WindowBackground}" Padding="24">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="OptionsTitle" Style="{StaticResource Glass.Heading}"/>
          <Button Content="" Click="OnCloseOptions" Style="{StaticResource Glass.CaptionButton}" HorizontalAlignment="Right"/>
          <StackPanel Grid.Row="1">
            <StackPanel x:Name="ProjectOptions">
              <ComboBox x:Name="ReleasePicker" ItemsSource="{Binding Releases}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" SelectedValue="{Binding SelectedReleaseKey}" IsEnabled="{Binding CanSelectRelease}" Style="{StaticResource Glass.Combo}" Width="110" HorizontalAlignment="Left"/>
              <TextBlock Text="{l:Tr Project.Label}" Style="{StaticResource Glass.Muted}" Margin="0,8,0,6"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Common.Browse}" Click="OnBrowseProject" Style="{StaticResource Glass.Button}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding Session.ProjectPath,UpdateSourceTrigger=PropertyChanged}" Tag="{l:Tr Project.Placeholder}" Style="{StaticResource Glass.Field}"/>
              </DockPanel>
              <WrapPanel Margin="0,12">
                <CheckBox Content="{l:Tr Toolbar.Mock}" ToolTip="{l:Tr Toolbar.Mock.Tip}" IsChecked="{Binding Session.UseMock}" Style="{StaticResource Glass.Check}" Margin="0,0,20,0"/>
                <CheckBox Content="{l:Tr Toolbar.Headless}" ToolTip="{l:Tr Toolbar.Headless.Tip}" IsChecked="{Binding Session.Headless}" Style="{StaticResource Glass.Check}"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <Button Content="{l:Tr Common.Reload}" Command="{Binding Engineering.Refresh}" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Toolbar.Doctor}" ToolTip="{l:Tr Toolbar.Doctor.Tip}" Command="{Binding Session.RunDoctor}" Style="{StaticResource Glass.Button}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Toolbar.Connect}" ToolTip="{l:Tr Toolbar.Connect.Tip}" Command="{Binding Session.Connect}" Style="{StaticResource Glass.Primary}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Common.Open}" Command="{Binding Session.OpenProject}" Style="{StaticResource Glass.Primary}"/>
              </StackPanel>
              <TextBlock Text="{l:Tr Sidebar.Devices}" Style="{StaticResource Glass.Heading}" Margin="0,20,0,8"/>
              <TextBlock Text="{l:Tr Sidebar.Empty}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Visibility="{Binding Engineering.HasDevices,Converter={StaticResource NotBoolToVisibility}}"/>
              <TreeView ItemsSource="{Binding Engineering.DeviceTree}" SelectedItemChanged="OnDeviceSelected" MaxHeight="200" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource Ui.DeviceNodeTemplate}"/>
            </StackPanel>
            <StackPanel x:Name="ExportOptions">
              <TextBlock Text="{l:Tr Blocks.ExportTo}" Style="{StaticResource Glass.Muted}" Margin="0,8,0,6"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Common.Browse}" Click="OnBrowseOutput" Style="{StaticResource Glass.Button}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding Engineering.OutputDirectory,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Glass.Field}"/>
              </DockPanel>
              <CheckBox Content="{l:Tr Blocks.SourceFormat}" ToolTip="{l:Tr Blocks.SourceFormat.Tip}" IsChecked="{Binding Engineering.SourceFormat}" Style="{StaticResource Glass.Check}" Margin="0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button Content="{l:Tr Blocks.Export}" Command="{Binding Engineering.Export}" Style="{StaticResource Glass.Primary}" Margin="0,0,8,0"/>
                <Button Content="{l:Tr Toolbar.Import}" Command="{Binding Engineering.Import}" Style="{StaticResource Glass.Button}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel x:Name="InspectOptions">
              <TextBlock Text="{l:Tr Glass.NamingPattern}" Style="{StaticResource Glass.Muted}" Margin="0,8,0,6"/>
              <TextBox Text="{Binding Engineering.NamePattern,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Glass.Field}"/>
              <Button Content="{l:Tr Toolbar.Inspect}" Command="{Binding Engineering.Inspect}" Style="{StaticResource Glass.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel x:Name="WorkspaceOptions">
              <TextBlock Text="{l:Tr Vc.New}" Style="{StaticResource Glass.Muted}" Margin="0,8,0,6"/>
              <TextBox Text="{Binding VersionControl.NewWorkspaceName,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Glass.Field}"/>
              <TextBlock Text="{l:Tr Vc.In}" Style="{StaticResource Glass.Muted}" Margin="0,12,0,6"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Common.Browse}" Click="OnBrowseWorkspace" Style="{StaticResource Glass.Button}" Margin="8,0,0,0"/>
                <TextBox Text="{Binding VersionControl.NewWorkspaceFolder,UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:Tr Vc.Folder.Tip}" Style="{StaticResource Glass.Field}"/>
              </DockPanel>
              <Button Content="{l:Tr Vc.Create}" Command="{Binding VersionControl.VcCreate}" Style="{StaticResource Glass.Primary}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel>
            <TextBlock Text="{Binding Activity.Status}" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border VerticalAlignment="Bottom" Margin="246,0,360,20" CornerRadius="10" Background="{DynamicResource Ui.WindowBackground}" Padding="12,8" Visibility="{Binding Busy,Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{Binding Activity.Status}" Style="{StaticResource Glass.Muted}"/>
        <ProgressBar Height="3" Margin="0,6,0,0" Maximum="{Binding Activity.ProgressMax}" Value="{Binding Activity.ProgressValue,Mode=OneWay}"/>
      </StackPanel>
    </Border>
    <Grid x:Name="DrawerOverlay" Margin="0,40,0,0" Visibility="Collapsed">
      <Border Background="{DynamicResource Ui.Overlay}" MouseLeftButtonDown="OnDrawerBackdrop"/>
      <Border x:Name="DrawerPanel" Width="400" Margin="0,8,12,12" HorizontalAlignment="Right" Background="{DynamicResource Ui.MenuBackground}" BorderBrush="{DynamicResource Ui.HairLine}" BorderThickness="1" CornerRadius="16" Effect="{DynamicResource Glass.DrawerShadow}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border BorderBrush="{DynamicResource Ui.Separator}" BorderThickness="0,0,0,1" Padding="22,0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="" Style="{StaticResource Glass.CaptionButton}" Click="OnCloseDrawer"/>
              <TextBlock x:Name="DrawerTitle" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <views:SettingsView x:Name="SettingsContent" Grid.Row="1"/>
          <Border x:Name="ApprovalsContent" Grid.Row="1" Margin="22,14,22,22" Padding="16,24" Background="{DynamicResource Ui.ControlBackground}" CornerRadius="12" VerticalAlignment="Top" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="{l:Tr Shell.NoPending}" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock Text="{l:Tr Shell.NoPendingDescription}" Style="{StaticResource Glass.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="{DynamicResource Ui.DialogOverlay}">
      <Border Width="420" VerticalAlignment="Center" Background="{DynamicResource Ui.MenuBackground}" BorderBrush="{DynamicResource Ui.HairLine}" BorderThickness="1" CornerRadius="16" Padding="24,22" Effect="{DynamicResource Glass.DrawerShadow}">
        <StackPanel>
          <TextBlock Text="{l:Tr Settings.ConfirmOffTitle}" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="{l:Tr Settings.ConfirmOffDescription}" FontSize="12.5" Foreground="{DynamicResource Ui.SecondaryLabel}" TextWrapping="Wrap" Margin="0,12,0,18"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelApprovalOff" Content="{l:Tr Shell.Cancel}" Style="{StaticResource Glass.Button}" Click="OnCancelApprovalOff" Margin="0,0,8,0"/>
            <Button x:Name="ConfirmApprovalOff" Content="{l:Tr Settings.TurnOff}" Style="{StaticResource Glass.Button}" Background="{DynamicResource Ui.Orange}" Foreground="{DynamicResource Ui.OnWarning}" Click="OnConfirmApprovalOff"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border x:Name="Toast" Width="320" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Padding="14,12" Background="{DynamicResource Ui.MenuBackground}" BorderBrush="{DynamicResource Ui.HairLine}" BorderThickness="1" CornerRadius="14" Visibility="Collapsed" MouseLeftButtonDown="OnToastClick">
      <DockPanel>
        <Button Content="" DockPanel.Dock="Right" Style="{StaticResource Glass.CaptionButton}" Click="OnDismissToast"/>
        <Border Width="34" Height="34" Background="{DynamicResource Ui.WarningSoft}" CornerRadius="10" Margin="0,0,12,0">
          <TextBlock Text="!" Foreground="{DynamicResource Ui.Orange}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel>
          <TextBlock x:Name="ToastTitle" FontSize="12.5" FontWeight="Bold"/>
          <TextBlock x:Name="ToastMessage" Style="{StaticResource Glass.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
