<UserControl x:Class="TiaMcpConfigurator.ConfigurationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls"
    Foreground="{DynamicResource Primer.text}" FontFamily="{DynamicResource Ui.Font}"
    FontSize="{DynamicResource Ui.FontSize.Body}" UseLayoutRounding="True">
  <UserControl.Resources>
    <DataTemplate x:Key="Configuration.Release">
      <StackPanel>
        <TextBlock Text="{Binding DisplayName}" FontFamily="{DynamicResource Ui.FontMono}" HorizontalAlignment="Center"/>
        <TextBlock HorizontalAlignment="Center" FontSize="{DynamicResource Ui.FontSize.Caption}" Style="{StaticResource Primer.Muted}"
                   Text="{Binding Path=(AutomationProperties.HelpText),RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>
  <DockPanel AutomationProperties.Name="{l:Tr Config.Eyebrow}">
    <Border DockPanel.Dock="Top" Style="{StaticResource Primer.IdeBar}">
      <DockPanel LastChildFill="False">
        <TextBlock Text="{l:Tr Config.McpService}" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
        <Label x:Name="AccessibleLabel1" Content="{l:Tr Access.FieldConfigVersion}" Target="{Binding ElementName=Version}"
               Style="{StaticResource Primer.FormLabel}" Margin="16,0,4,0" VerticalAlignment="Center"/>
        <ComboBox x:Name="Version" AutomationProperties.Name="{l:Tr Config.Version}" AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel1}"
                  ItemContainerStyle="{StaticResource Primer.SelectItem}" DisplayMemberPath="DisplayName" SelectedValuePath="Key" VerticalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="GoClients" Content="{l:Tr Mcp.Clients}" AutomationProperties.Name="{l:Tr Mcp.Clients}"
                  Command="{x:Static ux:WorkbenchCommands.Navigate}" CommandParameter="Clients" Style="{StaticResource Primer.IdeToolButton}"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid x:Name="Panes" ux:ResponsiveLayout.Enabled="True" ux:ResponsiveLayout.ScrollWholePage="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <Border Style="{StaticResource Primer.Container}" Margin="0,0,0,12">
            <StackPanel>
              <ux:PageHeadPanel x:Name="ModeHead" Title="{Binding ElementName=ModeTitle}">
                <TextBlock x:Name="ModeTitle" Text="{l:Tr Config.Transport}" Style="{StaticResource Primer.ContainerTitle}" VerticalAlignment="Center"/>
                <UniformGrid Columns="2">
                  <RadioButton x:Name="LocalNav" GroupName="Transport" AutomationProperties.Name="{l:Tr Config.LocalMode}" Style="{StaticResource Primer.Tile}"
                               Margin="0,0,4,0" ToolTip="{l:Tr Config.LocalTitle}">
                    <StackPanel><TextBlock Text="{l:Tr Config.LocalMode}"/><TextBlock Text="stdio" Style="{StaticResource Primer.Mono}"/></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="RemoteNav" GroupName="Transport" IsChecked="True" AutomationProperties.Name="{l:Tr Config.RemoteMode}"
                               Style="{StaticResource Primer.Tile}" Margin="4,0,0,0" ToolTip="{l:Tr Config.RemoteTitle}">
                    <StackPanel><TextBlock Text="{l:Tr Config.RemoteMode}"/><TextBlock Text="HTTP" Style="{StaticResource Primer.Mono}"/></StackPanel>
                  </RadioButton>
                </UniformGrid>
              </ux:PageHeadPanel>
              <TextBlock x:Name="PageSubtitle" Margin="0,8,0,0" Style="{StaticResource Primer.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
            </StackPanel>
          </Border>
          <Border x:Name="InstallationCard" Style="{StaticResource Primer.Container}">
            <StackPanel>
              <DockPanel>
                <ContentControl x:Name="DetectionChip" DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}">
                  <TextBlock x:Name="DetectionSource" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
                <TextBlock Text="{l:Tr Config.Installation}" Style="{StaticResource Primer.ContainerTitle}" TextWrapping="Wrap" TextTrimming="None"/>
              </DockPanel>
              <UniformGrid x:Name="ReleaseTiles" Columns="4" Margin="-2,8,-2,8" IsEnabled="{Binding IsEnabled,ElementName=Version}"
                           AutomationProperties.Name="{l:Tr Config.Version}"/>
              <Label x:Name="AccessibleLabel2" Content="{l:Tr Access.FieldConfigInstallPath}" Target="{Binding ElementName=TiaPath}"
                     Style="{StaticResource Primer.FormLabel}" AutomationProperties.Name="{l:Tr Config.InstallPath}"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="DetectTia" Content="{l:Tr Config.AutoDetect}" AutomationProperties.Name="{l:Tr Config.AutoDetect}"
                        Style="{StaticResource Primer.FormAction}" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" x:Name="BrowseTia" Content="{l:Tr Config.Browse}" AutomationProperties.Name="{l:Tr Config.Browse}"
                        Style="{StaticResource Primer.FormAction}" Margin="8,0,0,0"/>
                <TextBox x:Name="TiaPath" AutomationProperties.Name="{l:Tr Config.InstallPath}" AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel2}"
                         Style="{StaticResource Primer.MonoInput}" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
              </DockPanel>
            </StackPanel>
          </Border>
          <Border x:Name="ServerPane" Style="{StaticResource Primer.Container}" Margin="0,16,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="24"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto" MinHeight="52"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto" MinHeight="30"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <ContentControl x:Name="ServiceStateChip" DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}">
                  <TextBlock x:Name="ServiceStatusText" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
                <TextBlock Text="{l:Tr Config.HttpService}" Style="{StaticResource Primer.ContainerTitle}" TextWrapping="Wrap" TextTrimming="None"/>
              </DockPanel>
              <Grid x:Name="AddressRow" Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="Auto" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=ServerAddress}" x:Name="AccessibleLabel3" Content="{l:Tr Access.FieldConfigIpv4}" Target="{Binding ElementName=ServerAddress}" Style="{StaticResource Primer.FormLabel}"/>
                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel3}" AutomationProperties.Name="{l:Tr Config.Ipv4}" x:Name="ServerAddress" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.MonoInput}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <StackPanel><Label AutomationProperties.Name="{Binding Path=(AutomationProperties.Name),ElementName=ServerPort}" x:Name="AccessibleLabel4" Content="{l:Tr Access.FieldConfigPort}" Target="{Binding ElementName=ServerPort}" Style="{StaticResource Primer.FormLabel}"/>
                    <TextBox AutomationProperties.LabeledBy="{Binding ElementName=AccessibleLabel4}" AutomationProperties.Name="{l:Tr Config.Port}" x:Name="ServerPort" Text="8765" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.MonoInput}"/></StackPanel>
                </StackPanel>
              </Grid>
              <Grid x:Name="ServerActions" Grid.Row="4">
                <WrapPanel>
                  <Button x:Name="TestClient" Content="{l:Tr Pages.TestConnection}" AutomationProperties.Name="{l:Tr Pages.TestConnection}"
                          Style="{StaticResource Primer.FormAction}" Margin="0,0,8,0"/>
                  <Button AutomationProperties.Name="{l:Tr Config.Network}" x:Name="Network" Content="{l:Tr Config.Network}" Style="{StaticResource Primer.FormAction}" Margin="0,0,8,0"/>
                  <Grid>
                    <Button AutomationProperties.Name="{l:Tr Config.Start}" x:Name="StartServer" Content="{l:Tr Config.Start}" Style="{StaticResource Primer.FormRun}"/>
                    <Button AutomationProperties.Name="{l:Tr Config.Stop}" x:Name="StopServer" Content="{l:Tr Config.Stop}" Style="{StaticResource Primer.FormAction}" IsEnabled="False" Visibility="Collapsed"/>
                  </Grid>
                </WrapPanel>
              </Grid>
            </Grid>
          </Border>
          <Button x:Name="SaveBoth" Content="{l:Tr Pages.SaveBoth}" AutomationProperties.Name="{l:Tr Pages.SaveBoth}" Margin="0,8,0,0"
                  HorizontalAlignment="Left" Style="{StaticResource Primer.Secondary}" IsDefault="True"/>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel>
            <DockPanel Margin="0,0,0,8">
              <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding Tag,ElementName=ServiceStateChip}">
                <TextBlock x:Name="LinkState" Style="{StaticResource Primer.StatusText}"/>
              </ContentControl>
              <TextBlock Text="{l:Tr Config.Summary}" Style="{StaticResource Primer.SectionLabel}"/>
            </DockPanel>
            <Border x:Name="SummaryCard" Style="{StaticResource Primer.TableContainer}">
              <Border.ToolTip>
                <TextBlock x:Name="Status"/>
              </Border.ToolTip>
              <StackPanel>
                <Border Style="{StaticResource Primer.ListRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Mcp.Clients}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock x:Name="LinkClient" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Primer.ListRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Config.Service}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock x:Name="LinkServer" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Primer.ListRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Config.Address}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock x:Name="LinkEndpoint" Grid.Column="1" Style="{StaticResource Primer.ListMonoValue}" Margin="8,0,0,0"><Run
                        x:Name="EndpointScheme"/><Run x:Name="EndpointAddress"/><Run x:Name="EndpointPath"/></TextBlock>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Primer.ListRow}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:Tr Config.Transport}" Style="{StaticResource Primer.Muted}"/>
                    <TextBlock x:Name="Transport" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Primer.Note}" Margin="0,12,0,0">
              <TextBlock x:Name="LastTest" FontSize="{DynamicResource Ui.FontSize.Caption}" Style="{StaticResource Primer.Text.text}"/>
            </Border>
            <DockPanel Margin="0,12,0,6">
              <Button x:Name="RefreshHosts" DockPanel.Dock="Right" Content="{l:Tr Hosts.Refresh}" AutomationProperties.Name="{l:Tr Hosts.Refresh}" Style="{StaticResource Primer.Quiet}"/>
              <TextBlock Text="{l:Tr Hosts.Title}" Style="{StaticResource Primer.SectionLabel}"/>
            </DockPanel>
            <ListBox x:Name="HostList" MinHeight="36" Style="{StaticResource Primer.List}" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{l:Tr Hosts.Title}">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="HostDetail" Text="{l:Tr Hosts.Hint}" TextWrapping="Wrap" Style="{StaticResource Primer.Muted}" Margin="0,6,0,6"/>
            <WrapPanel>
              <Button x:Name="RestartHost" Content="{l:Tr Hosts.Restart}" AutomationProperties.Name="{l:Tr Hosts.Restart}" IsEnabled="False" Style="{StaticResource Primer.Secondary}" Margin="0,0,8,0"/>
              <Button x:Name="StopHost" Content="{l:Tr Hosts.Stop}" AutomationProperties.Name="{l:Tr Hosts.Stop}" IsEnabled="False" Style="{StaticResource Primer.Secondary}"/>
            </WrapPanel>
          </StackPanel>
          <Expander x:Name="ConfigurationActivity" AutomationProperties.Name="{l:Tr Mcp.ActivityLog}" Header="{l:Tr Mcp.ActivityLog}" Style="{StaticResource Primer.Expander}" Margin="0,16,0,0">
            <Grid Height="240">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="24"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <Button AutomationProperties.Name="{l:Tr Primer.Clear}" x:Name="ClearLog" Content="{l:Tr Primer.Clear}" DockPanel.Dock="Right" Style="{StaticResource Primer.Quiet}" Margin="12,0,0,0"/>
                <TextBlock x:Name="LogCount" DockPanel.Dock="Right" Style="{StaticResource Primer.Muted}" FontSize="{DynamicResource Ui.FontSize.Caption}"/>
                <TextBlock Text="{l:Tr Mcp.ActivityLog}" Style="{StaticResource Primer.SectionLabel}"/>
              </DockPanel>
              <Border x:Name="ConfigurationLogCard" Grid.Row="2" Style="{StaticResource Primer.TableContainer}">
                <ux:WorkbenchLogView AutomationProperties.Name="{l:Tr Mcp.ActivityLog}" x:Name="ActivityLog" Style="{StaticResource Primer.LogDocument}"/>
              </Border>
            </Grid>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
