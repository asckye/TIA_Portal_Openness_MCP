<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:TiaOpenness.Gui.Localization" xmlns:ux="clr-namespace:TiaOpenness.Gui.Controls" xmlns:controls="clr-namespace:TiaOpenness.Gui.Controls" x:Class="TiaMcpConfigurator.ConfigurationView" Foreground="{DynamicResource Primer.text}" FontFamily="{DynamicResource Ui.Font}" FontSize="12" UseLayoutRounding="True">
  <Grid x:Name="Panes">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="20"/>
      <ColumnDefinition Width="300"/>
    </Grid.ColumnDefinitions>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="166"/>
        <RowDefinition Height="14"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0">
          <ux:TrackedTextBlock Tracking="0.14" x:Name="PageStep" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" Foreground="{DynamicResource Primer.accent}" Visibility="Collapsed"/>
          <ux:TrackedTextBlock Tracking="-0.02" x:Name="PageTitle" Height="26" LineHeight="29" LineStackingStrategy="BlockLineHeight" FontSize="20" FontWeight="SemiBold" Margin="0"/>
          <TextBlock x:Name="PageSubtitle" Height="18" LineHeight="18" LineStackingStrategy="BlockLineHeight" FontSize="13" Margin="0,3,0,0" Style="{StaticResource Primer.Text.textMuted}"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Primer.SegmentGroup}">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="RemoteNav" Style="{StaticResource Primer.Segment}" IsChecked="True" Content="{l:Tr Config.RemoteMode}" ToolTip="{l:Tr Config.RemoteNote}"/>
            <RadioButton x:Name="LocalNav" Style="{StaticResource Primer.Segment}" Content="{l:Tr Config.LocalMode}" ToolTip="{l:Tr Config.LocalNote}"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Style="{StaticResource Primer.TableContainer}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="InstallationCard" Style="{StaticResource Primer.InstallationHalf}" Grid.Column="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <ContentControl x:Name="DetectionChip" DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}">
                  <TextBlock x:Name="DetectionSource" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
                <TextBlock Text="{l:Tr Config.Installation}" Style="{StaticResource Primer.ContainerTitle}"/>
              </DockPanel>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Tr Config.Version}" Style="{StaticResource Primer.InputLabel}" Margin="0,0,0,4"/>
                  <ComboBox x:Name="Version" Tag="FilledTriangle" ItemContainerStyle="{StaticResource Primer.SelectItem}" DisplayMemberPath="DisplayName" SelectedValuePath="Key"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Tr Config.InstallPath}" Style="{StaticResource Primer.InputLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="TiaPath" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Style="{StaticResource Primer.MonoInput}"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="4" Orientation="Horizontal">
                <Button x:Name="BrowseTia" Content="{l:Tr Config.Browse}" Margin="0,0,8,0" Style="{StaticResource Primer.Secondary}"/>
                <Button x:Name="DetectTia" Content="{l:Tr Config.AutoDetect}" Style="{StaticResource Primer.Secondary}"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border x:Name="ServerPane" Grid.Column="1" Style="{StaticResource Primer.ServerHalf}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="24"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="52"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
              </Grid.RowDefinitions>
              <DockPanel>
                <ContentControl x:Name="ServiceStateChip" DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}">
                  <TextBlock x:Name="ServiceStatusText" Style="{StaticResource Primer.StatusText}"/>
                </ContentControl>
                <TextBlock Text="{l:Tr Config.HttpService}" Style="{StaticResource Primer.ContainerTitle}"/>
              </DockPanel>
              <Grid x:Name="AddressRow" Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="{l:Tr Config.Ipv4}" Style="{StaticResource Primer.InputLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ServerAddress" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.MonoInput}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{l:Tr Config.Port}" Style="{StaticResource Primer.InputLabel}" Margin="0,0,0,4"/>
                  <TextBox x:Name="ServerPort" Text="8765" FontFamily="{DynamicResource Ui.FontMono}" Style="{StaticResource Primer.MonoInput}"/>
                </StackPanel>
              </Grid>
              <Grid x:Name="ServerActions" Grid.Row="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="Network" Content="{l:Tr Config.Network}" Style="{StaticResource Primer.Secondary}"/>
                <Grid Grid.Column="2">
                  <Button x:Name="StartServer" Content="{l:Tr Config.Start}" Style="{StaticResource Primer.Run}"/>
                  <Button x:Name="StopServer" Content="{l:Tr Config.Stop}" Style="{StaticResource Primer.Secondary}" IsEnabled="False" Visibility="Collapsed"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border x:Name="ClientPane" Grid.Row="4" Style="{StaticResource Primer.TableContainer}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Style="{StaticResource Primer.HeaderStrip}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <DockPanel>
                <TextBlock Text="{l:Tr Mcp.Clients}" Style="{StaticResource Primer.ContainerTitle}" Margin="0,0,4,0"/>
                <TextBlock x:Name="ClientSelection" Style="{StaticResource Primer.Muted}" FontSize="12" Cursor="Hand"/>
              </DockPanel>
              <TextBlock Grid.Column="1" Text="{l:Tr Mcp.ClientsNote}" Style="{StaticResource Primer.Muted}" FontSize="10.5"/>
            </Grid>
          </Border>
          <ListBox x:Name="ClientChoices" Grid.Row="1" Style="{StaticResource Primer.List}" SelectionMode="Multiple" ItemContainerStyle="{StaticResource Primer.ClientRow}" ItemTemplate="{StaticResource Primer.ClientContent}" Margin="0" Padding="0" VerticalAlignment="Top">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3"/>
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
          </ListBox>
          <Border x:Name="SecretBand" Grid.Row="2" Style="{StaticResource Primer.FooterStrip}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="32"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Mcp.SecretTitle}" Style="{StaticResource Primer.InputLabel}" Margin="0,0,12,0"/>
                <Grid x:Name="SecretField" Grid.Column="1" ToolTip="{l:Tr Mcp.SecretNote}">
                  <PasswordBox x:Name="Key" Style="{StaticResource Primer.SecretInput}"/>
                  <TextBox x:Name="KeyVisible" FontFamily="{DynamicResource Ui.FontMono}" Visibility="Collapsed" Style="{StaticResource Primer.MonoInput}"/>
                  <TextBlock x:Name="KeyPlaceholder" Text="{l:Tr Mcp.NoSecret}" FontFamily="{DynamicResource Ui.FontMono}" FontSize="11" Margin="12,0" IsHitTestVisible="False" Style="{StaticResource Primer.Text.textFaint}"/>
                </Grid>
                <Button x:Name="GenerateKey" Grid.Column="2" Content="{l:Tr Config.Generate}" Margin="8,0,0,0" Style="{StaticResource Primer.Secondary}"/>
                <CheckBox x:Name="ShowKey" Grid.Column="3" Content="{l:Tr Config.Show}" Style="{StaticResource Primer.Secondary}" Margin="8,0,0,0"/>
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SaveBoth" Content="{l:Tr Config.SaveBoth}" Style="{StaticResource Primer.Secondary}"/>
                <TextBlock x:Name="WriteTargets" Grid.Column="1" Style="{StaticResource Primer.Muted}" Margin="12,0" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}"/>
                <Button x:Name="TestClient" Grid.Column="2" Content="{l:Tr Config.Test}" Style="{StaticResource Primer.OutlinedAccent}"/>
                <Button x:Name="SaveClient" Grid.Column="3" Content="{l:Tr Config.Write}" ToolTip="{l:Tr Config.Write}" Margin="8,0,0,0" Style="{StaticResource Primer.Primary}"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="20"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <ContentControl DockPanel.Dock="Right" Style="{StaticResource Primer.StatusChip}" Tag="{Binding Tag,ElementName=ServiceStateChip}">
            <TextBlock x:Name="LinkState" Style="{StaticResource Primer.StatusText}"/>
          </ContentControl>
          <TextBlock Text="{l:Tr Config.Summary}" Style="{StaticResource Primer.SectionLabel}"/>
        </DockPanel>
        <Border x:Name="SummaryCard" Style="{StaticResource Primer.TableContainer}">
          <Border.ToolTip>
            <TextBlock x:Name="Status"/>
          </Border.ToolTip>
          <StackPanel>
            <Border Style="{StaticResource Primer.ListRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Mcp.Clients}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock x:Name="LinkClient" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Primer.ListRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Config.Service}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock x:Name="LinkServer" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Primer.ListRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Config.Address}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock x:Name="LinkEndpoint" Grid.Column="1" Style="{StaticResource Primer.ListMonoValue}" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Primer.ListRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr Config.Transport}" Style="{StaticResource Primer.Muted}"/>
                <TextBlock x:Name="Transport" Grid.Column="1" Style="{StaticResource Primer.ListValue}" Margin="8,0,0,0"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Primer.Note}" Margin="0,12,0,0">
          <TextBlock x:Name="LastTest" FontSize="11" Style="{StaticResource Primer.Text.text}"/>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="24"/>
          <RowDefinition Height="8"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="ClearLog" Content="{l:Tr Primer.Clear}" DockPanel.Dock="Right" Style="{StaticResource Primer.Quiet}" Margin="12,0,0,0"/>
          <TextBlock x:Name="LogCount" DockPanel.Dock="Right" Style="{StaticResource Primer.Muted}" FontSize="10.5"/>
          <TextBlock Text="{l:Tr Mcp.ActivityLog}" Style="{StaticResource Primer.SectionLabel}"/>
        </DockPanel>
        <Border x:Name="ConfigurationLogCard" Grid.Row="2" Style="{StaticResource Primer.TableContainer}">
          <controls:WorkbenchLogView x:Name="ActivityLog" Style="{StaticResource Primer.LogDocument}"/>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
