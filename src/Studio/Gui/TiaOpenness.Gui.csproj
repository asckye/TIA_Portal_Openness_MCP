<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TiaOpenness</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Published apphosts look for the bundled runtime/dotnet first (scripts/build/bundled-dotnet.json), then an installed .NET. -->
    <AppHostRelativeDotNet>../dotnet</AppHostRelativeDotNet>
    <AppHostDotNetSearch>AppRelative;EnvironmentVariable;Global</AppHostDotNetSearch>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Client/TiaOpenness.Client.csproj" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../Bridge/TiaOpenness.Bridge.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/OpennessEnvironment.cs" Link="Configuration/OpennessEnvironment.cs" />
    <Compile Include="../../Shared/BundleLayout.cs" Link="Configuration/BundleLayout.cs" />
    <Compile Include="../../Shared/DataLocations.cs" Link="Configuration/DataLocations.cs" />
    <Resource Include="Fonts/*.ttf"/>
    <Content Include="Fonts/*OFL.txt" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="CopyNativeBridge" AfterTargets="Build">
    <ItemGroup><BridgePayload Include="../Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.exe;../Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.dll;../Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.config" /></ItemGroup>
    <Copy SourceFiles="@(BridgePayload)" DestinationFolder="$(TargetDir)bridge" SkipUnchangedFiles="true" />
    <Delete Files="$(TargetDir)bridge/Newtonsoft.Json.dll" Condition="!Exists('../Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/Newtonsoft.Json.dll')" />
  </Target>
</Project>
