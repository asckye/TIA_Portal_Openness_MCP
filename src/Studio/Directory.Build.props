<Project>
  <Import Project="$(MSBuildThisFileDirectory)../../Version.props" />
  <Import Project="$(MSBuildThisFileDirectory)../Shared/TiaSharedAdapterPaths.props" />
  <PropertyGroup Condition="'$(TiaSharedAdapterPaths)' == 'true'">
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <StudioOutputSubdirectory>shared-adapter/</StudioOutputSubdirectory>
    <OutputPath>bin/$(Configuration)/$(StudioOutputSubdirectory)</OutputPath>
    <BaseIntermediateOutputPath>obj/$(StudioOutputSubdirectory)</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <DefineConstants Condition="'$(MSBuildProjectName)' == 'TiaOpenness.Core' Or '$(MSBuildProjectName)' == 'TiaOpenness.Client' Or $([System.String]::Copy('$(MSBuildProjectName)').StartsWith('TiaOpenness.Gui'))">$(DefineConstants);TIA_BUNDLE_LAYOUT_STUDIO</DefineConstants>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>true</NuGetAudit>
  </PropertyGroup>
</Project>
