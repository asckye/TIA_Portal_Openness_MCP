<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../Version.props" />
  <PropertyGroup>
    <RootNamespace>TiaMcp.OnlineChannels</RootNamespace>
    <AssemblyName>TiaMcp.Runtime</AssemblyName>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Simulation/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Preserve the engine dependency version when resolving the OPC UA client independently. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Sharp7" />
    <PackageReference Include="Workstation.UaClient" />
    <PackageReference Include="Siemens.Simatic.S7.Webserver.API" />
    <ProjectReference Include="../Logic/TiaMcp.Logic.csproj" GlobalPropertiesToRemove="BaseIntermediateOutputPath;MSBuildProjectExtensionsPath" />
  </ItemGroup>
  <!-- The protocol clients run without Openness. The PLCSIM runtime loader belongs to the net48 worker. -->
  <Target Name="RejectEngineeringDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <ForbiddenRuntimeReference Include="@(ReferencePath)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^(?i:Siemens\.Engineering|Siemens\.Simatic\.Simulation|TiaMcpServer|ModelContextProtocol)'))" />
    </ItemGroup>
    <Error Condition="'@(ForbiddenRuntimeReference)' != ''" Text="TiaMcp.Runtime must not reference engineering or MCP assemblies: @(ForbiddenRuntimeReference)" />
  </Target>
</Project>
