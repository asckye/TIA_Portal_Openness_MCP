{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiamcp.org/standards/v1/common.schema.json",
  "title": "common",
  "$ref": "#/$defs/file",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:*?\"<>|\\x00-\\x1f])[^/]+(?:/[^/]+)*$"
    },
    "release": {
      "enum": [
        "14sp1",
        "15.1",
        "16",
        "17",
        "18",
        "19",
        "20",
        "21"
      ]
    },
    "semver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?:\\*|\\^[0-9]+(?:\\.[0-9]+){0,2}|(?:>=|>|<=|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:\\s+(?:>=|>|<=|<|=)[0-9]+(?:\\.[0-9]+){0,2})*)$"
    },
    "localized": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "additionalProperties": false
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "enum": [
        "project",
        "hardware",
        "network",
        "plcStructure",
        "plcTypes",
        "plcLibrary",
        "plcProgram",
        "plcTags",
        "alarms",
        "hmi",
        "compile",
        "save"
      ]
    },
    "parameterSchema": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/parameterSchema"
          },
          "maxProperties": 10000
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "minItems": 0,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/parameterSchema"
        },
        "enum": {
          "type": "array",
          "items": {},
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "default": {},
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "comment": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "type",
        "role"
      ],
      "additionalProperties": false
    },
    "packageReference": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:\\*|\\^[0-9]+(?:\\.[0-9]+){0,2}|(?:>=|>|<=|<|=)?[0-9]+(?:\\.[0-9]+){0,2}(?:\\s+(?:>=|>|<=|<|=)[0-9]+(?:\\.[0-9]+){0,2})*)$"
        }
      },
      "required": [
        "package",
        "version"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:*?\"<>|\\x00-\\x1f])[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ]
    },
    "expressionPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    }
  }
}
