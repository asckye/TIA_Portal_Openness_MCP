<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Shared/Xunit.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Library</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TestVciFamily Condition="'$(TestVciFamily)' == ''">modern</TestVciFamily>
    <DefineConstants Condition="'$(TestVciFamily)' == 'modern'">$(DefineConstants);STUDIO_VCI;STUDIO_VCI_MODERN</DefineConstants>
    <DefineConstants Condition="'$(TestVciFamily)' == 'initial'">$(DefineConstants);STUDIO_VCI;STUDIO_VCI_INITIAL</DefineConstants>
    <DefineConstants Condition="'$(TestVciFamily)' == 'classic'">$(DefineConstants);STUDIO_VCI</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Adapters/Native/Vci/VciFallbackAdapter.cs" Link="VciFallbackAdapter.cs" />
    <Compile Include="../../../src/Shared/NativePathSelection.cs" Link="Shared/NativePathSelection.cs" />
    <ProjectReference Include="../../../src/Logic/TiaMcp.Logic.csproj" />
    <ProjectReference Include="../../../src/Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" />
  </ItemGroup>
</Project>
