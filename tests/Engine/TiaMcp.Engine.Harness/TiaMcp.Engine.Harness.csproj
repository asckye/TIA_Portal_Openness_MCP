<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>TiaMcp.Engine.Harness</AssemblyName>
    <RootNamespace>TiaMcp.Engine.Harness</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../manifest/version-tools.json" LogicalName="VersionTools.json" />
  </ItemGroup>
  <ItemGroup><Reference Include="System.Web.Extensions" /></ItemGroup>
  <!-- Compile-only SDK/JSON types; runtime dependencies resolve beside the loaded EXE.
       Keep transitive build targets so net48 uses its inbox System.ValueTuple. -->
  <ItemGroup><PackageReference Include="ModelContextProtocol.Core" Version="0.3.0-preview.4" IncludeAssets="compile" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Text.Json" Version="10.0.0-preview.4.25258.110" IncludeAssets="compile;buildTransitive" /></ItemGroup>
  <ItemGroup><None Update="Golden/*.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Compile Include="../TiaMcp.Engine.Tests/HmiScreenTraversalTests.cs" Link="HmiScreenTraversalTests.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../TiaMcp.Engine.Tests/OfflineContractChecks.cs" Link="OfflineContractChecks.cs" /></ItemGroup>
  <Import Project="../../Shared/HostDomainBuild.targets" />
  <ItemGroup><ProjectReference Include="../../../src/Adapters.Contracts/TiaMcp.Adapters.Contracts.csproj" /></ItemGroup>
  <!-- The PLC harness entry reflects over the kept net48 Logic. Its build goes to plc-logic/ and is loaded
       only by that entry: Logic's dependencies (another Microsoft.Bcl.AsyncInterfaces) in the application
       base would replace the engine's own copies and stop engine types from loading. -->
  <ItemGroup>
    <ProjectReference Include="../../../src/Logic/TiaMcp.Logic.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" ExcludeAssets="all"
                      SetTargetFramework="TargetFramework=net48" />
  </ItemGroup>
  <Target Name="CopyPlcLogicBuild" AfterTargets="Build">
    <ItemGroup>
      <PlcLogicReference Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(Filename)' == 'TiaMcp.Logic'" />
    </ItemGroup>
    <MSBuild Projects="@(PlcLogicReference)" Targets="GetTargetPath"
             Properties="%(PlcLogicReference.SetConfiguration);%(PlcLogicReference.SetPlatform);%(PlcLogicReference.SetTargetFramework)"
             RemoveProperties="%(PlcLogicReference.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences)">
      <Output TaskParameter="TargetOutputs" ItemName="PlcLogicBinary" />
    </MSBuild>
    <Error Condition="'@(PlcLogicBinary->Count())' != '1' or !Exists('@(PlcLogicBinary)')" Text="The PLC harness entry requires the exact net48 Logic build: @(PlcLogicBinary)." />
    <ItemGroup><PlcLogicPayload Include="%(PlcLogicBinary.RootDir)%(PlcLogicBinary.Directory)*.dll" /></ItemGroup>
    <Copy SourceFiles="@(PlcLogicPayload)" DestinationFolder="$(TargetDir)plc-logic" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(TargetDir)plc-logic/TiaMcp.Logic.dll')" Text="The net48 Logic build was not copied to plc-logic." />
  </Target>
</Project>
