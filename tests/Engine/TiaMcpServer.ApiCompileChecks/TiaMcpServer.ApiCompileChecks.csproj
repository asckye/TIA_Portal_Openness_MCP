<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only library: no executable, no TIA initialization, no native tests. -->
  <PropertyGroup>
    <!-- A standalone/solution compile checks the current engine release; scripts select all eight. -->
    <TiaReleaseKey Condition="'$(TiaReleaseKey)' == ''">21</TiaReleaseKey>
    <TiaPublicApiReleaseKey>$(TiaReleaseKey)</TiaPublicApiReleaseKey>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../src/Shared/TiaPublicApi.props" />
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net48</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <UseReferenceAssemblyPackage Condition="'$(UseReferenceAssemblyPackage)' == ''">true</UseReferenceAssemblyPackage>
    <CoreApiName Condition="'$(TiaReleaseKey)' != '21'">Siemens.Engineering</CoreApiName>
    <CoreApiName Condition="'$(TiaReleaseKey)' == '21'">Siemens.Engineering.Base</CoreApiName>
    <ExpectedApiVersion>$(TiaReleaseKey).0.0.0</ExpectedApiVersion>
    <ExpectedApiVersion Condition="'$(TiaReleaseKey)' == '14sp1'">14.0.1.0</ExpectedApiVersion>
    <ExpectedApiVersion Condition="'$(TiaReleaseKey)' == '15.1'">15.1.0.0</ExpectedApiVersion>
    <ExpectedPublicKey>d29ec89bac048f84</ExpectedPublicKey>
    <ExpectedPublicKey Condition="'$(TiaReleaseKey)' == '21'">29bfe5fdf4ba5d3b</ExpectedPublicKey>
    <ExpectedTargetFramework>net48</ExpectedTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ApiCompileChecks.cs" />
    <Compile Include="../../../src/Engine/Siemens/OpennessReleaseContract.cs" Link="OpennessReleaseContract.cs" />
    <Compile Include="../../../src/Shared/NativePathSelection.cs" Link="Shared/NativePathSelection.cs" />
    <Compile Include="../../../src/Logic/Siemens/EngineeringAssemblyIdentity.cs" Link="EngineeringAssemblyIdentity.cs" />
    <Compile Include="../../../src/Logic/Siemens/TiaVersionCatalog.cs" Link="TiaVersionCatalog.cs" />
    <Reference Include="$(CoreApiName)"><HintPath>$(SiemensEngineeringDirectory)/$(CoreApiName).dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Siemens.Engineering.Step7" Condition="'$(TiaReleaseKey)' == '21'"><HintPath>$(SiemensEngineeringDirectory)/Siemens.Engineering.Step7.dll</HintPath><Private>false</Private></Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48' and '$(UseReferenceAssemblyPackage)' == 'true'" />
  </ItemGroup>
  <Target Name="ValidateSelectedApi" BeforeTargets="ResolveReferences">
    <Error Condition="'$(TargetFramework)' != '$(ExpectedTargetFramework)'" Text="Do not substitute a different target framework for this API compile check." />
    <Error Condition="'$(TiaReleaseKey)' != '14sp1' and '$(TiaReleaseKey)' != '15.1' and '$(TiaReleaseKey)' != '16' and '$(TiaReleaseKey)' != '17' and '$(TiaReleaseKey)' != '18' and '$(TiaReleaseKey)' != '19' and '$(TiaReleaseKey)' != '20' and '$(TiaReleaseKey)' != '21'" Text="An exact supported TiaReleaseKey is required; V14/V15 are excluded." />
    <Error Condition="'$(SiemensEngineeringDirectory)' == '' or !Exists('$(SiemensEngineeringDirectory)/$(CoreApiName).dll')" Text="Select an explicit authorized PublicAPI directory containing the matching core assembly." />
    <GetAssemblyIdentity AssemblyFiles="$(SiemensEngineeringDirectory)/$(CoreApiName).dll"><Output TaskParameter="Assemblies" ItemName="SelectedCoreIdentity" /></GetAssemblyIdentity>
    <Error Condition="'%(SelectedCoreIdentity.Version)' != '$(ExpectedApiVersion)' or '%(SelectedCoreIdentity.PublicKeyToken)' != '$(ExpectedPublicKey)'" Text="Selected PublicAPI identity does not match $(TiaReleaseKey): @(SelectedCoreIdentity)" />
    <GetAssemblyIdentity AssemblyFiles="$(SiemensEngineeringDirectory)/Siemens.Engineering.Step7.dll" Condition="'$(TiaReleaseKey)' == '21'"><Output TaskParameter="Assemblies" ItemName="SelectedStep7Identity" /></GetAssemblyIdentity>
    <Error Condition="'$(TiaReleaseKey)' == '21' and ('%(SelectedStep7Identity.Version)' != '21.0.0.0' or '%(SelectedStep7Identity.PublicKeyToken)' != '29bfe5fdf4ba5d3b')" Text="V21 Step7 reference identity must match the selected Base module." />
    <Message Importance="high" Text="Compile-only API reference: @(SelectedCoreIdentity); target $(TargetFramework); directory $(SiemensEngineeringDirectory)" />
  </Target>
  <ItemGroup><Compile Include="../../../src/Shared/OpennessEnvironment.cs" Link="Shared/OpennessEnvironment.cs" /></ItemGroup>
</Project>
