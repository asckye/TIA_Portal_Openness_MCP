<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Shared/Xunit.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateProgramFile>true</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Logic/TiaMcp.Logic.csproj" />
    <None Update="Examples/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../templates/standards/tiamcp.basic/**/*" Link="BasicPackage/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
