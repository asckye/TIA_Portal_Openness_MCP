<Project>
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <Compile Include="$(MSBuildThisFileDirectory)CheckSuite.cs" Link="Shared/CheckSuite.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)CheckTheory.cs" Link="Shared/CheckTheory.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)XunitDefaults.cs" Link="Shared/XunitDefaults.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestPaths.cs" Link="Shared/TestPaths.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)ShardFramework.cs" Link="Shared/ShardFramework.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TimeSensitiveTests.cs" Link="Shared/TimeSensitiveTests.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestDeadlines.cs" Link="Shared/TestDeadlines.cs" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>TiaMcp.Engine.Tests.Shared.ShardFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
