<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable></PropertyGroup>
  <!-- The linked launcher has its own Main; retain the test SDK's entry point. -->
  <PropertyGroup><StartupObject>AutoGeneratedProgram</StartupObject></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Studio/Launcher/Launcher.cs" Link="Launcher.cs" />
    <Compile Include="../../Engine/TiaMcpServer.Tests/DataLocationsTests.cs" Link="DataLocationsTests.cs" />
    <ProjectReference Include="../../../src/Studio/Gui/TiaOpenness.Gui.csproj" />
    <ProjectReference Include="../../../src/Logic/TiaMcp.Logic.csproj" Aliases="PlcRendering" />
    <EmbeddedResource Include="../../../src/Studio/Gui/**/*.xaml;../../../src/Studio/Gui/**/*.cs"
      Exclude="../../../src/Studio/Gui/bin/**;../../../src/Studio/Gui/obj/**" LinkBase="Source" WithCulture="false" />
  </ItemGroup>
  <Target Name="CopyBridgeForFunctionalTests" AfterTargets="Build">
    <ItemGroup><BridgePayload Include="../../../src/Studio/Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.exe;../../../src/Studio/Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.dll;../../../src/Studio/Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/*.config" /></ItemGroup>
    <Copy SourceFiles="@(BridgePayload)" DestinationFolder="$(TargetDir)bridge" SkipUnchangedFiles="true" />
    <Delete Files="$(TargetDir)bridge/Newtonsoft.Json.dll" Condition="!Exists('../../../src/Studio/Bridge/bin/$(Configuration)/$(StudioOutputSubdirectory)net48/Newtonsoft.Json.dll')" />
  </Target>
  <ItemGroup>
    <Compile Include="../V4Fixtures.cs" Link="V4Fixtures.cs" />
    <EmbeddedResource Include="../V4Supplemental.json" Link="V4Supplemental.json" />
  </ItemGroup>
</Project>
