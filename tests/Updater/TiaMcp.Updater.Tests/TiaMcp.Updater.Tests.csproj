<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TiaMcp.Updater.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Updater/Updater.cs" Link="Updater/Updater.cs" />
    <Compile Include="../../../src/Shared/BundleLayout.cs" Link="Shared/BundleLayout.cs" />
    <Compile Include="../../../src/Logic/Siemens/TiaVersionCatalog.cs" Link="Shared/TiaVersionCatalog.cs" />
    <Compile Include="../../../src/Updater/UpdaterText.cs" Link="Updater/UpdaterText.cs" />
    <EmbeddedResource Include="../../../src/Updater/UpdaterMessages.resx" Link="Updater/UpdaterMessages.resx">
      <LogicalName>TiaMcp.Updater.UpdaterMessages.resources</LogicalName>
    </EmbeddedResource>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/ShardFramework.cs" Link="Shared/ShardFramework.cs" />
    <Compile Include="../../Shared/TimeSensitiveTests.cs" Link="Shared/TimeSensitiveTests.cs" />
    <AssemblyAttribute Include="Xunit.TestFrameworkAttribute">
      <_Parameter1>TiaMcp.Engine.Tests.Shared.ShardFramework</_Parameter1>
      <_Parameter2>$(AssemblyName)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="../../Shared/XunitDefaults.cs" Link="Shared/XunitDefaults.cs" />
  </ItemGroup>
</Project>
