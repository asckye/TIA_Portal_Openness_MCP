<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TiaMcp.ReleaseTool</AssemblyName>
    <RootNamespace>TiaMcp.ReleaseTool</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);TIA_RELEASE_TEST_SCHEDULING</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" />
    <!-- Use the installed SDK parser; no additional analyzer or NuGet package. -->
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
    <Compile Include="../../tests/Shared/FixtureExit.cs" Link="FixtureExit.cs" />
    <Compile Include="../../tests/Shared/TimeSensitiveTests.cs" Link="TimeSensitiveTests.cs" />
    <Compile Include="../../src/Tools/WriteGuard/ToolNames.cs" Link="Plugin/ToolNames.cs" />
    <EmbeddedResource Include="dead-reference-policy.json" />
    <ProjectReference Include="../common/TiaMcp.BuildCommon/TiaMcp.BuildCommon.csproj" />
    <ProjectReference Include="../../src/Logic/TiaMcp.Logic.csproj" />
    <ProjectReference Include="../../src/WorkerChannel/TiaMcp.WorkerChannel.csproj" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TiaMcp.ReleaseTool.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>TiaMcp.SourceContracts.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
