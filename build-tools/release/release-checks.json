  "groups": {
    "binary-build": "Native instrumentation, Foundation hosts, all eight adapters/workers, Studio, configurator, updater, WriteGuard and bundled runtime in both tiers.",
    "offline-suites": "All unit/offline suite gates; tier selection never alters compiler or publish arguments.",
    "native-coverage": "Adapter inventories, JIT diagnostics, native safety and diagnostic fixtures.",
    "resource-discovery": "V20/V21 rosters/resources and all Foundation catalogs; produces the mandatory usage inventory.",
    "product-smoke": "Eight real stdio MCP products: initialize, tools/list, InitializeEnvironment, one safe readiness/approval refusal; Studio starts against its bundled runtime.",
    "foundation-transport": "STDIO/HTTP transports across eight FoundationHost releases.",
    "foundation-approval": "Three default-approval/readiness checks per Foundation release.",
    "foundation-responses": "Capture and compare all six Foundation response snapshots.",
    "gui-tests": "Studio GUI process tests; configuration and core unit suites always run.",
    "relocation": "Extracted bundle check from outside the checkout, with an SDK root and user outside the Openness group.",
    "plc-functional": "example-library, process-leases, software-lookup, engineering-api, http, hmi, native-export, hmi-snapshot, global-script, graphic-selection, runtime-settings, migration-assembly, ecosystem-assembly, download-route, match-plc-name. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-worker-isolation": "Foundation worker fault injection and product transport checks for V20/V21. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-approval": "Default-on approval and real EXE readiness for V20/V21. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-ecosystem": "V21 ecosystem adapters on the V20 and V21 hosts. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-stability": "Four stdio/HTTP full/lite stability runs per release. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-isolated-stability": "Four FoundationHost session-worker stdio/HTTP full/lite stability runs at concurrency 16. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-contracts": "Capture and compare V20/V21 contracts. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l).",
    "plc-responses": "V20/V21 FoundationHost responses installed, source-layout and packaged hosts. Runs on FoundationHost and the PLC SDK fixture worker (the engine group retired in P8-04l)."
  }
