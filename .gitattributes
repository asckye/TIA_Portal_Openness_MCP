# Runtime checksums must survive checkout unchanged, including EXE configuration files.
runtime/** -text

# Preserve generated release metadata bytes across browser uploads and checkout.
manifest/** -text whitespace=cr-at-eol
# 源码与脚本的行尾/编码约定：仓库内 LF、无 BOM 的 UTF-8
*.cs text eol=lf
*.xaml text eol=lf
*.py text eol=lf

# Renderer goldens are compared byte for byte; keep their LF bytes on every checkout.
tests/Engine/TiaMcp.Engine.Tests/Fixtures/PlcRender/** -text

# Frozen 3.x contract evidence must retain its original bytes.
manifest/history/contracts-v3/** -text

# GitHub language statistics: renderer goldens are test data and the tool examples are snippets in target languages.
tests/Engine/TiaMcp.Engine.Tests/Fixtures/PlcRender/** linguist-generated
reference/tool-examples/** linguist-documentation

# Standard inventories and SCL golden bytes must survive Windows/Linux checkout.
templates/standards/tiamcp.basic/** text eol=lf
tests/Generation/**/Golden/** text eol=lf

# Campaign plan data is compared against the Python LF generation oracle.
scripts/diagnostics/campaign/plans/*.json text eol=lf
scripts/diagnostics/campaign/ledger-history.json text eol=lf

# Product generators compare raw UTF-8 bytes on Windows and Ubuntu.
src/Shared/ToolUsageData.json text eol=lf
src/Logic/ModelContextProtocol/ToolProfiles.resx text eol=lf
tests/Engine/TiaMcp.Engine.Tests/FullEngineRejections.json text eol=lf
reference/tool-catalog/*.json text eol=lf
reference/version-feature-matrix.json text eol=lf
docs/reference/version-tool-catalog.md text eol=lf
docs/reference/real-machine-ledger.md text eol=lf
docs/releases/v4.0.0-tool-migration.md text eol=lf

# Generated tool-count blocks are byte-checked inside these documents.
README.md text eol=lf
README.zh-CN.md text eol=lf
docs/getting-started/configuration.md text eol=lf
docs/getting-started/beginners.zh-CN.md text eol=lf
docs/reference/version-tools.md text eol=lf
docs/releases/v4.0.0.md text eol=lf
docs/development/runtime-layout.md text eol=lf
