<Project>
  <PropertyGroup>
    <TiaMcpRelease>3.3.0</TiaMcpRelease>
    <Version>$(TiaMcpRelease)</Version>
    <AssemblyVersion>$(TiaMcpRelease)</AssemblyVersion>
    <FileVersion>$(TiaMcpRelease).0</FileVersion>
    <InformationalVersion>$(TiaMcpRelease)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TiaMcpRelease" Value="$(TiaMcpRelease)" />
  </ItemGroup>
</Project>
