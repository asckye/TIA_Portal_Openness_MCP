<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TiaGitAddIn.Core</AssemblyName>
    <RootNamespace>TiaGitAddIn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The add-in's settings store is the only Newtonsoft.Json user and nothing here calls it; leaving it out keeps the
         Studio payload System.Text.Json-only (Build-Studio refuses Newtonsoft.Json.dll). The source file stays unmodified. -->
    <Compile Remove="Configuration/ConfigurationService.cs" />
  </ItemGroup>

</Project>
